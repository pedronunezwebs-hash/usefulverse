      "context": "fields.faq.1.a",
      "direction": "back",
      "source_text": "一个矩形不能包含多个数字提示。 每个矩形必须包含一个数字提示。",
      "source_text_sha256": "12493e0a262116d6221a5b02771708d63b36a6a400721ae9c59f24df2099f76d",
      "text": "A rectangle cannot contain multiple numbered hints. Each rectangle must contain one numbered hint.",
      "text_sha256": "7780b9d2a4f1f9e3e6e8ba3bf585e0eb60e6f74c32ec44997f436d03bd5e6de0",
