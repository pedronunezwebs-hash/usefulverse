/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=()

/
  Cache-Control: public, max-age=60, s-maxage=3600, stale-while-revalidate=86400

/tools/*
  Cache-Control: public, max-age=60, s-maxage=3600, stale-while-revalidate=86400

/tools/voice-recorder/*
  Permissions-Policy: microphone=(self)

/tools/guitar-tuner/*
  Permissions-Policy: microphone=(self)

/tools/password-breach-checker/*
  Content-Security-Policy: connect-src 'self' https://api.pwnedpasswords.com

/*/tools/password-breach-checker/*
  Content-Security-Policy: connect-src 'self' https://api.pwnedpasswords.com

/tools/local-ai-chat/*
  Content-Security-Policy: connect-src 'self' https://huggingface.co https://*.hf.co https://raw.githubusercontent.com

/*/tools/local-ai-chat/*
  Content-Security-Policy: connect-src 'self' https://huggingface.co https://*.hf.co https://raw.githubusercontent.com

/tools/paraphrasing-tool/*
  Content-Security-Policy: connect-src 'self' https://huggingface.co https://*.hf.co https://raw.githubusercontent.com

/*/tools/paraphrasing-tool/*
  Content-Security-Policy: connect-src 'self' https://huggingface.co https://*.hf.co https://raw.githubusercontent.com

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/pyodide-314.0.7/online-python-worker.mjs
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'none'
