{"approved":false,"back_sample":null,"beam_size":2,"checks":{"no_residual_markers":true,"nonempty":true,"not_truncated":true,"protected_values":true,"translated":true},"context":"singapore-cpf UI copy.fields.accuracyNote","detected_language":"ar","format":"usefulverse-background-draft-v1","key":"singapore-cpf.copy.fields.accuracyNote","keys":["singapore-cpf.copy.fields.accuracyNote"],"locale":"ar","model":"google/madlad400-3b-mt","raw_translation":"ويشمل هذا التقدير المحلي الأجور العادية لمواطني سنغافورة والمقيمين الدائمين اعتبارا من السنة الثالثة فصاعدا، ولا يشمل العلاوات والأجور الإضافية الأخرى، والمقيمين الدائمين في السنة الأولى والثانية، والعاملين في المنصات، والحدود القصوى للأجور السنوية وغيرها من قواعد كشوف المرتبات. وتتغير المعدلات للموظفين فوق ZXQPH0000QXZ إلى ZXQPH0001QXZ من كانون الثاني/يناير ZXQPH0002QXZ، ZXQPH0003QXZ. تحقق من قواعد مجلس صندوق الضمان الاجتماعي الحالية قبل استخدام كشوف المرتبات.","record_id":"6abea0e1953832ff3e645323b1c661b552b7440b2eeb7f3b54d006d13f18acbd","revision":"fa184c675da0b5c9e1c8694fccd4e12e2d422094","run_id":"40843674935","seconds":3.5638836016249797,"source":"This local estimate covers ordinary wages only for Singapore citizens and permanent residents from their third year onward. It excludes bonuses and other Additional Wages, first- and second-year permanent residents, platform workers, annual wage ceilings and other payroll rules. Rates for employees above 55 to 65 change from January 1, 2027. Check the current CPF Board rules before payroll use.","source_commit":"e1f72394198c1a94fce448ea14cd79b496701273","source_hash":"ae2da644c1c409e76f86c8d02838389aa5a3b2e4ede17ea94e9c69f94a2bcab2","status":"machine-draft","translation":"ويشمل هذا التقدير المحلي الأجور العادية لمواطني سنغافورة والمقيمين الدائمين اعتبارا من السنة الثالثة فصاعدا، ولا يشمل العلاوات والأجور الإضافية الأخرى، والمقيمين الدائمين في السنة الأولى والثانية، والعاملين في المنصات، والحدود القصوى للأجور السنوية وغيرها من قواعد كشوف المرتبات. وتتغير المعدلات للموظفين فوق 55 إلى 65 من كانون الثاني/يناير 1، 2027. تحقق من قواعد مجلس صندوق الضمان الاجتماعي الحالية قبل استخدام كشوف المرتبات.","truncated":false,"warnings":[]}
{"approved":false,"back_sample":null,"beam_size":2,"checks":{"no_residual_markers":true,"nonempty":true,"not_truncated":true,"protected_values":true,"translated":true},"context":"sleep-debt-calculator UI copy.fields.accuracyNote","detected_language":"ar","format":"usefulverse-background-draft-v1","key":"sleep-debt-calculator.copy.fields.accuracyNote","keys":["sleep-debt-calculator.copy.fields.accuracyNote"],"locale":"ar","model":"google/madlad400-3b-mt","raw_translation":"هذا يضيف كل فجوة دون المرجعية؛ فهو لا يقوم بنمذجة فيزيولوجيا النوم أو التنبؤ بالتعافي. الليالي فوق المرجعية تظهر بشكل منفصل ولا تمحو أوجه القصور السابقة. احتياجات النوم تختلف باختلاف الشخص والسياق. التماس الرعاية المؤهلة لمشاكل النوم المستمرة؛ هذه الأداة لا تشخيص أو وصف.","record_id":"6a92ef3a90a02e9b849b2784a91e9e26b8a4900122a1f4c020bc4929af84f059","revision":"fa184c675da0b5c9e1c8694fccd4e12e2d422094","run_id":"40843674935","seconds":2.58949490225001,"source":"This adds each below-reference gap; it does not model sleep physiology or predict recovery. Nights above the reference are shown separately and do not erase earlier shortfalls. Sleep needs vary by person and context. Seek qualified care for persistent sleep problems; this tool does not diagnose or prescribe.","source_commit":"e1f72394198c1a94fce448ea14cd79b496701273","source_hash":"5644f564c9da71f0fb90e9b293dc3a5f866594e7fb8309f8954c4287428fbb68","status":"machine-draft","translation":"هذا يضيف كل فجوة دون المرجعية؛ فهو لا يقوم بنمذجة فيزيولوجيا النوم أو التنبؤ بالتعافي. الليالي فوق المرجعية تظهر بشكل منفصل ولا تمحو أوجه القصور السابقة. احتياجات النوم تختلف باختلاف الشخص والسياق. التماس الرعاية المؤهلة لمشاكل النوم المستمرة؛ هذه الأداة لا تشخيص أو وصف.","truncated":false,"warnings":[]}
