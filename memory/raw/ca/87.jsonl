{"approved":false,"back_sample":null,"beam_size":2,"checks":{"no_residual_markers":true,"nonempty":true,"not_truncated":true,"protected_values":true,"translated":true},"context":"bond-calculator UI copy.additionalFaqs.1.answer","detected_language":"ca","format":"usefulverse-background-draft-v1","key":"bond-calculator.copy.additionalFaqs.1.answer","keys":["bond-calculator.copy.additionalFaqs.1.answer"],"locale":"ca","model":"google/madlad400-3b-mt","raw_translation":"El preu d' un bo és el valor actual dels seus cupons programats i del capital. Un rendiment de descompte més alt redueix aquest valor actual; un rendiment més baix l' augmenta.","record_id":"87e72b52971585c8d5dfe86f22f7fa8534571d83362151f92688375da5f5bef4","revision":"fa184c675da0b5c9e1c8694fccd4e12e2d422094","run_id":"40565692987","seconds":0.522595621624987,"source":"A bond price is the present value of its scheduled coupons and principal. A higher discount yield reduces that present value; a lower yield increases it.","source_commit":"e8a7cb94dc75d40f2c0e14bb27c0a1819e230012","source_hash":"e92f435739cff311db059d45d31a81b0d8ee9f7edcd8603db08716f8567dfec6","status":"machine-draft","translation":"El preu d' un bo és el valor actual dels seus cupons programats i del capital. Un rendiment de descompte més alt redueix aquest valor actual; un rendiment més baix l' augmenta.","truncated":false,"warnings":[]}
