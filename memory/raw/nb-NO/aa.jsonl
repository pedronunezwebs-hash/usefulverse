{"approved":false,"back_sample":null,"beam_size":2,"checks":{"no_residual_markers":true,"nonempty":true,"not_truncated":true,"protected_values":true,"translated":true},"context":"go-game UI copy.body","detected_language":"nb","format":"usefulverse-background-draft-v1","key":"go-game.copy.body","keys":["go-game.copy.body"],"locale":"nb-NO","model":"google/madlad400-3b-mt","raw_translation":"Dette lokale nybegynnerbrettet bruker posisjonell gjentakelsesforebygging og enkel områdepoengtelling: steiner pluss tomme områder omgitt av én farge. Det gjelder ikke komi, handikap, turneringsklokker, liv- og- død-dommer eller alle regelsettvariasjoner. To personer deler denne enheten; trekk blir ikke lastet opp eller lagret.","record_id":"aa2263eb43dbdd398583268246ceac497fe833fb5ad2c63e3a3912c479262b21","revision":"fa184c675da0b5c9e1c8694fccd4e12e2d422094","run_id":"40565692987","seconds":1.1211867618749807,"source":"This local beginner board uses positional repetition prevention and simple area scoring: stones plus empty regions bordered by one color. It does not apply komi, handicap, tournament clocks, life-and-death adjudication or every ruleset variation. Two people share this device; moves are not uploaded or saved.","source_commit":"e8a7cb94dc75d40f2c0e14bb27c0a1819e230012","source_hash":"5889565da27fa1b5953bdef9760a54de6df104ffd779a8554788ea1a0ba7b6eb","status":"needs-review","translation":"Dette lokale nybegynnerbrettet bruker posisjonell gjentakelsesforebygging og enkel områdepoengtelling: steiner pluss tomme områder omgitt av én farge. Det gjelder ikke komi, handikap, turneringsklokker, liv- og- død-dommer eller alle regelsettvariasjoner. To personer deler denne enheten; trekk blir ikke lastet opp eller lagret.","truncated":false,"warnings":["language_detection"]}
