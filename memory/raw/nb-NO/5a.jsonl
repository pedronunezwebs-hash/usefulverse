{"approved":false,"back_sample":null,"beam_size":2,"checks":{"no_residual_markers":true,"nonempty":true,"not_truncated":true,"protected_values":true,"translated":true},"context":"norway-car-import-cost-calculator UI copy.faq.2.a","detected_language":"no","format":"usefulverse-background-draft-v1","key":"norway-car-import-cost-calculator.copy.faq.2.a","keys":["norway-car-import-cost-calculator.copy.faq.2.a"],"locale":"nb-NO","model":"google/madlad400-3b-mt","raw_translation":"Nei, den beregner de viktigste avgifter og gebyrer du oppgir. Teknisk godkjenning, etterlevelsesendringer, transport innenfor Norge, reparasjoner, forsikring og andre registreringskostnader ligger utenfor dette anslaget.","record_id":"5a3b38dc33fb868fea6ba839b5ecc6a6380f6458cf8fda05fbc40e46cd97bc9e","revision":"fa184c675da0b5c9e1c8694fccd4e12e2d422094","run_id":"40565692987","seconds":2.000660927125068,"source":"No. It estimates the main taxes and fees you enter. Technical approval, compliance changes, transport inside Norway, repairs, insurance and other registration costs are outside this estimate.","source_commit":"e8a7cb94dc75d40f2c0e14bb27c0a1819e230012","source_hash":"c036565bb5744bc89e9ca6c090502001204d8eaa2d7564cf1ccdf1e325336bf8","status":"machine-draft","translation":"Nei, den beregner de viktigste avgifter og gebyrer du oppgir. Teknisk godkjenning, etterlevelsesendringer, transport innenfor Norge, reparasjoner, forsikring og andre registreringskostnader ligger utenfor dette anslaget.","truncated":false,"warnings":[]}
