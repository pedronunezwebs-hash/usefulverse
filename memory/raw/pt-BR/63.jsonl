{"approved":false,"back_sample":null,"beam_size":2,"checks":{"no_residual_markers":true,"nonempty":true,"not_truncated":true,"protected_values":true,"translated":true},"context":"hitori UI copy.fields.rules","detected_language":"pt","format":"usefulverse-background-draft-v1","key":"hitori.copy.fields.rules","keys":["hitori.copy.fields.rules"],"locale":"pt-BR","model":"google/madlad400-3b-mt","raw_translation":"Um tabuleiro válido não tem números brancos repetidos em nenhuma linha ou coluna, sem células pretas que se tocam lateralmente e uma área branca conectada. Verifique o tabuleiro ou peça uma dica quando precisar de ajuda.","record_id":"6370316fb405b24ee60ce65bf69fe2af1a6e5bfa18109654a8e4a48d36a7da21","revision":"fa184c675da0b5c9e1c8694fccd4e12e2d422094","run_id":"40565692987","seconds":1.5335661567499983,"source":"Tap or focus a number and press Enter or Space to mark it black. Marked cells are crossed out; unmarked cells stay white. A valid board has no repeated white number in any row or column, no side-touching black cells, and one connected white area. Check the board or request a hint when you need help.","source_commit":"e8a7cb94dc75d40f2c0e14bb27c0a1819e230012","source_hash":"7deee4ca79b5818b102b91b9f79abacbe163816a265151531562cedad7e69b7e","status":"machine-draft","translation":"Um tabuleiro válido não tem números brancos repetidos em nenhuma linha ou coluna, sem células pretas que se tocam lateralmente e uma área branca conectada. Verifique o tabuleiro ou peça uma dica quando precisar de ajuda.","truncated":false,"warnings":[]}
