{"approved":false,"auto_usable":true,"back_translation":"The standard household support pays 90% of any amount of spot price per hour above NOK 0.77/kWh before taxes, for eligible usage up to 5,000 kWh per month. Norgespris uses the fixed reference price NOK 0.50/kWh including taxes (NOK 0.40 without electricity tax); the settlement uses the average spot price for full month area and eligible meter usage. The limit is 5,000 kWh/month for homes or 1,000 kWh/month for holiday homes. A household can choose one scheme, not both. Network charges and other charges are entered separately and added to all scenarios. The comparison uses the exact hourly data you provide; prices are not taken.","back_truncated":false,"format":"usefulverse-semantic-audit-v1","native_review":false,"policy":{"allows_publication":false,"claims_native_quality":false,"embedding":{"license":"MIT","repository":"intfloat/multilingual-e5-small","revision":"614241f622f53c4eeff9890bdc4f31cfecc418b3"},"max_tokens":512,"maximum_contradiction":0.2,"minimum_entailment":0.6,"minimum_similarity":0.8,"nli":{"license":"Apache-2.0","repository":"cross-encoder/nli-deberta-v3-small","revision":"fa2804872c3b4bd748f38c0185cc85775361e735"},"version":"semantic-screen-1"},"policy_digest":"36421db300bb5b4775311d883e0717d9efadde33b6766e5fd6d698175f610ed0","raw_digest":"328d4dc79ccf905d13639e58cabe2bc85a10903a92044beb895548859a0284bf","reasons":[],"record_id":"a8097d1c9f0b608c83334a396844a8bc36677c70c3ca5e692810e9cb41d953a1","scores":{"forward_contradiction":0.0011746747186407447,"forward_entailment":0.9934584498405457,"reverse_contradiction":0.0009261242230422795,"reverse_entailment":0.9949783682823181,"similarity":0.945424497127533}}
