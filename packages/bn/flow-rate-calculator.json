{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"flow-rate-calculator.copy.additionalFaqs.0.question":{"context":"flow-rate-calculator UI copy.additionalFaqs.0.question","source_hash":"68c990505da9a8f5b2e044b9b6e10f453b8e2033e57dd21ccfc986823197c019","translation":"একটি 2 m² অংশের প্রবাহের হার কত, যা 3 m/s বেগে প্রবাহিত হয়?"},"flow-rate-calculator.copy.additionalFaqs.1.answer":{"context":"flow-rate-calculator UI copy.additionalFaqs.1.answer","source_hash":"7c573fd71701c5e24bd47ca8e0166f74d1abdd30205c3784fa09ec87d1ac23bf","translation":"পাইপের ক্রস- সেকশন ক্ষেত্রফলকে তরলের গড় গতি দ্বারা গুণ করুন । একটি বৃত্তাকার পাইপের ক্ষেত্রে, ক্ষেত্রফল হল π গুণ অভ্যন্তরীণ ব্যাসার্ধের বর্গকে চার দ্বারা বিভক্ত করা; বাইরের ব্যাসার্ধ নয়, অভ্যন্তরীণ ব্যাসার্ধ ব্যবহার করুন ।"},"flow-rate-calculator.copy.fields.cubicMetersPerSecond":{"context":"flow-rate-calculator UI copy.fields.cubicMetersPerSecond","source_hash":"eb537da597ddc6003fd0657dc1a1dde06d65601561fb176d666e69e647f76815","translation":"প্রতি সেকেন্ডে ঘনমিটার (m³/ s)"},"flow-rate-calculator.copy.fields.tankVolume":{"context":"flow-rate-calculator UI copy.fields.tankVolume","source_hash":"6d323345a7c486ae144b07c7c3245beb4c21ffeb6a1d5504a1de3949cdad20ff","translation":"ট্যাংক অথবা কন্টেইনার ভলিউম"},"flow-rate-calculator.copy.fields.usGallons":{"context":"flow-rate-calculator UI copy.fields.usGallons","source_hash":"c295a8b8a622ed30ee8b09be98a9ec9f9610b5c578d2f0cf1ef541defe7407a1","translation":"মার্কিন গ্যালন (US gal)"},"flow-rate-calculator.copy.fields.volumeUnit":{"context":"flow-rate-calculator UI copy.fields.volumeUnit","source_hash":"10b2f05d240a6364567a97514bb63f5cc3386ea5272980735a68c0c5b330c3b4","translation":"ভলিউমের একক"},"flow-rate-calculator.copy.howAnswer":{"context":"flow-rate-calculator UI copy.howAnswer","source_hash":"1f3f4899f63ab5cc3e1f65d9265252070b9fa68d439aaa24dc4a03795f9b489f","translation":"একটি অংশের মধ্য দিয়ে স্থিতিশীল প্রবাহের ক্ষেত্রে, ভলিউমেট্রিক প্রবাহের হার Q সমতুল্য ক্রস- স