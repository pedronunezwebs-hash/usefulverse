{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"customer-journey-map.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"উদাহরণ লোড করো"},"customer-journey-map.copy.fields.accuracyNote":{"context":"customer-journey-map UI copy.fields.accuracyNote","source_hash":"8a5b56e297300a6c29a61a9227fe1b50426f5a4e40a1c59c8fd9a678ce23309e","translation":"এটি একটি কাঠামোগত কর্মক্ষেত্র, গ্রাহক গবেষণা নয়। এটি মানুষের সাক্ষাৎকার নেয় না, গ্রাহকের আচরণ অনুমান করে না বা প্রমাণ উৎপাদন করে না। প্রস্তাবিত ধাপগুলি সম্পাদনযোগ্য অনুরোধ, আপনার দর্শকদের সম্পর্কে কোন দাবি নয়। অনুমানগুলিকে অনুমান হিসাবে চিহ্নিত করুন এবং অজ্ঞাত অঞ্চলগুলি অজানা হিসাবে চিহ্নিত করুন। আপনি যদি JSON ডাউনলোড না করেন তবে সমস্ত বিষয়বস্তু এই পৃষ্ঠায় থাকবে।"},"customer-journey-map.copy.fields.moveDown":{"context":"customer-journey-map UI copy.fields.moveDown","source_hash":"3a3664419cf0799911114f8e9f094e22d26907b4a276852ce7f0919670d9b136","translation":"মঞ্চ নীচে সরাও"},"customer-journey-map.copy.fields.starterStages.0":{"context":"customer-journey-map UI copy.fields.starterStages.0","source_hash":"d4a33d5b78bccebe3f16843dc30e6c0f73b4eb6efb4e7114ddfebde7fa2c9954","translation":"আবিষ্কার"},"customer-journey-map.copy.howAnswer":{"context":"customer-journey-map UI copy.howAnswer","source_hash":"69b43033821af289f4b79d6381136af486ccb9a375880523b9248edd0fbcc8db","translation":"দর্শক এবং এর লক্ষ্য লিখুন, তারপর প্রস্তাবিত ধাপগুলি পুনর্বিবেচনা করুন বা প্রতিস্থাপন করুন । তিন থেকে আটটি ধাপ যোগ করুন এবং রেকর্ড করুন যে ব্যক্তিটি কী করে, তারা কোথায় যোগাযোগ করে, তারা কীভাবে অনুভব করে, কীভাবে পথে আসে এবং কী উন্নত করা যেতে পারে । প্রতিটি ধাপকে পর্যবেক্ষণকৃত প্রমাণ, একটি ধারণা বা এখনো গবেষণা করা হয়নি হিসাবে লেবেল করুন । পর্যবেক্ষণ করা চিহ্নিত কোন ধাপ রপ্তানি করার আগে উৎস বিবরণ যোগ করুন ।"},"customer-journey-map.copy.messages.canvasUnavailable":{"context":"Shared UI copy.messages.canvasUnavailable","sourc