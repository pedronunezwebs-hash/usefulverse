{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-employer-cost-calculator.copy.details":{"context":"norway-employer-cost-calculator UI copy.details","source_hash":"8b288037e5ace5a06c2ac3508b1fb5530ef3639d3532d57a8cec85bb4567058f","translation":"ক্যালকুলেটরটি সাধারণ কার্যক্রম বা কৃষি/মৎস্যচাষের জন্য প্রকাশিত 2026 অঞ্চলের হার ব্যবহার করে। এটি যোগ করা হয়েছে ছুটির বেতন, করযোগ্য ক্ষতিপূরণ এবং অংশগ্রহণের ভিত্তিতে যে কোনও পেনশন অংশগ্রহণ। জোন Ia এর সাধারণ কার্যক্রমের জন্য, 850,000 NOK প্রতি-প্রতিষ্ঠান ভিন্ন অনুদানটি এই বছর ইতিমধ্যে ব্যবহার করা হয়েছে। ফলাফলগুলি বার্ষিক পরিকল্পনার অনুমান; কর্মচারীর নিবন্ধিত অবস্থান এবং কার্যক্রম প্রযোজ্য নিয়ম নির্ধারণ করে।"},"norway-employer-cost-calculator.copy.faq.3.a":{"context":"norway-employer-cost-calculator UI copy.faq.3.a","source_hash":"cc7d5e9ffcc6fb913633a6319fc4e13af00a4531ac7d7bc89f73cdaef48157c5","translation":"না, ছুটি বেতন হার এবং ভিত্তি, পেনশনযোগ্য বেতন এবং অন্যান্য খরচ সম্পাদনযোগ্য অনুমান। বিমা, বেতন প্রশাসন, বিশেষ সুবিধা, ছাড় এবং ব্যক্তিগত কর্মচারী সীমা সম্পূর্ণরূপে মডেল করা হয়নি।"},"norway-employer-cost-calculator.copy.fields.zoneIVa":{"context":"norway-employer-cost-calculator UI copy.fields.zoneIVa","source_hash":"371bc2246cf8d2bb68e6eedfba7196e215d3434a81b06d0124935709c4ea0dd5","translation":"অঞ্চল IVa — 7.9% সাধারণ / 5.1% কৃষি ও মৎস্যচাষ"},"norway-employer-cost-calculator.copy.fields.zoneV":{"context":"norway-employer-cost-calculator UI copy.fields.zoneV","source_hash":"35a0778780f31cb3ea4738061fccb7ba550935635fc4e9beee9344022dad826a","translation":"জোন V — 0%"},"norway-employer-cost-calculator.copy.related":{"context":"norway-employer-cost-calculator UI copy.related","source_hash":"3da6e153ee8cea08506a33e168e7b5e25fbdf546dcd75c3aeb3fa4345774f329","translation":"সম্পর্কিত টুল"}},"locale":"bn","missing":["norway-employer-cost-calculator.copy.name","norway-employer-cost-calculator.copy.title","norway-employer-cost-calculator.copy.description","norway-employer-cost-calculator.copy.int