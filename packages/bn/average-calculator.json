{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"average-calculator.copy.examples.1.heading":{"context":"average-calculator UI copy.examples.1.heading","source_hash":"1cf8410afc6a1fca2047420b6c8a8989d9b6b6017ff1cddb67153885cee9909b","translation":"ভিন্ন ক্রেডিট"},"average-calculator.copy.faq.2.question":{"context":"average-calculator UI copy.faq.2.question","source_hash":"a45167c6857e962255434e7c079a5067e0fbce004b9358996260480a69f6485d","translation":"কিভাবে মিডিয়ান কাজ করে?"},"average-calculator.copy.form.fields.a":{"context":"average-calculator UI copy.form.fields.a","source_hash":"53b09e104f608daac0a306abc28a053b592f4518cfc1dc28d81c5b52813eb599","translation":"মানসমূহ"},"average-calculator.copy.form.fields.c":{"context":"average-calculator UI copy.form.fields.c","source_hash":"7c02a493e4508c7b41f304cb63c51946d2d8e13e30e0f1761bfd085e7ec46867","translation":"টার্গেট গ্রেড (%)"},"average-calculator.copy.form.modes.weighted":{"context":"average-calculator UI copy.form.modes.weighted","source_hash":"9ed0fb8fbe4b0a5bed7b0f19b6c166a6b94db2fa58d85debc1171d7742c13160","translation":"ওজনকৃত গড়"},"average-calculator.copy.how.steps.2.text":{"context":"average-calculator UI copy.how.steps.2.text","source_hash":"3a4e5db8bce160e75d393890aca8e8834ae802ce24b070d3973abd89daa1b3b3","translation":"গণনা করুন, কাজটি পরীক্ষা করুন এবং প্রয়োজন হলে ফলাফল সংরক্ষণ করুন । বাতিল করা একটি দীর্ঘ কাজ বন্ধ করে ।"},"average-calculator.copy.method.paragraphs.4":{"context":"average-calculator UI copy.method.paragraphs.4","source_hash":"e56bede094fe34ce1a9b66564f543f0582e6afdfae64fca828e3eac09fbeab32","translation":"প্রয়োজনীয় শেষ গ্রেড অনুমান করা হয় যে বর্তমান গ্রেড শেষের পূর্বে সমস্ত কাজের উপর প্রভাব ফেলে । ফর্মুলা হল (উদ্দেশ্য × 100 - বর্তমান × (100 - শেষ ওজন)) / শেষ ওজন । বর্তমান এবং লক্ষ্য গ্রেড শূন্য থেকে একশতের মধ্যে এবং শেষ ওজন ধনাত্মক ।"},"average-calculator.copy.privacy.heading":{"context":"average-calculator UI copy.privacy.heading","source_hash":"bef0dc8aaebf768fa2be1fb224ac1a08ac3fa810c85991f3040785b5239b6229","translation":"ব্যক্তিগত গণনা, পরিষ্কার সীমা"},"average-calculator.copy.privacy.paragraphs.2":{"context":"average-calculator UI copy.privacy.paragraphs.2","source_hash":"8b3fd9a899a4f3c379c1bc5f5801391bfa6053d76d429ccef1de4f2589ffbb6f","translation":"বড় গণনা ডিভাইস সময় এবং মেমরি উপর নির্ভর করে । বাতিল করা সক্রিয় কাজ বন্ধ করে । একটি ত্রুটি পুরনো উত্তর মুছে ফেলে এবং তাদের ডাউনলোড নিষ্ক্রিয় করে ।"},"average-calculator.copy.ui.errors.GRADE_RANGE":{"context":"average-calculator UI copy.ui.errors.GRADE_RANGE","source_hash":"42c6f31b492c8a0b5850b37c310229357f33011712b30ee5ea9552b710553f09","translation":"গ্রেড ব্যবহার করুন 0 থেকে 100 এবং একটি শেষ ওজন শূন্যের উপরে 100 পর্যন্ত।"},"average-calculator.copy.ui.errors.NOT_ENOUGH":{"context":"average-calculator UI copy.ui.errors.NOT_ENOUGH","source_hash":"dea150bdfc2549c8be20d8114bc3689c883a873f0049febf17cb14037be47dc6","translation":"এই পরিসীমাটিতে আপনার অনুরোধকৃত পরিসীমার চেয়ে কম ভিন্ন মান রয়েছে । এটি প্রশস্ত করুন অথবা পুনরাবৃত্তি অনুমোদন করুন ।"},"average-calculator.copy.ui.temporalSource":{"context":"average-calculator UI copy.ui.temporalSource","source_hash":"33da353ebf9d16691c05170ce2ceca80d77810c60076b44c23a1c3201e4fd8d9","translation":"আরো নিয়ম এবং কাজের উদাহরণ"},"average-calculator.copy.ui.withinRange":{"context":"average-calculator UI copy.ui.withinRange","source_hash":"2670992149b662998317d15b803849d1661d09f3eb9a570fb6f2bb74262ed989","translation":"প্রবেশ করা 0–100 গ্রেড স্কেলের মধ্যে"},"average-calculator.copy.uses.paragraphs.1":{"context":"average-calculator UI copy.uses.paragraphs.1","source_hash":"8f32e746e41356cec55940fd027c4d911c616249d395c8490f71472436754ab1","translation":"সমান নয় এমন ক্রেডিট, পরিমাণ বা অবদানগুলির জন্য ওজনযুক্ত মোড ব্যবহার করুন । মান এবং ওজনগুলি তাদের মূল ক্রম অনুসারে জোড়ায় রাখুন । একটি তালিকাকে অন্যটি বাদ দিয়ে সাজানো সমস্যাটি পরিবর্তন করে এবং একটি যুক্তিসঙ্গত কিন্তু ভুল উত্তর তৈরি করতে পারে ।"}},"locale":"bn","missing":["average-calculator.copy.