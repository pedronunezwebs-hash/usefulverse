{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-car-import-cost-calculator.copy.exampleHeading":{"context":"norway-car-import-cost-calculator UI copy.exampleHeading","source_hash":"d029f87e3d80f8fd9b1be67c7426b4cc1ff47b4a9d0a8461c826a59d8c5eb6cd","translation":"উদাহরণ"},"norway-car-import-cost-calculator.copy.faq.2.a":{"context":"norway-car-import-cost-calculator UI copy.faq.2.a","source_hash":"c036565bb5744bc89e9ca6c090502001204d8eaa2d7564cf1ccdf1e325336bf8","translation":"না, এটা মূল কর এবং ফির হিসাব করে, যা আপনি প্রবেশ করেন। প্রযুক্তিগত অনুমোদন, অনুমোদন পরিবর্তন, নরওয়ের মধ্যে পরিবহন, মেরামত, বিমা এবং অন্যান্য নিবন্ধন খরচ এই হিসাব থেকে বাদ পড়ে।"},"norway-car-import-cost-calculator.copy.fields.total":{"context":"norway-car-import-cost-calculator UI copy.fields.total","source_hash":"4393203e39d9b10cb963b58a324b9d526bffe71ddf0730c82071cb0aa849192a","translation":"ক্রয় সহ মোট অনুমান"},"norway-car-import-cost-calculator.copy.fields.vatHelp":{"context":"norway-car-import-cost-calculator UI copy.fields.vatHelp","source_hash":"13df66fe6a0030ac431f9b36666725bbe3d8029361c50e308a6e097b771f417a","translation":"যানবাহন আমদানির ক্ষেত্রে ভ্যাটের আদর্শ হার হল 25%।"},"norway-car-import-cost-calculator.copy.limits":{"context":"norway-car-import-cost-calculator UI copy.limits","source_hash":"10e4c95428924dc48084ce39fac73af1928fac6d5eaf13d4569168da87f5cbd0","translation":"শুধুমাত্র নরওয়ে · চেক করা 17 অক্টোবর 2026 · প্রতি অনুমানে একটি গাড়ি। ভ্যাট রেট, মুদ্রার হার, একবার রেজিস্ট্রেশন কর, রেফ্রিজারেটর চার্জ এবং তুলনামূলক নরওয়েজিয়ান বাজারের মূল্য আপনার দ্বারা প্রবেশ করা হয়। NOK 2,400 স্ক্র্যাপ ডিপোজিট দেখানো হয়েছে বর্তমান যাত্রীবাহী গাড়ির পরিমাণ, কিন্তু তা পরিবর্তন করা যেতে পারে। কোন প্রযুক্তিগত অনুমোদন, মূল্য-তালিকা অবমূল্যায়ন পদ্ধতি, গাড়ির ছাড়, গ্রীনহাউস গ্যাসের ধরন গণনা বা নিবন্ধন সিদ্ধান্ত অনুমান করা হয় না। কেনার আগে Skatteetaten এবং নরওয়ের কাস্টমস চেক করুন।"},"norway-car-import-cost-calculator.copy.privacy":{"context":"norway-car-import-cost-calcula