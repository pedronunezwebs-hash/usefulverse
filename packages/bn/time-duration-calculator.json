{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"time-duration-calculator.copy.description":{"context":"time-duration-calculator UI copy.description","source_hash":"5a396a86f1d578e4a85234fc049e0bab280da3cb882da483e3bb2ac0413ef475","translation":"সময় অথবা তারিখের মধ্যে ঘন্টা, মিনিট এবং সেকেন্ড খুঁজুন। রাতের বেলা, বিরতি, টাইম জোন এবং ঘড়ির পরিবর্তন ব্যবস্থাপনা করুন। আপনার ব্রাউজার-এ বিনামূল্যে গণনা করুন।"},"time-duration-calculator.copy.faq.1.answer":{"context":"time-duration-calculator UI copy.faq.1.answer","source_hash":"ed424efdbe651eafb3d3f5734a69c795ea91d66421c76b8e4555839f1b9065a7","translation":"ঘড়ির সময়-এ, সমাপ্তি পরবর্তী দিন। সক্রিয় করুন। 23:30 থেকে 01:15-এর জন্য, উত্তর হবে 1 ঘন্টা 45 মিনিট। একাধিক দিনের জন্য, প্রকৃত তারিখ ব্যবহার করুন।"},"time-duration-calculator.copy.faq.3.question":{"context":"time-duration-calculator UI copy.faq.3.question","source_hash":"82dcd42b691ecbea4e3433d5409ecd424120fc04a72f2b3127f8f0305e3fa5e5","translation":"আমি কিভাবে দুপুরের খাবার বিরতি মুছে ফেলব?"},"time-duration-calculator.copy.how.heading":{"context":"time-duration-calculator UI copy.how.heading","source_hash":"8c53d88b153589eb1bdcb0e5e8cba15e4e9a39b1852537d7345fd19a7d433a1e","translation":"দুবার, একটা উত্তর যাচাই করতে পারবে।"},"time-duration-calculator.copy.labels.examples":{"context":"time-duration-calculator UI copy.labels.examples","source_hash":"38a8c28c47b65bc9325ba45486b759c726d614e9fc2509eae8fbd0fdf234681b","translation":"একটু এগিয়ে গিয়েছি"},"time-duration-calculator.copy.method.paragraphs.2":{"context":"time-duration-calculator UI copy.method.paragraphs.2","source_hash":"0cb1ecf008172991fb74da08089f6548a60e70ea08c93132d80893fdbab50184","translation":"বসন্তকালীন ঘড়ি পরিবর্তনের ফলে স্থানীয় ঘড়ি থেকে এক ঘণ্টা সরিয়ে ফেলা যেতে পারে । কিছু স্থানীয় সময় কখনোই ঘটে না । শরৎকালীন পরিবর্তনের ফলে ঘণ্টাটি পুনরাবৃত্তি হতে পারে, যার ফলে লেবেলটি অস্পষ্ট হয়ে পড়ে । এই ক্যালকুলেটরটি অনুপস্থিত সময় প্রত্যাখ্যান করে এবং পুনরাবৃত্তির জন্য কোন ঘটনার কথা বলছে তা জিজ্ঞাসা করে । এটি আপনার ইনপুটকে কখনো নিঃশব্দে সরিয়ে দেয় না ।"},"time-duration-calculator.copy.navigation.examples":{"context":"time-duration-calculator UI copy.navigation.examples","source_hash":"936698aa19410efc088439217f04f509021920dc8e42c0438c6dee3ce1f21680","translation":"কাজকৃত উদাহরণ"},"time-duration-calculator.copy.privacy.paragraphs.1":{"context":"time-duration-calculator UI copy.privacy.paragraphs.1","source_hash":"787281ddc1bb2b812a3be8c259895b5cbb6ba1b5c4ada5fb2807a38f19e302f1","translation":"সময়-অঞ্চলের নিয়ম টাইম লাইব্রেরী দ্বারা ব্যবহৃত ব্রাউজারের তথ্য থেকে এসেছে। নতুন নিয়মের জন্য আপনার ব্রাউজার হালনাগাদ করুন। ভবিষ্যতে সরকারী পরিবর্তন এবং ঐতিহাসিক রেকর্ড তথ্যের সংস্করণের মধ্যে পার্থক্য হতে পারে। এই টুলটি জুলিয়ান ক্যালেন্ডার থেকে লেপ সেকেন্ড বা প্রত্যেক দেশের পরিবর্তন মডেল করে না।"},"time-duration-calculator.copy.ui.dayNote":{"context":"time-duration-calculator UI copy.ui.dayNote","source_hash":"7a7d3583d9a80361725d5430974fd836957edd01e2febe532cd78d4d80ae433d","translation":"এখানে দেখানো প্রত্যেকটি দিন 24 ঘন্টার একটি ব্লক।"},"time-duration-calculator.copy.ui.endOccurrence":{"context":"time-duration-calculator UI copy.ui.endOccurrence","source_hash":"a34ae86acfad85f74e5a166e8de3053f7b31f06d3b7f432cee5ecebbd78e24e7","translation":"সমাপ্তির সময় পুনরাবৃত্তি হলে"},"time-duration-calculator.copy.ui.later":{"context":"time-duration-calculator UI copy.ui.later","source_hash":"bdb6a6862253d1ca27903a07a2034d81065509a1e61568799d4ba5320dff72dd","translation":"দ্বিতীয় সংঘটন"},"time-duration-calculator.copy.ui.reject":{"context":"time-duration-calculator UI copy.ui.reject","source_hash":"980eeb394efd2e3181a4c862b883831878d1854c64a9cba5a13468d48e29e779","translation":"আমাকে বেছে নিতে বলো"},"time-duration-calculator.copy.ui.start":{"context":"time-duration-calculator UI copy.ui.start","source_hash":"252acb3651259b06df3cf1f99409f9809f13d50a914554f7fcf40a055e7a5eb3","translation":"আরম্ভের তারিখ ও সময়"},"time-duration-calculator.copy.ui.zoneNote":{"context":"time-duration-calc