{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"date-calculator.copy.description":{"context":"date-calculator UI copy.description","source_hash":"b9545b9eb0577f4e5b0dc2fa9201b0f0e0fdd95a3327cefb8c12fb2e2ea9ff46","translation":"তারিখের মধ্যে দিন গণনা করুন অথবা বছর, মাস, সপ্তাহ এবং দিন যোগ করুন। ক্যালেন্ডার, সপ্তাহের দিন এবং মাসের শেষের নিয়ম দেখুন। বিনামূল্যে, আপনার ব্রাউজার থেকে গণনা করা যাবে।"},"date-calculator.copy.examplesAction":{"context":"date-calculator UI copy.examplesAction","source_hash":"68623191a26dab07c7acedb36efb8ae1cacd13e3fabd0fe23f1f7d026bfe8424","translation":"এই উদাহরণটি ব্যবহার করুন"},"date-calculator.copy.faq.7.question":{"context":"date-calculator UI copy.faq.7.question","source_hash":"1db31f79eca7e861e53e33bf5d69ab07641998a90bc740e652efa8904ab34f7c","translation":"যদি সমাপ্তির তারিখ আরম্ভের তারিখের আগে হয়?"},"date-calculator.copy.how.steps.2.heading":{"context":"date-calculator UI copy.how.steps.2.heading","source_hash":"7f0b30d9dd6daca4c10b947e1e8aa435e89d85ec0295002c9ecc1ca9d2714795","translation":"ফলাফল পড়ো"},"date-calculator.copy.labels.method":{"context":"date-calculator UI copy.labels.method","source_hash":"ad1d4546ea405ba7444e37ec07f2cf556212b511495775fbaffd15c334bd8f21","translation":"কোন লুকানো ক্যালেন্ডার নিয়ম নেই"},"date-calculator.copy.method.paragraphs.4":{"context":"date-calculator UI copy.method.paragraphs.4","source_hash":"c0e9da1bd3710dc9fba1b6cd203cb5e7dce6ffe21c9a57c1bcec59f1dbb24949","translation":"ক্যালেন্ডার তারিখ ব্যবহার করে গণনা করা হয়, দিনের সময় নয় । দিনের আলোর পরিবর্তন একটি ক্যালেন্ডার দিনকে এখানে একটি ভগ্নাংশে পরিণত করে না । সময়ের মধ্যে ঘন্টা নির্ধারণের জন্য, সময়কাল গণনাকারী ব্যবহার করুন । কার্যদিবস নির্ধারণের জন্য, ব্যবসায়িক দিন গণনাকারী ব্যবহার করুন এবং যে ছুটির দিনগুলি প্রযোজ্য তা বেছে নিন ।"},"date-calculator.copy.navigation.onPage":{"context":"date-calculator UI copy.navigation.onPage","source_hash":"06a7b55d6c3eb44df5cb54524e6103ecbc08f496c8689513efc7aac2b548b170","translation":"এর বেশিরভাগ অংশ নিতে"},"date-calculator.copy.privacy.paragraphs.2":{"context":"date-calculator UI copy.privacy.paragraphs.2","source_hash":"69bc3a9f0734b944a69b852a935df233299f12a6c680220407802077c9d7d41c","translation":"গণনা নেটওয়ার্ক অনুরোধ করে না এবং স্বয়ংক্রিয়ভাবে সংরক্ষণ করা হয় না । পাতা এবং এর ফন্ট সাইট থেকে লোড করা হয় । একটি শেয়ার লিঙ্ক অনুলিপি করা আপনার প্রবেশ করা তারিখ এই লিঙ্কে রাখে । যখন কেউ এটি খুলবে, এই তারিখগুলি পাতা ঠিকানা অংশ হয়ে যায় । ব্যক্তিগত তারিখ শেয়ার করা এড়িয়ে চলুন ।"},"date-calculator.copy.title":{"context":"date-calculator UI copy.title","source_hash":"db18aaed564e06ed2a7fb82c53d71496b0bdead1dbcdebed2d8d9be9e32109d1","translation":"তারিখ ক্যালকুলেটর — তারিখের মধ্যবর্তী দিন এবং তারিখ যোগ করুন | UsefulVerse"},"date-calculator.copy.ui.errors.LINK_INVALID":{"context":"date-calculator UI copy.ui.errors.LINK_INVALID","source_hash":"f74e7dc8e4a84e4b31bb61e1a666a283f9d9ab8f49a54ee6c29877449de55896","translation":"এই লিঙ্ক- এ অবৈধ তারিখ অথবা অপশন রয়েছে । আবার শুরু করতে নীচে তারিখ বেছে নিন ।"},"date-calculator.copy.ui.inclusive":{"context":"date-calculator UI copy.ui.inclusive","source_hash":"744b95368d1d43a95bf3223762734ea3810910735211c105cac83d8b7da44ccc","translation":"উভয় তারিখ গণনা করো"},"date-calculator.copy.ui.reversed":{"context":"date-calculator UI copy.ui.reversed","source_hash":"55a5f24eece5795cccc41db96491e794c2e232b9542b196f935b9159e24db9f7","translation":"আপনার সমাপ্তি তারিখ আগে । মোট দেখাও তারিখের মধ্যে দূরত্ব."},"date-calculator.copy.ui.share":{"context":"date-calculator UI copy.ui.share","source_hash":"6aaa89b8157cc3291e664ce0f58160b6c0a14d4e6e1146119b3b285e28de5f2b","translation":"একটি লিঙ্ক অনুলিপি করুন"}},"locale":"bn","missing":["date-calculator.copy.heading","date-calculator.copy.intro","date-calculator.copy.category","date-calculator.copy.eyebrow","date-calculator.copy.ui.between","date-calculator.copy.ui.shift","date-calculator.copy.ui.calculation","date-calculator.copy.ui.start","date-calculator.copy.ui.end","date-calculator.copy.ui.