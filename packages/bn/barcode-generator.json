{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"barcode-generator.copy.examples.2.heading":{"context":"barcode-generator UI copy.examples.2.heading","source_hash":"d82ec9a2d3a07a649ab97e84081d11249235276f9a96b30d1228435c8754cc90","translation":"প্রথম শূণ্য রেখে দাও"},"barcode-generator.copy.faq.7.answer":{"context":"barcode-generator UI copy.faq.7.answer","source_hash":"e2b07a0b91eb1d6b77c7df6d73fccb8148eab2e9bb13473bcce07c83cb281992","translation":"হ্যাঁ, আপনার ডিভাইসের মেমোরির মধ্যে। প্রত্যেকটি বৈধ লাইন ZIP-এ একটি SVG পাবে। CSV ম্যানিফেস্টো প্রত্যেকটি প্রক্রিয়াকৃত লাইন এবং ত্রুটি তালিকাভুক্ত করে।"},"barcode-generator.copy.privacy.paragraphs.2":{"context":"barcode-generator UI copy.privacy.paragraphs.2","source_hash":"4a3c3e8a722c9dc83fe8840351a30aa8263161a86606a6abe1c21817fefb3789","translation":"ডাউনলোড করা ফাইলে আপনার পরিচায়ক রয়েছে। আর্কাইভ শেয়ার করার পূর্বে গন্তব্য ফোল্ডার পরীক্ষা করুন। CSV মানগুলি স্প্রেডশীট সূত্রের মত দেখায় এবং নিরাপদভাবে খোলার জন্য একটি শুরুর অ্যাপোস্ট্রোফ গ্রহণ করে। এটি ম্যানিফেস্ট সেল পরিবর্তন করে, প্রকৃত এনকোডকৃত পরিচায়ক নয়।"},"barcode-generator.copy.ui.errors.LENGTH":{"context":"barcode-generator UI copy.ui.errors.LENGTH","source_hash":"1f0bfaf573e791e72e7f3da6b378d32884d094d7e9180c53f4ef6f492d85c589","translation":"EAN-13-এর জন্য 12 অথবা 13 ডিজিট ব্যবহার করুন, UPC-A-র জন্য 11 অথবা 12, অথবা EAN-8-এর জন্য 7 অথবা 8।"},"barcode-generator.copy.ui.errors.LINK":{"context":"barcode-generator UI copy.ui.errors.LINK","source_hash":"ea0d1391b2e842da1152b3dd03ac1de7ab045a9bf2159624937e709c64dd994e","translation":"এই লিঙ্ক- এ অবৈধ মান রয়েছে । অনুগ্রহ করে আপনার তথ্য আবার লিখুন ।"}},"locale":"bn","missing":["barcode-generator.copy.title","barcode-generator.copy.description","barcode-generator.copy.heading","barcode-generator.copy.intro","barcode-generator.copy.category","barcode-generator.copy.eyebrow","barcode-generator.copy.ui.themeDark","barcode-generator.copy.ui.themeLight","barcode-generator.copy.ui.copy","barcode-genera