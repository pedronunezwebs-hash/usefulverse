{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"barcode-generator.copy.examples.2.heading":{"context":"barcode-generator UI copy.examples.2.heading","source_hash":"d82ec9a2d3a07a649ab97e84081d11249235276f9a96b30d1228435c8754cc90","translation":"প্রথম শূণ্য রেখে দাও"},"barcode-generator.copy.examples.2.text":{"context":"barcode-generator UI copy.examples.2.text","source_hash":"5cccf8b4107aaf52dd3fe21551c397d38d0208336d2cbbf1ea7018caeb83c133","translation":"UPC-A ইনপুট 01234567890 হয়ে যায় 012345678905। প্রথম শূণ্য এনকোডকৃত পরিচায়কের অংশ হিসেবে থেকে যায়।"},"barcode-generator.copy.faq.0.answer":{"context":"barcode-generator UI copy.faq.0.answer","source_hash":"25e621396ada8da894dc86e786095f967b4bb0bc813929140fab855d267a1f44","translation":"হ্যাঁ। এখানে কোন অ্যাকাউন্ট, দৈনিক কোটা বা পরিশোধের পদক্ষেপ নেই। আপনার ব্রাউজারেই তৈরি ও ডাউনলোড করা হবে।"},"barcode-generator.copy.faq.4.question":{"context":"barcode-generator UI copy.faq.4.question","source_hash":"83432ac60e05ef6f0570f8d55aedf16602860cffe233c3cbb0800786a80af708","translation":"অগ্রগামী শূণ্যগুলো কি অদৃশ্য হয়ে যাবে?"},"barcode-generator.copy.faq.7.answer":{"context":"barcode-generator UI copy.faq.7.answer","source_hash":"e2b07a0b91eb1d6b77c7df6d73fccb8148eab2e9bb13473bcce07c83cb281992","translation":"হ্যাঁ, আপনার ডিভাইসের মেমোরির মধ্যে। প্রত্যেকটি বৈধ লাইন ZIP-এ একটি SVG পাবে। CSV ম্যানিফেস্টো প্রত্যেকটি প্রক্রিয়াকৃত লাইন এবং ত্রুটি তালিকাভুক্ত করে।"},"barcode-generator.copy.faq.9.question":{"context":"barcode-generator UI copy.faq.9.question","source_hash":"110330eda7c7e669e2cde184be89be9b9bda7e50a501f5a7686f76f47bd7cd0f","translation":"একটি সফল পর্দা স্ক্যান মুদ্রিত লেবেলকে কি সার্টিফিকেট দেয়?"},"barcode-generator.copy.footer":{"context":"barcode-generator UI copy.footer","source_hash":"cc6a568643e72d46318873863eaa7d8453c43c2bd226e53e97619f2e95091528","translation":"ব্যবহারযোগ্য টুলস। পরিষ্কার ফলাফল। আপনার ব্রাউজার জন্য তৈরি।"},"barcode-generator.copy.how.steps.2.heading":{"context":"barcode-generator UI copy.how.steps.2.heading","source_hash":"7a694902149dbae99eb9a686e7e6dfc01475725c9e4189c038825f8b3a9deff1","translation":"সংরক্ষণ এবং পরীক্ষা"},"barcode-generator.copy.method.paragraphs.1":{"context":"barcode-generator UI copy.method.paragraphs.1","source_hash":"f6bedd8064f12cce694674288d9895d0435f00dce5e87ab0331dcdc3ef2e6c53","translation":"EAN- 13, UPC- A এবং EAN- 8 একটি শেষ চেক ডিজিট ব্যবহার করে । ডানদিকের ডাটা ডিজিট থেকে শুরু করে, বিকল্প ডিজিটগুলোকে তিন দিয়ে গুণ করুন । অবশিষ্ট ডিজিটগুলো যোগ করুন । সবচেয়ে ছোট শেষ ডিজিটটি বেছে নিন যা এই যোগফলকে দশের গুণক করে তুলবে । একটি যোগফল যা ইতিমধ্যেই দশ দ্বারা ভাগ করা যায় তার শূন্য প্রয়োজন ।"},"barcode-generator.copy.method.paragraphs.2":{"context":"barcode-generator UI copy.method.paragraphs.2","source_hash":"d017f9d34c79652b7a97c5332a06a63122c1a5559c66a3decae9a4d4617701ef","translation":"শেষ অঙ্ক গণনা করার জন্য শুধুমাত্র তথ্যের অঙ্ক লিখুন । এটি বৈধ করার জন্য একটি সম্পূর্ণ সংখ্যা লিখুন । জেনারেটর ভুলভাবে প্রদত্ত অঙ্ক প্রত্যাখ্যান করে । এটি আপনাকে না বলে কখনোই একটি সম্পূর্ণ পণ্যের সংখ্যা সংশোধন করে না । শুরুর শূণ্য গণনা চলাকালে স্ট্রিং হিসেবে থাকে ।"},"barcode-generator.copy.navigation.breadcrumbLabel":{"context":"barcode-generator UI copy.navigation.breadcrumbLabel","source_hash":"2bd873d6c734e63ea80e163a6a643f75bf87a3d24e3164987d176a2e3e5c567e","translation":"ব্রেডক্রাম্ব"},"barcode-generator.copy.navigation.how":{"context":"barcode-generator UI copy.navigation.how","source_hash":"9c870aa6e5e93270170d5a81277ad3e623afe8d4efd186d3e28f3d2b646d52e6","translation":"এটা কিভাবে কাজ করে"},"barcode-generator.copy.navigation.mainLabel":{"context":"barcode-generator UI copy.navigation.mainLabel","source_hash":"eb355944b92d10582856f8aea34b3e319ba465b8aa4c294973cf53f665399a2c","translation":"প্রধান ন্যাভিগেশন"},"barcode-generator.copy.privacy.paragraphs.2":{"context":"barcode-generator UI copy.privacy.paragraphs.2","source_hash":"4a3c3e8a722c9dc83fe8840351a30aa8263161a86606a6abe1c21817fefb3789","translation":"ডাউনলোড করা ফাইলে আপনার পরিচায়ক রয়েছে। আর্কাইভ শেয়ার করার পূর্বে গন্তব্য ফোল্ডার পরীক্ষা করুন। CSV মানগুলি স্প্রেডশীট সূত্রের মত দেখায় এবং নিরাপদভাবে খোলার জন্য একটি শুরুর অ্যাপোস্ট্রোফ গ্রহণ করে। এটি ম্যানিফেস্ট সেল পরিবর্তন করে, প্রকৃত এনকোডকৃত পরিচায়ক নয়।"},"barcode-generator.copy.related.1.title":{"context":"barcode-generator UI copy.related.1.title","source_hash":"fae5bcfdfb1d942bf5fb18f145aa85998284a4966e11b9e75c0fda9bb8ef89aa","translation":"QR কোড রিডার"},"barcode-generator.copy.sourcesText":{"context":"barcode-generator UI copy.sourcesText","source_hash":"92a1f2d70cc10a244f97eb7bcaf56780108efd5c66915ab0bdf83d6dac94fdd7","translation":"ফরম্যাট এবং চেক-ডিজিট রেফারেন্স পড়ুন। তৈরি করা ছবিটি একটি সার্টিফিকেটেড রিটেইল লেবেল নয়।"},"barcode-generator.copy.ui.batchHint":{"context":"barcode-generator UI copy.ui.batchHint","source_hash":"6e7e27b5ac5b535290f2bb6455914a164292c60127db047943c8790a03a1876f","translation":"ফাঁকা লাইন উপেক্ষা করা হবে। প্রত্যেকটি বৈধ লাইন একটি SVG পাবে; ম্যানিফেস্টোতে যে কোন ত্রুটি তালিকাভুক্ত করা হবে।"},"barcode-generator.copy.ui.copied":{"context":"barcode-generator UI copy.ui.copied","source_hash":"a53e263c52533edb4352c9cba5d92004a24af3ea14a03481a95739f840650396","translation":"ক্লিপবোর্ডে কপি করা হয়েছে ।"},"barcode-generator.copy.ui.copyFallback":{"context":"barcode-generator UI copy.ui.copyFallback","source_hash":"476d9fdc2a1b77869df1f8646d6a4c7f3d2cfce2de2741d20c06324136310e10","translation":"নীচে লেখাটি বেছে নিয়ে কপি করো ।"},"barcode-generator.copy.ui.errors.LENGTH":{"context":"barcode-generator UI copy.ui.errors.LENGTH","source_hash":"1f0bfaf573e791e72e7f3da6b378d32884d094d7e9180c53f4ef6f492d85c589","translation":"EAN-13-এর জন্য 12 অথবা 13 ডিজিট ব্যবহার করুন, UPC-A-র জন্য 11 অথবা 12, অথবা EAN-8-এর জন্য 7 অথবা 8।"},"barcode-generator.copy.ui.errors.LINK":{"context":"barcode-generator UI copy.ui.errors.LINK","source_hash":"ea0d1391b2e842da1152b3dd03ac1de7ab045a9bf2159624937e709c64dd994e","translation":"এই লিঙ্ক- এ অবৈধ মান রয়েছে । অনুগ্রহ করে আপ