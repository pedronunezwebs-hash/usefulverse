{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"uk-universal-credit.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"উদাহরণ লোড করো"},"uk-universal-credit.copy.additionalFaqs.1.answer":{"context":"uk-universal-credit UI copy.additionalFaqs.1.answer","source_hash":"4a5506124846288e6347287158891c1e308abc590a854560b4a430683b0dab07","translation":"এটি শুধুমাত্র উপার্জন হ্রাস প্রদর্শন করে এবং উপযুক্ততা যাচাই করে না বা সম্পূর্ণ সার্বজনীন ক্রেডিট পুরস্কার গণনা করে না। এটি উপার্জনের আগে সর্বোচ্চ পুরস্কার ধরে নেয়। 55% হ্রাস নির্বাচিত কাজের অনুমোদনের উপরে প্রযোজ্য: £427 বাসস্থান সহায়তার সাথে, £710 বাসস্থান সহায়তা ছাড়া, অথবা £0 যদি কোন কাজের অনুমোদন প্রযোজ্য না হয়। বিশেষ ক্ষেত্রে এবং অন্যান্য হ্রাস বাদ দেওয়া হয়। নিয়মগুলি 2026–27 এর জন্য এবং 6 এপ্রিল 2027 এর আগে পর্যালোচনা করা উচিত।"},"uk-universal-credit.copy.fields.earningsReduction":{"context":"uk-universal-credit UI copy.fields.earningsReduction","source_hash":"9537c47d93501b400ef55b422dbb6f6d260160d2c265c0fb7278eb6db2448663","translation":"আনুমানিক আয় কমে যাওয়ার হার"},"uk-universal-credit.copy.fields.maximumAward":{"context":"uk-universal-credit UI copy.fields.maximumAward","source_hash":"ce1b1e45deb61c7434c53700d9f665a83345df5659ab0994a37f9a059c3ad705","translation":"উপার্জনের আগে সর্বোচ্চ মাসিক UC পুরস্কার (GBP)"},"uk-universal-credit.copy.howAnswer":{"context":"uk-universal-credit UI copy.howAnswer","source_hash":"0e44e8eafd8cc8a7031bef858c5dde7f31083eb9d8dcfb0bf1754a429c6361b1","translation":"সর্বোচ্চ মাসিক ইউনিভার্সাল ক্রেডিট পরিমাণ যোগ করুন আয়, প্রতিবেদনকৃত মাসিক নেট আয় এবং যেকোন প্রযোজ্য কাজের অনুদান পূর্বে।"},"uk-universal-credit.copy.messages.canvasUnavailable":{"context":"Shared UI copy.messages.canvasUnavailable","source_hash":"87f1714ac2b50a74f2590e77ef89541657c6dcc3726bc088d40302e09fc91137","translation":"এই ব্রাউজার প্রাকদর্শন প্রস্তুত করতে পারেনি।"},"uk-universal