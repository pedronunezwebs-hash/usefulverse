{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"online-whiteboard.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"উদাহরণ লোড করো"},"online-whiteboard.copy.description":{"context":"online-whiteboard UI copy.description","source_hash":"ffc730e4713574e4dca03f0b545bc07f009a804311d6be24a53b7271637b2e79","translation":"অঙ্কন, স্টিকার যোগ করুন, চিন্তা এবং গোষ্ঠী সম্পর্কিত নোট একটি ব্যক্তিগত, একক ডিভাইস হোয়াইটবোর্ডে সংগঠিত করুন। আপনার কাজ একটি PNG হিসাবে রপ্তানি করুন।"},"online-whiteboard.copy.fields.clearBoard":{"context":"online-whiteboard UI copy.fields.clearBoard","source_hash":"734150f1e576b2b708a8458817a7e7b9a5ed2c5f5ac397e41f72fab069a99c3c","translation":"বোর্ড ফাঁকা করো"},"online-whiteboard.copy.fields.exportPng":{"context":"online-whiteboard UI copy.fields.exportPng","source_hash":"3f09c05b1382289e9141dda5f4b18079361cb22af1c442f334ac1e449d53ba12","translation":"বোর্ড PNG হিসাবে ডাউনলোড করুন"},"online-whiteboard.copy.fields.ungroup":{"context":"online-whiteboard UI copy.fields.ungroup","source_hash":"164bb1ca3145627ed1f804026ed5f87be7dcca81d2cfcedc49d0785a4b3089eb","translation":"নির্বাচিত নোটগুলিকে গ্রুপ থেকে আলাদা করুন"},"online-whiteboard.copy.howAnswer":{"context":"online-whiteboard UI copy.howAnswer","source_hash":"5bdbae264ee3c8a799b45c48cac5d4842083526af9947c673b808612e614d15a","translation":"বোর্ড চালু করুন, কলম বা নির্বাচন করুন, তারপর অঙ্কন করুন অথবা সংক্ষিপ্ত নোট যোগ করুন। নোটগুলো সাজানোর জন্য তাদের টেনে আনুন; একাধিক নোট নির্বাচন করার জন্য Shift টিপে রাখুন, তারপর তাদেরকে গ্রুপ করুন। নির্বাচিত নোটগুলো সরাতে কীবোর্ডের তীর চিহ্ন ব্যবহার করুন এবং মুছে ফেলতে Delete টিপুন। প্রস্তুত হলে একটি PNG রপ্তানি করুন।"},"online-whiteboard.copy.messages.canvasUnavailable":{"context":"Shared UI copy.messages.canvasUnavailable","source_hash":"87f1714ac2b50a74f2590e77ef89541657c6dcc3726bc088d40302e09fc91137","translation":"এই ব্রাউজার প্