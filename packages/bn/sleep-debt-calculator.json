{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"sleep-debt-calculator.copy.fields.accuracyNote":{"context":"sleep-debt-calculator UI copy.fields.accuracyNote","source_hash":"5644f564c9da71f0fb90e9b293dc3a5f866594e7fb8309f8954c4287428fbb68","translation":"এটি নিচের প্রতিটি রেফারেন্স ফাঁক যোগ করে; এটি ঘুমের শারীরবৃত্তীয় মডেল বা পুনরুদ্ধারের ভবিষ্যদ্বাণী করে না। রেফারেন্সের উপরের রাতগুলি পৃথকভাবে প্রদর্শিত হয় এবং পূর্ববর্তী অভাবগুলি মুছে ফেলা হয় না। ব্যক্তি এবং প্রসঙ্গ অনুসারে ঘুমের প্রয়োজন পরিবর্তিত হয়। স্থায়ী ঘুমের সমস্যার জন্য যোগ্য চিকিৎসা নিন; এই টুলটি রোগ নির্ণয় বা চিকিত্সা করে না।"},"sleep-debt-calculator.copy.fields.targetHint":{"context":"sleep-debt-calculator UI copy.fields.targetHint","source_hash":"ecbd14c72a0e7cff2a598384522a62633cd649670bd05b95a4f698bf4908d734","translation":"আপনার নিজের তুলনা রেফারেন্স 3 থেকে 12 ঘন্টা বেছে নিন। ডিফল্ট শুধুমাত্র একটি সম্পাদনযোগ্য আরম্ভ মান, একটি সুপারিশ নয়।"},"sleep-debt-calculator.copy.fields.targetReference":{"context":"sleep-debt-calculator UI copy.fields.targetReference","source_hash":"d37f59746fc94955bdf0603f5621edf6f0ba077872a717874cfc8fa2b79b9ea7","translation":"আপনার রেফারেন্স"},"sleep-debt-calculator.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"এই ব্রাউজার- এ অনুলিপি পাওয়া যাচ্ছে না ।"},"sleep-debt-calculator.copy.messages.saved":{"context":"Shared UI copy.messages.saved","source_hash":"1a85c48d59fd318e7cdb5d4842aadd3dc77c166dbd1ba8a57c3b43bc095b851b","translation":"এই ডিভাইসে লগ সংরক্ষণ করা হয়েছে।"}},"locale":"bn","missing":["sleep-debt-calculator.copy.name","sleep-debt-calculator.copy.title","sleep-debt-calculator.copy.description","sleep-debt-calculator.copy.intro","sleep-debt-calculator.copy.howQuestion","sleep-debt-calculator.copy.howAnswer","sleep-debt-calculator.copy.privacyQuestion","sleep-debt-calculator.copy.privacyAnswer","sleep-debt-calculator