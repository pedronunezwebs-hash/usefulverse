{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"shoe-size-converter.copy.details":{"context":"shoe-size-converter UI copy.details","source_hash":"ed95f0c030255c698f5e993999ab9b00fc24ffe5abde57d880ed2b75038cf02f","translation":"এই টুলটি মিলিমিটার থেকে মিলিমিটার, সেন্টিমিটার বা ইঞ্চিতে রূপান্তর করে, আপনার দুটি পায়ের মধ্যে দীর্ঘতমটি ব্যবহার করে এবং আপনি সাঁটানো চার্টের মধ্যে সবচেয়ে কাছের দৈর্ঘ্য খুঁজে পান। শুধুমাত্র যখন আপনার চার্টের কলাম জুতার অভ্যন্তরীণ দৈর্ঘ্য বর্ণনা করে তখনই একটি পায়ের আঙ্গুলের অনুমতি যোগ করা হয়। Mondopoint মিলিমিটার দ্বারা পরিমাপকৃত পায়ের দৈর্ঘ্য হিসাবে প্রদর্শিত হয়; এটি অন্য কোন সিস্টেমে রূপান্তরিত হয় না।"},"shoe-size-converter.copy.fields.calculate":{"context":"shoe-size-converter UI copy.fields.calculate","source_hash":"d418094ce12ba06d295a61b8d933986a2512432c67feebc61005c6a8e7d9b847","translation":"দৈর্ঘ্যের তুলনা করো"},"shoe-size-converter.copy.fields.chartHelp":{"context":"shoe-size-converter UI copy.fields.chartHelp","source_hash":"b0c81ec8dc4a0834bed506b7dd8e0d86caf04a4977c99bf6d0236a0d8474d131","translation":"2–100 ডাটা সারি সাঁটো, ইচ্ছাকৃতভাবে একটি শিরোনাম সারি সহ, প্রতি লাইন এক: মাপ লেবেল, নির্বাচিত চার্ট এককের দৈর্ঘ্য। একটি কমন, সেমিকোলন অথবা ট্যাব ব্যবহার করো। উদাহরণ: মাপ 40; 258। দৈর্ঘ্য সবচেয়ে ছোট থেকে সবচেয়ে বড় পর্যন্ত কমানো উচিত নয়। চার্টের সঠিক বয়সভিত্তিক গ্রুপ ব্যবহার করো এবং আকার অনুযায়ী নির্দেশাবলী অনুসরণ করো।"},"shoe-size-converter.copy.fields.chartUnit":{"context":"shoe-size-converter UI copy.fields.chartUnit","source_hash":"9b3c93cc1f10ef8a62b019896fca640b6ec45d8e02b47af483208d670bfd64d0","translation":"চার্টে ব্যবহৃত একক"},"shoe-size-converter.copy.fields.closest":{"context":"shoe-size-converter UI copy.fields.closest","source_hash":"9538b0440cf0390f6ee41642b324b63fe755c26adf8e24827bf9e46371f42041","translation":"সবচেয়ে কাছাকাছি চার্ট এন্ট্রি"},"shoe-size-converter.copy.fields.inches":{"context":"shoe-size-converter UI copy.fields.inches","source_hash":"f831c59e09265ffa74465d4c46d8ded148602d57a0c