{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"nurikabe.copy.actions.easy":{"context":"Shared UI copy.actions.easy","source_hash":"d6915875decb6e43dbf131d2453a2f065d78b915a3d0580777e834b9bf6afafd","translation":"সহজ"},"nurikabe.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"ত্রিভুজ"},"nurikabe.copy.additionalFaqs.1.question":{"context":"nurikabe UI copy.additionalFaqs.1.question","source_hash":"45ea83e00b3d448cc1d7637e6af6409fe979b9fbc8996a35e1aa21152bba104c","translation":"প্রত্যেক ধাঁধার একটা সমাধান আছে?"},"nurikabe.copy.fields.accuracyNote":{"context":"nurikabe UI copy.fields.accuracyNote","source_hash":"e0f6fe43fe159e1d244840361f90f37633f6920a7c3ac5500430d4586b409b00","translation":"নতুন ধাঁধার একটি সমাধানের জন্য স্থানীয়ভাবে পরীক্ষা করা হয়। যদি উৎপাদন তার নিরাপত্তা সীমায় পৌঁছে যায়, তাহলে একটি পরীক্ষাকৃত ধাঁধা অন্য একটি বিন্যাসকে ঘুরিয়ে দেয়।"},"nurikabe.copy.fields.column":{"context":"nurikabe UI copy.fields.column","source_hash":"881d5fb60090f59aabba4f287d7596317ca7091d00c2180b6cbc8ab018b9febd","translation":"কলাম"},"nurikabe.copy.fields.rules":{"context":"nurikabe UI copy.fields.rules","source_hash":"bd603c1a413dfd6cd8cb3c8b6e6afeb802f980e95c9a7b41183818a96d3a8a14","translation":"প্রত্যেকটি সংখ্যা একটি দ্বীপের সূচনা করে, যেখানে একই সংখ্যক ঘর রয়েছে। দ্বীপগুলো একে অপরকে স্পর্শ করতে পারে না। প্রত্যেকটি অন্য ঘর হল সমুদ্র: সমুদ্রের সকল ঘরকে সংযুক্ত হওয়া আবশ্যক, এবং কোন 2×2 বর্গক্ষেত্রই সম্পূর্ণভাবে সমুদ্র হতে পারে না। সমুদ্র চিহ্নিত করার জন্য একটি ফাঁকা ঘরে ক্লিক করুন; চিহ্ন মুছে ফেলার জন্য পুনরায় ক্লিক করুন। সংখ্যাযুক্ত ইঙ্গিত পরিবর্তন করা যাবে না।"},"nurikabe.copy.intro":{"context":"Shared UI copy.intro","source_hash":"5da052b859b3476e9c08b35cb8cd21fcb8b39e59cabe39a51ede01cceccc007f","translation":"সংখ্যাযুক্ত দ্বীপের চারপাশে সমুদ্র চিহ্নিত করুন। সমুদ্রকে সংযুক্ত রাখুন, প্রত্যেকটি 2×2 সমুদ্র বর্গক্ষেত্র এড়িয়ে যান এবং প্রত্যেকটি ইঙ্গিতকে তার সঠিক আকার অনুযায়ী একটি দ্বীপ দিন।"},"nurikabe.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"এই ব্রাউজার- এ অনুলিপি পাওয়া যাচ্ছে না ।"},"nurikabe.copy.messages.islandSize":{"context":"Shared UI copy.messages.islandSize","source_hash":"52b2a2ef4a73c3259ebc9eaa68d25da55caba849160bd21d0922a1e9a2d93091","translation":"একটি দ্বীপ তার ইঙ্গিত আকার মিলছে না।"}},"locale":"bn","missing":["nurikabe.copy.name","nurikabe.copy.title","nurikabe.copy.description","nurikabe.copy.howQuestion","nurikabe.copy.howAnswer","nurikabe.copy.privacyQuestion","nurikabe.copy.privacyAnswer","nurikabe.copy.fields.difficulty","nurikabe.copy.fields.board","nurikabe.copy.fields.cell","nurikabe.copy.fields.row","nurikabe.copy.fields.sea","nurikabe.copy.fields.island","nurikabe.copy.actions.calculate","nurikabe.copy.actions.generate","nurikabe.copy.actions.reset","nurikabe.copy.actions.example","nurikabe.copy.actions.newGame","nurikabe.copy.actions.rules","nurikabe.copy.actions.reveal","nurikabe.copy.actions.next","nurikabe.copy.actions.copy","nurikabe.copy.actions.download","nurikabe.copy.actions.result","nurikabe.copy.actions.rectangle","nurikabe.copy.actions.circle","nurikabe.copy.actions.meters","nurikabe.copy.actions.centimeters","nurikabe.copy.actions.feet","nurikabe.copy.actions.inches","nurikabe.copy.actions.kgPerCubicMeter","nurikabe.copy.actions.lbPerCubicFoot","nurikabe.copy.actions.kilograms","nurikabe.copy.actions.pounds","nurikabe.copy.actions.computer","nurikabe.copy.actions.twoPlayers","nurikabe.copy.actions.privacyNote","nurikabe.copy.actions.checkBoard","nurikabe.copy.actions.hint","nurikabe.copy.actions.clearMarks","nurikabe.copy.actions.medium","nurikabe.copy.actions.hard","nurikabe.copy.messages.copied","nurikabe.copy.messages.calculated","nurikabe.copy.messages.checkInputs","nurikabe.copy.messages.area","nurikabe.copy.messages.vo