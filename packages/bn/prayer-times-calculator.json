{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"prayer-times-calculator.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"ত্রিভুজ"},"prayer-times-calculator.copy.description":{"context":"prayer-times-calculator UI copy.description","source_hash":"38d63b08a03c4d656e497c800e84578cf021adeb7325e164ee972864a6b2fcd9","translation":"আপনার তারিখ, স্থানাঙ্ক এবং নির্বাচিত গণনা পদ্ধতি থেকে দৈনন্দিন নামাযের সময় অনুমান করুন। আপনার ব্রাউজারটি মুক্ত এবং স্থানীয়।"},"prayer-times-calculator.copy.fields.accuracyNote":{"context":"prayer-times-calculator UI copy.fields.accuracyNote","source_hash":"d4079e8b18ff5e729891ef974dbe2f79f9fa8cf1a79b40919a3ada3316ce487e","translation":"আনুমানিক সময়সূচী, সরকারি সময়সূচী অথবা ধর্মীয় নিয়ম নয়। পদ্ধতি, স্থানীয় নিয়ম এবং UTC অফসেট ফলাফল প্রভাবিত করে। দীর্ঘস্থায়ী অন্ধকারের সাথে উচ্চ অক্ষাংশের তারিখের জন্য, নির্বাচিত ফ্যালবেক একটি অনুমান এবং চিহ্নিত করা হবে। স্থানীয় বিশ্বাসযোগ্য কর্তৃপক্ষের সাথে সময় নিশ্চিত করুন। কোন স্বয়ংক্রিয় অবস্থান অনুসন্ধান নেই।"},"prayer-times-calculator.copy.fields.karachi":{"context":"prayer-times-calculator UI copy.fields.karachi","source_hash":"c28e7aeceabc98bb7e010cb49f81b51394a3bce91e894f350446d1b8d223a02b","translation":"ইসলামী বিজ্ঞান বিশ্ববিদ্যালয়, করাচি"},"prayer-times-calculator.copy.fields.longitude":{"context":"prayer-times-calculator UI copy.fields.longitude","source_hash":"8d76461164a73e0be1e73e9ddf53a372ae429196e502a8844c7264c897482707","translation":"দ্রাঘিমাংশ (−180 থেকে 180)"},"prayer-times-calculator.copy.fields.mwl":{"context":"prayer-times-calculator UI copy.fields.mwl","source_hash":"3d181fa68fdcbc3491e90346bb84129ffb8b745eb8a08cf113d3fef6cc43279b","translation":"মুসলিম বিশ্ব লীগ (এমডব্লিউএল)"},"prayer-times-calculator.copy.fields.standard":{"context":"prayer-times-calculator UI copy.fields.standard","source_hash":"b10be51538d4a967f75a8b824cd37b552473a07ff57e2938fe5b86