{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"inductor-calculator.copy.fields.accuracyNote":{"context":"inductor-calculator UI copy.fields.accuracyNote","source_hash":"afb560136b551f41a3012376f29e0acf944d00215a9916e516e2d603237c8159","translation":"تقدير فقط. يستخدم نموذج القلب الهوائي تقدير ويلر للطبقة الواحدة وهو دليل تقريبي عندما يكون قطر الملف أقل من 3 × طول لف. وهو يغفل سمك الأسلاك، والمسافة، والمعدن القريب، والتردد، والسعة الطفيلية وظروف القياس. وبالنسبة للتورويد، أدخل عامل AL من صحيفة بيانات القلب الدقيق؛ AL والنفاذية يمكن أن تتغير مع التردد، ودرجة الحرارة، والتحيز المستمر، والفجوة والتسامح في التصنيع. التحقق من أي تصميم حقيقي مع صانع القلب والقياس."},"inductor-calculator.copy.fields.alValue":{"context":"inductor-calculator UI copy.fields.alValue","source_hash":"33fe4e626674caaf58df842da0629d96ed39db723357ed67a84bf7c5360c14ed","translation":"قيمة AL الأساسية (ن هيدروجين/دورة²)"},"inductor-calculator.copy.fields.outsideWheelerRange":{"context":"inductor-calculator UI copy.fields.outsideWheelerRange","source_hash":"d4da74bf72091012e25322314817e7675be4e3932e355150eea8070108c1d1f2","translation":"تقع الشكل الهندسي خارج نطاق ويلر المذكور؛ وينبغي التعامل مع التقدير بحذر خاص."},"inductor-calculator.copy.fields.targetUnit":{"context":"inductor-calculator UI copy.fields.targetUnit","source_hash":"26440f0d851cbfb23d4bdb4a0ea9778af67b4e878c677c679ac48bee061d8f29","translation":"الوحدة المستهدفة"}},"locale":"ar","missing":["inductor-calculator.copy.name","inductor-calculator.copy.title","inductor-calculator.copy.description","inductor-calculator.copy.intro","inductor-calculator.copy.howQuestion","inductor-calculator.copy.howAnswer","inductor-calculator.copy.privacyQuestion","inductor-calculator.copy.privacyAnswer","inductor-calculator.copy.fields.mode","inductor-calculator.copy.fields.airCore","inductor-calculator.copy.fields.toroid","inductor-calculator.copy.fields.turns","inductor-calculator.copy.fields.dimensionUnit","inductor-calculator.c