{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fuel-cost-calculator.copy.description":{"context":"fuel-cost-calculator UI copy.description","source_hash":"28b0424515306b4664c435b6ef3c0375e35e4413eda885f057ab6db09788893e","translation":"تقدير وقود الرحلة وتكلفتها باستخدام L/100 كيلومتر، أمريكي MPG أو إمبراطوري MPG. أضف رحلة ذهاب وإياب وتقسيم التكلفة على الركاب. مجانا في متصفحك."},"fuel-cost-calculator.copy.faq.8.answer":{"context":"fuel-cost-calculator UI copy.faq.8.answer","source_hash":"6346bf2653a9151af5771bf07b9a66444fba2d2b92d4594d9f316b29a0a7ceb3","translation":"لا، فهي لا تقدر سوى تكاليف الوقود، وتضاف التكاليف الأخرى المتفق عليها بصورة منفصلة لوضع ميزانية سفر كاملة."},"fuel-cost-calculator.copy.faq.9.answer":{"context":"fuel-cost-calculator UI copy.faq.9.answer","source_hash":"3b77456371d776f1744ad5a2264005871fe45c880034d613fa37ec70142a4ec4","translation":"ليس بالضرورة، فالاستهلاك الفعلي يتغير مع الظروف، والنتيجة هي تقدير من القيم التي تقدمونها."},"fuel-cost-calculator.copy.form.fields.c":{"context":"fuel-cost-calculator UI copy.form.fields.c","source_hash":"dddf9349afeae6c62b56691f005b6c3ec892f9f55988486bb4c745a5862bd9d4","translation":"سعر اللتر"},"fuel-cost-calculator.copy.form.hint":{"context":"fuel-cost-calculator UI copy.form.hint","source_hash":"9c82738424488dd1290e1905689fbabab4c6b6b42c687ab0799aa3a752cb4b24","translation":"تطابق وحدة سعر المضخة مع وحدة الوقود المختارة. والعملة هي علامة، وليست تحويلا لسعر الصرف الفعلي."},"fuel-cost-calculator.copy.form.modes.metric":{"context":"fuel-cost-calculator UI copy.form.modes.metric","source_hash":"8d3b2f9c5952cdbc224f9fda28ff48da4e10b4a008dee3b08b988bb4b26d46d5","translation":"الكيلومترات واللتر"},"fuel-cost-calculator.copy.how.heading":{"context":"fuel-cost-calculator UI copy.how.heading","source_hash":"6643e0aafaf46092d12acfd0539b8d40605366adf900ffce3fdbe473c0314f8b","translation":"اختار، أدخل، تحقق"},"fuel-cost-calculator.copy.method.paragraphs.4":{"context":"fuel-cost-calculator 