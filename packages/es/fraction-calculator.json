{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fraction-calculator.copy.description":{"context":"fraction-calculator UI copy.description","source_hash":"86b5fe15b179b259074296f5e91af7beb003399f113191f2defa8503e3cf0086","translation":"Añade, resta, multiplica o divide fracciones con pasos exactos. Simplifica, compara, convierte decimales y añade una lista.Gratis, completamente en tu navegador."},"fraction-calculator.copy.examples.3.heading":{"context":"fraction-calculator UI copy.examples.3.heading","source_hash":"599f37646506a1d0c95a566c845042c2a843b0c814ea17740e4f40626e6f4cb2","translation":"Más de dos fracciones"},"fraction-calculator.copy.faq.6.question":{"context":"fraction-calculator UI copy.faq.6.question","source_hash":"694c246d9ff18afa2c19a5cb31736d38aca3422d5f44cc3b10d92195a17a02d5","translation":"¿Puede el denominador ser negativo?"},"fraction-calculator.copy.faqHeading":{"context":"fraction-calculator UI copy.faqHeading","source_hash":"60614104ed521729598445ddcf8330ba2f7c254806b3b9d9c156d0982b2c05b4","translation":"Preguntas sobre este cálculo"},"fraction-calculator.copy.method.paragraphs.1":{"context":"fraction-calculator UI copy.method.paragraphs.1","source_hash":"2dff18d8489fba64d1d5304bb1233dd760c6112ba0288aedb75d8ef9ce320aba","translation":"Para sumar o restar, primero usa un denominador común. El menor múltiplo común da el denominador útil más pequeño. Reescribe cada numerador por el mismo factor que su denominador. Luego combina los numeradores y reduce el resultado. El trabajo muestra ese paso intermedio de denominador común."},"fraction-calculator.copy.navigation.allTools":{"context":"fraction-calculator UI copy.navigation.allTools","source_hash":"81c151f98a190da765d67a020d175d400bfd9e46ed8da05bdaeeb0a9b8eef566","translation":"Todas las herramientas"},"fraction-calculator.copy.navigation.faq":{"context":"fraction-calculator UI copy.navigation.faq","source_hash":"170c554f6d94a09b2ec7ad12f0b43cd2245655c2a8716b2bfce24cf80e