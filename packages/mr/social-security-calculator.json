{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"social-security-calculator.copy.fields.age69":{"context":"social-security-calculator UI copy.fields.age69","source_hash":"ae36e46689b4a351a3a8bb715e139e58d4b66fda0865f42246f8b2ac7392d2f6","translation":"69 वर्षे"},"social-security-calculator.copy.fields.claimingAge":{"context":"social-security-calculator UI copy.fields.claimingAge","source_hash":"b6cac06d6e9289c3890dbadad766fe235419abc94a9050cdf55a896fff47011f","translation":"लाभ सुरू होण्याची वयोमर्यादा"},"social-security-calculator.copy.fields.estimateOnly":{"context":"social-security-calculator UI copy.fields.estimateOnly","source_hash":"10b7141dcd1652e32b02bf1b2d445fdbb5860cd67362820d6dcc6d3a79f3c284","translation":"हा एक सोपा अंदाज आहे, एक पुरस्कार नाही किंवा पैसे देण्याचे आश्वासन. ते अधिकृत 2025 / 2026 PIA फॉर्म्युला वापरते आणि 67 चे पूर्ण निवृत्तीवेळ मानते. ते वेतनापासून AIME ची गणना करत नाही, नंतर COLAs जोडते, कामाचे क्रेडिट किंवा कमाईची खात्री करते, किंवा मॉडेल कर, मेडिकेअर प्रीमियम, कुटुंब लाभ, अपंगत्व किंवा जीवित लाभ. आपल्या अधिकृत सामाजिक सुरक्षा निविदा तपासा आणि वैयक्तिक अंदाजासाठी SSA चे अंदाजपत्रक वापरा. हे साधन सामान्य माहिती देते, आर्थिक सल्ला नाही."},"social-security-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"ba22b570174c2ab9fae09ea5bfe222ed4021e58e65c38627273fdb366ee32e44","translation":"तुमच्या सरासरी निर्देशांकित मासिक कमाईचा वापर करून निवृत्त-कामगार लाभाचा अंदाज लावा (AIME), तुम्ही 62 कडे वळलेले वर्ष आणि 62 ते 70 पर्यंतचा दावा करणारा वय. या सोप्या अंदाजाने तुमचा सामाजिक सुरक्षा रेकॉर्ड वापरला जात नाही."},"social-security-calculator.copy.messages.checkInputs":{"context":"Shared UI copy.messages.checkInputs","source_hash":"b783d1c825983958909863790e82e6c29fbe67a202fdbc519536276f9df670b8","translation":"0 पासून 200,000 पर्यंत पूर्ण डॉलर AIME प्रविष्ट करा व समर्थित वर्ष व वय निवडा."}},"locale":"mr","missing":["social-security-calculator.copy.name","social-security-calculator.copy.title","social-se