{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"prime-number-checker.copy.examples.1.heading":{"context":"prime-number-checker UI copy.examples.1.heading","source_hash":"cae18be59464210b73e4dcbf03e6db3fbabb040c334df22a1efe880f7a6ced92","translation":"एक परिचित कंपोझिट"},"prime-number-checker.copy.faq.0.answer":{"context":"prime-number-checker UI copy.faq.0.answer","source_hash":"a46da1bc645e907eb0e6f7d492ada338435991387308a0ac1719faa5b17d4b7d","translation":"नाही. प्रीमियम 1 पेक्षा जास्त असायला हवे व त्यास दोन सकारात्मक विभाजक असायला हवेत. एक प्रीमियम किंवा संमिश्र नाही."},"prime-number-checker.copy.faq.4.answer":{"context":"prime-number-checker UI copy.faq.4.answer","source_hash":"2060b5fec47354fe3af9324af7dc9e353fc0c7e1e6153286fe9929add944c539","translation":"2^64 वरील किंवा त्यापेक्षा जास्त संख्या 32 अनियमित-आधार राउंड पास केली. हा मजबूत पुरावा आहे, पण हे प्राथमिक प्रमाणपत्र नाही."},"prime-number-checker.copy.faq.6.question":{"context":"prime-number-checker UI copy.faq.6.question","source_hash":"8f2e4ee146f0d2136984b2dfbab8b96618bd2ffa5f8cb95141d44bffee6c6f20","translation":"एक संमिश्र संख्या विभाजक नसताना का दाखवली जाते?"},"prime-number-checker.copy.faq.7.answer":{"context":"prime-number-checker UI copy.faq.7.answer","source_hash":"7eb26213a77a5482409c1f4c44634918741bc7dbb6832bdb49e0cf73aea40ec9","translation":"नाही. ही तपासणी सामान्य धनात्मक- पूर्णांक व्याख्या वापरते. ऋणात्मक नसलेले पूर्णांक अंक प्रविष्ट करा; शून्य व एक वेगळे वर्गीकृत केले जातात."},"prime-number-checker.copy.method.paragraphs.4":{"context":"prime-number-checker UI copy.method.paragraphs.4","source_hash":"57872dc1ec97e4be649e39efa8c4731cf7e2a0a28204e180a9cd90e30155951a","translation":"त्या सीमा किंवा त्यापेक्षा जास्त, चाचणी 32 ब्राऊजर क्रिप्टोग्राफी पासून स्वतंत्ररित्या निवडलेले बेरीज वापरते. पास परिणामास कदाचित प्राइम असे लेबल केले जाते. हे गणितीय प्राइम प्रमाणपत्र नाही. प्रत्येक पास मोठे इनपुट प्राइम ला शांतपणे कॉल करण्याऐवजी हे वैशिष्ट्य दिसून येते."},"prime-number-checker.copy.privacy.paragraphs.0":{"context":"prime-number-checker UI copy.privacy.paragraphs.0","source_hash":"2a8a7346782ddf710d2aeed2933d35a281ab8c2cb38470663cc705491c8c8dce","translation":"तुमचे इनपुट व परिणाम या ब्राऊजर अंतर्गत राहतात. गणना स्थानिक कार्यकर्त्या अंतर्गत चालविले जाते, गणना API किंवा अपलोड केलेले माहिती विना."},"prime-number-checker.copy.ui.errors.ALL_ZERO":{"context":"prime-number-checker UI copy.ui.errors.ALL_ZERO","source_hash":"ef1e47cc0edf70d59e683713b2b9de86f4c0a09ed7ef394e731cfaf29a6f8237","translation":"सर्व- शून्य गुणोत्तराचे एकमेव सर्वात सोपे रूप नाही. किमान एक शून्य- नसून- शून्य शब्द प्रविष्ट करा."},"prime-number-checker.copy.ui.themeLight":{"context":"prime-number-checker UI copy.ui.themeLight","source_hash":"2f740f4cf6888e99dfe73f3d6208323cb350b33a37016e1ae3367a90b3e93c84","translation":"हलकी सुत्रयोजना करीता बदलवा"},"prime-number-checker.copy.uses.paragraphs.0":{"context":"prime-number-checker UI copy.uses.paragraphs.0","source_hash":"645231f5c2934f6ead648cbc6cbc777092f93ce56aa101402bf4fc588220492d","translation":"अभ्यास, विभाज्यता रचना किंवा दस्तऐवजापासून प्रतिकृत केलेले मोठे पूर्णांक तपासण्याकरीता या तपासणीकर्ताचा वापर करा. दर्शविलेले घटक जोडलेल्या घटकाबरोबर गुणाकार करून तुलना करा. यशस्वी गुणाकार हे थेट व स्वतंत्रपणे तपासण्याजोगी कारण आहे."},"prime-number-checker.copy.uses.paragraphs.2":{"context":"prime-number-checker UI copy.uses.paragraphs.2","source_hash":"3da2035453c442bb18f0e62d56c7379b1240668d119e78ecec2e896efba91d01","translation":"प्रत्येक घटक किंवा शेजारील प्राईसची यादी तपासणीकर्ता करीत नाही. त्याचे मुख्य काम एक स्पष्ट प्राईसचा निर्णय घेणे आहे. हे कार्य स्पष्ट ठेवणे पूर्ण घटकीकरणाची हमी देणे टाळते जेव्हा एकमेव साक्षीदाराने एक संमिश्र आढळले आहे."}},"locale":"mr","missing":["prime-number-checker.copy.title","prime-number-checker.copy.description","prime-number-checker.copy.heading","prime-number-checker.copy.intro","prime-number-checker.copy.category","prime-number-checker.copy.eyebrow","prime-number-checker.copy.ui.themeDa