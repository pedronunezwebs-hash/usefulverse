{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"inductor-calculator.copy.actions.toroidExample":{"context":"Shared UI copy.actions.toroidExample","source_hash":"6baac8153a156bd934bbd559c38512d7f40351209662057452c1cc363be6e820","translation":"AL 100 nH/turn² आणि 10 वळणांचा प्रयत्न करा"},"inductor-calculator.copy.additionalFaqs.1.answer":{"context":"inductor-calculator UI copy.additionalFaqs.1.answer","source_hash":"795f0258cd5511441af6f76aa4c799166ea04c149f780503b68167a838672ba0","translation":"फक्त प्रारंभिक अंदाजासाठी वापरा. या पानावर संतृप्ती, कोर नुकसान, तापमान वाढ, विंगिंग विद्युत, इन्सुलेशन, स्वयं- प्रतिध्वनी किंवा सुरक्षा मर्यादा तपासले जात नाहीत. कोर व तार उत्पादकांच्या रचना माहितीचे अनुसरण करा व वास्तविक बांधणी तपासा."},"inductor-calculator.copy.additionalFaqs.1.question":{"context":"inductor-calculator UI copy.additionalFaqs.1.question","source_hash":"c8563d5165ad0fbf9082629ce5aace990e99dbd41db2d30d86cc29abb267bdcb","translation":"हा अंदाज वापरून मी एक पॉवर इन्ड्युसर बनवू शकतो का?"},"inductor-calculator.copy.fields.accuracyNote":{"context":"inductor-calculator UI copy.fields.accuracyNote","source_hash":"afb560136b551f41a3012376f29e0acf944d00215a9916e516e2d603237c8159","translation":"फक्त अंदाज. एअर-कोर मॉडेल व्हीलरच्या एकल-स्तराच्या अंदाजाचा वापर करते आणि कॉइल व्यास 3 × विंडिंग लांबीपेक्षा कमी असल्यास एक रुंद मार्गदर्शक आहे. ते ताराची जाडी, अंतर, जवळच्या धातू, आवृत्ती, परजीवी क्षमता आणि मोजणीची परिस्थिती टाळते. एक टोरॉइडसाठी, त्याच्या अचूक कोर डेटाशीटपासून एल घटक प्रविष्ट करा; एल आणि पारदर्शकता आवृत्ती, तापमान, डीसी bias, अंतर आणि उत्पादन सहनशीलतेसह बदलू शकते. कोर निर्माता आणि मोजणीसह कोणताही वास्तविक डिझाइन तपासा."},"inductor-calculator.copy.messages.methodAl":{"context":"Shared UI copy.messages.methodAl","source_hash":"5bfa993da66bfb41ed98085a8079eec0392d08d42d3a4525b67a16cb4a3e6926","translation":"निर्माता कोर AL घटक"},"inductor-calculator.copy.name":{"context":"inductor-calculator UI copy.name","source_hash":"7b51b9793b02fcfd0