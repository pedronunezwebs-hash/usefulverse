{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"date-calculator.copy.description":{"context":"date-calculator UI copy.description","source_hash":"b9545b9eb0577f4e5b0dc2fa9201b0f0e0fdd95a3327cefb8c12fb2e2ea9ff46","translation":"दिनांकांमधील दिवसांची गणना करा किंवा वर्षे, महिने, आठवडे व दिवस जोडा. कॅलेंडरचे अंतर, आठवड्याचे दिवस व महिन्याचे शेवटचे नियम पहा. मोफत, तुमच्या ब्राऊजरमध्ये गणना करा."},"date-calculator.copy.examples.0.text":{"context":"date-calculator UI copy.examples.0.text","source_hash":"cbe190211afe7b2ae5316539207231011e3d491a655f2a27f24b89442ac37b93","translation":"ऑक्टोबर 1 ते नोव्हेंबर 1, 2026 हे 31 झालेले दिवस आहेत: चार आठवडे आणि तीन दिवस. 32 साठी दोन्ही तारखेची गणना करा."},"date-calculator.copy.examplesAction":{"context":"date-calculator UI copy.examplesAction","source_hash":"68623191a26dab07c7acedb36efb8ae1cacd13e3fabd0fe23f1f7d026bfe8424","translation":"या उदाहरणाचा वापर करा"},"date-calculator.copy.faq.1.question":{"context":"date-calculator UI copy.faq.1.question","source_hash":"5575581be04ce9e4caf865dcb74b689a3fd2fe3a7d8ae3669419322ae908c2ad","translation":"मी प्रारंभ व समाप्ती दिनांकांची गणना करावी का?"},"date-calculator.copy.faq.7.question":{"context":"date-calculator UI copy.faq.7.question","source_hash":"1db31f79eca7e861e53e33bf5d69ab07641998a90bc740e652efa8904ab34f7c","translation":"समाप्ती दिनांक प्रारंभ दिनांकाच्या आधी असेल तर काय?"},"date-calculator.copy.method.paragraphs.4":{"context":"date-calculator UI copy.method.paragraphs.4","source_hash":"c0e9da1bd3710dc9fba1b6cd203cb5e7dce6ffe21c9a57c1bcec59f1dbb24949","translation":"कॅल्क्युलेशन कॅलेंडर दिनांकांचा वापर करते, दिवसाचे तास नव्हे. दिवस- उन्हाळा संचयन बदल एका कॅलेंडर दिवसाला येथे अंशात बदलवत नाही. वेळ दरम्यानच्या तासांकरीता, वेळ कालावधी कॅल्क्युलेटरचा वापर करा. कार्य दिनांक करीता, व्यावसायिक दिवस कॅल्क्युलेटरचा वापर करा व वैध सुट्टी निवडा."},"date-calculator.copy.navigation.onPage":{"context":"date-calculator UI copy.navigation.onPage","source_hash":"06a7b55d