{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fuel-cost-calculator.copy.description":{"context":"fuel-cost-calculator UI copy.description","source_hash":"28b0424515306b4664c435b6ef3c0375e35e4413eda885f057ab6db09788893e","translation":"प्रवास इंधन आणि खर्च L / 100 किमी, US MPG किंवा इंपीरियल MPG वापरून अंदाज. एक परतीचा प्रवास जोडा आणि प्रवासी खर्च विभाजित. आपल्या ब्राउझरमध्ये मोफत."},"fuel-cost-calculator.copy.examples.3.heading":{"context":"fuel-cost-calculator UI copy.examples.3.heading","source_hash":"4f88fd0304c0fa08f12e7841abce6027887a529609a2ad3156829a4afb14902b","translation":"इंपीरियल पम्प किंमत वापरा"},"fuel-cost-calculator.copy.faq.4.answer":{"context":"fuel-cost-calculator UI copy.faq.4.answer","source_hash":"5ed2a5dac273fede4ac39b3ddceb1b209830133f9ef53175e7e5c9fcbbef82cc","translation":"प्रत्येक भाग स्वतंत्रपणे दोन जागी गोल केला जातो. एकूण अनेक भागात विभाजित केल्यास छोटे गोल अवशेष शिल्लक राहू शकतात."},"fuel-cost-calculator.copy.faq.8.answer":{"context":"fuel-cost-calculator UI copy.faq.8.answer","source_hash":"6346bf2653a9151af5771bf07b9a66444fba2d2b92d4594d9f316b29a0a7ceb3","translation":"नाही. हे फक्त इंधनाचा अंदाज लावते. पूर्ण प्रवास बजेटसाठी इतर सहमतीत खर्च वेगळे जोडा."},"fuel-cost-calculator.copy.faq.9.answer":{"context":"fuel-cost-calculator UI copy.faq.9.answer","source_hash":"3b77456371d776f1744ad5a2264005871fe45c880034d613fa37ec70142a4ec4","translation":"गरजेनुरूप नाही. वास्तविक वापर परिस्थितीनुरूप बदलतो. परिणाम तुम्ही पुरविलेल्या मुल्य पासून अंदाजे आहे."},"fuel-cost-calculator.copy.form.fields.currency":{"context":"fuel-cost-calculator UI copy.form.fields.currency","source_hash":"de3ac40ff858392eeb316d45b55dae2e75e634b3b9e2f8c72850b0531ec8d722","translation":"चलन लेबल"},"fuel-cost-calculator.copy.form.hint":{"context":"fuel-cost-calculator UI copy.form.hint","source_hash":"9c82738424488dd1290e1905689fbabab4c6b6b42c687ab0799aa3a752cb4b24","translation":"निवडलेल्या इंधन एककाशी पंप- किंमत एकक जुळवा. चलन हे लेबल आहे, प्र