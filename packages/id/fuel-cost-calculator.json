{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fuel-cost-calculator.copy.description":{"context":"fuel-cost-calculator UI copy.description","source_hash":"28b0424515306b4664c435b6ef3c0375e35e4413eda885f057ab6db09788893e","translation":"Perkirakan bahan bakar dan biaya perjalanan menggunakan L/100 km, US MPG atau imperial MPG. Tambahkan perjalanan pulang-pergi dan bagikan biaya dengan penumpang. Gratis di peramban Anda."},"fuel-cost-calculator.copy.examples.2.heading":{"context":"fuel-cost-calculator UI copy.examples.2.heading","source_hash":"ca369bb83abe6f4840c513dcef30b5930f6d2bb2e819b16a1113a2dfcefa6fda","translation":"Jaga galon AS konsisten"},"fuel-cost-calculator.copy.examples.3.text":{"context":"fuel-cost-calculator UI copy.examples.3.text","source_hash":"80a2dd27b28c7e970f497d43560333a8bdcc46a493767020d56ca8129f949833","translation":"200 mil pada 40 imperial MPG menggunakan 5 imperial gallon. Pada 7.00 per gallon, biayanya adalah 35.00 GBP."},"fuel-cost-calculator.copy.form.fields.currency":{"context":"fuel-cost-calculator UI copy.form.fields.currency","source_hash":"de3ac40ff858392eeb316d45b55dae2e75e634b3b9e2f8c72850b0531ec8d722","translation":"Label mata uang"},"fuel-cost-calculator.copy.form.modeLabels.us.b":{"context":"fuel-cost-calculator UI copy.form.modeLabels.us.b","source_hash":"30f8212f899cdc8a62b1664ad78f7dd473359d9a5b82fb742a69d550712fd1b0","translation":"Efisiensi (US MPG)"},"fuel-cost-calculator.copy.how.heading":{"context":"fuel-cost-calculator UI copy.how.heading","source_hash":"6643e0aafaf46092d12acfd0539b8d40605366adf900ffce3fdbe473c0314f8b","translation":"Pilih, masukkan, periksa"},"fuel-cost-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"b237cee27f84a7011acd8ab8173e58dca2ef4322298ed9caa18bc7bf99e0be48","translation":"Masukkan jarak, penggunaan bahan bakar dan harga pompa. Perkirakan biaya perjalanan, termasuk perjalanan pulang-pergi atau bagian penumpang."},"fuel-cost-calculator.copy.method.paragraphs.2":{"context":"fuel-cost-calculator UI copy.method.paragraphs.2","source_hash":"853cdb4c9b7a6a32c4c963064871ab098b5703e3161918074b02b1ea72a231dc","translation":"US gallon dan imperial gallon adalah kuantitas yang berbeda. Pilih mode MPG yang benar dan gunakan harga pompa untuk jenis gallon yang sama. Kalkulator tidak secara diam-diam mencampur satu definisi gallon dengan yang lain atau mengkonversi harga yang unitnya tidak diketahui."},"fuel-cost-calculator.copy.sourcesText":{"context":"fuel-cost-calculator UI copy.sourcesText","source_hash":"2ca12e5930143193abc7ef654dc9490feafa270d5cc0a75f6aab40a8f0e000c1","translation":"Baca aturan sumber dan bandingkan contoh-contoh yang dikerjakan. Tidak ada layanan perhitungan eksternal yang menerima masukan Anda."},"fuel-cost-calculator.copy.ui.cancelled":{"context":"fuel-cost-calculator UI copy.ui.cancelled","source_hash":"cbc7e63195c8c729eb51e1604d71b9a5e25fa25e519cbe3319c9563fe20ffb48","translation":"Berhenti. Ubah masukan atau perhitungkan lagi."},"fuel-cost-calculator.copy.ui.copied":{"context":"fuel-cost-calculator UI copy.ui.copied","source_hash":"a53e263c52533edb4352c9cba5d92004a24af3ea14a03481a95739f840650396","translation":"Disalin ke papan klipmu."},"fuel-cost-calculator.copy.ui.errors.NOT_ENOUGH":{"context":"fuel-cost-calculator UI copy.ui.errors.NOT_ENOUGH","source_hash":"dea150bdfc2549c8be20d8114bc3689c883a873f0049febf17cb14037be47dc6","translation":"Rentang berisi lebih sedikit nilai yang berbeda dari yang Anda minta. Lebarkan rentang atau biarkan berulang."},"fuel-cost-calculator.copy.ui.errors.NUMBER":{"context":"fuel-cost-calculator UI copy.ui.errors.NUMBER","source_hash":"5791b10619568453aa365b88ae69c40df27f9ff3b3f317469873bc97d5e215e3","translation":"Gunakan bilangan bulat, titik desimal, pecahan, atau bilangan campuran seperti 2 1/3. Jangan gunakan pemisah ribuan."},"fuel-cost-calculator.copy.ui.labels.maximum":{"context":"fuel-cost-calculator UI copy.ui.labels.maximum","source_hash":"66c9ab