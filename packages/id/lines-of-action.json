{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"lines-of-action.copy.actions.start":{"context":"Shared UI copy.actions.start","source_hash":"e4bb9f1ece9af9264a3b9e3913bbdb2cf497457167b14ced5f85688bfde74644","translation":"Mulai"},"lines-of-action.copy.additionalFaqs.0.answer":{"context":"lines-of-action UI copy.additionalFaqs.0.answer","source_hash":"928250cafc7ac491f348b3e7b83b2ffda36fc04c0a72892956242dccaba2363d","translation":"Ya. Ini gratis di peramban Anda dan tidak memerlukan akun. Memori perangkat dan dukungan peramban masih berlaku."},"lines-of-action.copy.fields.accuracyNote":{"context":"lines-of-action UI copy.fields.accuracyNote","source_hash":"09b37b643e7a02924e95e8009e90c8027ced5eda7adb57dae972f935a23258d0","translation":"Ini mengikuti deskripsi aturan 8×8 dari International Computer Games Association: dua belas bilah per sisi, hitungan garis penuh yang tepat, berdekatan diagonal untuk koneksi, melewati ketika tidak dapat bergerak, dan draw pada posisi ketiga yang diulang. Varian yang dipublikasikan berbeda pada koneksi simultan; pilih aturan yang Anda sukai. Tantangan komputer menggunakan heuristik lokal kecil dan bukan mesin turnamen."},"lines-of-action.copy.fields.rulesSource":{"context":"lines-of-action UI copy.fields.rulesSource","source_hash":"be96ca3221647bfbbba9e3141c486accf9e5f995db22155ee83daeda2bfbf794","translation":"Baca aturan di International Computer Games Association"},"lines-of-action.copy.fields.simultaneousMoverWins":{"context":"lines-of-action UI copy.fields.simultaneousMoverWins","source_hash":"7ecca5726343fd0b86b78c8c03d1efc71b422fdca48f93f0d0be58d25f0019fa","translation":"Pemain yang bergerak menang"},"lines-of-action.copy.fields.white":{"context":"lines-of-action UI copy.fields.white","source_hash":"3495e757855a5c678addcf32516274e2962d0572f065378dba689e22168f28dd","translation":"Putih"},"lines-of-action.copy.howAnswer":{"context":"lines-of-action UI copy.howAnswer","source_hash":"21f20bb069113843c8bec9