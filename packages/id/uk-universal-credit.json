{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"uk-universal-credit.copy.additionalFaqs.1.answer":{"context":"uk-universal-credit UI copy.additionalFaqs.1.answer","source_hash":"4a5506124846288e6347287158891c1e308abc590a854560b4a430683b0dab07","translation":"Ini hanya menggambarkan pengurangan penghasilan dan tidak memeriksa kelayakan atau menghitung penghargaan Kredit Universal penuh. Ini mengasumsikan penghargaan maksimal sebelum penghasilan sudah diketahui. Pengurangan 55% berlaku di atas upah kerja yang dipilih: £427 dengan dukungan perumahan, £710 tanpa dukungan perumahan, atau £0 jika tidak ada upah kerja yang berlaku. Kasus khusus dan pengurangan lainnya tidak termasuk. Peraturan adalah untuk 2026–27 dan harus ditinjau kembali sebelum 6 April 2027."},"uk-universal-credit.copy.fields.earningsReduction":{"context":"uk-universal-credit UI copy.fields.earningsReduction","source_hash":"9537c47d93501b400ef55b422dbb6f6d260160d2c265c0fb7278eb6db2448663","translation":"Perkiraan pengurangan pendapatan"},"uk-universal-credit.copy.fields.estimatedPayment":{"context":"uk-universal-credit UI copy.fields.estimatedPayment","source_hash":"5685ee5db14bcb4f6a4fc54007aa6df6aa264ed706206d0efb6ccfb970560a31","translation":"Penghargaan ilustratif setelah penurunan laba"},"uk-universal-credit.copy.howAnswer":{"context":"uk-universal-credit UI copy.howAnswer","source_hash":"0e44e8eafd8cc8a7031bef858c5dde7f31083eb9d8dcfb0bf1754a429c6361b1","translation":"Masukkan jumlah maksimum bulanan Universal Credit sebelum penghasilan, penghasilan bulanan bersih yang dilaporkan dan semua tunjangan kerja yang berlaku."},"uk-universal-credit.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"Pilih gambar terlebih dahulu."},"uk-universal-credit.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc