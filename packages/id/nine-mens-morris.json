{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"nine-mens-morris.copy.details":{"context":"nine-mens-morris UI copy.details","source_hash":"94bcf79f949c5c356bee432117345f05fed6ef0d578c713237ea702c39b10360","translation":"Setiap pemain meletakkan sembilan bilah berturut-turut. Setelah meletakkan, pindahkan satu bilah di sepanjang garis yang ditandai ke titik kosong terdekat. Jika Anda memiliki tepat tiga bilah, versi ini memungkinkan Anda untuk terbang ke titik kosong manapun. Membentuk sebuah pabrik menghapus satu bilah lawan. Anda menang dengan mengurangi lawan menjadi dua bilah atau meninggalkan mereka tanpa gerakan sah. Posisi yang diulang atau batas putaran 200 adalah remis."},"nine-mens-morris.copy.faq.3.a":{"context":"nine-mens-morris UI copy.faq.3.a","source_hash":"3e2fc8aab0093406099582f2b7292f61f39295c789dd078e57c4e58800a9c19a","translation":"Komputer hanya menggunakan papan yang terlihat dan gerakan yang sah. Ia mencari mill atau cara untuk memblokirnya, lalu memilih di antara gerakan yang tersedia secara lokal."},"nine-mens-morris.copy.fields.computer":{"context":"nine-mens-morris UI copy.fields.computer","source_hash":"76ed42d22129dc354362704eb4b54208041b68736f976932aada43bc0035f7c0","translation":"Komputer"},"nine-mens-morris.copy.fields.newGame":{"context":"nine-mens-morris UI copy.fields.newGame","source_hash":"946ed70539f05d2d96a21e223038245dabc5e099d565b32ce65941adc8cc239c","translation":"Permainan baru"},"nine-mens-morris.copy.fields.resumed":{"context":"nine-mens-morris UI copy.fields.resumed","source_hash":"e69dcaf2473fa0ccdd755549ceb5d77aed29a42e2de5b2a1554f1821ccef1312","translation":"Permainan yang disimpan dilanjutkan."},"nine-mens-morris.copy.fields.sourceTitle":{"context":"nine-mens-morris UI copy.fields.sourceTitle","source_hash":"425ad95e9e8790c664b3570babf398d10ba754962901a89ad8cddc5efbdff4e4","translation":"Peraturan Morris Sembilan Orang"},"nine-mens-morris.copy.fields.yourTurnMove":{"context":"nine-mens-morr