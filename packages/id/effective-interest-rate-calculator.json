{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"effective-interest-rate-calculator.copy.additionalFaqs.1.answer":{"context":"effective-interest-rate-calculator UI copy.additionalFaqs.1.answer","source_hash":"69b67179066c05f64f0f81554ca2a45418c3ea5ad0b4603c562b52bbb0aa6422","translation":"Tidak perlu. Alat ini mengkonversi tingkat tahunan nominal yang dimasukkan pengguna menggunakan frekuensi campuran yang dipilih. Pengenalan APR legal mungkin termasuk biaya, jadwal pembayaran atau aturan yang tidak dimodelkan oleh konversi matematika ini."},"effective-interest-rate-calculator.copy.additionalFaqs.1.question":{"context":"effective-interest-rate-calculator UI copy.additionalFaqs.1.question","source_hash":"9107e8b7afc2aef76b6405e0211db494d92daf350821ab4301dbee3d74b71a31","translation":"Apakah ini sama dengan APR yang diungkapkan oleh bank atau pemberi pinjaman?"},"effective-interest-rate-calculator.copy.howAnswer":{"context":"effective-interest-rate-calculator UI copy.howAnswer","source_hash":"fe78b074adbd1d99e0a797d7cf4aab3016d94b38ff9812d5eef74ae6613339fa","translation":"Untuk penggabungan periodik, APY = (1 + APR ÷ m)^m − 1, di mana m adalah jumlah periode penggabungan per tahun. Untuk mengkonversi APY kembali ke APR nominal, gunakan APR = m × ((1 + APY)^(1/m) − 1). Penggabungan terus menerus menggunakan APY = e^APR − 1. Masukkan tingkat sebagai persentase; misalnya, 12 berarti 12%."},"effective-interest-rate-calculator.copy.messages.balancedEquation":{"context":"Shared UI copy.messages.balancedEquation","source_hash":"e2ba0a543ea9f5d93aeb09582b765fba8e0cd79fdefa17dc5425d907983142f4","translation":"Persamaan seimbang"},"effective-interest-rate-calculator.copy.messages.beltSpeed":{"context":"Shared UI copy.messages.beltSpeed","source_hash":"5236d9c335e41d361c836c30e4f8d81d8255d240e47b7a3f8372ea25809e56a2","translation":"Kecepatan sabuk driver"},"effective-interest-rate-calculator.copy.messages.copyUnavailable":{"context":"Shared UI copy.mess