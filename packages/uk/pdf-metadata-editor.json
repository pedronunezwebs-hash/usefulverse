{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"pdf-metadata-editor.copy.additionalFaqs.0.question":{"context":"pdf-metadata-editor UI copy.additionalFaqs.0.question","source_hash":"68f2ae243565b4379427b424ed790f09f1339358034b6d60b59fd38dda6426bf","translation":"Видалити всі метадані з PDF?"},"pdf-metadata-editor.copy.additionalFaqs.1.answer":{"context":"pdf-metadata-editor UI copy.additionalFaqs.1.answer","source_hash":"241da11c7d2b0490ed2d423573aec2d7a5e6f45b692d8598f4f9f47226511ac3","translation":"Не покладайтеся на це. Збереження перезапише файл PDF і може призвести до скасування існуючих цифрових підписів або вплинути на можливості, які не підтримуються цим інструментом. Зберігайте оригінал і перевіряйте копію."},"pdf-metadata-editor.copy.additionalFaqs.2.question":{"context":"pdf-metadata-editor UI copy.additionalFaqs.2.question","source_hash":"22b95a116beb7f58a12d4fa26d7e7e99c6c2983038d0ba1f1d4c2a0a90001d38","translation":"Чи перезаписано оригінал PDF?"},"pdf-metadata-editor.copy.fields.pages":{"context":"pdf-metadata-editor UI copy.fields.pages","source_hash":"9046da16aea909ba75a36cec13b56cb2144dc2ede45cde361e99a8d79802eabf","translation":"Сторінки"},"pdf-metadata-editor.copy.howAnswer":{"context":"pdf-metadata-editor UI copy.howAnswer","source_hash":"bae373802bd764fe2bed3963ab3ed02178e4446212f7759c6acaa4a786dd4521","translation":"За допомогою цього інструменту можна редагувати стандартні поля відомостей про документ: заголовок, автора, тему, ключові слова, творця, виробника, дату створення і дату зміни. За допомогою цього інструменту не можна редагувати метадані XMP або нетипові властивості."},"pdf-metadata-editor.copy.messages.cleared":{"context":"Shared UI copy.messages.cleared","source_hash":"7b9d5d26fdb9ad059a189973838df143b93fced3ce4bed4c0f94f63f9e3c2fd6","translation":"Поля порожні. Натисніть кнопку Зберегти, щоб вилучити ці стандартні записи з нової копії."},"pdf-metadata-editor.copy.messages.downloadReady":{"context":"Share