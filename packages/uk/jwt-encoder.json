{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"jwt-encoder.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"Завантажити приклад"},"jwt-encoder.copy.additionalFaqs.1.answer":{"context":"jwt-encoder UI copy.additionalFaqs.1.answer","source_hash":"1a14284ba54e87eb25378c17b336eda5d2e9a76736333f8efa613597295fb69e","translation":"Цей інструмент створює і перевіряє токени HS256 з секретом HMAC. Він не створює і не перевіряє RSA, ECDSA, EdDSA або інші алгоритми."},"jwt-encoder.copy.description":{"context":"jwt-encoder UI copy.description","source_hash":"7a2c7c922b3bb2cf88caed028d50aa60d6303300b5018555945377261dcb3c29","translation":"Створити і перевірити локальні HS256 JWTs з заявок JSON. Без API для вивантаження, облікового запису або токенів."},"jwt-encoder.copy.fields.accuracyNote":{"context":"jwt-encoder UI copy.fields.accuracyNote","source_hash":"cb81995b2be5ea5126ff63ba03348e24ed609897502b2a6b5679c5d20ecf8afe","translation":"Тільки локальний інструмент HS256 — не провайдер ідентифікаційних даних або рішення щодо розпізнавання. Коректний підпис не доводить, хто видав токен або чи варто довіряти його заявам. Перевіряйте видавця, аудиторію, керування ключами, час і правила програми окремо. JSON обмежено до 64 КБ, а токени — до 128 КБ."},"jwt-encoder.copy.fields.createMode":{"context":"jwt-encoder UI copy.fields.createMode","source_hash":"5d8e8e30bc4fbc8708be633e9ddefbdad23f5a03fe37c870471a5f5354d6409c","translation":"Створити токен"},"jwt-encoder.copy.fields.expiresIn":{"context":"jwt-encoder UI copy.fields.expiresIn","source_hash":"be6ffe03f523629a40952735f2baf3a23a3ae1a3702a1d489316954e515d036c","translation":"Скасувати через секунди (не обов' язкове)"},"jwt-encoder.copy.fields.token":{"context":"jwt-encoder UI copy.fields.token","source_hash":"3bd703cecc504372d0e335dca81aea42436e51740f6bf4a06fec11e5fac1f93f","translation":"Компактний JWT"},"jwt-encoder.copy.howAnswer":{"context":"jwt-encoder UI copy.howAnswer","source_hash":"913bfaee4873c6ac889ad39ae6e85d8456fc4990385b7adc59950b2132563f08","translation":"Він підписує заголовок з кодуванням base64url і вміст JSON за допомогою HMAC- SHA- 256 (HS256) або перевіряє цей підпис локально. За бажанням ви можете додати повідомлення про закінчення терміну дії у секундах. Підтримується лише HS256."},"jwt-encoder.copy.intro":{"context":"Shared UI copy.intro","source_hash":"2b28b7071a3b67dd6922f564812614b5e2a7bbc14f3d52392b814c83a459e718","translation":"Побудувати компактний токен HS256 з об’ єкта заявки JSON або перевірити його підпис у цьому переглядачі. Перевірка підпису сама по собі не визначає надійного видавця або не розпізнає користувача."},"jwt-encoder.copy.messages.copied":{"context":"Shared UI copy.messages.copied","source_hash":"e5c1ac3f48a4f7499e307e319b43370a1b5adafecb4a904414263b94b6e98e7c","translation":"Результат скопійовано."}},"locale":"uk","missing":["jwt-encoder.copy.name","jwt-encoder.copy.title","jwt-encoder.copy.howQuestion","jwt-encoder.copy.privacyQuestion","jwt-encoder.copy.privacyAnswer","jwt-encoder.copy.fields.mode","jwt-encoder.copy.fields.verifyMode","jwt-encoder.copy.fields.payload","jwt-encoder.copy.fields.secret","jwt-encoder.copy.fields.secretHint","jwt-encoder.copy.fields.standardSource","jwt-encoder.copy.fields.expiresHint","jwt-encoder.copy.fields.resultHeading","jwt-encoder.copy.fields.resultOutput","jwt-encoder.copy.actions.run","jwt-encoder.copy.actions.copy","jwt-encoder.copy.actions.result","jwt-encoder.copy.messages.created","jwt-encoder.copy.messages.verified","jwt-encoder.copy.messages.working","jwt-encoder.copy.messages.checkInputs","jwt-encoder.copy.messages.invalidSignature","jwt-encoder.copy.messages.unsupportedCrypto","jwt-encoder.copy.messages.copyUnavailable","jwt-encoder.copy.additionalFaqs.0.question","jwt-encoder.copy.additionalFaqs.0.answer","jwt-encoder.copy.additionalFaqs.1.question","jwt-encode