{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"nine-mens-morris.copy.details":{"context":"nine-mens-morris UI copy.details","source_hash":"94bcf79f949c5c356bee432117345f05fed6ef0d578c713237ea702c39b10360","translation":"Кожен гравець по черзі розміщує дев’ ять фігур. Після розміщення, пересуньте одну фігуру вздовж позначеної лінії у сусідню порожню точку. Якщо у вас є точно три фігури, ця версія дає вам змогу перелетіти до будь- якої порожньої точки. Створення млина вилучає одну фігуру супротивника. Ви виграєте, якщо зменшите супротивника до двох фігур або залишите його без законного ходу. Повторне розташування або обмеження ходу 200 є нічиєю."},"nine-mens-morris.copy.faq.0.q":{"context":"nine-mens-morris UI copy.faq.0.q","source_hash":"460eb239131ec78fbf78989db043269c67e1ac197e37503801f66a8f9f4e44ab","translation":"Що таке млин?"},"nine-mens-morris.copy.faq.1.a":{"context":"nine-mens-morris UI copy.faq.1.a","source_hash":"f7fed65bf629bd574fe46b2e5f5a88fc8fefa6cb17b9843ea32748532e32fa72","translation":"Звичайно, ні, якщо супротивник має будь- яку фігуру за межами млина. Якщо всі фігури супротивника знаходяться у млині, можна вилучити будь- яку фігуру."},"nine-mens-morris.copy.faq.3.a":{"context":"nine-mens-morris UI copy.faq.3.a","source_hash":"3e2fc8aab0093406099582f2b7292f61f39295c789dd078e57c4e58800a9c19a","translation":"Комп’ ютер використовує лише видиму дошку і законні ходи. Він шукає млин або спосіб заблокувати його, а потім вибирає один з наявних ходів локально."},"nine-mens-morris.copy.fields.invalidCapture":{"context":"nine-mens-morris UI copy.fields.invalidCapture","source_hash":"378d7a55b9b7049eecae8d493671ede035029dc26f9d44902dbbf6bc4703bea1","translation":"Цю фігуру не можна вилучити, поки залишається незахищена фігура."},"nine-mens-morris.copy.fields.selectOwn":{"context":"nine-mens-morris UI copy.fields.selectOwn","source_hash":"df747abf18a100731491370b23a0e3eac0f3fd325e23a0bbaf69ad3899130261","translation":"Спочатку виберіть одну зі своїх фігур."},"nine-mens-morris.copy.fields.sourceTitle":{"context":"nine-mens-morris UI copy.fields.sourceTitle","source_hash":"425ad95e9e8790c664b3570babf398d10ba754962901a89ad8cddc5efbdff4e4","translation":"Правила дев'яти чоловік Морріса"},"nine-mens-morris.copy.fields.yourTurnMove":{"context":"nine-mens-morris UI copy.fields.yourTurnMove","source_hash":"d4f8e88ce0cf82c130b89b21e988e9678ee2b55bde6fd5911189094b882063fe","translation":"Ваша черга: оберіть одну з ваших фігур, а потім порожню точку."},"nine-mens-morris.copy.home":{"context":"nine-mens-morris UI copy.home","source_hash":"81c151f98a190da765d67a020d175d400bfd9e46ed8da05bdaeeb0a9b8eef566","translation":"Всі інструменти"},"nine-mens-morris.copy.howItWorks":{"context":"nine-mens-morris UI copy.howItWorks","source_hash":"13a6b22428cd17c402c4a0361b645ee0894bada3ee921a3faa3eb3f2dd110e0c","translation":"Як грати"},"nine-mens-morris.copy.name":{"context":"nine-mens-morris UI copy.name","source_hash":"6e8a74179a315a93b9b739a61629b8d1ac58d5e0406e96b5ec65b6567c93b2d6","translation":"Дев'ять чоловік Морріса"}},"locale":"uk","missing":["nine-mens-morris.copy.title","nine-mens-morris.copy.description","nine-mens-morris.copy.intro","nine-mens-morris.copy.privacy","nine-mens-morris.copy.useTool","nine-mens-morris.copy.exampleHeading","nine-mens-morris.copy.example","nine-mens-morris.copy.faqHeading","nine-mens-morris.copy.faq.0.a","nine-mens-morris.copy.faq.1.q","nine-mens-morris.copy.faq.2.q","nine-mens-morris.copy.faq.2.a","nine-mens-morris.copy.faq.3.q","nine-mens-morris.copy.faq.4.q","nine-mens-morris.copy.faq.4.a","nine-mens-morris.copy.limitsHeading","nine-mens-morris.copy.limits","nine-mens-morris.copy.related","nine-mens-morris.copy.freeBadge","nine-mens-morris.copy.language","nine-mens-morris.copy.fields.newGame","nine-mens-morris.copy.fields.resume","nine-mens-morris.copy.fields.deleteSave","nine-mens-morris.copy.fields.ready","nine-mens-morris.copy.fields.boardLabel","nine-mens-morris.copy.fiel