{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"germany-net-salary.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"Завантажити приклад"},"germany-net-salary.copy.actions.run":{"context":"Shared UI copy.actions.run","source_hash":"c6d33ec22492765d8db1fdc96c8d689a0695e0f842f9de185c2fa9a24e68c9a1","translation":"Оцінити чисту зарплату"},"germany-net-salary.copy.fields.accuracyNote":{"context":"germany-net-salary UI copy.fields.accuracyNote","source_hash":"ce8d379687cd313a2c8a7c1ca7bc20c710a627f6d130d67e5691a1d7c1c22885","translation":"Це приблизна оцінка для одиноких осіб, а не звіт про заробітну плату або податкове декларування. У цій оцінці використовується загальнообов’ язкове медичне страхування і податковий клас I/ IV, середнє додаткове медичне страхування 2026 використовується лише як початкове значення, яке можна редагувати, і не враховується доплата за соціальне страхування, приватне страхування, податковий клас II/ III/ V/ VI, змінна заробітна плата, надбавки і індивідуальні відрахування. Перевірте поточні дані у вашій страховій компанії або платіжному відділенні."},"germany-net-salary.copy.fields.estimatedAnnualNet":{"context":"germany-net-salary UI copy.fields.estimatedAnnualNet","source_hash":"10ffab130ae29f8f71f391745b19dab9df62023cdab4003c2ee60fd3fd15f76d","translation":"Оцінена річна чиста"},"germany-net-salary.copy.fields.state":{"context":"germany-net-salary UI copy.fields.state","source_hash":"977fe0030231ef2eab9cffd9e074e63f1bf2231c15b70680baf175730b72039d","translation":"Федеративна держава"},"germany-net-salary.copy.howAnswer":{"context":"germany-net-salary UI copy.howAnswer","source_hash":"f38ab67ad62d346ad357b07c556edc2579d43a5b2d5196d2fb3a14f3c7ce6a2c","translation":"Введіть вашу щомісячну заробітну плату брутто, ставку додаткового внеску вашої страхової компанії, вік, дані про дітей, федеральну ставку податку штату і церковного податку. Для розрахунку буде застосовано ставку податку на прибуток 2026 і верхню межу статутного внеску, а потім результат буде розраховано на рік за рівними місяцями 12."},"germany-net-salary.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"Спочатку оберіть зображення."},"germany-net-salary.copy.messages.invalid-church-tax-rate":{"context":"Shared UI copy.messages.invalid-church-tax-rate","source_hash":"c006f343a09dd33a30fd1c3875a83b7994fd23bb3104bec6cb439a62338b938d","translation":"Виберіть церковний податок 0%, 8% або 9%."},"germany-net-salary.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"У цю дату в цьому місці не відбудеться жодної події."},"germany-net-salary.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"38047c4bbe9fe015ab19fee410a909b81813ed877b433d208fbca2b304ce562a","translation":"Ні. Обробка виконується у цьому переглядачі. Цей інструмент не зберігає і не висилає ваш вхід."}},"locale":"uk","missing":["germany-net-salary.copy.intro","germany-net-salary.copy.howQuestion","germany-net-salary.copy.privacyQuestion","germany-net-salary.copy.actions.reset","germany-net-salary.copy.actions.copy","germany-net-salary.copy.actions.download","germany-net-salary.copy.actions.start","germany-net-salary.copy.actions.pause","germany-net-salary.copy.actions.resume","germany-net-salary.copy.actions.restart","germany-net-salary.copy.messages.complete","germany-net-salary.copy.messages.error","germany-net-salary.copy.messages.copied","germany-net-salary.copy.messages.copyUnavailable","germany-net-salary.copy.messages.fileError","germany-net-salary.copy.messages.imageTooLarge","germany-net-salary.copy.messages.canvasUnavailable","germany-net-salary.copy.messages.readerFinished","germany-n