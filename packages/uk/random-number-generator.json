{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"random-number-generator.copy.examples.2.text":{"context":"random-number-generator UI copy.examples.2.text","source_hash":"720752f92b5cf25cde9a10650c4be8430381157dd076eef0debb82edfe3ccd5c","translation":"Намалювати три значення на ґратці 0.01 між 0 і 1. Можливі обидві кінцеві точки."},"random-number-generator.copy.faq.1.question":{"context":"random-number-generator UI copy.faq.1.question","source_hash":"d54099d34d3c9b164475fba2d86ee7f2d379789982f98218742b4475dbad75be","translation":"Чи можу я запобігти дублікатам?"},"random-number-generator.copy.faq.2.question":{"context":"random-number-generator UI copy.faq.2.question","source_hash":"0d60ec6941c94cc977987ed85d723d859c344efc1c066ac4c84e42990cee1ca9","translation":"Чому відхилено мій унікальний запит?"},"random-number-generator.copy.faq.7.question":{"context":"random-number-generator UI copy.faq.7.question","source_hash":"b9ebd7b77eff9dbe5350daf48722a046199e4c3d3c65fe60b561af3cf47f9da9","translation":"Чи буде спільне посилання відтворювати мій малюнок?"},"random-number-generator.copy.form.hint":{"context":"random-number-generator UI copy.form.hint","source_hash":"430b42fabd2cbb919a906375f7f7c9165a3584364df138616903aa34587a518d","translation":"Буде включено обидві можливі кінцеві точки. Цілі числа буде округлено всередину; десяткові числа буде використано вибрану сітку. Кількість має бути додатним цілим числом."},"random-number-generator.copy.form.modes.decimals":{"context":"random-number-generator UI copy.form.modes.decimals","source_hash":"5953e4c43e346da100109b735e39ce08b3225ca75b032c8fad471f679943a954","translation":"Десяткова ґратка"},"random-number-generator.copy.how.steps.2.text":{"context":"random-number-generator UI copy.how.steps.2.text","source_hash":"3a4e5db8bce160e75d393890aca8e8834ae802ce24b070d3973abd89daa1b3b3","translation":"Обчислити, перевірити роботу і зберегти результат, якщо це потрібно. Скасувати зупиняє довге завдання."},"random-number-generator.copy.method.paragraphs.1":{"context":"random-number-generator UI copy.method.paragraphs.1","source_hash":"34f9ed3264811f372169b4f2b0173a82ae9adb9dd60c27848f7bf84d1fb4fb7e","translation":"Режим цілих чисел включає перше і останнє ціле число, яким можна скористатися. Нижня межа значення 1.2 стає 2, а верхня межа значення 5.8 стає 5. Якщо округлений до середини інтервал не містить цілих чисел, на сторінці буде показано, що діапазон порожній."},"random-number-generator.copy.navigation.mainLabel":{"context":"random-number-generator UI copy.navigation.mainLabel","source_hash":"eb355944b92d10582856f8aea34b3e319ba465b8aa4c294973cf53f665399a2c","translation":"Головна навігація"},"random-number-generator.copy.privacy.paragraphs.1":{"context":"random-number-generator UI copy.privacy.paragraphs.1","source_hash":"385bbbc22c5ebef5f1b966691700700df07e063a184ff05e36f2c7ab920055b0","translation":"На цій сторінці зберігаються лише ваші параметри теми. Скопійоване посилання містить вибрані вводи і параметри, отже, поділіться ним з іншими."},"random-number-generator.copy.relatedHeading":{"context":"random-number-generator UI copy.relatedHeading","source_hash":"3af73a31ab098fe0db206c522f27cc8b9cd49ef9f0227a8b1e4b20d7611ea7ed","translation":"Корисне наступне обчислення"},"random-number-generator.copy.ui.calculate":{"context":"random-number-generator UI copy.ui.calculate","source_hash":"2121cc15afb6ba5350deb90e1a292faa7d932537a19ddddadff4aeb796a8d595","translation":"Обчислити"},"random-number-generator.copy.ui.copyFallback":{"context":"random-number-generator UI copy.ui.copyFallback","source_hash":"476d9fdc2a1b77869df1f8646d6a4c7f3d2cfce2de2741d20c06324136310e10","translation":"Виберіть і скопіюйте текст нижче."},"random-number-generator.copy.ui.download":{"context":"random-number-generator UI copy.ui.download","source_hash":"0455f0c48ef89c2680aba6ac224254879144590ac3d706943e662673171373bc","translation":"Результат звантаження"},"random-number-generator.copy.ui.lab