{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"average-calculator.copy.examples.2.text":{"context":"average-calculator UI copy.examples.2.text","source_hash":"fb0cc178840e87649590edec08b1f5b8cb80c7fe6763cd3af8a43a99bdfd7e19","translation":"Поточний рівень 80, цільовий 85 і кінцева вага 25% вимагають 100% у фіналі."},"average-calculator.copy.examples.3.text":{"context":"average-calculator UI copy.examples.3.text","source_hash":"4be0bd3c6b0f052749411419536ef1895144cd20c7178f41e798cfbcd1d75ad6","translation":"Середнє значення 0.1 і 0.2 дорівнює точно 0.15, або 3/20, без двійкового шуму з рухомою комою."},"average-calculator.copy.eyebrow":{"context":"average-calculator UI copy.eyebrow","source_hash":"8b7fcde409e3e571a1f83b6be9472f12756dee103f504e59003058eedac24aad","translation":"Корисне резюме, деталі все ще видно."},"average-calculator.copy.faq.1.answer":{"context":"average-calculator UI copy.faq.1.answer","source_hash":"837fc69dc0a88658607583ccccb9ff88697e7f9e7f1a7fa07c41ec7cfbbfd6b6","translation":"Так. Нуль є коректним значенням і додається до підрахунку. Порожній рядок — це роздільник, а не нульовий запис."},"average-calculator.copy.faq.2.question":{"context":"average-calculator UI copy.faq.2.question","source_hash":"a45167c6857e962255434e7c079a5067e0fbce004b9358996260480a69f6485d","translation":"Как работает медиана?"},"average-calculator.copy.how.steps.2.text":{"context":"average-calculator UI copy.how.steps.2.text","source_hash":"3a4e5db8bce160e75d393890aca8e8834ae802ce24b070d3973abd89daa1b3b3","translation":"Обчислити, перевірити роботу і зберегти результат, якщо це потрібно. Скасувати зупиняє довге завдання."},"average-calculator.copy.method.paragraphs.4":{"context":"average-calculator UI copy.method.paragraphs.4","source_hash":"e56bede094fe34ce1a9b66564f543f0582e6afdfae64fca828e3eac09fbeab32","translation":"Потрібна кінцева оцінка передбачає, що поточна оцінка охоплює всі роботи, виконані до завершення. Формула: (цільова оцінка × 100 — поточна оцінка × (100 — кінцева оцінка)) / кінцева оцінка. Поточні і цільові оцінки знаходяться у діапазоні від нуля до ста, а кінцева оцінка є додатною."},"average-calculator.copy.privacy.paragraphs.2":{"context":"average-calculator UI copy.privacy.paragraphs.2","source_hash":"8b3fd9a899a4f3c379c1bc5f5801391bfa6053d76d429ccef1de4f2589ffbb6f","translation":"Великі обчислення залежать від часу і пам’ яті пристрою. Скасувати зупиняє активне завдання. Помилка вилучає старі відповіді і вимикає їх звантаження."},"average-calculator.copy.ui.cancelled":{"context":"average-calculator UI copy.ui.cancelled","source_hash":"cbc7e63195c8c729eb51e1604d71b9a5e25fa25e519cbe3319c9563fe20ffb48","translation":"Зупинено. Змініть вхідні дані або переобчисліть."},"average-calculator.copy.ui.copyFallback":{"context":"average-calculator UI copy.ui.copyFallback","source_hash":"476d9fdc2a1b77869df1f8646d6a4c7f3d2cfce2de2741d20c06324136310e10","translation":"Виберіть і скопіюйте текст нижче."},"average-calculator.copy.ui.dateRange":{"context":"average-calculator UI copy.ui.dateRange","source_hash":"dd5a46f90fce3232af4d2c884d6b4e8c4a8fc1eed55da117dfe611d230abb7b5","translation":"За межами підтримуваного діапазону календарів"},"average-calculator.copy.ui.errors.INTEGER":{"context":"average-calculator UI copy.ui.errors.INTEGER","source_hash":"3dca929772263a49354e7500b8abbb26cb6a7b090282ba16b12969c91cf4e289","translation":"Введіть невід’ ємне ціле число з цифрами 0– 9."},"average-calculator.copy.ui.labels.maximum":{"context":"average-calculator UI copy.ui.labels.maximum","source_hash":"66c9ab177708cbc6b9770301ef0caa3f4fdcab0e3741a7f555b025a5d7dac2eb","translation":"Максимальна"},"average-calculator.copy.ui.labels.minimum":{"context":"average-calculator UI copy.ui.labels.minimum","source_hash":"735beee2e390c7979f936104c3cb5a30c752d73d68844eefc028c403aee8229b","translation":"Мінімальний"},"average-calculator.copy.ui.labels.sum":{"context":"average-calculator UI copy.ui.labels.sum","source_hash