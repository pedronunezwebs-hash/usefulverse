{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"density-calculator.copy.additionalFaqs.0.answer":{"context":"density-calculator UI copy.additionalFaqs.0.answer","source_hash":"a908d7f1433e3639b95de6b5d3d483e0172698ac7a5c2e80cb3ab645fe058cc3","translation":"Густина ділиться на масу і об’ єм: ρ = m / V. Цей калькулятор використовує kg, m³ і kg/ m³, а також показує g/ cm³ і lb/ ft³."},"density-calculator.copy.additionalFaqs.2.answer":{"context":"density-calculator UI copy.additionalFaqs.2.answer","source_hash":"25ccd26c48b5799c491ef1e6d713a516262e5f868a5ee18a9aa003fc5b646eb3","translation":"Введіть масу і об’ єм кожного з компонентів у окремий рядок. За допомогою цього інструменту загальна маса буде поділено на загальний об’ єм, і буде прийнято, що об’ єми компонентів є додавальними. Справжні суміші можуть зменшуватися, розширюватися, розчинятися або містити порожнечі, отже, виміряний кінцевий об’ єм буде точнішим, якщо це має значення."},"density-calculator.copy.fields.densityKgM3":{"context":"density-calculator UI copy.fields.densityKgM3","source_hash":"e6f47b16cc93712cc33e88f8ac38499c167e87b703eb1de0bdf4f968873bf93a","translation":"Густина (кг/ м³)"},"density-calculator.copy.fields.volumeM3":{"context":"density-calculator UI copy.fields.volumeM3","source_hash":"6a6f1797e79258d0eff87583c4886bb32a84ebb4d351376bd68026e20388bdec","translation":"Об' єм (м³)"},"density-calculator.copy.howQuestion":{"context":"Shared UI copy.howQuestion","source_hash":"4f07e654da89ba0c8da3a1ddaa2603021a76470aea3e51796a6d0f58818209cc","translation":"Як розрахувати щільність?"},"density-calculator.copy.messages.copied":{"context":"Shared UI copy.messages.copied","source_hash":"e5c1ac3f48a4f7499e307e319b43370a1b5adafecb4a904414263b94b6e98e7c","translation":"Результат скопійовано."},"density-calculator.copy.messages.density":{"context":"Shared UI copy.messages.density","source_hash":"77a283d69258c2ae985dc2343725d0af253da0fc1d87626966f7cefe4a3c7469","translation":"Щіл