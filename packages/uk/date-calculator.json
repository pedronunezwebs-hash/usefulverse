{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"date-calculator.copy.examples.1.heading":{"context":"date-calculator UI copy.examples.1.heading","source_hash":"d6d28bc1383520659baef7759384cdd9eb82ee0c7a2094e8bd9e088f7b1ef544","translation":"Перехід на високосний день"},"date-calculator.copy.eyebrow":{"context":"date-calculator UI copy.eyebrow","source_hash":"d5393b38646f4b3acc06d8cf78fe4dee46bf4434fcdb13b2e058b734aea357b4","translation":"Трохи ясності для вашого календаряName"},"date-calculator.copy.faq.4.question":{"context":"date-calculator UI copy.faq.4.question","source_hash":"20e2906acf94872777c6f078ae781854e6c4a0c33727dc5f5c7180393ef6f6ba","translation":"Чому січень 31 плюс один місяць стає лютим 28?"},"date-calculator.copy.faq.5.answer":{"context":"date-calculator UI copy.faq.5.answer","source_hash":"c295a7457ac3f473e2189f8320e41b3622b9d2f407d44a7e1da5a4f757c5e5a3","translation":"Так. Роки, що діляться на чотири, є високосними, за винятком років століть, які не діляться на 400. У році 2000 число лютого дорівнює 29; у році 1900 — ні."},"date-calculator.copy.faq.7.answer":{"context":"date-calculator UI copy.faq.7.answer","source_hash":"c87824778e667a5b0885f8264c38dc618778b8229911a20652d6490c6b9b0c90","translation":"Ви все одно отримаєте додатну відстань між датами з поясненням порядку. Поміняйте місцями дати, якщо ви бажаєте, щоб їх було показано у хронологічному порядку."},"date-calculator.copy.faq.9.question":{"context":"date-calculator UI copy.faq.9.question","source_hash":"3da5ad3925c1d5d801d5c8b33511473428bf0388dc437022566a061094940482","translation":"Чи можу я зберегти або поділитись своїм обчисленням?"},"date-calculator.copy.labels.method":{"context":"date-calculator UI copy.labels.method","source_hash":"ad1d4546ea405ba7444e37ec07f2cf556212b511495775fbaffd15c334bd8f21","translation":"Без прихованих правил календаря"},"date-calculator.copy.method.paragraphs.4":{"context":"date-calculator UI copy.method.paragraphs.4","source_hash":"c0e9da1bd3710dc9fba1b6cd203cb5e7dce6ffe21c9a57c1bcec59f1dbb24949","translation":"Для обчислень буде використано дати календаря, а не час дня. Зміна літнього часу не перетворює календарний день на дроб. Щоб вказати кількість годин між різними часами, скористайтеся Калькулятором тривалості часу. Щоб вказати кількість робочих днів, скористайтеся Калькулятором робочих днів і оберіть відповідні свята."},"date-calculator.copy.navigation.onPage":{"context":"date-calculator UI copy.navigation.onPage","source_hash":"06a7b55d6c3eb44df5cb54524e6103ecbc08f496c8689513efc7aac2b548b170","translation":"Використовуйте його максимально."},"date-calculator.copy.privacy.paragraphs.2":{"context":"date-calculator UI copy.privacy.paragraphs.2","source_hash":"69bc3a9f0734b944a69b852a935df233299f12a6c680220407802077c9d7d41c","translation":"Обчислення не надсилають запитів до мережі і не зберігаються автоматично. Сторінка і її шрифт завантажуються з сайту. Копіювання посилання на спільний доступ додає введені вами дати до цього посилання. Коли хтось відкриває це посилання, ці дати стають частиною адреси сторінки. Уникайте спільного використання приватних дат."},"date-calculator.copy.related.2.text":{"context":"date-calculator UI copy.related.2.text","source_hash":"e653f1fe8a85bd6533cfd5ff616a06f25ad8d5dcf935413772c7a4315395b1d6","translation":"Розрахувати вік за допомогою явного правила високосних днів."},"date-calculator.copy.title":{"context":"date-calculator UI copy.title","source_hash":"db18aaed564e06ed2a7fb82c53d71496b0bdead1dbcdebed2d8d9be9e32109d1","translation":"Калькулятор дат — Дні між датами і додавання дат | UsefulVerse"},"date-calculator.copy.ui.clipped":{"context":"date-calculator UI copy.ui.clipped","source_hash":"17b28869c0069b7545d357b15d31054abb7410b9e5d5eaaf9a1a90697bf31837","translation":"Місяць призначення коротший. Ми скористалися його останнім чинним днем, який було обрано."},"date-calculator.copy.ui.errors.LINK_INVALID":{"context":"date-calculator UI copy.ui.errors.LINK_INVALID","source_hash":"f74e7dc8e4a84e4b31bb61e1a666a283f9d9ab8f49a54ee6c29877449de55896","translation":"Це посилання містить некоректні дати або параметри. Виберіть дати нижче, щоб почати знову."},"date-calculator.copy.ui.unit.month":{"context":"date-calculator UI copy.ui.unit.month","source_hash":"a5c7d1719e284f2c9485405d44f62d152cde9e6ede83e1a79a2442b65f6a8735","translation":"місяць"},"date-calculator.copy.ui.unit.years":{"context":"date-calculator UI copy.ui.unit.years","source_hash":"1c50993b009c62dd6600bc0113d0424f9e8ffee8f7eddb0cdad9d4aad67eb4f6","translation":"роки"}},"locale":"uk","missing":["date-calculator.copy.description","date-calculator.copy.heading","date-calculator.copy.intro","date-calculator.copy.category","date-calculator.copy.ui.between","date-calculator.copy.ui.shift","date-calculator.copy.ui.calculation","date-calculator.copy.ui.start","date-calculator.copy.ui.end","date-calculator.copy.ui.base","date-calculator.copy.ui.inclusive","date-calculator.copy.ui.inclusiveHint","date-calculator.copy.ui.swap","date-calculator.copy.ui.calculate","date-calculator.copy.ui.today","date-calculator.copy.ui.operation","date-calculator.copy.ui.add","date-calculator.copy.ui.subtract","date-calculator.copy.ui.years","date-calculator.copy.ui.months","date-calculator.copy.ui.weeks","date-calculator.copy.ui.days","date-calculator.copy.ui.overflow","date-calculator.copy.ui.constrain","date-calculator.copy.ui.reject","date-calculator.copy.ui.advanced","date-calculator.copy.ui.copy","date-calculator.copy.ui.share","date-calculator.copy.ui.reset","date-calculator.copy.ui.copied","date-calculator.copy.ui.copyFallback","date-calculator.copy.ui.shareNotice","date-calculator.copy.ui.result","date-calculator.copy.ui.empty","date-calculator.copy.ui.elapsed","date-calculator.copy.ui.counted","date-calculator.copy.ui.newDate","date-calculator.copy.ui.weekSpan","date-calculator.copy.ui.calendarSpan","date-calculator.copy.ui.periodNote","date-calculator.copy.ui.reversed","d