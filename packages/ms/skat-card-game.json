{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"skat-card-game.copy.details":{"context":"skat-card-game UI copy.details","source_hash":"7850c2586a2737a7960b5257390f795f390b02bd0fc491fcc9a26eb426d3fdea","translation":"Satu pembahagian menggunakan kad 32: tujuh, lapan, sembilan, jack, permaisuri, raja, sepuluh dan ace dalam setiap suit. Setiap pemain mendapat sepuluh kad dan dua membentuk Skat. Tawar secara bergantian; penjual tertinggi memilih daiman, hati, sekop, kelawar, Grand atau Null. Dengan permainan pickup, ambil Skat dan kembalikan dua kad; dengan Hand, biarkan ia tidak dilihat. Pemain mesti ikut suit atau trump yang dipimpin bila mungkin. Permainan suit dan Grand memerlukan mata 61; dalam Null, pengisytihar tidak boleh mengambil sebarang trick."},"skat-card-game.copy.faq.1.q":{"context":"skat-card-game UI copy.faq.1.q","source_hash":"f26101756ed1e94acbd3a1876e32426a575ad15c0e8128c5fcd7aaf06afbf251","translation":"Apa itu Skat?"},"skat-card-game.copy.faq.2.q":{"context":"skat-card-game UI copy.faq.2.q","source_hash":"b2afc28fa2a372110a54d1141ff668fd07c3f6f16196f4edbf93391148cf408b","translation":"Kontrak apa yang boleh saya pilih?"},"skat-card-game.copy.faq.7.q":{"context":"skat-card-game UI copy.faq.7.q","source_hash":"82b38ac20be7aca069020424c4451ccc63fcc1b2d77876b849d18c97e5b6711b","translation":"Adakah CPU tahap pakar?"},"skat-card-game.copy.faq.8.q":{"context":"skat-card-game UI copy.faq.8.q","source_hash":"494f8f0fc8bceb56551338ac5a5272c57957b6837693a5ef188388a6c8a453f2","translation":"Adakah permainan saya dimuat naik atau disimpan secara atas talian?"},"skat-card-game.copy.fields.chooseContract":{"context":"skat-card-game UI copy.fields.chooseContract","source_hash":"36c504b467a28ca087f777d5fe3374afce3f5ee86906f93f3848f09a9d03c2ae","translation":"Pilih kontrak anda"}},"locale":"ms","missing":["skat-card-game.copy.name","skat-card-game.copy.title","skat-card-game.copy.description","skat-card-game.copy.intro","skat-card-game.c