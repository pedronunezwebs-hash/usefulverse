{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"date-calculator.copy.examples.2.heading":{"context":"date-calculator UI copy.examples.2.heading","source_hash":"1662029e28fed513e56ae163ee5f9c1f8609a5555b0182b31a63a42086e439c1","translation":"जनवरी के बाद एक माह 31"},"date-calculator.copy.examplesAction":{"context":"date-calculator UI copy.examplesAction","source_hash":"68623191a26dab07c7acedb36efb8ae1cacd13e3fabd0fe23f1f7d026bfe8424","translation":"इस उदाहरण का प्रयोग करें"},"date-calculator.copy.faq.5.answer":{"context":"date-calculator UI copy.faq.5.answer","source_hash":"c295a7457ac3f473e2189f8320e41b3622b9d2f407d44a7e1da5a4f757c5e5a3","translation":"हाँ. चार से विभाजित होने वाले वर्ष लीप वर्ष हैं, शताब्दियों को छोड़कर जो 400 से विभाजित नहीं हैं. वर्ष 2000 में फरवरी 29 है; 1900 नहीं है."},"date-calculator.copy.faq.7.question":{"context":"date-calculator UI copy.faq.7.question","source_hash":"1db31f79eca7e861e53e33bf5d69ab07641998a90bc740e652efa8904ab34f7c","translation":"क्या होगा यदि समाप्ति तिथि प्रारंभ तिथि से पहले हो?"},"date-calculator.copy.labels.method":{"context":"date-calculator UI copy.labels.method","source_hash":"ad1d4546ea405ba7444e37ec07f2cf556212b511495775fbaffd15c334bd8f21","translation":"कोई छिपे हुए पंचांग नियम नहीं"},"date-calculator.copy.labels.privacy":{"context":"date-calculator UI copy.labels.privacy","source_hash":"aab7685123cf4b021c62a41c905fdc381aaa3ae8e944299e4cdf58955258f445","translation":"जानना अच्छा है"},"date-calculator.copy.method.paragraphs.4":{"context":"date-calculator UI copy.method.paragraphs.4","source_hash":"c0e9da1bd3710dc9fba1b6cd203cb5e7dce6ffe21c9a57c1bcec59f1dbb24949","translation":"गणना कैलेण्डर तिथियों का उपयोग करती है, न कि दिन के समय का. दिन के उजाले से बचाने का परिवर्तन यहाँ एक कैलेण्डर दिन को एक अंश में नहीं बदलता है. समय के बीच घंटों के लिए, समय अवधि गणक का उपयोग करें. कार्य दिवसों के लिए, व्यावसायिक दिनों गणक का उपयोग करें और छुट्टी चुनें जो लागू हो."},"date-calculator.copy.navigation.onPage":{"context":"date-calculator UI copy.navigation.onPage","source_hash":"06a7b55d6c3eb44df5cb54524e6103ecbc08f496c8689513efc7aac2b548b170","translation":"इसका अधिकतम लाभ उठाएं"},"date-calculator.copy.privacy.paragraphs.2":{"context":"date-calculator UI copy.privacy.paragraphs.2","source_hash":"69bc3a9f0734b944a69b852a935df233299f12a6c680220407802077c9d7d41c","translation":"गणना नेटवर्क अनुरोध नहीं करता है तथा स्वचालित रूप से सहेजा नहीं जाता है. पृष्ठ तथा इसके फ़ॉन्ट साइट से लोड होते हैं. साझा लिंक की नक़ल आपके द्वारा प्रविष्ट की गई तिथियों को उस लिंक में रखता है. जब कोई इसे खोलता है, वे तिथियाँ पृष्ठ पता का हिस्सा बन जाती हैं. निजी तिथियां साझा करने से बचें."},"date-calculator.copy.title":{"context":"date-calculator UI copy.title","source_hash":"db18aaed564e06ed2a7fb82c53d71496b0bdead1dbcdebed2d8d9be9e32109d1","translation":"तारीख़ कैलकुलेटर - तारीख़ों के बीच के दिन और जोड़ें | UsefulVerse"},"date-calculator.copy.ui.clipped":{"context":"date-calculator UI copy.ui.clipped","source_hash":"17b28869c0069b7545d357b15d31054abb7410b9e5d5eaaf9a1a90697bf31837","translation":"लक्ष्य माह छोटा है. हमने इसका अंतिम वैध दिन इस्तेमाल किया, जैसा कि चुना गया."},"date-calculator.copy.ui.errors.LINK_INVALID":{"context":"date-calculator UI copy.ui.errors.LINK_INVALID","source_hash":"f74e7dc8e4a84e4b31bb61e1a666a283f9d9ab8f49a54ee6c29877449de55896","translation":"इस लिंक में अवैध तारीख़ या विकल्प हैं. फिर से प्रारंभ करने के लिए नीचे की तारीख़ चुनें."},"date-calculator.copy.ui.inclusive":{"context":"date-calculator UI copy.ui.inclusive","source_hash":"744b95368d1d43a95bf3223762734ea3810910735211c105cac83d8b7da44ccc","translation":"दोनों तिथियां गिनें"},"date-calculator.copy.ui.trust.1":{"context":"date-calculator UI copy.ui.trust.1","source_hash":"9472204455bbfcaab40a5dde1302e556be2ef4902a820af4637ee7424053506a","translation":"कोई साइन-अप नहीं"},"date-calculator.copy.ui.years":{"context":"date-calculator UI copy.ui.years","source_hash":"b68ca0811f132f73edc68e9d3bebb288ef036c1fef8aabe6