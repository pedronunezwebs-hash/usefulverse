{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"average-calculator.copy.examples.2.text":{"context":"average-calculator UI copy.examples.2.text","source_hash":"fb0cc178840e87649590edec08b1f5b8cb80c7fe6763cd3af8a43a99bdfd7e19","translation":"एक वर्तमान ग्रेड 80, लक्ष्य 85 और अंतिम वजन 25% अंतिम पर 100% की आवश्यकता होती है।"},"average-calculator.copy.examples.3.heading":{"context":"average-calculator UI copy.examples.3.heading","source_hash":"e77f0561819255ffad2ecebc54292545864f153aad0cf4124867e5d21f024809","translation":"दशमलव मान सटीक रखें"},"average-calculator.copy.examples.3.text":{"context":"average-calculator UI copy.examples.3.text","source_hash":"4be0bd3c6b0f052749411419536ef1895144cd20c7178f41e798cfbcd1d75ad6","translation":"0.1 और 0.2 का औसत, बिना द्विचर फ्लोटिंग-पॉइंट शोर के, ठीक से 0.15 या 3/20 है।"},"average-calculator.copy.eyebrow":{"context":"average-calculator UI copy.eyebrow","source_hash":"8b7fcde409e3e571a1f83b6be9472f12756dee103f504e59003058eedac24aad","translation":"एक उपयोगी सारांश, विवरण अभी भी दिखाई देता है."},"average-calculator.copy.faq.0.question":{"context":"average-calculator UI copy.faq.0.question","source_hash":"eff179d8ed618d48c796090e62ea270022fc80425f7606212ff4cbe5e10019e9","translation":"कौन से सेपरेटर मैं चिपका सकता हूँ?"},"average-calculator.copy.faq.1.question":{"context":"average-calculator UI copy.faq.1.question","source_hash":"50ca6465a7c203d6bd53b7af95d984f502cdb458fb6d473c55d3ab99d6e847a1","translation":"क्या शून्य औसत में गिनती करता है?"},"average-calculator.copy.faq.6.answer":{"context":"average-calculator UI copy.faq.6.answer","source_hash":"03c3a2b8a27e8777e88ef6379cd96fe53f45b49b90b6ad680bdfd3b37c6e1cfe","translation":"आपके मौज़ूदा अंक अंतिम अंक से पहले के सभी कार्यों को कवर करते हैं. अंतिम वजन पूर्ण अंक का प्रतिशत है."},"average-calculator.copy.faq.6.question":{"context":"average-calculator UI copy.faq.6.question","source_hash":"62403754dcf765bbcf8968c697b273dbeb54badc658ee5237aae645fce5751aa","translation":"अंतिम ग्रेड मोड क्या मानता है?"},"average-calculator.copy.form.hint":{"context":"average-calculator UI copy.form.hint","source_hash":"688289accdf94acb2d7b6865f79df6f13dc721ccb636a4e52c36e0a3f779f66f","translation":"सूची खाली स्थान, अल्पविराम, टैब या नई पंक्तियों को स्वीकारती है. दशमलव के लिए बिंदु का प्रयोग करें. खाली स्थान के साथ मिश्रित संख्याएँ सूची प्रविष्टियाँ नहीं हैं."},"average-calculator.copy.form.modeLabels.final.c":{"context":"average-calculator UI copy.form.modeLabels.final.c","source_hash":"7c02a493e4508c7b41f304cb63c51946d2d8e13e30e0f1761bfd085e7ec46867","translation":"लक्ष्य ग्रेड (%)"},"average-calculator.copy.form.modes.weighted":{"context":"average-calculator UI copy.form.modes.weighted","source_hash":"9ed0fb8fbe4b0a5bed7b0f19b6c166a6b94db2fa58d85debc1171d7742c13160","translation":"वजन औसत"},"average-calculator.copy.how.steps.2.text":{"context":"average-calculator UI copy.how.steps.2.text","source_hash":"3a4e5db8bce160e75d393890aca8e8834ae802ce24b070d3973abd89daa1b3b3","translation":"गणना करें, कार्य की जांच करें तथा यदि आवश्यक हो तो परिणाम सहेजें. रद्द करने से लंबा कार्य रुक जाता है."},"average-calculator.copy.method.paragraphs.4":{"context":"average-calculator UI copy.method.paragraphs.4","source_hash":"e56bede094fe34ce1a9b66564f543f0582e6afdfae64fca828e3eac09fbeab32","translation":"आवश्यक अंतिम ग्रेड यह मानता है कि अंतिम से पहले सभी कार्यों को वर्तमान ग्रेड कवर करता है. सूत्र है (लक्ष्य × 100 - वर्तमान × (100 - अंतिम वजन)) / अंतिम वजन. वर्तमान और लक्ष्य ग्रेड शून्य से एक सौ तक हैं, और अंतिम वजन धनात्मक है."},"average-calculator.copy.method.paragraphs.5":{"context":"average-calculator UI copy.method.paragraphs.5","source_hash":"e6f68c361b187f8bfef8f08618633d841b0888104c042239fa93b09a771e9262","translation":"इस मॉडल के अंतर्गत एक सौ से अधिक आवश्यक अंकों को अप्राप्ति योग्य के रूप में लेबल किया जाता है. एक ऋणात्मक आवश्यकता का अर्थ है कि लक्ष्य पहले से ही शून्य अंतिम अंक के साथ सुरक्षित है, इसलिए प्रदर्शित आवश्यकता शून्य है. संस्थान अन्य ग्रेडिंग या राउंडिंग नियमों का उपयोग कर सकते हैं; वास्तविक नीति की जांच करें."},"average-calculator.copy.privacy.heading":{"context":"average-calculator UI copy.privacy.heading","source_hash":"bef0dc8aaebf768fa2be1fb224ac1a08ac3fa810c85991f3040785b5239b6229","translation":"निजी गणनाएँ, सीमाएँ साफ करें"},"average-calculator.copy.privacy.paragraphs.1":{"context":"average-calculator UI copy.privacy.paragraphs.1","source_hash":"385bbbc22c5ebef5f1b966691700700df07e063a184ff05e36f2c7ab920055b0","translation":"पृष्ठ सिर्फ आपकी प्रसंग वरीयता को सहेजा जाता है. नक़ल की गई लिंक में चयनित इनपुट तथा विकल्प होते हैं, अतः इसे जानबूझकर साझा करें."},"average-calculator.copy.privacy.paragraphs.2":{"context":"average-calculator UI copy.privacy.paragraphs.2","source_hash":"8b3fd9a899a4f3c379c1bc5f5801391bfa6053d76d429ccef1de4f2589ffbb6f","translation":"बड़ी गणनाएँ उपकरण समय तथा मेमोरी पर निर्भर करती हैं. रद्द करें सक्रिय कार्य को रोकता है. एक त्रुटि पुराने उत्तरों को मिटा देता है तथा उनके डाउनलोड को अक्षम करता है."},"average-calculator.copy.related.0.title":{"context":"average-calculator UI copy.related.0.title","source_hash":"14c3c23fdb40224b6aa49d741c2c3af10061c4a6261cfada9dd39e64e36d171c","translation":"मानक विचलन गणक"},"average-calculator.copy.title":{"context":"average-calculator UI copy.title","source_hash":"53b7d66f44e179b3b97a53896d31475df10f6cd085e4bc53d8596c18251e0f1f","translation":"औसत कैलकुलेटर - औसत, वजन तथा अंतिम अंक"},"average-calculator.copy.ui.cancelled":{"context":"average-calculator UI copy.ui.cancelled","source_hash":"cbc7e63195c8c729eb51e1604d71b9a5e25fa25e519cbe3319c9563fe20ffb48","translation":"बन्द. इनपुट बदलें या फिर से गणना करें."},"average-calculator.copy.ui.dateRange":{"context":"average-calculator UI copy.ui.dateRange","source_hash":"dd5a46f90fce3232af4d2c884d6b4e8c4a8fc1eed55da117dfe611d230abb7b5","translation":"समर्थित कैलेण्डर सीमा के बाहर"},"average-calculator.copy.ui.errors.INTEGER":{"context":"average-calculator UI copy.ui.errors.INTEGER","source_