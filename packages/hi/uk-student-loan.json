{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"uk-student-loan.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"उदाहरण लोड करें"},"uk-student-loan.copy.additionalFaqs.1.answer":{"context":"uk-student-loan UI copy.additionalFaqs.1.answer","source_hash":"332ef622a94e12190766e2fea758d5584af61be1a97c8ef0e9606a9b742914e3","translation":"एक तिथि 2026–27 स्नैपशॉट का उपयोग करता है 19 अक्टूबर 2026 और 19 नवम्बर 2026 से गणनाओं को अक्षम करता है जब तक कि नियमों की समीक्षा नहीं की जाती है. वार्षिक पुनर्भुगतान पेरोल गोल करने से पहले एक अनुमान है. ब्याज चयनित योजना के लिए शेष पर एक नाममात्र एक वर्ष का अनुमान है; योजना 2 दरें भिन्न होती हैं और बदल सकती हैं. मिटाने का अनुमान चयनित योजना और तिथियों का अनुसरण करता है, आपके व्यक्तिगत खाते के बयान नहीं."},"uk-student-loan.copy.fields.annualIncome":{"context":"uk-student-loan UI copy.fields.annualIncome","source_hash":"31a85106ee53751bfaf14f9f687b84cd7aefc299cfd55a95a6a8563d2db5b0bb","translation":"टैक्स से पहले वार्षिक आय (£)"},"uk-student-loan.copy.fields.firstLoanDate":{"context":"uk-student-loan UI copy.fields.firstLoanDate","source_hash":"adec02011c2cd135176d00838bc0ebe7145d2653ea1b6e6af4aff978ce7f7164","translation":"तारीख़ जब आपका पहला कोर्स लोन चुकाया गया था"},"uk-student-loan.copy.fields.firstRepaymentYear":{"context":"uk-student-loan UI copy.fields.firstRepaymentYear","source_hash":"7e8919bf652814cd60657cb7ff00d797f96ab45992eb291fc8165d2e6fe8367e","translation":"वर्ष पुनर्भुगतान पहली बार निर्धारित हुआ"},"uk-student-loan.copy.fields.planRepayment":{"context":"uk-student-loan UI copy.fields.planRepayment","source_hash":"dc0cd3b44f606ed0629b02e4f5340ac7822c3dbdba3c4f0d472a49ee353ec1a8","translation":"वार्षिक पुनर्भुगतान अनुमान"},"uk-student-loan.copy.howAnswer":{"context":"uk-student-loan UI copy.howAnswer","source_hash":"9f528db83c3948479ca8b2794fc32ca1be99b2d7248618e9f00947db510f0bbc","trans