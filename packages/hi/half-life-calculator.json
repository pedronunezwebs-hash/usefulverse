{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"half-life-calculator.copy.actions.calculate":{"context":"Shared UI copy.actions.calculate","source_hash":"2121cc15afb6ba5350deb90e1a292faa7d932537a19ddddadff4aeb796a8d595","translation":"गणना करें"},"half-life-calculator.copy.actions.circle":{"context":"Shared UI copy.actions.circle","source_hash":"b93d3bcecff5d7493a58a41ea44f7196a46295f6512ebc06940510676a666384","translation":"वृत्त"},"half-life-calculator.copy.fields.accuracyNote":{"context":"half-life-calculator UI copy.fields.accuracyNote","source_hash":"e1f4748997a82fea593ded12511e146b8166004dfb9191159629cc7d4b150fab","translation":"धनात्मक मात्रा तथा अर्ध- जीवन का प्रयोग करें; बीता समय शून्य हो सकता है. क्षय मॉडल में शेष राशि प्रारंभिक राशि से अधिक नहीं हो सकती. बीता समय तथा अर्ध- जीवन को एक ही इकाई में भरें. मान गणक द्वारा दिखाई गई परिमित संख्यात्मक सीमा तक सीमित हैं. यह एक शैक्षिक गणितीय औजार है, विकिरण, स्वास्थ्य, खुराक या सुरक्षा गणक नहीं."},"half-life-calculator.copy.fields.mode":{"context":"half-life-calculator UI copy.fields.mode","source_hash":"1a54d3cb785f61225fac14deaddef7dc9bd9c3a9aeca645bc1f9965696188fda","translation":"हल करने के लिए मूल्य"},"half-life-calculator.copy.fields.remainingAmount":{"context":"half-life-calculator UI copy.fields.remainingAmount","source_hash":"1b2d6366c3fd5cd41a67226cbf7e42ae0d4ce80cb48849c4eee852a6a34d904a","translation":"शेष राशि"},"half-life-calculator.copy.fields.solveHalfLife":{"context":"half-life-calculator UI copy.fields.solveHalfLife","source_hash":"6a28c4fe555ef03f9cd05da9dbd70be467ab1a171ab4b8d13b782a6c8ed16928","translation":"अर्ध- जीवन"},"half-life-calculator.copy.fields.solveRemaining":{"context":"half-life-calculator UI copy.fields.solveRemaining","source_hash":"1b2d6366c3fd5cd41a67226cbf7e42ae0d4ce80cb48849c4eee852a6a34d904a","translation":"शेष राशि"},"half-life-calculator.copy.howAnswer":{"context":"half-life-calculator UI copy.howAnswer","source_hash":"8613317289246f6264e45987f0be8e56b0a638ff9f86b08fdfaa763dd3fe62c0","translation":"इस मॉडल में शेष राशि = प्रारंभिक राशि × (1/2)^(बीता समय ÷ अर्ध जीवन). हल करने के लिये कौन सा मान चुनें, अन्य तीनों को भरें, और बीते समय तथा अर्ध जीवन के लिये उसी समय इकाई का प्रयोग करें. एक अर्ध जीवन के पश्चात, 50% शेष रहता है; दो के पश्चात, 25%. यह एक गणितीय मॉडल है, चिकित्सा, सुरक्षा या संभालने की सलाह नहीं."},"half-life-calculator.copy.howQuestion":{"context":"Shared UI copy.howQuestion","source_hash":"c646fd7b84f6b232946af1fe993ec6e66dcae7c7c7415f2d29a89ad997d95322","translation":"आप अर्ध- जीवन और रेडियोधर्मी क्षय की गणना कैसे करते हैं?"},"half-life-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"0c98631791704a3ee4f783a2e95f8d215d6e3c41a0e07e204b0997649dc93b78","translation":"अर्ध- जीवन समीकरण में एक मान हल करें. अन्य तीनों से. डाटा अपलोड किए बगैर शेष राशि, प्रतिशत और बीत चुके अर्ध- जीवन देखें."},"half-life-calculator.copy.messages.bagsToBuy":{"context":"Shared UI copy.messages.bagsToBuy","source_hash":"a89760dac2e54e45dd5902cb4c842481cde3f3a18cf1e636c62843a2383e997f","translation":"खरीदने के लिए पूरा बैग"},"half-life-calculator.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"इस ब्राउज़र में नक़ल उपलब्ध नहीं है."},"half-life-calculator.copy.privacyQuestion":{"context":"Shared UI copy.privacyQuestion","source_hash":"7c516f2d04f697daac52c93a46d46856b0303ccdd6c1eae980e1b52890e58cd2","translation":"क्या मेरे मान अपलोड किए गए हैं?"},"half-life-calculator.copy.title":{"context":"half-life-calculator UI copy.title","source_hash":"cc3362f92ce1ae57744a47a616f8ffd74a3646173d93fa38a696350d5f5d3694","translation":"आधे जीवन कैलकुलेटर मुफ़्त | UsefulVerse"}},"locale":"hi","missing":["half-life-calculator.copy.name","half-life-calculator.copy.description","half-life-calculator.copy.privacyAnswer","half-life-calculator.copy.fields.solveInitial","half-life-calculator.copy.