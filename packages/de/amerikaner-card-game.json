{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"amerikaner-card-game.copy.description":{"context":"amerikaner-card-game UI copy.description","source_hash":"f289654300bb839c6d0748a232434fbac6059fe05b747c556c813a7f68d2d405","translation":"Spielen Sie das Kartenspiel Norwegischer Amerikaner lokal mit drei bis sechs Spielern, bieten Sie auf Stiche, wählen Sie Trumpf, finden Sie Ihren Partner und halten Sie die Punktzahl auf diesem Gerät."},"amerikaner-card-game.copy.faq.0.q":{"context":"amerikaner-card-game UI copy.faq.0.q","source_hash":"8788e11e58a20d4339822c60f9156e759298d13734ef9e31f7d290b570360536","translation":"Wie viele Spieler können spielen?"},"amerikaner-card-game.copy.faq.1.a":{"context":"amerikaner-card-game UI copy.faq.1.a","source_hash":"9b3aa9c3c5c1c535572ca2a536662648df1f7e4eb5012312243cdb1088ac0b39","translation":"Verwenden Sie 52 Karten ohne Joker.Legen Sie eine Zwei für drei Spieler, keine für vier, zwei für fünf und alle vier Zweien für sechs, so dass jede Hand die gleiche Anzahl von Karten hat."},"amerikaner-card-game.copy.fields.chooseCard":{"context":"amerikaner-card-game UI copy.fields.chooseCard","source_hash":"f18a3dc99d705a831cb98f7e77b7b3ef8f291c38fd4d29bb5c860aed71ba76c0","translation":"Wähle eine Karte zum Spielen"},"amerikaner-card-game.copy.fields.deleted":{"context":"amerikaner-card-game UI copy.fields.deleted","source_hash":"1f9bc6adddbd1af200d7e3b66d3aaf6fea0a7c77681fa3ece722b90b62c6479a","translation":"Gespeichertes Spiel gelöscht."},"amerikaner-card-game.copy.fields.gameWon":{"context":"amerikaner-card-game UI copy.fields.gameWon","source_hash":"e60b3ed046b64e467908319b32893f72c0d1dd88bece704103dcada41da2f1d6","translation":"{player} hat das Spiel mit {count} Punkten gewonnen!"},"amerikaner-card-game.copy.fields.newGame":{"context":"amerikaner-card-game UI copy.fields.newGame","source_hash":"946ed70539f05d2d96a21e223038245dabc5e099d565b32ce65941adc8cc239c","translation":"Neues Neues Spiel"},"amerikaner-car