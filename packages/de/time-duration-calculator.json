{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"time-duration-calculator.copy.category":{"context":"time-duration-calculator UI copy.category","source_hash":"2459ea42894c5c5b6f95fdbde7276e335f60615d3fb2e4aa2550f731cbace2bb","translation":"Datum & Uhrzeit"},"time-duration-calculator.copy.description":{"context":"time-duration-calculator UI copy.description","source_hash":"5a396a86f1d578e4a85234fc049e0bab280da3cb882da483e3bb2ac0413ef475","translation":"Finden Sie Stunden, Minuten und Sekunden zwischen Zeiten oder Datumsangaben, verwalten Sie Übernachtungszeiträume, Pausen, Zeitzonen und Zeitumstellungen. Kostenlose Berechnungen in Ihrem Browser."},"time-duration-calculator.copy.examples.2.text":{"context":"time-duration-calculator UI copy.examples.2.text","source_hash":"3be9367ab59bbaf25b7c5e5cc1e2d49086665edeeb656841752a696205fdde4e","translation":"In New York am März 10, 2024, Mitternacht bis 04:00 ist 3 Stunden vergangen.Die Uhr springt eine Stunde."},"time-duration-calculator.copy.faq.1.answer":{"context":"time-duration-calculator UI copy.faq.1.answer","source_hash":"ed424efdbe651eafb3d3f5734a69c795ea91d66421c76b8e4555839f1b9065a7","translation":"Aktivieren Sie bei Uhrzeiten die Option Ende ist der nächste Tag. Für 23:30 bis 01:15 lautet die Antwort 1 Stunde 45 Minuten.Verwenden Sie bei mehr als einem Tag die tatsächlichen Daten.For more than one day, use actual dates."},"time-duration-calculator.copy.faq.3.question":{"context":"time-duration-calculator UI copy.faq.3.question","source_hash":"82dcd42b691ecbea4e3433d5409ecd424120fc04a72f2b3127f8f0305e3fa5e5","translation":"Wie entferne ich eine Mittagspause?"},"time-duration-calculator.copy.faq.4.question":{"context":"time-duration-calculator UI copy.faq.4.question","source_hash":"4c5124e6f8b4e752b638795149664f4799736c3e34cc6dc4f2e8decf115e09b2","translation":"Verändert die Sommerzeit die Dauer?"},"time-duration-calculator.copy.faq.7.answer":{"context":"time-duration-calculator UI copy.faq.7.answer","source_hash":"a4b1581f715a50cc6bdd156debb8d8de40cba08baaddc403a7e2adf64f6669f7","translation":"Ja. Wählen Sie unter Datum & Uhrzeit jede Zone separat aus. Jede Ortszeit wird vor der Subtraktion in ihren eigenen UTC-Instant umgewandelt. Das Ergebnis listet die verwendeten Offsets und UTC-Zeiten auf."},"time-duration-calculator.copy.faq.8.question":{"context":"time-duration-calculator UI copy.faq.8.question","source_hash":"a468b2c227af29c92d1a64d455e5ed9b841baa585f5b812805106f45dbeb936e","translation":"Wie funktionieren Dezimalstunden?"},"time-duration-calculator.copy.footer":{"context":"time-duration-calculator UI copy.footer","source_hash":"a3880b0f3081d8eba36744d728875fed10f0747643525c7a0306a90333b867ba","translation":"Kleine Werkzeuge. Ein bisschen mehr Raum zum Nachdenken."},"time-duration-calculator.copy.method.paragraphs.2":{"context":"time-duration-calculator UI copy.method.paragraphs.2","source_hash":"0cb1ecf008172991fb74da08089f6548a60e70ea08c93132d80893fdbab50184","translation":"Eine Frühlingsumstellung kann eine Stunde von der lokalen Uhr entfernen. Manche lokale Zeiten treten nie auf. Eine Herbstumstellung kann eine Stunde wiederholen, wodurch ein Label mehrdeutig wird. Dieser Rechner lehnt fehlende Zeiten ab und fragt, welches Vorkommen Sie für wiederholte Zeiten meinen. Er verschiebt Ihre Eingabe niemals stillschweigend."},"time-duration-calculator.copy.navigation.mainLabel":{"context":"time-duration-calculator UI copy.navigation.mainLabel","source_hash":"eb355944b92d10582856f8aea34b3e319ba465b8aa4c294973cf53f665399a2c","translation":"Die Hauptnavigation"},"time-duration-calculator.copy.ui.endOccurrence":{"context":"time-duration-calculator UI copy.ui.endOccurrence","source_hash":"a34ae86acfad85f74e5a166e8de3053f7b31f06d3b7f432cee5ecebbd78e24e7","translation":"Wenn sich die Endzeit wiederholt"},"time-duration-calculator.copy.ui.errors.TIME_REPEAT":{"context":"time-duration-calculator UI copy.ui.errors.TIME_REPEAT","source_hash":"70b11ca59cdb9