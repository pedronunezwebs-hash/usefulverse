{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"uk-universal-credit.copy.additionalFaqs.1.answer":{"context":"uk-universal-credit UI copy.additionalFaqs.1.answer","source_hash":"4a5506124846288e6347287158891c1e308abc590a854560b4a430683b0dab07","translation":"Es wird davon ausgegangen, dass der maximale Zuschlag vor dem bereits bekannten Einkommen gewährt wird. Der Zuschlag 55% gilt über dem ausgewählten Arbeitszuschuss hinaus: £427 mit Wohngeld, £710 ohne Wohngeld oder £0, wenn kein Arbeitszuschuss gewährt wird. Sonderfälle und andere Abzüge sind ausgeschlossen. Die Regeln gelten für 2026–27 und müssen vor 6 April 2027 überprüft werden."},"uk-universal-credit.copy.fields.earningsReduction":{"context":"uk-universal-credit UI copy.fields.earningsReduction","source_hash":"9537c47d93501b400ef55b422dbb6f6d260160d2c265c0fb7278eb6db2448663","translation":"Geschätzte Ergebnis-Taper-Reduktion"},"uk-universal-credit.copy.fields.maximumAward":{"context":"uk-universal-credit UI copy.fields.maximumAward","source_hash":"ce1b1e45deb61c7434c53700d9f665a83345df5659ab0994a37f9a059c3ad705","translation":"Maximale monatliche UC-Prämie vor Einnahmen (GBP)"},"uk-universal-credit.copy.fields.resultTitle":{"context":"uk-universal-credit UI copy.fields.resultTitle","source_hash":"6e7d50e84f4731ef74187cf8cfa2672184eed8866b0b0074a772f4a64e0f4ba2","translation":"Ergebnis"},"uk-universal-credit.copy.fields.workAllowanceAmount":{"context":"uk-universal-credit UI copy.fields.workAllowanceAmount","source_hash":"24670fa0905cb891ee2b2daf891d0929d174d4263fe7b550ad8492cc06573000","translation":"Ausgewählte Arbeitszulage"},"uk-universal-credit.copy.howAnswer":{"context":"uk-universal-credit UI copy.howAnswer","source_hash":"0e44e8eafd8cc8a7031bef858c5dde7f31083eb9d8dcfb0bf1754a429c6361b1","translation":"Geben Sie den maximalen monatlichen Universal Credit-Betrag vor Einkommen, gemeldetem monatlichem Nettoverdienst und allen anwendbaren Arbeitszulagen ein."},"uk-universal-cred