{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"flow-rate-calculator.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"Dreieck"},"flow-rate-calculator.copy.additionalFaqs.0.question":{"context":"flow-rate-calculator UI copy.additionalFaqs.0.question","source_hash":"68c990505da9a8f5b2e044b9b6e10f453b8e2033e57dd21ccfc986823197c019","translation":"Wie hoch ist die Durchflussrate für einen 2 m² Abschnitt, der sich mit 3 m/s bewegt?"},"flow-rate-calculator.copy.additionalFaqs.2.answer":{"context":"flow-rate-calculator UI copy.additionalFaqs.2.answer","source_hash":"a664962ae4c403ca652e8c38c43efdfcde0ecc63186e8d676e83c3155c5ab18e","translation":"Dividieren Sie das Tankvolumen durch die Durchflussrate, indem Sie kompatible Volumen- und Zeiteinheiten verwenden.Die Schätzung geht davon aus, dass der Durchfluss konstant bleibt und der Tank nicht überläuft oder Flüssigkeit verliert."},"flow-rate-calculator.copy.additionalFaqs.2.question":{"context":"flow-rate-calculator UI copy.additionalFaqs.2.question","source_hash":"cffa48f25cc229417de12392b582fcee47267fe87caad80c176309eae47df2e4","translation":"Wie kann ich abschätzen, wie lange es dauert, einen Tank zu füllen?"},"flow-rate-calculator.copy.fields.solveArea":{"context":"flow-rate-calculator UI copy.fields.solveArea","source_hash":"6ddbca06952fe942646cab14b058e4b904b93a0e995e9ace723f8372ec87d6fc","translation":"Querschnittsfläche"},"flow-rate-calculator.copy.fields.usGallons":{"context":"flow-rate-calculator UI copy.fields.usGallons","source_hash":"c295a8b8a622ed30ee8b09be98a9ec9f9610b5c578d2f0cf1ef541defe7407a1","translation":"US-Gallonen (US gal)"},"flow-rate-calculator.copy.howAnswer":{"context":"flow-rate-calculator UI copy.howAnswer","source_hash":"1f3f4899f63ab5cc3e1f65d9265252070b9fa68d439aaa24dc4a03795f9b489f","translation":"Für eine gleichmäßige Strömung durch einen Abschnitt e