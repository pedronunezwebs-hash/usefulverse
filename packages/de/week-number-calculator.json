{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"week-number-calculator.copy.actions.calculate":{"context":"Shared UI copy.actions.calculate","source_hash":"6af150ed9f7607c0a682ebea8ce3307d5e30de3e62337d2d920e5a7fc16c4f75","translation":"Finden Sie Woche"},"week-number-calculator.copy.additionalFaqs.0.answer":{"context":"week-number-calculator UI copy.additionalFaqs.0.answer","source_hash":"32dbc304f5247c47b1ef61940acda56749011266d13840e5aa10e88da2a01986","translation":"Eine ISO-Woche gehört zu dem Jahr, in dem ihr Donnerstag liegt, ein Datum Anfang Januar kann also zur letzten ISO-Woche des Vorjahres gehören, und ein Datum Ende Dezember kann zur Woche 1 des nächsten ISO-Jahres gehören."},"week-number-calculator.copy.additionalFaqs.1.answer":{"context":"week-number-calculator UI copy.additionalFaqs.1.answer","source_hash":"82866b2f70a63e94c16d573ec52088bcd45abc6765fc4532658e7b9ce3e7aa5e","translation":"Der Sieben-Tage-Zeitraum, der Januar 1 enthält, wird als Woche 1 nummeriert, wobei der ausgewählte erste Tag verwendet wird.Die Beschriftung bleibt beim Kalenderjahr. Dies ist eine transparente Vergleichsregel, keine Behauptung über die offizielle Vereinbarung Ihres Landes oder Arbeitgebers."},"week-number-calculator.copy.additionalFaqs.1.question":{"context":"week-number-calculator UI copy.additionalFaqs.1.question","source_hash":"c8b21add8f3dd9f57fd7603e37123c1d33372f8837d2d9c00a485d9364e7af03","translation":"Was bedeutet die benutzerdefinierte Kalenderwoche-Option?"},"week-number-calculator.copy.fields.weekStart":{"context":"week-number-calculator UI copy.fields.weekStart","source_hash":"be9a6943be5d26b8c5580acf05a7bfe4152fc68cd1e7e0b7ddfa2dbad9a3db85","translation":"Erster Tag der Woche"}},"locale":"de","missing":["week-number-calculator.copy.name","week-number-calculator.copy.title","week-number-calculator.copy.description","week-number-calculator.copy.intro","week-number-calculator.copy.howQuestion","week-number-calculator.copy.howAnswer