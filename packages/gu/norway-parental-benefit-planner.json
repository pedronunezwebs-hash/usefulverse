{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-parental-benefit-planner.copy.details":{"context":"norway-parental-benefit-planner UI copy.details","source_hash":"2a967325f900dffe6a755c0f3eca335d02b3ee02dabc1c55c859fbf356845d7a","translation":"પ્રથમ પસંદ થયેલ ઘટના તારીખ, ઘટના પ્રકાર, બાળકોની સંખ્યા અને કવરેજ માટે સત્તાવાર સમયગાળો કોષ્ટકની સરખામણી કરો. પછી તમારી જાતની તારીખવાળા છૂટછાટ સમયગાળા ઉમેરો. અઠવાડિયાના દિવસો લાભ દિવસોનો વપરાશ કરે છે; આંશિક પાછા ખેંચવું અઠવાડિયાના દિવસે વપરાતા દિવસોને ઘટાડે છે અને કેલેન્ડરને વિસ્તારે છે. ગેરહાજરીઓ લાભ પાછા ખેંચ્યા વગર કામ અથવા રજા દર્શાવી શકે છે."},"norway-parental-benefit-planner.copy.fields.comparisonShared":{"context":"norway-parental-benefit-planner UI copy.fields.comparisonShared","source_hash":"3567fe20f899c859d05b6a51b64a55315a54254c76d35a7182cc1e5d734c5251","translation":"વહેંચાયેલ સમયગાળા"},"norway-parental-benefit-planner.copy.fields.mother":{"context":"norway-parental-benefit-planner UI copy.fields.mother","source_hash":"86605cac7f0646867f62ff0f03ca6af9dc3ce860f772a8673cdb6cd34dffc3b1","translation":"માતા"},"norway-parental-benefit-planner.copy.fields.parentColumn":{"context":"norway-parental-benefit-planner UI copy.fields.parentColumn","source_hash":"5f7953f7c9b6ba16602898e540795140db39847cf03fd10d32ef636cded0360e","translation":"પિતૃ"},"norway-parental-benefit-planner.copy.fields.sourceOfficialPlanner":{"context":"norway-parental-benefit-planner UI copy.fields.sourceOfficialPlanner","source_hash":"bf8ff1a9cde4a0116c7bbd2dbe8b687fec765f280487b21f2e7a01e133c2f897","translation":"NAV · સત્તાવાર માતાપિતા લાભ યોજનાકાર"}},"locale":"gu","missing":["norway-parental-benefit-planner.copy.name","norway-parental-benefit-planner.copy.title","norway-parental-benefit-planner.copy.description","norway-parental-benefit-planner.copy.intro","norway-parental-benefit-planner.copy.privacy","norway-parental-benefit-planner.copy.exampleHeading","norway-parental-benefit-planner.copy.example","norway-paren