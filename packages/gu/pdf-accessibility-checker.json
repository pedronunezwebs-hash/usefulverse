{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"pdf-accessibility-checker.copy.additionalFaqs.0.question":{"context":"pdf-accessibility-checker UI copy.additionalFaqs.0.question","source_hash":"b27ba10bdc4edf59d570d8bca11fa1a7d18500d0f1f6e4eaff809350f09e48f1","translation":"શું હકારાત્મક પરિણામનો અર્થ એ છે કે PDF સુલભ છે?"},"pdf-accessibility-checker.copy.additionalFaqs.1.answer":{"context":"pdf-accessibility-checker UI copy.additionalFaqs.1.answer","source_hash":"adb34565b3651bcb357ee3b8c9fb0619366b401b76b59dafbf6f9bfc86e42d1b","translation":"ના. આ પ્રથમ-પાસ ચકાસનાર દરેક જરૂરિયાત ચકાસી શકતુ નથી અને PDF/UA, WCAG, વિભાગ 508, અથવા કાયદાકીય અનુરૂપતાને પ્રમાણિત કરી શકતુ નથી."},"pdf-accessibility-checker.copy.description":{"context":"pdf-accessibility-checker UI copy.description","source_hash":"85d07d0a0e02d2a0f6637878b60b3e4fec2115625e0c84a7afc9f808a6fe4c04","translation":"મૂળભૂત સુલભતા સંકેતો: ટેગો, શીર્ષક, ભાષા, પસંદ કરી શકાય તેવું લખાણ, alt લખાણ વગરના આકૃતિઓ, અને હેડિંગ ક્રમ માટે PDF ને ચકાસો."},"pdf-accessibility-checker.copy.fields.headingJumps":{"context":"pdf-accessibility-checker UI copy.fields.headingJumps","source_hash":"ceab2aca5250370ac5b6232f4301492b235e580ee2496d0601443cb4a36fbc06","translation":"સંભવિત શીર્ષક-સ્તર કૂદકો"},"pdf-accessibility-checker.copy.fields.manualContrast":{"context":"pdf-accessibility-checker UI copy.fields.manualContrast","source_hash":"dde5844c5d9fd46d70336cbee98679a9dcc8f0e1e55fcb5ad40686cca5ead712","translation":"રંગ વિરોધાભાસ, કડીનો અર્થ, કીબોર્ડ ક્રિયા, ફોર્મ લેબલો, કોષ્ટક હેડરો, અને દસ્તાવેજ ભાષા ચકાસો."},"pdf-accessibility-checker.copy.fields.textCharacters":{"context":"pdf-accessibility-checker UI copy.fields.textCharacters","source_hash":"70a698d728291b26ba6322359c1c40f90e8a23de58efe7476707c73cda4c706a","translation":"પસંદ કરી શકાય તેવા લખાણ અક્ષરો"},"pdf-accessibility-checker.copy.howAnswer":{"context":"pdf-accessibility-checker UI copy.howAnswer","source_hash":"1ac77b9602a2a1bbd806ed95725947df930590c3aee035466046f1542c55c43d","translation":"તે અહેવાલ આપે છે કે શું PDF સંરચના ટેગો, દસ્તાવેજ શીર્ષક અને ભાષા, દરેક પાના પર પસંદ કરી શકાય તેવું લખાણ, વૈકલ્પિક લખાણ સાથેના આંકડા, અને હેડિંગ સ્તરોમાં શક્ય જમ્પને પ્રદર્શિત કરે છે. તે નક્કી કરી શકતું નથી કે શું વાંચન ક્રમ અથવા વૈકલ્પિક લખાણ અર્થપૂર્ણ છે."},"pdf-accessibility-checker.copy.messages.textLimit":{"context":"Shared UI copy.messages.textLimit","source_hash":"363f32b31faebd5142497605da732c462b7c5db79ac09b38665abb0afb7f9bb8","translation":"આ PDF એ 2,000,000 કરતાં વધારે લખાણ અક્ષરોને સમાવે છે; ઉપકરણ મેમરીનું રક્ષણ કરવા માટે ચકાસણી બંધ થઈ ગઈ."},"pdf-accessibility-checker.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"4148106cfea982c6ed20d0907e9169164c67c5815c2a0634692bc6af314fbb36","translation":"નહિં. પસંદ થયેલ PDF આ બ્રાઉઝર ટેબમાં ચકાસાયેલ છે. ફાઇલ અને તેનું લખાણ અપલોડ થયેલ નથી, આપમેળે સંગ્રહ થયેલ નથી, અથવા સર્વરમાં મોકલાયેલ નથી."},"pdf-accessibility-checker.copy.privacyQuestion":{"context":"Shared UI copy.privacyQuestion","source_hash":"3ace67f700b85407de2fdccb3c53746e4bd5045a6fc24d8c3434ea720f0b2a88","translation":"શું મારો PDF ચકાસણી માટે અપલોડ થયેલ છે?"}},"locale":"gu","missing":["pdf-accessibility-checker.copy.name","pdf-accessibility-checker.copy.title","pdf-accessibility-checker.copy.intro","pdf-accessibility-checker.copy.howQuestion","pdf-accessibility-checker.copy.fields.file","pdf-accessibility-checker.copy.fields.fileHint","pdf-accessibility-checker.copy.fields.title","pdf-accessibility-checker.copy.fields.language","pdf-accessibility-checker.copy.fields.tagged","pdf-accessibility-checker.copy.fields.text","pdf-accessibility-checker.copy.fields.figureAlt","pdf-accessibility-checker.copy.fields.headingSequence","pdf-accessibility-checker.copy.fields.signalPresent","pdf-accessibility-checker.copy.fields.signalMissing","pdf-accessibility-checker.copy.fields.pages","pdf-accessibility-checker.copy.fields.figures","pdf-accessibility-checker.copy.fields.figuresWithoutAlt","pdf-