te":{"context":"travel-itinerary-planner UI copy.fields.tripStartDate","source_hash":"6c0f6d250287a58051ed88d343ed575481f0ac2a88f78f88cd5dd5d21a5db80f","translation":"પહેલો દિવસ"},"travel-itinerary-planner.copy.intro":{"context":"Shared UI copy.intro","source_hash":"59e9ad0ccdce0f2a565bcfe9c94800de2ec0de50e5d2032665b91f1b3242b1cb","translation":"કાર્યક્રમો, ભોજન, પરિવહન અને જાતે બુકિંગ નોંધો સાથે દિવસ-દર-દિવસની યાત્રાની યોજના બનાવો. સમય વિરોધાભાસો ચકાસો, પછી કેલેન્ડર ફાઇલ નિકાસ કરો અથવા તમારી યાત્રા પ્રકાશિત કરો."},"travel-itinerary-planner.copy.messages.checkInputs":{"context":"Shared UI copy.messages.checkInputs","source_hash":"6ff8847244631961a615cde9eed82d7f815735e6002cecc11729e195e9e56b3d","translation":"દરેક જરૂરી માપન માટે શૂન્ય કરતાં વધુની સંખ્યા દાખલ કરો. વૈકલ્પિક કિંમતો પણ ચકાસો."},"travel-itinerary-planner.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"નકલ આ બ્રાઉઝરમાં ઉપલબ્ધ નથી."},"travel-itinerary-planner.copy.messages.exportFailed":{"context":"Shared UI copy.messages.exportFailed","source_hash":"2f35bb1ff9849f8c22e1c034ecb32c4bca47e646791a50f081b6ef7720e6420f","translation":"કેલેન્ડર ફાઇલ બનાવી શક્યા નહિં."},"travel-itinerary-planner.copy.messages.itemUpdated":{"context":"Shared UI copy.messages.itemUpdated","source_hash":"718d51daa5061b9aead76d0e2b56f3ee23711efcaf55ad39668bb44ecae6d85e","translation":"આ ટેબમાં સુધારવાનું બંધ કરો."},"travel-itinerary-planner.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"fa192999c37cf0a8707791cececdcdf7f466c9ab4077a1691c77930ac940dcb4","translation":"નહિં. આ માર્ગદર્શિકા તમારા બ્રાઉઝરમાં બનાવવામાં આવે છે અને પ્રવાસ સેવામાં અપલોડ થયેલ નથી. તે આ ટેબમાં રહે છે જ્યાં સુધી તમે સ્પષ્ટ રીતે આ બ્રાઉઝરમાં સંગ્રહને સક્રિય ન કરો અથવા બેકઅપ ડાઉનલોડ ન કરો. બ્રાઉઝર સંગ્રહ એનક્રિપ્ટ થયેલ નથી; વહેંચાયેલ ઉપકરણ પર નોંધોમાં સંવેદનશીલ વપરાશ કોડ્સને મૂકવાનું ટાળો."}},"locale":"g