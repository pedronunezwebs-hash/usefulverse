{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"freecell.copy.additionalFaqs.2.answer":{"context":"freecell UI copy.additionalFaqs.2.answer","source_hash":"93a0ab7c19edddb171b4acadbf64792fe55fc9cb19c14bce1622f0674ee5316b","translation":"હા. તે જ વૈકલ્પિક સીડ દાખલ કરો અને આ બ્રાઉઝરમાં તેના દેખાવને પુનઃસર્જિત કરવા માટે નવી ભાગીદારી પસંદ કરો. રેન્ડમ શફલ માટે સીડને ખાલી છોડી દો. કોઇ સીડ કે રમત સર્વરને મોકલવામાં આવતી નથી."},"freecell.copy.fields.diamonds":{"context":"freecell UI copy.fields.diamonds","source_hash":"dc95f33b5876b38e2f374e2ebe236862184323933b1d90d45876d1e158631353","translation":"ડાયમંડ્સ"},"freecell.copy.fields.foundationNote":{"context":"freecell UI copy.fields.foundationNote","source_hash":"7f102470fb2b3a776422d9f1bec02f08a653085daa146fa0f12bff1d6861a919","translation":"એક્કાથી રાજા સુધીની પાયાની રચના એક જ રંગની હોય છે. ફક્ત સ્તંભનું ઉપરનું પાનું અથવા ખાલી ખાનામાંનું પાનું જ ખસેડી શકાય છે."},"freecell.copy.fields.note":{"context":"freecell UI copy.fields.note","source_hash":"053129979949d9885f797a21f0ff8ffcd379b0162bdb6502e038df3208288cdc","translation":"ટેબલ્યુ પત્તાઓ વૈકલ્પિક રંગોમાં નીચે બાંધે છે. પસંદ થયેલ ચાલે પહેલાથી જ વૈકલ્પિક રંગો અને એક રેન્કથી નીચે જવુ જ જોઇએ. સુપરચાલ હાલના ખાલી મુક્ત ખાનાંઓ અને મદદગાર સ્તંભો દ્વારા મર્યાદિત છે."},"freecell.copy.messages.seedError":{"context":"Shared UI copy.messages.seedError","source_hash":"8bceeecc730bb98f7db7c596bad25ff234b5998f92e82db070e36462895797d4","translation":"1 થી 48 અક્ષરો સુધીનું પુનરાવર્તન સીડ વાપરો, અથવા તેને ખાલી છોડો."},"freecell.copy.messages.won":{"context":"Shared UI copy.messages.won","source_hash":"a955eff9b3f579890586770bb114726b1cf9b4f106721f4e604b929facfab468","translation":"બધા ચાર પાયા પૂરા થઈ ગયા. તમે જીત્યું!"}},"locale":"gu","missing":["freecell.copy.name","freecell.copy.title","freecell.copy.description","freecell.copy.category","freecell.copy.intro","freecell.copy.summary","freecell.copy.howQuestion","freecell.copy.howAnswer","freecell.copy.privacyQue