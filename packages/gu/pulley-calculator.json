{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"pulley-calculator.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"ઉદાહરણ લાવો"},"pulley-calculator.copy.actions.result":{"context":"Shared UI copy.actions.result","source_hash":"3d1add36b6ca4fbf2e6e625dea61450af61728982f7d5c0739622ab4355ab0b4","translation":"અંદાજિત પરિણામો"},"pulley-calculator.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"ત્રિકોણ"},"pulley-calculator.copy.fields.accuracyNote":{"context":"pulley-calculator UI copy.fields.accuracyNote","source_hash":"06aa6f128ac76f10a509b08b22f3b5c3b3a9f5e80dbbcc21f58dcc8d60c77e95","translation":"આદર્શ, ખુલ્લી બે-પૂલી બેલ્ટ માટે અંદાજિત પિટ લંબાઈ. બધા માપદંડો માટે એક જ એકમ વાપરો. ખરેખર બેલ્ટ લંબાઈ અને ઝડપ બેલ્ટ રૂપરેખા, પિટ, ટેન્શન, સ્લિપ, વપરાશ અને સહનશીલતા સાથે અલગ હોઈ શકે. આ ખરીદી શકાય તેવી બેલ્ટ પસંદ કરતું નથી અથવા પાવર, સુરક્ષા અથવા સલામતીનું મૂલ્યાંકન કરતું નથી. વપરાશ પહેલાં ઉત્પાદક માહિતી ચકાસો. સ્થાનિક રીતે ચલાવે છે; અપલોડ નથી."},"pulley-calculator.copy.fields.sketchDescription":{"context":"pulley-calculator UI copy.fields.sketchDescription","source_hash":"fc325ccd8e1a94c1d460fb7be8376f35361c88b9ae50d2082ee2d9c6f7220fb9","translation":"ડાબી બાજુએ ડ્રાઇવર અને જમણી બાજુએ ડ્રાઇવ થયેલ પુલી સાથે ખુલ્લી બેલ્ટ વડે જોડાયેલ બે પુલીનો આકૃતિ ચિત્ર."},"pulley-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"3d8d256e856780786107b2f635eee2d2957af2b37025b9885ebbc0b36584fb74","translation":"બે પુલી વચ્ચે સરળ ખુલ્લી બેલ્ટ માટે પીચ લંબાઈ અને ઝડપ સંબંધનો અંદાજ લગાવો. માપદંડો એ જ એકમમાં દાખલ કરો."},"pulley-calculator.copy.messages.beltSpeed":{"context":"Shared UI copy.messages.beltSpeed","source_hash":"5236d9c335e41d361c836c30e4f8d81d8255d240e47b7a3f8372ea25809e56a2","translation":"ડ્રાઇવર બેલ્ટ ઝડપ"},"pu