{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"heart-rate-zone-calculator.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"ઉદાહરણ લાવો"},"heart-rate-zone-calculator.copy.fields.boundaryNote":{"context":"heart-rate-zone-calculator UI copy.fields.boundaryNote","source_hash":"86ede906662ddfc3e08ddcc1c38c381d1a131c85fb4a915a3417b758cec3cf93","translation":"0 થી 100% સુધી છ કડક રીતે વધતા કટોકટીઓને સુયોજિત કરો. તેઓ પાંચ પડોશી ક્ષેત્રો બનાવે છે; મૂળભૂત સાથે શરૂ કરો અથવા તેમને વૈવિધ્યપૂર્ણ બનાવો."},"heart-rate-zone-calculator.copy.fields.safetyNote":{"context":"heart-rate-zone-calculator UI copy.fields.safetyNote","source_hash":"0751c9b0644817ec78a5140d0072c66a2025ae82cbbd97bc96178e2edd5c3c82","translation":"દવાઓ અને આરોગ્યની સ્થિતિઓ હૃદયના ધબકારાને બદલી શકે છે. જો તમારી પાસે હૃદયની સ્થિતિ હોય, હૃદયના ધબકારાને અસર કરતી દવાઓ લો, ગર્ભવતી છો, 18 ની નીચે છો, અથવા વ્યક્તિગત વ્યાયામ લક્ષ્યની જરૂર હોય, તો યોગ્ય આરોગ્ય વ્યવસાયિકને પૂછો. પ્રવૃત્તિ બંધ કરો અને સંબંધિત લક્ષણો માટે યોગ્ય મદદ શોધો. CDC વાતચીત ચકાસણી સંબંધિત પ્રયત્નનો નિર્ણય લેવાનો બીજો રસ્તો છે."},"heart-rate-zone-calculator.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"નકલ આ બ્રાઉઝરમાં ઉપલબ્ધ નથી."},"heart-rate-zone-calculator.copy.messages.maxSource":{"context":"Shared UI copy.messages.maxSource","source_hash":"e40baec0299b6efd7b86041182958f030fde9c801c5516be4aab8917c2e90d78","translation":"મહત્તમ હૃદય-દર સ્ત્રોત પસંદ કરો."},"heart-rate-zone-calculator.copy.messages.method":{"context":"Shared UI copy.messages.method","source_hash":"a0a412c51b2d35d3857efc8648584bc24459e5d5a0d24fa9b3f3595c6dddf0cc","translation":"ગણતરી પદ્ધતિ પસંદ કરો."},"heart-rate-zone-calculator.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"2a2982982f