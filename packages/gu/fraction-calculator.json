{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fraction-calculator.copy.examples.3.text":{"context":"fraction-calculator UI copy.examples.3.text","source_hash":"a2fa0d980efefb2cc0697adb017178844c47860e28c7db1cb652e3a0c8526e2a","translation":"1/2, 1/3 અને 1/6 ને 1 માં ઉમેરો. દરેક કિંમતને તેની પોતાની લીટી પર મૂકો."},"fraction-calculator.copy.faq.5.answer":{"context":"fraction-calculator UI copy.faq.5.answer","source_hash":"ca74f3556d49ec71bc2d3c375cf7e8046b53962bb8dc477c29946f8d2fb3f71c","translation":"અંતિમ કિંમતો ચોક્કસ હોઈ શકે છે. બીજા દશાંશને બાર સ્થાનો સુધી ગોઠવવામાં આવે છે અને ≈ સાથે ચિહ્નિત થયેલ છે. ભેદ ચોક્કસ રહે છે."},"fraction-calculator.copy.footer":{"context":"fraction-calculator UI copy.footer","source_hash":"cc6a568643e72d46318873863eaa7d8453c43c2bd226e53e97619f2e95091528","translation":"ઉપયોગી સાધનો. પરિણામો સાફ કરો. તમારા બ્રાઉઝર માટે બનાવેલ."},"fraction-calculator.copy.method.paragraphs.3":{"context":"fraction-calculator UI copy.method.paragraphs.3","source_hash":"c26f57418ecb2859de1caae12a63513629fc45b724bef2b93abe9b3bef024aec","translation":"મિશ્રિત સંખ્યાઓ ગણતરી કરતા પહેલા અયોગ્ય ભેગાંમાં રૂપાંતરિત થાય છે. અહીં, -2 1/3 નો અર્થ -(2 + 1/3) થાય છે, જે -7/3 છે. આ નિશાની સંપૂર્ણ મિશ્રિત કિંમત માટે લાગુ પડે છે. દશાંશ જેવું કે 0.125 ઘટાડો કરતા પહેલા 125/1000 બને છે."},"fraction-calculator.copy.navigation.onPageLabel":{"context":"fraction-calculator UI copy.navigation.onPageLabel","source_hash":"b5658fc8edda24f9c94eabac9e536e0a18e3055a8ca255f9d1b8f256ea02a6cc","translation":"આ પાના પર"},"fraction-calculator.copy.privacy.heading":{"context":"fraction-calculator UI copy.privacy.heading","source_hash":"bef0dc8aaebf768fa2be1fb224ac1a08ac3fa810c85991f3040785b5239b6229","translation":"ખાનગી ગણતરીઓ, મર્યાદાઓને સાફ કરો"},"fraction-calculator.copy.privacy.paragraphs.2":{"context":"fraction-calculator UI copy.privacy.paragraphs.2","source_hash":"8b3fd9a899a4f3c379c1bc5f5801391bfa6053d76d429ccef1de4f2589ffbb6f","translation":"મોટી ગણતરી ઉપકરણ સમય અને મેમરી પર આધાર રાખે છે. રદ કરો સક્રિય કાર્યને બંધ કરે છે. ભૂલ જૂના જવાબોને સાફ કરે છે અને તેમના ડાઉનલોડને નિષ્ક્રિય કરે છે."},"fraction-calculator.copy.ui.decimalNote":{"context":"fraction-calculator UI copy.ui.decimalNote","source_hash":"130afa47f1fb786eeebfdef705eb46297f9d4ab3d1e6d6a161954a9537c72251","translation":"દશાંશ કિંમતો 12 જગ્યાઓ સુધી ગોળ છે. ભેદ સાચો રહે છે."},"fraction-calculator.copy.ui.themeDark":{"context":"fraction-calculator UI copy.ui.themeDark","source_hash":"8abe9e0ba6b6f3834c2e48d2f858557641277e2c17463e526685fe3f95967843","translation":"ઘાટી થીમ પર જાવ"},"fraction-calculator.copy.ui.themeLight":{"context":"fraction-calculator UI copy.ui.themeLight","source_hash":"2f740f4cf6888e99dfe73f3d6208323cb350b33a37016e1ae3367a90b3e93c84","translation":"હળવી થીમ પર બદલો"},"fraction-calculator.copy.uses.paragraphs.2":{"context":"fraction-calculator UI copy.uses.paragraphs.2","source_hash":"372969b904ab08477549c6acddc9d6ad630258b6fcf7bae9ac44f752a1e70c9f","translation":"લાંબી યાદી અથવા વિશાળ વિભાજક વધારે મેમરી અને સમય લઈ શકે છે. વર્કર ગણતરી ઇન્ટરફેસથી દૂર રાખે છે, અને રદ કરો તેને બંધ કરે છે. ત્યાં કોઈ દિવસની કોટા અથવા ઇનપુટ લીટીઓની ચોક્કસ સંખ્યા નથી."}},"locale":"gu","missing":["fraction-calculator.copy.title","fraction-calculator.copy.description","fraction-calculator.copy.heading","fraction-calculator.copy.intro","fraction-calculator.copy.category","fraction-calculator.copy.eyebrow","fraction-calculator.copy.ui.copy","fraction-calculator.copy.ui.share","fraction-calculator.copy.ui.copied","fraction-calculator.copy.ui.copyFallback","fraction-calculator.copy.ui.reset","fraction-calculator.copy.ui.featuresLabel","fraction-calculator.copy.ui.shareNotice","fraction-calculator.copy.ui.trust.0","fraction-calculator.copy.ui.trust.1","fraction-calculator.copy.ui.trust.2","fraction-calculator.copy.ui.calculate","fraction-calculator.copy.ui.cancel","fraction-calculator.copy.ui.result","fraction-calculator.copy.ui.empty","fraction-calculator.copy.ui.working