{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"average-calculator.copy.examples.0.text":{"context":"average-calculator UI copy.examples.0.text","source_hash":"6f72b87d5cbdfc69b729cb59d3d22077cecfe81c9a7b8310af2a3992046c68cf","translation":"10, 12 e 14 hanno una somma di 36 e una media di 12; la loro mediana è anche 12."},"average-calculator.copy.examples.2.heading":{"context":"average-calculator UI copy.examples.2.heading","source_hash":"df4eda48937a8ab9a4c6b3160579a8cdde79ea5cfbd6b62f2cd23ce679d19998","translation":"Una finale che vale un quarto"},"average-calculator.copy.examples.2.text":{"context":"average-calculator UI copy.examples.2.text","source_hash":"fb0cc178840e87649590edec08b1f5b8cb80c7fe6763cd3af8a43a99bdfd7e19","translation":"Un grado corrente di 80, obiettivo 85 e peso finale 25% richiedono 100% sul finale."},"average-calculator.copy.eyebrow":{"context":"average-calculator UI copy.eyebrow","source_hash":"8b7fcde409e3e571a1f83b6be9472f12756dee103f504e59003058eedac24aad","translation":"Un utile riepilogo, con i dettagli ancora visibili."},"average-calculator.copy.faq.1.question":{"context":"average-calculator UI copy.faq.1.question","source_hash":"50ca6465a7c203d6bd53b7af95d984f502cdb458fb6d473c55d3ab99d6e847a1","translation":"Lo zero conta nella media?"},"average-calculator.copy.faq.2.question":{"context":"average-calculator UI copy.faq.2.question","source_hash":"a45167c6857e962255434e7c079a5067e0fbce004b9358996260480a69f6485d","translation":"Come funziona la mediana?"},"average-calculator.copy.faq.6.answer":{"context":"average-calculator UI copy.faq.6.answer","source_hash":"03c3a2b8a27e8777e88ef6379cd96fe53f45b49b90b6ad680bdfd3b37c6e1cfe","translation":"Il tuo voto attuale copre tutto il lavoro prima della prova finale e il suo peso finale è una percentuale del voto totale."},"average-calculator.copy.how.steps.2.text":{"context":"average-calculator UI copy.how.steps.2.text","source_hash":"3a4e5db8bce160e75d393890aca8e8834ae802ce24b070d3973abd89daa1b3b3","translation":"Calcolare, ispezionare il lavoro e salvare il risultato se necessario. Annulla interrompe un lungo lavoro."},"average-calculator.copy.method.paragraphs.4":{"context":"average-calculator UI copy.method.paragraphs.4","source_hash":"e56bede094fe34ce1a9b66564f543f0582e6afdfae64fca828e3eac09fbeab32","translation":"Il voto finale richiesto presuppone che il voto corrente copra tutti i lavori prima del finale. La formula è (obiettivo × 100 - corrente × (100 - peso finale)) / peso finale.I voti attuali e obiettivo vanno da zero a cento e il peso finale è positivo."},"average-calculator.copy.privacy.heading":{"context":"average-calculator UI copy.privacy.heading","source_hash":"bef0dc8aaebf768fa2be1fb224ac1a08ac3fa810c85991f3040785b5239b6229","translation":"Calcoli privati, limiti chiari"},"average-calculator.copy.privacy.paragraphs.2":{"context":"average-calculator UI copy.privacy.paragraphs.2","source_hash":"8b3fd9a899a4f3c379c1bc5f5801391bfa6053d76d429ccef1de4f2589ffbb6f","translation":"I calcoli di grandi dimensioni dipendono dal tempo e dalla memoria del dispositivo. Annulla interrompe il lavoro attivo.Un errore cancella le vecchie risposte e ne disabilita il download."},"average-calculator.copy.relatedHeading":{"context":"average-calculator UI copy.relatedHeading","source_hash":"3af73a31ab098fe0db206c522f27cc8b9cd49ef9f0227a8b1e4b20d7611ea7ed","translation":"Un utile prossimo calcolo"},"average-calculator.copy.ui.cancelled":{"context":"average-calculator UI copy.ui.cancelled","source_hash":"cbc7e63195c8c729eb51e1604d71b9a5e25fa25e519cbe3319c9563fe20ffb48","translation":"Interrotto. Modificare l'input o calcolare di nuovo."},"average-calculator.copy.ui.copyFallback":{"context":"average-calculator UI copy.ui.copyFallback","source_hash":"476d9fdc2a1b77869df1f8646d6a4c7f3d2cfce2de2741d20c06324136310e10","translation":"Seleziona e copia il testo sottostante."},"average-calculator.copy.ui.errors.NOT_ENOUGH":{"context":"average-calc