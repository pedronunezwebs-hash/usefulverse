{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"dominoes-game.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"2530c04512b78dcc9559de75b55ced6386ea960bc8ba9872f52bdd9f92ecae09","translation":"Prova un esempio"},"dominoes-game.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"Triangolo."},"dominoes-game.copy.additionalFaqs.0.answer":{"context":"dominoes-game UI copy.additionalFaqs.0.answer","source_hash":"1ab8b250495eb0369a143453cc57431d0305c3e8cebcc52d52730028916647a5","translation":"Nel domino a sorteggio, un giocatore che non ha nessuna pedina legale pesca dal mazzo fino a quando non può giocare o il mazzo si esaurisce. Nel domino a blocchi, invece, quel giocatore passa."},"dominoes-game.copy.howAnswer":{"context":"dominoes-game UI copy.howAnswer","source_hash":"503d37a4f04108ef5df451bfef0e607d4100574507692324173c011fa2628f65","translation":"Ogni giocatore riceve sette tessere. Si apre il doppio più alto in entrambe le mani; se nessuna delle mani ha un doppio, si apre la tessera di valore più alto. Abbina un'estremità di una tessera a un'estremità aperta della linea. In modalità disegno, prendi tessere dallo stock fino a quando non puoi giocare o è vuoto. In modalità blocco, passa quando non puoi giocare. Il round finisce quando una mano è vuota o nessun giocatore può muoversi; il giocatore con meno punti rimanenti vince un round bloccato."},"dominoes-game.copy.messages.noMoves":{"context":"Shared UI copy.messages.noMoves","source_hash":"0eda9c8dac3c38b8495171fd22335a516ad302ed2ec2abccbedaae1becec7bd9","translation":"Nessuna mossa legale. Pescare una tessera o passare."}},"locale":"it","missing":["dominoes-game.copy.name","dominoes-game.copy.title","dominoes-game.copy.description","dominoes-game.copy.intro","dominoes-game.copy.howQuestion","dominoes-game.copy.privacyQuestion","dominoes-game.cop