{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"prime-number-checker.copy.faq.4.answer":{"context":"prime-number-checker UI copy.faq.4.answer","source_hash":"2060b5fec47354fe3af9324af7dc9e353fc0c7e1e6153286fe9929add944c539","translation":"Un numero pari o superiore a 2^64 ha superato i turni di base casuale di 32: è una prova forte, ma non è un certificato di primalità."},"prime-number-checker.copy.labels.examples":{"context":"prime-number-checker UI copy.labels.examples","source_hash":"38a8c28c47b65bc9325ba45486b759c726d614e9fc2509eae8fbd0fdf234681b","translation":"Un piccolo vantaggio di partenza"},"prime-number-checker.copy.method.paragraphs.3":{"context":"prime-number-checker UI copy.method.paragraphs.3","source_hash":"77594d2370f3a7b134edc67250b7ec7afdef11179082f7d0862cf8fde85c0ded","translation":"Per i numeri inferiori a 2^64, sette basi documentate danno un risultato deterministico di primalità, il limite superiore è 18,446,744,073,709,551,616, escluso. Il calcolo utilizza BigInt in tutto, quindi gli interi sopra il solito intervallo di numeri sicuri non perdono le loro cifre finali."},"prime-number-checker.copy.related.0.text":{"context":"prime-number-checker UI copy.related.0.text","source_hash":"aa0f8d70fb18658326b95c0379d69eef5c9f9e62f381e2c0bc97ee6de5606b1a","translation":"Continua con l'aritmetica sul numero che hai controllato."},"prime-number-checker.copy.ui.answers.neither":{"context":"prime-number-checker UI copy.ui.answers.neither","source_hash":"f3f34d8a9f8835e92b5dbfc3c5db82dd39ca3b9b72d81a30847216a75dcead5b","translation":"Né primo né composito"},"prime-number-checker.copy.ui.cancel":{"context":"prime-number-checker UI copy.ui.cancel","source_hash":"19766ed6ccb2f4a32778eed80d1928d2c87a18d7c275ccb163ec6709d3eb2e27","translation":"Annulla"},"prime-number-checker.copy.ui.themeDark":{"context":"prime-number-checker UI copy.ui.themeDark","source_hash":"8abe9e0ba6b6f3834c2e48d2f858557641277e2c17463e526685fe3f95967843","transl