{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-employer-cost-calculator.copy.details":{"context":"norway-employer-cost-calculator UI copy.details","source_hash":"8b288037e5ace5a06c2ac3508b1fb5530ef3639d3532d57a8cec85bb4567058f","translation":"Il calcolatore utilizza l'aliquota di zona 2026 pubblicata per attività ordinaria o agricoltura/pesca. Aggiunge alla base contributiva l'indennità di ferie, l'indennità imponibile e l'eventuale contributo pensionistico. Per l'attività ordinaria nella zona Ia, l'indennità differenziale 850,000 NOK per impresa viene applicata all'importo inserito come già utilizzato quest'anno. I risultati sono stime di pianificazione annuale; la sede registrata e l'attività del datore di lavoro determinano le regole applicabili."},"norway-employer-cost-calculator.copy.example":{"context":"norway-employer-cost-calculator UI copy.example","source_hash":"f30c769371f3acb43827634a4b139057c36d7da182d30717c996a403dd1b0030","translation":"Inserisci la busta paga annuale totale, scegli la zona contributiva registrata del datore di lavoro e il tipo di attività, quindi aggiungi il pagamento delle ferie, la pensione e altre retribuzioni. Ad esempio, 1,000,000 NOK di base contributiva nella zona I dà 141,000 NOK di contributo del datore di lavoro a 14.1%."},"norway-employer-cost-calculator.copy.faq.2.q":{"context":"norway-employer-cost-calculator UI copy.faq.2.q","source_hash":"17ac876c77c1040d0305951bc9be382b110962584f5b57a1ae83d373133a97e6","translation":"Il contributo pensionistico 2% è obbligatorio per ogni datore di lavoro?"},"norway-employer-cost-calculator.copy.faq.3.a":{"context":"norway-employer-cost-calculator UI copy.faq.3.a","source_hash":"cc7d5e9ffcc6fb913633a6319fc4e13af00a4531ac7d7bc89f73cdaef48157c5","translation":"Il tasso di retribuzione e la base per le ferie, la retribuzione pensionabile e altri costi sono ipotesi modificabili. Assicurazione, amministrazione della retribuzione, benefici speciali, esenzioni e limiti individuali dei dipendenti non sono completamente modellati."},"norway-employer-cost-calculator.copy.fields.monthlyResult":{"context":"norway-employer-cost-calculator UI copy.fields.monthlyResult","source_hash":"91ba1c9503740ddb2e145b3361b33ee70f542e11f384799377e6eb021f2ff256","translation":"Costo medio mensile"},"norway-employer-cost-calculator.copy.fields.payrollResult":{"context":"norway-employer-cost-calculator UI copy.fields.payrollResult","source_hash":"f41ea7c265508fc3330acc8209e2090af4c936dfb29949926f97ac92acd90610","translation":"Busta paga lorda"},"norway-employer-cost-calculator.copy.fields.zone":{"context":"norway-employer-cost-calculator UI copy.fields.zone","source_hash":"151e4b21ab565baa7a2fd64cbee08232d23ef35362bb570c44ecf3823e54d1ef","translation":"Zona di contributo del datore di lavoro"},"norway-employer-cost-calculator.copy.fields.zoneIVa":{"context":"norway-employer-cost-calculator UI copy.fields.zoneIVa","source_hash":"371bc2246cf8d2bb68e6eedfba7196e215d3434a81b06d0124935709c4ea0dd5","translation":"Zona IVa — 7.9% ordinario / 5.1% agricoltura e pesca"},"norway-employer-cost-calculator.copy.fields.zoneV":{"context":"norway-employer-cost-calculator UI copy.fields.zoneV","source_hash":"35a0778780f31cb3ea4738061fccb7ba550935635fc4e9beee9344022dad826a","translation":"Zona V — 0%"},"norway-employer-cost-calculator.copy.related":{"context":"norway-employer-cost-calculator UI copy.related","source_hash":"3da6e153ee8cea08506a33e168e7b5e25fbdf546dcd75c3aeb3fa4345774f329","translation":"Strumenti correlati"}},"locale":"it","missing":["norway-employer-cost-calculator.copy.name","norway-employer-cost-calculator.copy.title","norway-employer-cost-calculator.copy.description","norway-employer-cost-calculator.copy.intro","norway-employer-cost-calculator.copy.exampleHeading","norway-employer-cost-calculator.copy.howItWorks","norway-employer-cost-calculator.copy.faqHeading","norway-employer-cost-calculator.copy.faq.0.q","norway-employer-cost-calculato