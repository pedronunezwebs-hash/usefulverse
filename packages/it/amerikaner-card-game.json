{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"amerikaner-card-game.copy.description":{"context":"amerikaner-card-game UI copy.description","source_hash":"f289654300bb839c6d0748a232434fbac6059fe05b747c556c813a7f68d2d405","translation":"Gioca al gioco di carte Norwegian Amerikaner in locale con da tre a sei giocatori, fai offerte per le prese, scegli il tuo trionfo, trova il tuo partner e tieni traccia del punteggio su questo dispositivo."},"amerikaner-card-game.copy.fields.allPassed":{"context":"amerikaner-card-game UI copy.fields.allPassed","source_hash":"a8f9bb7e6e3ea22f975b293ec67010001be8b55805757850b6373b083bd79113","translation":"Tutti passano. La mano viene ridistribuita e il dealer si sposta a sinistra."},"amerikaner-card-game.copy.fields.deleted":{"context":"amerikaner-card-game UI copy.fields.deleted","source_hash":"1f9bc6adddbd1af200d7e3b66d3aaf6fea0a7c77681fa3ece722b90b62c6479a","translation":"Gioco salvato eliminato."},"amerikaner-card-game.copy.fields.leadTitle":{"context":"amerikaner-card-game UI copy.fields.leadTitle","source_hash":"9a0dd3f2faba93b140d2a40e865db951519614bc945bcaa06c91a72a58595c90","translation":"Impostare il trionfo e chiedere al tuo partner"},"amerikaner-card-game.copy.fields.noCards":{"context":"amerikaner-card-game UI copy.fields.noCards","source_hash":"61e77b414b9d0010981c1fe9f185258c5ad7d1ed027f4cf94b686f81f0613cdc","translation":"Nessuna carta è stata ancora giocata."},"amerikaner-card-game.copy.fields.noSave":{"context":"amerikaner-card-game UI copy.fields.noSave","source_hash":"2737af063d040db83bfb9452dae26f2b6a487a984b54671ddcf89a358755bc60","translation":"Non ci sono giochi salvati su questo dispositivo."},"amerikaner-card-game.copy.fields.passedYou":{"context":"amerikaner-card-game UI copy.fields.passedYou","source_hash":"fb15087c7830089188d8c6390fd413bf590877c04e2ff747932964fc8de78989","translation":"Hai superato."},"amerikaner-card-game.copy.fields.playPanel":{"context":"amerikaner-card-game UI copy.fields.playPanel","source_hash":"63750140fffbb192ac2dd063e5677967226e2434ecb22aa040f5a91c731f1702","translation":"Gioca una carta"},"amerikaner-card-game.copy.fields.resumed":{"context":"amerikaner-card-game UI copy.fields.resumed","source_hash":"e69dcaf2473fa0ccdd755549ceb5d77aed29a42e2de5b2a1554f1821ccef1312","translation":"Gioco salvato ripreso."},"amerikaner-card-game.copy.fields.started":{"context":"amerikaner-card-game UI copy.fields.started","source_hash":"342e2aad1bc3c04b76f8dfbec648a907570189b773679eee6ac3f78f9de76e73","translation":"Il giocatore a sinistra del mazziere fa per primo l'offerta."},"amerikaner-card-game.copy.fields.summary":{"context":"amerikaner-card-game UI copy.fields.summary","source_hash":"664d651c70685d8a9ceee9910c6ea5b9af9a2a68c57654572c69d1f1c94bfe1d","translation":"Un mazzo di carte standard 52, senza jolly. Distribuisci in modo equo per i giocatori 3–6 mettendo da parte abbastanza due. Un'offerta regolare inizia a metà mano arrotondata e deve superare l'offerta precedente. Chiama Amerikaner per prendere tutte le prese da solo. In un'offerta regolare, guida per impostare il trionfo e richiedere una carta partner. Segui il seme quando possibile. La squadra vince o perde l'offerta; gli altri giocatori ottengono il loro conteggio delle prese. Il punteggio più alto vince quando un punteggio raggiunge 52."},"amerikaner-card-game.copy.fields.table":{"context":"amerikaner-card-game UI copy.fields.table","source_hash":"43ddeb606a8eeb2c5a7c777efd291b76377cf1ec1371d4cb03fc944e744197fc","translation":"Trick corrente"},"amerikaner-card-game.copy.howItWorks":{"context":"amerikaner-card-game UI copy.howItWorks","source_hash":"13a6b22428cd17c402c4a0361b645ee0894bada3ee921a3faa3eb3f2dd110e0c","translation":"Come giocare"},"amerikaner-card-game.copy.limitsHeading":{"context":"amerikaner-card-game UI copy.limitsHeading","source_hash":"926339d39ba2e00f153580c146d2bd10a422f42555e686773349380ba6e3672c","translation":"Regole e limitazioni"}},"locale