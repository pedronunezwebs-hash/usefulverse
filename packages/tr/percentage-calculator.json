{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"percentage-calculator.copy.examples.1.text":{"context":"percentage-calculator UI copy.examples.1.text","source_hash":"ac07325702a2fe93cc3d030d68480c1913ec192973f5efde29298c2be92bb65b","translation":"Artış 20, orijinal 80'ye göre, yani 25% değişikliği."},"percentage-calculator.copy.examples.2.text":{"context":"percentage-calculator UI copy.examples.2.text","source_hash":"0663c652695ab0c09f08d5d21f476a6d3464cd761fa52e470e9601f178c3d0af","translation":"80 ve 120, referans olarak 100'nin ortalamasını kullanarak 40%'nin yüzde farkına sahiptir."},"percentage-calculator.copy.faq.0.answer":{"context":"percentage-calculator UI copy.faq.0.answer","source_hash":"8a055e5310f75e4ec73ad05c40cc7be8c940801d4837c3dc2c7089c0ba9ff44d","translation":"Bir değerin yüzdesini seçin. İlk olarak yüzdeyi ve ikinci olarak temel miktarı girin. Örneğin, 15% of 200 is 30."},"percentage-calculator.copy.faq.3.question":{"context":"percentage-calculator UI copy.faq.3.question","source_hash":"148f00fe12d06e4c6e28be7c37e7bc46183687c900d7c47b4e8ceba381c3fd82","translation":"Değişim ve farklılık nasıl farklılık gösterir?"},"percentage-calculator.copy.faq.6.answer":{"context":"percentage-calculator UI copy.faq.6.answer","source_hash":"58f941eedb0094ac6b3deea6ecf3b5f967ff0aa3d43a3e61e65090709c5da7ba","translation":"Hayır. 100'nin üzerindeki yüzde geçerlidir. 100'nin üzerindeki bir azalma negatif bir sonuç verebilir, bu yüzden bağlamı dikkatlice yorumlayın."},"percentage-calculator.copy.form.modeLabels.decrease.b":{"context":"percentage-calculator UI copy.form.modeLabels.decrease.b","source_hash":"bb30a38c014844609fe2151caa34b4f9a2afbd99cab277340bf3707fc616c80b","translation":"Yüzde azalma"},"percentage-calculator.copy.form.modeLabels.share.a":{"context":"percentage-calculator UI copy.form.modeLabels.share.a","source_hash":"8570a2e1669ff057c9f9f64098c35346c82a82b5492982c6a347a36b1eb39f65","translation":"Parça"},"percentage-calculator