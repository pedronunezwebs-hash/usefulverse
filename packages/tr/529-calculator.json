{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"529-calculator.copy.additionalFaqs.0.answer":{"context":"529-calculator UI copy.additionalFaqs.0.answer","source_hash":"40fc91090b2e5589ab4abc92bc847a8529bd6531b9539d1abbc526cc3b8a86ed","translation":"Hayır. Planlamak istediğiniz yıllık maliyeti giriniz; tahmin bu miktarı sadece ders ücreti gibi bir maliyet olarak kapsar. Eğer bunları dahil etmek istiyorsanız oda, yiyecek, kitaplar veya ücretleri girdiğiniz yere kendi elinizle ekleyin."},"529-calculator.copy.fields.accuracyNote":{"context":"529-calculator UI copy.fields.accuracyNote","source_hash":"854a66520d4cd87bfeac26c831c959ab676fc020bbded96071ab88fbead1e486","translation":"Sadece tahmin. Ay sonu mevduatlarını, hem üniversite öncesi hem de üniversite sırasında ücret/vergilerden önce sabit bir etkin yıllık geri dönüşü, her eğitim yılının başında ödenen ders ücretini, ders ücreti enflasyonunu ve yıllık sabit bir bursu varsayar. Oda, yemek, kitaplar, ücretler, vergiler ve hesap kurallarını dışarıda bırakır. Geri dönüşler ve maliyetler değişebilir. Yatırım, vergi veya finansal tavsiye değil. Mevcut plan kuralları ve uygun giderleri kontrol edin."},"529-calculator.copy.messages.bandwidth":{"context":"Shared UI copy.messages.bandwidth","source_hash":"bd34d03a3ad4ad2da3827cc9efa7625ffaf69dfdacdf81f7649e9d78d14374bb","translation":"Yaklaşık bant genişliği"},"529-calculator.copy.messages.beltSpeed":{"context":"Shared UI copy.messages.beltSpeed","source_hash":"5236d9c335e41d361c836c30e4f8d81d8255d240e47b7a3f8372ea25809e56a2","translation":"Sürücü kemeri hızı"},"529-calculator.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"Bu tarayıcıda kopyalama mevcut değil."},"529-calculator.copy.messages.depth":{"context":"Shared UI copy.messages.depth","source_hash":"f1dbc33978a95b952b19bfc0da8f928e8e3958930810988de2f6e4bd8b27ce01