{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"nine-mens-morris.copy.details":{"context":"nine-mens-morris UI copy.details","source_hash":"94bcf79f949c5c356bee432117345f05fed6ef0d578c713237ea702c39b10360","translation":"Her oyuncu sırayla dokuz taş koyar. Taşları koyduktan sonra, bir taş işaretli bir çizgi boyunca komşu boş bir yere taşın. Eğer tam olarak üç taşınız varsa, bu versiyonda herhangi bir boş yere uçmanıza izin verilir. Bir değirmen oluşturarak rakip taşlardan birini kaldırırsınız. Rakip taşları iki taşa indirerek ya da onları yasal bir hareket yapmadan bırakarak kazanırsınız. Tekrarlanan bir pozisyon ya da 200 tur limiti beraberliğe yol açar."},"nine-mens-morris.copy.exampleHeading":{"context":"nine-mens-morris UI copy.exampleHeading","source_hash":"33a470364b4384470b75377d202082c1b4c94492c00e07699b943fd43df0571f","translation":"Değirmen nasıl çalışır?"},"nine-mens-morris.copy.fields.computer":{"context":"nine-mens-morris UI copy.fields.computer","source_hash":"76ed42d22129dc354362704eb4b54208041b68736f976932aada43bc0035f7c0","translation":"Bilgisayar"},"nine-mens-morris.copy.fields.deleted":{"context":"nine-mens-morris UI copy.fields.deleted","source_hash":"1f9bc6adddbd1af200d7e3b66d3aaf6fea0a7c77681fa3ece722b90b62c6479a","translation":"Kaydedilen oyun silindi."},"nine-mens-morris.copy.fields.invalidCapture":{"context":"nine-mens-morris UI copy.fields.invalidCapture","source_hash":"378d7a55b9b7049eecae8d493671ede035029dc26f9d44902dbbf6bc4703bea1","translation":"Bu parça korunmamış bir parça kaldığı sürece kaldırılamaz."},"nine-mens-morris.copy.fields.newGame":{"context":"nine-mens-morris UI copy.fields.newGame","source_hash":"946ed70539f05d2d96a21e223038245dabc5e099d565b32ce65941adc8cc239c","translation":"Yeni oyun"},"nine-mens-morris.copy.fields.sourceTitle":{"context":"nine-mens-morris UI copy.fields.sourceTitle","source_hash":"425ad95e9e8790c664b3570babf398d10ba754962901a89ad8cddc5efbdff4e4","translation":"Dokuz Erkeğin Mo