{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"skat-card-game.copy.details":{"context":"skat-card-game UI copy.details","source_hash":"7850c2586a2737a7960b5257390f795f390b02bd0fc491fcc9a26eb426d3fdea","translation":"Um acordo usa cartas 32: sete, oito, nove, Jack, Queen, King, dez e Ás em cada naipe. Cada jogador recebe dez cartas e duas formam o Skat. Ofereça por sua vez; o maior licitante escolhe ouros, copas, espadas, paus, Grand ou Null. Com um jogo de coleta, pegue o Skat e devolva duas cartas; com Hand, deixe-o sem ser visto. Os jogadores devem seguir o naipe ou trunfo conduzido quando possível. Jogos de naipe e Grand precisam de olhos 61; em Null, o declarante não deve tomar nenhuma vaza."},"skat-card-game.copy.faq.1.q":{"context":"skat-card-game UI copy.faq.1.q","source_hash":"f26101756ed1e94acbd3a1876e32426a575ad15c0e8128c5fcd7aaf06afbf251","translation":"O que é o Skat?"},"skat-card-game.copy.faq.7.q":{"context":"skat-card-game UI copy.faq.7.q","source_hash":"82b38ac20be7aca069020424c4451ccc63fcc1b2d77876b849d18c97e5b6711b","translation":"A CPU é de nível especialista?"},"skat-card-game.copy.fields.clubs":{"context":"skat-card-game UI copy.fields.clubs","source_hash":"98348a90362db8bb804d8e25334657b7a01f17c44f210ed87ec99845d54a9b81","translation":"Clubes"},"skat-card-game.copy.fields.defenders":{"context":"skat-card-game UI copy.fields.defenders","source_hash":"5699df5a4b501628829c1b51becb44ba3b637442a0585555c4475662dbede112","translation":"Defensores"},"skat-card-game.copy.fields.hearts":{"context":"skat-card-game UI copy.fields.hearts","source_hash":"a061d6997cde3cf8676d5eb64034563db5933c19a127184117db6d0b73b8058c","translation":"Corações"},"skat-card-game.copy.fields.invalid":{"context":"skat-card-game UI copy.fields.invalid","source_hash":"9253246254ee7cd354e1aee272dec9d6c8609cfb26dbd484e7f8f040104eaeb9","translation":"Essa ação não é legal. Verifique as regras e sua seleção."},"skat-card-game.copy.fields.nextDeal":{"context