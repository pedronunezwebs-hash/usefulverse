{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"time-duration-calculator.copy.description":{"context":"time-duration-calculator UI copy.description","source_hash":"5a396a86f1d578e4a85234fc049e0bab280da3cb882da483e3bb2ac0413ef475","translation":"Encontre horas, minutos e segundos entre horas ou datas.Lide com períodos noturnos, pausas, fusos horários e mudanças de relógio.Cálculos gratuitos no seu navegador."},"time-duration-calculator.copy.examples.2.text":{"context":"time-duration-calculator UI copy.examples.2.text","source_hash":"3be9367ab59bbaf25b7c5e5cc1e2d49086665edeeb656841752a696205fdde4e","translation":"Em Nova Iorque em março 10, 2024, meia-noite para 04:00 é 3 horas decorridos.O relógio pula uma hora."},"time-duration-calculator.copy.faq.4.question":{"context":"time-duration-calculator UI copy.faq.4.question","source_hash":"4c5124e6f8b4e752b638795149664f4799736c3e34cc6dc4f2e8decf115e09b2","translation":"O horário de verão altera a duração?"},"time-duration-calculator.copy.faq.6.question":{"context":"time-duration-calculator UI copy.faq.6.question","source_hash":"4cea8250c6e5649ca732a3fff3f56092de03643e5ef68f937a23e6715b878860","translation":"O que significa primeira ou segunda ocorrência?"},"time-duration-calculator.copy.faq.7.answer":{"context":"time-duration-calculator UI copy.faq.7.answer","source_hash":"a4b1581f715a50cc6bdd156debb8d8de40cba08baaddc403a7e2adf64f6669f7","translation":"Em Datas e horas, escolha cada zona separadamente. Cada hora local é convertida em seu próprio instante UTC antes da subtração.O resultado lista os deslocamentos e os horários UTC usados."},"time-duration-calculator.copy.faq.8.question":{"context":"time-duration-calculator UI copy.faq.8.question","source_hash":"a468b2c227af29c92d1a64d455e5ed9b841baa585f5b812805106f45dbeb936e","translation":"Como funcionam as horas decimais?"},"time-duration-calculator.copy.how.steps.1.heading":{"context":"time-duration-calculator UI copy.how.steps.1.heading","sourc