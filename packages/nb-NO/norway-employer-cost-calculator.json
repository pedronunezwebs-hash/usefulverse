{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-employer-cost-calculator.copy.details":{"context":"norway-employer-cost-calculator UI copy.details","source_hash":"8b288037e5ace5a06c2ac3508b1fb5530ef3639d3532d57a8cec85bb4567058f","translation":"Kalkulatoren bruker den publiserte sonesatsen 2026 for ordinær virksomhet eller jordbruk/fiske. Den legger til oppgitt feriepenger, skattepliktig kompensasjon og eventuelt pensjonsbidrag i avgiftsgrunnlaget. For ordinær virksomhet i sone Ia legges 850,000 kroner per virksomhet til det oppgitte beløpet som allerede er brukt i år. Resultatene er årlige planleggingsestimater, arbeidsgiverens registrerte sted og virksomhet avgjør hvilke regler som gjelder."},"norway-employer-cost-calculator.copy.faq.0.q":{"context":"norway-employer-cost-calculator UI copy.faq.0.q","source_hash":"21f4f579c617abfd5515c376b7f7b70971a1066f6fbc6a9f5607ec00c8e0ee7b","translation":"Beregner dette en ansatts take-home lønn?"},"norway-employer-cost-calculator.copy.faq.2.q":{"context":"norway-employer-cost-calculator UI copy.faq.2.q","source_hash":"17ac876c77c1040d0305951bc9be382b110962584f5b57a1ae83d373133a97e6","translation":"Er 2%-pensjonsbidrag obligatorisk for alle arbeidsgivere?"},"norway-employer-cost-calculator.copy.faq.3.a":{"context":"norway-employer-cost-calculator UI copy.faq.3.a","source_hash":"cc7d5e9ffcc6fb913633a6319fc4e13af00a4531ac7d7bc89f73cdaef48157c5","translation":"Nei, feriepengesats og -grunnlag, pensjonsberettiget lønn og andre kostnader er redigerbare forutsetninger. Forsikring, lønnsadministrasjon, spesielle ytelser, unntak og individuelle medarbeidergrenser er ikke fullt ut modellert."},"norway-employer-cost-calculator.copy.faqHeading":{"context":"norway-employer-cost-calculator UI copy.faqHeading","source_hash":"e956a9404b467e6b372e082d28cb9d4710af764c2fa5e56a415211e12166be0e","translation":"Ofte stilte spørsmål"},"norway-employer-cost-calculator.copy.fields.allowanceRemaining":{"context":"norwa