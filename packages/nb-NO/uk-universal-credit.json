{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"uk-universal-credit.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"Last inn eksempel"},"uk-universal-credit.copy.actions.start":{"context":"Shared UI copy.actions.start","source_hash":"e4bb9f1ece9af9264a3b9e3913bbdb2cf497457167b14ced5f85688bfde74644","translation":"Start@ title: group"},"uk-universal-credit.copy.additionalFaqs.1.answer":{"context":"uk-universal-credit UI copy.additionalFaqs.1.answer","source_hash":"4a5506124846288e6347287158891c1e308abc590a854560b4a430683b0dab07","translation":"Dette illustrerer kun inntjeningstappen og sjekker ikke kvalifiseringen eller beregner en full Universal Credit-tildeling. Den antar maksimal tildeling før inntjeningen allerede er kjent. 55%-tappen gjelder over den valgte arbeidsgodtgjørelsen: £427 med boligstøtte, £710 uten boligstøtte eller £0 hvis ingen arbeidsgodtgjørelse gjelder. Spesielle tilfeller og andre fradrag er ekskludert. Reglene er for 2026–27 og må gjennomgås før 6 april 2027."},"uk-universal-credit.copy.howAnswer":{"context":"uk-universal-credit UI copy.howAnswer","source_hash":"0e44e8eafd8cc8a7031bef858c5dde7f31083eb9d8dcfb0bf1754a429c6361b1","translation":"Skriv inn det maksimale månedlige Universal Credit-beløpet før inntjening, rapportert netto månedlig inntjening og eventuell gjeldende arbeidsgodtgjørelse."},"uk-universal-credit.copy.messages.fileError":{"context":"Shared UI copy.messages.fileError","source_hash":"da2bff338747a6e8148ba09e05ba32d0100aac1572969f54081341e9c075d3c3","translation":"Bildet kunne ikke leses."}},"locale":"nb-NO","missing":["uk-universal-credit.copy.intro","uk-universal-credit.copy.howQuestion","uk-universal-credit.copy.privacyQuestion","uk-universal-credit.copy.privacyAnswer","uk-universal-credit.copy.actions.run","uk-universal-credit.copy.actions.reset","uk-universal-credit.copy.actions.cop