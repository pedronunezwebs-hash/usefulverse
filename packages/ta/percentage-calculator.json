{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"percentage-calculator.copy.examples.1.text":{"context":"percentage-calculator UI copy.examples.1.text","source_hash":"ac07325702a2fe93cc3d030d68480c1913ec192973f5efde29298c2be92bb65b","translation":"இந்த அதிகரிப்பு 20 ஆகும். முந்தைய 80 க்கு ஒப்பிடும்போது, அது ஒரு 25% மாற்றம்."},"percentage-calculator.copy.faq.0.answer":{"context":"percentage-calculator UI copy.faq.0.answer","source_hash":"8a055e5310f75e4ec73ad05c40cc7be8c940801d4837c3dc2c7089c0ba9ff44d","translation":"ஒரு மதிப்பின் சதவிகிதத்தை தேர்ந்தெடுக்கவும். முதல் சதவிகிதத்தை உள்ளிடவும் இரண்டாவது அடிப்படை அளவு. உதாரணமாக, 15% of 200 is 30."},"percentage-calculator.copy.faq.3.question":{"context":"percentage-calculator UI copy.faq.3.question","source_hash":"148f00fe12d06e4c6e28be7c37e7bc46183687c900d7c47b4e8ceba381c3fd82","translation":"மாற்றம் மற்றும் வேறுபாடு எப்படி வேறுபடுகின்றன?"},"percentage-calculator.copy.faq.8.question":{"context":"percentage-calculator UI copy.faq.8.question","source_hash":"40aa3e397dcf26fa50e463e8199d7f4e1ba2660cb6640f36588664edf6f7700f","translation":"ஏன் சில நேரங்களில் விடை ஒரு பகுதியைக் கொண்டிருக்கும்?"},"percentage-calculator.copy.faq.9.question":{"context":"percentage-calculator UI copy.faq.9.question","source_hash":"cef1f540e644606dd68e8153da86b19e6f2ab20db4e92ddc3f8388edd17397c9","translation":"நான் அதே விழுக்காட்டை சேர்த்து ஒரு விலை குறைப்பை திரும்பப் பெற முடியுமா?"},"percentage-calculator.copy.form.hint":{"context":"percentage-calculator UI copy.form.hint","source_hash":"5213c24a885b723d6f5324e90a89745cc17ec0c7fb37370704c98f743eaa9ffc","translation":"ஒரு தசம புள்ளி அல்லது 1/3 போன்ற ஒரு சரியான பிரிவை பயன்படுத்தவும். எந்த மதிப்பு குறிப்பாக உள்ளது என்பதை சரிபார்க்கவும்."},"percentage-calculator.copy.form.modeLabels.change.b":{"context":"percentage-calculator UI copy.form.modeLabels.change.b","source_hash":"7ca9b97db8e5fed63d6e75e1c970c3e29c514436d5b9390d94f8a907bca92b12","translation":"புதிய மதிப்பு"},"percentage-calculator.copy.form.modeLabels.share.a":{"context":"percentage-calculator UI copy.form.modeLabels.share.a","source_hash":"8570a2e1669ff057c9f9f64098c35346c82a82b5492982c6a347a36b1eb39f65","translation":"பகுதி"},"percentage-calculator.copy.form.modes.change":{"context":"percentage-calculator UI copy.form.modes.change","source_hash":"8c832cf75bfbe9f9347f3abb55077511bfb36850f9a05f7c3eba2abb760260d3","translation":"விழுக்காட்டு மாற்றம்"},"percentage-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"ea016446549509b96e619593431fabe7571e8c8eb107f4d267db6637a898b484","translation":"நீங்கள் பதில் சொல்ல வேண்டிய விழுக்காட்டு கேள்வியை தேர்ந்தெடுக்கவும். இரண்டு மதிப்புகளை உள்ளிடவும் மற்றும் வாய்பாடு மற்றும் விளைவை பார்க்கவும்."},"percentage-calculator.copy.method.heading":{"context":"percentage-calculator UI copy.method.heading","source_hash":"ca522d6f862e62bfb06176529b7ec65aff02d9c9092a510cebaa3eca158ef9b8","translation":"முடிவுக்குப் பின்னுள்ள விதிமுறைகள்"},"percentage-calculator.copy.method.paragraphs.1":{"context":"percentage-calculator UI copy.method.paragraphs.1","source_hash":"82bedcebc7ca9439235a632b6f5ea15c8a715fe46fe6a36e3aceeb07ceaf9918","translation":"விழுக்காட்டு மாற்றம் ஒரு புதிய மதிப்புடன் ஒரு உண்மையான குறிப்பை ஒப்பிடுகிறது. வாய்ப்பாடு (new - original) / |original| × 100 ஆகும். முற்றிலும் பிரிப்பாளர் எதிர்மறையான துவக்க மதிப்புகளுக்கு ஒரு தெளிவான ஒப்பந்தத்தைத் தருகிறது. -10 ல் இருந்து -5 க்கு நகர்வது இந்த கருவியில் +50% யைத் தருகிறது."},"percentage-calculator.copy.navigation.faq":{"context":"percentage-calculator UI copy.navigation.faq","source_hash":"170c554f6d94a09b2ec7ad12f0b43cd2245655c2a8716b2bfce24cf80e5b7901","translation":"கேள்விகள் & பதில்கள்"},"percentage-calculator.copy.navigation.onPage":{"context":"percentage-calculator UI copy.navigation.onPage","source_hash":"06a7b55d6c3eb44df5cb54524e6103ecbc08f496c8689513efc7aac2b548b170","translation":"அதை பெரும்பாலான செய்ய"},"percentage-calculator.copy.related.0.title":{"context":"perc