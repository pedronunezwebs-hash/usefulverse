{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"database-schema-designer.copy.fields.accuracyNote":{"context":"database-schema-designer UI copy.fields.accuracyNote","source_hash":"705a3ee3a02d075c32a75ac1a9a8721bb8c5de24762510778a10e170b98c87c9","translation":"எளிய அட்டவணைகள் மற்றும் வெளிநாட்டு விசைகளுக்கான ஒரு வரையறுக்கப்பட்ட திட்டமுறை வடிவமைப்பாளர், ஒரு இடமாற்ற இயக்கி அல்ல, நேரடி தரவுத்தள இணைப்பு, கேள்வி திட்டமிடுபவர் அல்லது முழு SQL பகுப்பாய்வாளர். அடையாளங்கள் ASCII எழுத்துக்கள், எண்கள் மற்றும் அடிக்கோடுகளுக்கு வரையறுக்கப்பட்டுள்ளன. தசம எண் DECIMAL( 18,2) க்கு நிர்ணயிக்கப்பட்டுள்ளது; முன்னிருப்புகள், அட்டவணைகள், சேர்க்கப்பட்ட விசை மற்றும் மேம்பட்ட மொழிபெயர்ப்பு- குறிப்பிட்ட அம்சங்கள் சேர்க்கப்படவில்லை. அனைத்தும் இந்த உலாவியிலேயே உள்ளது."},"database-schema-designer.copy.fields.fields":{"context":"database-schema-designer UI copy.fields.fields","source_hash":"6e607890b302ea2ac51c0193028785faeccb373b729e8ab85a99fd64e09bb3ad","translation":"அட்டவணைகளும் நெடுவரிசைகளும்"},"database-schema-designer.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"database-schema-designer.copy.messages.fileError":{"context":"Shared UI copy.messages.fileError","source_hash":"da2bff338747a6e8148ba09e05ba32d0100aac1572969f54081341e9c075d3c3","translation":"பிம்பத்தை வாசிக்க முடியவில்லை."},"database-schema-designer.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"இந்த தேதியில் இந்த இடத்தில் எந்த நிகழ்வும் நடக்கவில்லை."},"database-schema-designer.copy.messages.schema-limit":{"context":"Shared UI copy.messages.schema-limit","source_hash":"d4c5f5291767a4be30f75843e4c5b8639183b21dad8888e494fa450738abc04d","translation":"திட்டமுறை இந்த கருவியின் வரம்புகளைத் தாண்டுகிறது."},"database-schema-designer.copy.pri