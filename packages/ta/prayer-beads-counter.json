{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"prayer-beads-counter.copy.additionalFaqs.0.answer":{"context":"prayer-beads-counter UI copy.additionalFaqs.0.answer","source_hash":"928250cafc7ac491f348b3e7b83b2ffda36fc04c0a72892956242dccaba2363d","translation":"ஆம். இது உங்கள் உலாவியில் இலவசம் மற்றும் கணக்கு தேவையில்லை. சாதன நினைவகம் மற்றும் உலாவி ஆதரவு இன்னும் பொருந்தும்."},"prayer-beads-counter.copy.fields.target":{"context":"prayer-beads-counter UI copy.fields.target","source_hash":"66be7a0c54c851b09ea56a4925eb24cc195c0b0f795fb46f2ccf44cad0d31603","translation":"ஒவ்வொரு அமைப்புக்கும் விருப்பத்தேர்வு இலக்கு (0 என்றால் இலக்கு இல்லை)"},"prayer-beads-counter.copy.howAnswer":{"context":"prayer-beads-counter UI copy.howAnswer","source_hash":"681ec6cca2d00008f7ce672eca048fdf8f2c65dbcda3ffe14b9f309595384a7f","translation":"ஒரு இலக்கை தேர்ந்தெடுக்கவும்; தொடர்ச்சியான எண்ணிக்கைக்கு அதை வெற்றாக விட்டுவிடவும். தேர்ந்தெடுக்கப்பட்ட துவக்க எண்ணிக்கையை உள்ளிடவும், பின்னர் பெரிய கூடுதல் மற்றும் குறைப்பு பொத்தான்களை பயன்படுத்தவும். ஒரு இலக்கு தற்போதைய எண்ணிக்கையை மற்றொரு முடிந்த தொகுப்பாக மாற்றுகிறது."},"prayer-beads-counter.copy.messages.atStart":{"context":"Shared UI copy.messages.atStart","source_hash":"3171a7fa901286a15b6387ec0254ceaf69f2bab6ae31db9eeb6407906d6ca219","translation":"எண்ணிக்கை ஏற்கனவே பூஜ்யமாக உள்ளது."},"prayer-beads-counter.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"prayer-beads-counter.copy.messages.error":{"context":"Shared UI copy.messages.error","source_hash":"768a12ab2b318689a3fbd21a518c806bbe9edb6858e67ffb12601e7a319d1fec","translation":"உள்ளிடப்பட்ட மதிப்புகளை சரிபார்க்கவும்."},"prayer-beads-counter.copy.messages.fileError":{"context":"Shared UI copy.messages.fileError","source_hash":"da2bff338747a6e8148ba09e05ba32d0100aac1572969f54081341e9c075d3c3","translation":"பிம்பத்த