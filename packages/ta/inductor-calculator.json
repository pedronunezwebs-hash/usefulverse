{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"inductor-calculator.copy.fields.accuracyNote":{"context":"inductor-calculator UI copy.fields.accuracyNote","source_hash":"afb560136b551f41a3012376f29e0acf944d00215a9916e516e2d603237c8159","translation":"மதிப்பீடு மட்டுமே. காற்று- உள் மாதிரி வில்லரின் ஒற்றை- அடுக்கு நெருக்கமானதை பயன்படுத்துகிறது மற்றும் கோல் விட்டம் 3 × சுழற்சி நீளத்தை விட குறைவாக இருக்கும் போது ஒரு சுருக்கமான வழிகாட்டியாகும். இது கம்பியின் தடிமன், இடைவெளி, அருகில் உள்ள உலோகங்கள், அதிர்வெண், பரவலான திறன் மற்றும் அளவீட்டு நிலைகளை தவிர்க்கிறது. ஒரு டோரைடிற்காக, அதன் சரியான உள் தரவுத்தளத்தில் இருந்து AL காரணியை உள்ளிடவும்; AL மற்றும் ஊடுருவல் அதிர்வெண், வெப்பநிலை, DC முரண்பாடு, இடைவெளி மற்றும் உற்பத்தி சகிப்புத்தன்மையுடன் மாறலாம். உள் தயாரிப்பாளருடன் எந்த உண்மையான வடிவமைப்பையும் சரிபார்க்கவும்."},"inductor-calculator.copy.fields.alValue":{"context":"inductor-calculator UI copy.fields.alValue","source_hash":"33fe4e626674caaf58df842da0629d96ed39db723357ed67a84bf7c5360c14ed","translation":"அடிப்படை AL மதிப்பு (nH/turn²)"},"inductor-calculator.copy.fields.targetInductance":{"context":"inductor-calculator UI copy.fields.targetInductance","source_hash":"17b3ba245372787638c425e1d8bf192fb76aaadacad44e572f9a6e254b3b63f0","translation":"இலக்கு இண்டக்டிவிட்டி (விருப்பமானது)"},"inductor-calculator.copy.fields.targetUnit":{"context":"inductor-calculator UI copy.fields.targetUnit","source_hash":"26440f0d851cbfb23d4bdb4a0ea9778af67b4e878c677c679ac48bee061d8f29","translation":"இலக்கு அலகு"},"inductor-calculator.copy.messages.checkInputs":{"context":"Shared UI copy.messages.checkInputs","source_hash":"802d3975b960fe4b4f1e9fe1c097b00cbaa02238bc2651149323a7e24a10098b","translation":"சுழற்சிகளை சரிபார்க்கவும், சுழல் அளவுகள், AL மதிப்பு மற்றும் இலக்கு."},"inductor-calculator.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"d4ee268810e0194bb33e3abc9a6661ae06c6e98029f0c115f131b4419c9d3ff1","translation":"இல்லை. கணக்கீடு இந்த