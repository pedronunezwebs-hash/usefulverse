{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"average-calculator.copy.examples.2.text":{"context":"average-calculator UI copy.examples.2.text","source_hash":"fb0cc178840e87649590edec08b1f5b8cb80c7fe6763cd3af8a43a99bdfd7e19","translation":"ஒரு தற்போதைய தரம் 80, இலக்கு 85 மற்றும் இறுதி எடை 25% இறுதியில் 100% தேவை."},"average-calculator.copy.eyebrow":{"context":"average-calculator UI copy.eyebrow","source_hash":"8b7fcde409e3e571a1f83b6be9472f12756dee103f504e59003058eedac24aad","translation":"ஒரு பயனுள்ள சுருக்கம், விவரங்கள் இன்னும் தெரிகிறது."},"average-calculator.copy.faq.8.question":{"context":"average-calculator UI copy.faq.8.question","source_hash":"bce32c0269bd39e1b7c9385dc73da3700f51d0a9dc5cd9154b5616e7a25f7d80","translation":"நான் துல்லியமான பின்னங்களை உள்ளிட முடியுமா?"},"average-calculator.copy.method.paragraphs.4":{"context":"average-calculator UI copy.method.paragraphs.4","source_hash":"e56bede094fe34ce1a9b66564f543f0582e6afdfae64fca828e3eac09fbeab32","translation":"கடைசி மதிப்பெண் தேவையானது தற்போதைய மதிப்பெண் முடிவிற்கு முன்பு அனைத்து பணிகளையும் உள்ளடக்கியதாக இருக்க வேண்டும். வாய்ப்பாடு (குறிக்கோள் × 100 - தற்போதைய × (100 - கடைசி எடை)) / கடைசி எடை. தற்போதைய மற்றும் இலக்கு மதிப்பெண்கள் சுழியிலிருந்து நூறு வரை உள்ளன, மற்றும் கடைசி எடை நேர்மறையானது."},"average-calculator.copy.navigation.allTools":{"context":"average-calculator UI copy.navigation.allTools","source_hash":"81c151f98a190da765d67a020d175d400bfd9e46ed8da05bdaeeb0a9b8eef566","translation":"அனைத்து கருவிகளும்"},"average-calculator.copy.ui.copyFallback":{"context":"average-calculator UI copy.ui.copyFallback","source_hash":"476d9fdc2a1b77869df1f8646d6a4c7f3d2cfce2de2741d20c06324136310e10","translation":"கீழ்கண்ட உரையை தேர்ந்தெடுத்து நகலெடுக்கவும்"},"average-calculator.copy.ui.dateRange":{"context":"average-calculator UI copy.ui.dateRange","source_hash":"dd5a46f90fce3232af4d2c884d6b4e8c4a8fc1eed55da117dfe611d230abb7b5","translation":"ஆதரிக்கப்பட்ட நாட்காட்டி வரம்பிற்கு வெளியே"}