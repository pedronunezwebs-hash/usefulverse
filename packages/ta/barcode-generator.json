{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"barcode-generator.copy.examples.2.text":{"context":"barcode-generator UI copy.examples.2.text","source_hash":"5cccf8b4107aaf52dd3fe21551c397d38d0208336d2cbbf1ea7018caeb83c133","translation":"UPC-A உள்ளீடு 01234567890 012345678905 ஆக மாறுகிறது. முதல் சுழற்சி குறியிடப்பட்ட அடையாளத்தின் ஒரு பகுதியாக உள்ளது."},"barcode-generator.copy.labels.related":{"context":"barcode-generator UI copy.labels.related","source_hash":"f5a1810c2c35c47f7383d1371dda5c1a7ab9e15da4e9b796f33c66ca0dac967c","translation":"உங்கள் அடுத்த சிறிய வெற்றி"},"barcode-generator.copy.navigation.breadcrumbLabel":{"context":"barcode-generator UI copy.navigation.breadcrumbLabel","source_hash":"2bd873d6c734e63ea80e163a6a643f75bf87a3d24e3164987d176a2e3e5c567e","translation":"பிரெட்க்ரூம்"},"barcode-generator.copy.navigation.how":{"context":"barcode-generator UI copy.navigation.how","source_hash":"9c870aa6e5e93270170d5a81277ad3e623afe8d4efd186d3e28f3d2b646d52e6","translation":"இது எப்படி வேலை செய்கிறது"},"barcode-generator.copy.privacy.paragraphs.2":{"context":"barcode-generator UI copy.privacy.paragraphs.2","source_hash":"4a3c3e8a722c9dc83fe8840351a30aa8263161a86606a6abe1c21817fefb3789","translation":"பதிவிறக்கங்களில் உங்கள் அடையாளங்கள் உள்ளன. ஒரு காப்பகத்தை பகிர்வதற்கு முன் சேரும் அடைவை சரிபார்க்கவும். விரிதாள் சூத்திரங்களைப் போல இருக்கும் CSV மதிப்புகள் பாதுகாப்பாக திறப்பதற்கு ஒரு முந்தைய அபோஸ்ட்ரோஃபை பெறுகின்றன. இது மெனிஃபஸ் அறை மாற்றுகிறது, உண்மையான குறியீடு அடையாளம் அல்ல."},"barcode-generator.copy.related.0.text":{"context":"barcode-generator UI copy.related.0.text","source_hash":"7ae1f0ff3a781c8fa2a3963cbe15654987e2ba4bd33ab9b3179d84c4138af40e","translation":"ஒரு சதுர குறியீட்டில் ஒரு இணைப்பு அல்லது நீண்ட உரை இடவும்."},"barcode-generator.copy.ui.batchHint":{"context":"barcode-generator UI copy.ui.batchHint","source_hash":"6e7e27b5ac5b535290f2bb6455914a164292c60127db047943c8790a03a1876f","translation":"வெற்று வரிகளை தவிர்க்கவும். ஒவ