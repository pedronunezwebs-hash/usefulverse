{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"uk-stamp-duty.copy.fields.accuracyNote":{"context":"uk-stamp-duty UI copy.fields.accuracyNote","source_hash":"ff2629b59a112298d0565f9e68608a1d874331c8151d3ecce82f3a5e53e79bdd","translation":"ஒரு சுலபமான குடியிருப்பு வாங்குவதற்கான எளிய மதிப்பீடு, 19 அக்டோபர் 2026 இல் சரிபார்க்கப்பட்ட விகிதங்களைப் பயன்படுத்தி. இது வாடகை, கலப்பு-பயன் பொருள், நிறுவனம் / நன்கொடை விதிமுறைகள், இணைக்கப்பட்ட கொள்முதல் மற்றும் சிறப்பு தளர்வுகளைத் தவிர்க்கிறது. தகுதி அனைத்து வாங்குபவர்கள் மற்றும் பரிவர்த்தனை விவரங்களைப் பொறுத்தது. விகிதங்கள் மாறலாம்; செயல்படுவதற்கு முன்னர் இணைக்கப்பட்ட வரி அதிகாரியுடன் மதிப்பீட்டை சரிபார்க்கவும். உங்கள் உள்ளீடுகள் இந்த உலாவியில் இருந்து UsefulVerse க்கு அனுப்பப்படுவதில்லை."},"uk-stamp-duty.copy.fields.estimateNotice":{"context":"uk-stamp-duty UI copy.fields.estimateNotice","source_hash":"5ff4c30b6c5e5d90617b4750ff5d843ca31775415cbf9769b3465c90aca6db83","translation":"மதிப்பீடு மட்டுமே. வாங்குபவரின் நிலையை உறுதிசெய்யவும், செயல்படும் தேதி, சலுகைகள் மற்றும் பரிவர்த்தனை விவரங்களை அதிகாரப்பூர்வ அதிகாரி அல்லது தகுதியான பரிவர்த்தனையாளருடன் பரிமாற்றம் அல்லது தாக்கல் செய்வதற்கு முன்பு உறுதிசெய்யவும்."},"uk-stamp-duty.copy.fields.estimatedTax":{"context":"uk-stamp-duty UI copy.fields.estimatedTax","source_hash":"cba20ce5142c6194fcfc4c0473fb81d5efd57dc31f9e1809fee139b88f048b1b","translation":"மதிப்பிடப்பட்ட கொள்முதல் வரி"},"uk-stamp-duty.copy.fields.firstTime":{"context":"uk-stamp-duty UI copy.fields.firstTime","source_hash":"d74780d8b2f3bb6e27c3137faeaa1136ab8f9e8bb6afecbfb2d6db66004d97aa","translation":"அனைத்து வாங்குபவர்கள் முதல் முறையாக வாங்குபவர் நிவாரணத்திற்கு தகுதியுள்ளதா மற்றும் வீட்டை கைப்பற்றுவார்கள்?"},"uk-stamp-duty.copy.fields.price":{"context":"uk-stamp-duty UI copy.fields.price","source_hash":"1fad5d42a29eedaa13bb604bf98f73a3e4e1f83de220759f08f7d7fec96b00d3","translation":"குடியிருப்பு வாங்குதல் விலை (£)"},"uk-stamp-duty.copy.messages.chooseFile":{"context":"Shared UI copy.messages.