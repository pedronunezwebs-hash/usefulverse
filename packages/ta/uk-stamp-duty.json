{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"uk-stamp-duty.copy.fields.accuracyNote":{"context":"uk-stamp-duty UI copy.fields.accuracyNote","source_hash":"ff2629b59a112298d0565f9e68608a1d874331c8151d3ecce82f3a5e53e79bdd","translation":"ஒரு சுலபமான குடியிருப்பு வாங்குவதற்கான எளிய மதிப்பீடு, 19 அக்டோபர் 2026 இல் சரிபார்க்கப்பட்ட விகிதங்களைப் பயன்படுத்தி. இது வாடகை, கலப்பு-பயன் பொருள், நிறுவனம் / நன்கொடை விதிமுறைகள், இணைக்கப்பட்ட கொள்முதல் மற்றும் சிறப்பு தளர்வுகளைத் தவிர்க்கிறது. தகுதி அனைத்து வாங்குபவர்கள் மற்றும் பரிவர்த்தனை விவரங்களைப் பொறுத்தது. விகிதங்கள் மாறலாம்; செயல்படுவதற்கு முன்னர் இணைக்கப்பட்ட வரி அதிகாரியுடன் மதிப்பீட்டை சரிபார்க்கவும். உங்கள் உள்ளீடுகள் இந்த உலாவியில் இருந்து UsefulVerse க்கு அனுப்பப்படுவதில்லை."},"uk-stamp-duty.copy.fields.estimatedTax":{"context":"uk-stamp-duty UI copy.fields.estimatedTax","source_hash":"cba20ce5142c6194fcfc4c0473fb81d5efd57dc31f9e1809fee139b88f048b1b","translation":"மதிப்பிடப்பட்ட கொள்முதல் வரி"},"uk-stamp-duty.copy.fields.price":{"context":"uk-stamp-duty UI copy.fields.price","source_hash":"1fad5d42a29eedaa13bb604bf98f73a3e4e1f83de220759f08f7d7fec96b00d3","translation":"குடியிருப்பு வாங்குதல் விலை (£)"},"uk-stamp-duty.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"uk-stamp-duty.copy.messages.fileError":{"context":"Shared UI copy.messages.fileError","source_hash":"da2bff338747a6e8148ba09e05ba32d0100aac1572969f54081341e9c075d3c3","translation":"பிம்பத்தை வாசிக்க முடியவில்லை."},"uk-stamp-duty.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"இந்த தேதியில் இந்த இடத்தில் எந்த நிகழ்வும் நடக்கவில்லை."},"uk-stamp-duty.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"38047c4bbe9fe015ab19fee410a909b81813ed