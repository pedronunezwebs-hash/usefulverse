{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"india-apy-calculator.copy.additionalFaqs.1.question":{"context":"india-apy-calculator UI copy.additionalFaqs.1.question","source_hash":"db798dd753c227c45a3872b95c032e1f05bfaabaac067c9698be4925d27ae534","translation":"இந்த முடிவு எவ்வளவு சரியானது?"},"india-apy-calculator.copy.fields.accuracyNote":{"context":"india-apy-calculator UI copy.fields.accuracyNote","source_hash":"663b6fb37a6063dbb4ee02ab3cfc2ac325d4a033c3af5da434f094b591803180","translation":"இந்தியாவுக்கு உரிய மதிப்பீடு மட்டுமே. APY நுழைவு வயதுகள் 18–40. PFRDA கூறுகிறது, வருமான வரி செலுத்துபவராக இருப்பவர் அல்லது இருந்தவர் 1 அக்டோபர் 2022 முதல் சேர முடியாது. தகுதி, வங்கிக் கட்டணங்கள், செலுத்த முடியாத தண்டனைகள், எதிர்கால விதிமுறை மாற்றங்கள் மற்றும் கணக்கு சார்ந்த விதிமுறைகள் இங்கு தீர்மானிக்கப்படுவதில்லை. மொத்தமாக பெயர் மிக்க பங்களிப்புகள் மட்டுமே; இது முதலீட்டு வளர்ச்சி, வரி அல்லது வருமானத்தை மாதிரிப்படுத்துவதில்லை. செயல்பட முன்பு தற்போதைய அதிகாரப்பூர்வ கால அட்டவணையை சரிபார்க்கவும்."},"india-apy-calculator.copy.fields.pension5000":{"context":"india-apy-calculator UI copy.fields.pension5000","source_hash":"c7515e3ab0ebdbd4c5ede25b74bfb6e97f69b1619659936737eae2d77a466bcc","translation":"மாதம் ₹5,000"},"india-apy-calculator.copy.fields.quarterly":{"context":"india-apy-calculator UI copy.fields.quarterly","source_hash":"d89999a0a808113968d0eb17a7ca991517756bf51e71f1627fffc2c3660a5a79","translation":"காலாண்டிதழ்"},"india-apy-calculator.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"india-apy-calculator.copy.messages.fileError":{"context":"Shared UI copy.messages.fileError","source_hash":"da2bff338747a6e8148ba09e05ba32d0100aac1572969f54081341e9c075d3c3","translation":"பிம்பத்தை வாசிக்க முடியவில்லை."},"india-apy-calculator.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent