{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"us-roth-conversion.copy.additionalFaqs.1.answer":{"context":"us-roth-conversion UI copy.additionalFaqs.1.answer","source_hash":"5a34ee6a52ad76537798e0c9bbc8c3facd440522b9e1934e79ff5ff09736b85f","translation":"அனைத்து விகிதங்களும் நீங்கள் உள்ளிடும் மதிப்பீடுகள். இந்த கணினி வரி விதிக்கக்கூடிய அடிப்படை, விகிதாச்சார சிகிச்சை, வரி பிரிவுகள், மாநில வரி, முந்தைய-விலக்குத் தண்டனைகள், மெடிகேர் விளைவுகள் அல்லது தகுதியைத் தீர்மானிக்காது. IRA க்கு வெளியே செலுத்தப்பட்ட வரி ஒரு வாய்ப்பு செலவு உள்ளது, இது காட்டப்பட்ட கணக்கு சமநிலையில் சேர்க்கப்படவில்லை. தற்போதைய வரி விதிமுறைகளை IRS அல்லது தகுதியான வரி நிபுணருடன் உறுதிப்படுத்தவும்."},"us-roth-conversion.copy.fields.accuracyNote":{"context":"us-roth-conversion UI copy.fields.accuracyNote","source_hash":"5a34ee6a52ad76537798e0c9bbc8c3facd440522b9e1934e79ff5ff09736b85f","translation":"அனைத்து விகிதங்களும் நீங்கள் உள்ளிடும் மதிப்பீடுகள். இந்த கணினி வரி விதிக்கக்கூடிய அடிப்படை, விகிதாச்சார சிகிச்சை, வரி பிரிவுகள், மாநில வரி, முந்தைய-விலக்குத் தண்டனைகள், மெடிகேர் விளைவுகள் அல்லது தகுதியைத் தீர்மானிக்காது. IRA க்கு வெளியே செலுத்தப்பட்ட வரி ஒரு வாய்ப்பு செலவு உள்ளது, இது காட்டப்பட்ட கணக்கு சமநிலையில் சேர்க்கப்படவில்லை. தற்போதைய வரி விதிமுறைகளை IRS அல்லது தகுதியான வரி நிபுணருடன் உறுதிப்படுத்தவும்."},"us-roth-conversion.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"us-roth-conversion.copy.messages.fileError":{"context":"Shared UI copy.messages.fileError","source_hash":"da2bff338747a6e8148ba09e05ba32d0100aac1572969f54081341e9c075d3c3","translation":"பிம்பத்தை வாசிக்க முடியவில்லை."},"us-roth-conversion.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"இந்த தேதியில் இந்த இடத்தில் எந்த நிகழ்வும் நடக்கவில்ல