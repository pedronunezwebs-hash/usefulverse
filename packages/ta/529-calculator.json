{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"529-calculator.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"முக்கோணம்"},"529-calculator.copy.additionalFaqs.2.answer":{"context":"529-calculator UI copy.additionalFaqs.2.answer","source_hash":"56f1b87a8ecdf2ca3ba01f506aaefac59c48573d121cda59787cfbe765432862","translation":"ஆம். ஒவ்வொரு கல்லூரி ஆண்டுக்கும் நிர்ணயிக்கப்பட்ட கல்வி உதவித்தொகை தொகையை உள்ளிடவும். கணிப்பொறி அந்த ஆண்டுக்கான திட்டமிடப்பட்ட கல்விக் கட்டணத்தை அடிப்படையாகக் கொண்டு அதை நிதியுதவி இலக்கிலிருந்து குறைக்கும்."},"529-calculator.copy.fields.accuracyNote":{"context":"529-calculator UI copy.fields.accuracyNote","source_hash":"854a66520d4cd87bfeac26c831c959ab676fc020bbded96071ab88fbead1e486","translation":"மதிப்பீடு மட்டுமே. மாத இறுதியில் வைப்புகள், கல்லூரி மற்றும் கல்லூரியின் போது கட்டணங்கள் / வரிகளுக்கு முன்னர் ஒரு நிலையான ஆண்டு வருமானம், ஒவ்வொரு கல்வி ஆண்டு ஆரம்பத்தில் செலுத்தப்படும் கல்விக் கட்டணம், கல்விக் கட்டணங்களின் பணவீக்கம் மற்றும் ஆண்டுக்கு ஒரு நிலையான கல்வி உதவித்தொகை. இது அறை, உணவு, புத்தகங்கள், கட்டணங்கள், வரி மற்றும் கணக்கு விதிமுறைகளை தவிர்க்கிறது. வருமானம் மற்றும் செலவுகள் மாறலாம். முதலீடு, வரி அல்லது நிதி ஆலோசனை அல்ல. தற்போதைய திட்ட விதிமுறைகள் மற்றும் தகுதியான செலவுகளை சரிபார்க்கவும்."},"529-calculator.copy.messages.amountNeededNow":{"context":"Shared UI copy.messages.amountNeededNow","source_hash":"8f42c65ac5ed7815c7b0c718afc4b7ed6c03e268f2b09ed9588ca175055b9e63","translation":"இன்று தேவைப்படும் கூடுதல் சேமிப்பு"},"529-calculator.copy.messages.balancedEquation":{"context":"Shared UI copy.messages.balancedEquation","source_hash":"e2ba0a543ea9f5d93aeb09582b765fba8e0cd79fdefa17dc5425d907983142f4","translation":"சமச்சீரான சமன்பாடு"},"529-calculator.copy.messages.depth":{"context":"Shared UI copy.messages.depth","source_hash":"f1dbc33978a95b952b19bfc0da8f928e8e3958930810988de2f6e4bd8b27ce01","transl