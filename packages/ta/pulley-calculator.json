{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"pulley-calculator.copy.fields.accuracyNote":{"context":"pulley-calculator UI copy.fields.accuracyNote","source_hash":"06aa6f128ac76f10a509b08b22f3b5c3b3a9f5e80dbbcc21f58dcc8d60c77e95","translation":"ஒரு சிறந்த, திறந்த இரு- புரளி பட்டைக்கு ஏறக்குறைய பீட் நீளம். அனைத்து அளவுகளுக்கும் ஒரே அளவை பயன்படுத்தவும். உண்மையான பட்டையின் நீளம் மற்றும் வேகம் பட்டையின் விவரக்குறிப்பு, பீட், தளர்வு, சாய்வு, அணிதல் மற்றும் சகிப்புத்தன்மையை பொறுத்து வேறுபடலாம். இது வாங்கக்கூடிய பட்டையை தேர்ந்தெடுக்கவோ அல்லது சக்தி, பாதுகாப்பு அல்லது பாதுகாப்பை மதிப்பிடவோ செய்யாது. பயன்படுத்துவதற்கு முன் தயாரிப்பாளரின் தரவை சரிபார்க்கவும். உள்ளமைவாக இயங்குகிறது; பதிவேற்றம் இல்லை."},"pulley-calculator.copy.messages.balancedEquation":{"context":"Shared UI copy.messages.balancedEquation","source_hash":"e2ba0a543ea9f5d93aeb09582b765fba8e0cd79fdefa17dc5425d907983142f4","translation":"சமச்சீரான சமன்பாடு"},"pulley-calculator.copy.messages.depth":{"context":"Shared UI copy.messages.depth","source_hash":"f1dbc33978a95b952b19bfc0da8f928e8e3958930810988de2f6e4bd8b27ce01","translation":"ஆழம்"}},"locale":"ta","missing":["pulley-calculator.copy.name","pulley-calculator.copy.title","pulley-calculator.copy.description","pulley-calculator.copy.intro","pulley-calculator.copy.howQuestion","pulley-calculator.copy.howAnswer","pulley-calculator.copy.privacyQuestion","pulley-calculator.copy.privacyAnswer","pulley-calculator.copy.fields.driverDiameter","pulley-calculator.copy.fields.drivenDiameter","pulley-calculator.copy.fields.centerDistance","pulley-calculator.copy.fields.diameterUnit","pulley-calculator.copy.fields.millimeters","pulley-calculator.copy.fields.inches","pulley-calculator.copy.fields.inputRpm","pulley-calculator.copy.fields.sketchTitle","pulley-calculator.copy.fields.sketchDescription","pulley-calculator.copy.actions.calculate","pulley-calculator.copy.actions.generate","pulley-calculator.copy.actions.reset","pulley-calculator.copy.act