{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"president-card-game.copy.faq.2.a":{"context":"president-card-game UI copy.faq.2.a","source_hash":"4bacac132ab6ab53561ccfd5ce62bd54ddd852713a4ac2d936459d6b7a33a4a1","translation":"ஆம். இந்த பதிப்பில் எப்பொழுதும் பரிமாற்றம் அனுமதிக்கப்படுகிறது. மற்றொரு விளையாட்டாளர் விளையாட்டு முடிவதற்கு முன் ஒரு உயர்ந்த தொகுப்பை சேர்த்தால், நீங்கள் பின்வரும் சுற்றில் விளையாடலாம்."},"president-card-game.copy.faq.3.a":{"context":"president-card-game UI copy.faq.3.a","source_hash":"9ad7c81f42f94f0295b73308d33dc4d742b283d236b69d389ec20eda86dae4c5","translation":"மற்ற விளையாட்டாளர்கள் அனைவரும் இன்னும் சீட்டுகளை வைத்திருந்தால், அடுக்கை தள்ளி வைக்கவும். விளையாடப்பட்ட கடைசி விளையாட்டாளர் அடுத்த சுற்றுக்கு தலைமை வகிக்கிறார்; அவர்கள் வெளியேறினால், சீட்டுகளை வைத்திருக்கும் அடுத்த விளையாட்டாளர் தலைமை வகிக்கிறார்."},"president-card-game.copy.fields.exchangeOff":{"context":"president-card-game UI copy.fields.exchangeOff","source_hash":"75081b593d15cf6e631971bc6768723f593b88b172477e40ae7d363e4829816d","translation":"முடக்கப்பட்ட"},"president-card-game.copy.fields.hand":{"context":"president-card-game UI copy.fields.hand","source_hash":"9de3e4f92af405a6c72dbcf82e8190eb892c7e064ee97e48785217161563a47b","translation":"உங்கள் கை"},"president-card-game.copy.fields.houseRules":{"context":"president-card-game UI copy.fields.houseRules","source_hash":"217940d6e366e600fb62030b3060d35936e1dfc96f3cf2c61beaefc32c4a5185","translation":"உங்கள் குழுவிற்கு விதிகளை அமைக்கவும்"},"president-card-game.copy.fields.illegal":{"context":"president-card-game UI copy.fields.illegal","source_hash":"da195fc2dd52e2ee102a9fa6edfc4a20bad144d56e3fe624db24c0756f5db43c","translation":"அந்த அமைப்பு தற்போதைய விளையாட்டை வெல்ல முடியாது. அதன் அளவை பொருத்தும் மற்றும் உயர்ந்த தரத்தை தேர்ந்தெடுக்கவும்."},"president-card-game.copy.fields.score":{"context":"president-card-game UI copy.fields.score","source_hash":"77deabe238de2f6dddc88c17dbe14221918571838d8fc1228843f93