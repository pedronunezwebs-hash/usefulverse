{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"block-puzzle.copy.additionalFaqs.1.answer":{"context":"block-puzzle UI copy.additionalFaqs.1.answer","source_hash":"7461927079ddeb1f396f000ffd40b2c142dd1c2ff77d95054d07c5741c65058e","translation":"இயல்பான மதிப்பெண்களுடன் ஒரு உள்நாட்டு முக்கோண அமைப்புப் பொழுதுபோக்கு: இடப்பட்டுள்ள ஒவ்வொரு அறைக்கு ஒரு புள்ளி மற்றும் துடைக்கப்பட்ட ஒவ்வொரு வரிசை அல்லது நெடுவரிசைக்கும் பத்து புள்ளிகள். வரிசைகளும் நெடுவரிசைகளும் ஒரே நேரத்தில் துடைக்கப்படுகின்றன. பலகை, மதிப்பெண்கள் மற்றும் துண்டுகள் இந்த உலாவியில் இருந்து வெளியேறும் அல்லது புதிய விளையாட்டைத் தொடங்கும் போது மீட்டமைக்கப்படுகின்றன. எந்த வணிக விளையாட்டு, தரவரிசை அல்லது வாங்குதல்கள் இல்லை."},"block-puzzle.copy.fields.row":{"context":"block-puzzle UI copy.fields.row","source_hash":"95110d74c4c009126c967cac38ab0454d73e337c4fdafc280c04f67e66e5fe95","translation":"கிடக்கை"},"block-puzzle.copy.fields.shapeNames.t":{"context":"block-puzzle UI copy.fields.shapeNames.t","source_hash":"b3aa25a0fec0bf4f1320bcce96be392780a497e94ee0cd8f4880b472464090c4","translation":"T வடிவம்"},"block-puzzle.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"block-puzzle.copy.messages.gameOver":{"context":"Shared UI copy.messages.gameOver","source_hash":"924f2de47ce06001afceca1463ddd34ac8ac5f708f64703686e2c45d265b6b36","translation":"மீதமுள்ள துண்டுகள் பொருந்தவில்லை. விளையாட்டு முடிந்தது."},"block-puzzle.copy.messages.illegal":{"context":"Shared UI copy.messages.illegal","source_hash":"bddc9982604dee96e0ec7a91f2ac2105217dfd85c7ce6364768a35d5e8569fbb","translation":"அந்த துண்டு அங்கு பொருந்தாது."},"block-puzzle.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"இந்த தேதியில் இந்த இடத்தில் எந்த நிகழ்வும் நடக்கவில்லை."},"bloc