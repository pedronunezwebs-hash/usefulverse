{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-parental-benefit-planner.copy.details":{"context":"norway-parental-benefit-planner UI copy.details","source_hash":"2a967325f900dffe6a755c0f3eca335d02b3ee02dabc1c55c859fbf356845d7a","translation":"முதல் தேர்ந்தெடுக்கப்பட்ட நிகழ்வு தேதி, நிகழ்வு வகை, குழந்தைகளின் எண்ணிக்கை மற்றும் பாதுகாப்புக்கான அதிகாரப்பூர்வ கால அட்டவணையை ஒப்பிடவும். பின்னர் உங்கள் தற்போதைய விடுமுறை காலங்களை சேர்க்கவும். வார நாட்கள் நன்மை நாட்களை உட்கொள்கிறது; பகுதி நீக்கம் வார நாட்களில் பயன்படுத்தப்பட்ட நாட்களை குறைக்கிறது மற்றும் நாட்காட்டியை விரிவாக்குகிறது. இடைவெளிகள் நன்மை நீக்கமின்றி வேலை அல்லது விடுமுறையை குறிக்கலாம்."},"norway-parental-benefit-planner.copy.faq.2.a":{"context":"norway-parental-benefit-planner UI copy.faq.2.a","source_hash":"c25a79727aec58cf1438ec83e14d635ce033d61aef390667918cfde57bb57c19","translation":"சில ஏற்பாடுகள் ஒட்டிக் கொள்ளலாம், ஆனால் நிலையான திட்டமிட்டவர் 100% க்கு இணைக்கப்பட்ட விலகலை வரையறை செய்கிறது. சிறப்பு பல-பிறப்பு மற்றும் பிற விதிவிலக்குகள் NAV உடன் சரிபார்க்கப்பட வேண்டும்."},"norway-parental-benefit-planner.copy.fields.addPeriodHeading":{"context":"norway-parental-benefit-planner UI copy.fields.addPeriodHeading","source_hash":"8501fa9c49a1ff6164d4053c71416e1e0d4e3b04d3767d8104d1eb9a035901f5","translation":"ஓய்வுக் காலத்தைச் சேர்"},"norway-parental-benefit-planner.copy.fields.eventDate":{"context":"norway-parental-benefit-planner UI copy.fields.eventDate","source_hash":"fec386cc46dc681d97cf18cbf7f89745da1c5758e295364b19781570c0d28cc4","translation":"எதிர்பார்த்த பிறப்பு அல்லது கவனிப்பு-மாற்றம் தேதி"},"norway-parental-benefit-planner.copy.fields.mother":{"context":"norway-parental-benefit-planner UI copy.fields.mother","source_hash":"86605cac7f0646867f62ff0f03ca6af9dc3ce860f772a8673cdb6cd34dffc3b1","translation":"தாய்"},"norway-parental-benefit-planner.copy.fields.statusExported":{"context":"norway-parental-benefit-planner UI copy.fields.statusExported","source_hash":"d1e6d0fd14cb