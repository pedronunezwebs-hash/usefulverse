{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"indian-rummy.copy.fields.accuracyNote":{"context":"indian-rummy UI copy.fields.accuracyNote","source_hash":"b6904e635e5bb7db32b70de6929e4689695c3dcd94de7a47f74574988f1b4f69","translation":"இரண்டு அச்சிடப்பட்ட ஜோக்கர்கள், ஒரு உள்ளமை எதிர்ப்பாளர், மற்றும் ஒரு 13-அட்டை அறிவிப்பு சோதனை ஆகியவற்றுடன் ஒரு தெளிவாக குறிப்பிடப்பட்ட இரு-டெக், இரு-ஆட்டக்காரர் பாப்லூ-வகை விதிகள் அமைப்பை பயன்படுத்துகிறது. கைவிடப்பட்ட அட்டைகளை உடனடியாக கைவிட முடியாது. புள்ளிகள், பந்தயம், பணம், இணைய விளையாட்டு அல்லது வீட்டு விதிகள் தேர்வு இல்லை. இந்த ரோபோ அடிப்படை மற்றும் உத்திபூர்வமாக விளையாடக்கூடாது."},"indian-rummy.copy.fields.drewDiscard":{"context":"indian-rummy UI copy.fields.drewDiscard","source_hash":"3f4f4147fe1648e64e61529b34270c79dac8ec8be2d4b08a08196381d0f95ed4","translation":"நீங்கள் மேல் எறிதலை எடுத்தீர்கள். வேறு ஒரு சீட்டை எறி"},"indian-rummy.copy.howAnswer":{"context":"indian-rummy UI copy.howAnswer","source_hash":"523ef496b1e81e7dba80fca02ccf8138a49fbf80c79057267c87b7085bbd38f0","translation":"ஒரு சுற்றை துவக்கவும், சேமிப்பில் இருந்து எடுக்கவும் அல்லது தவிர்க்கவும், பின்னர் ஒரு சீட்டை தவிர்க்கவும். வைல்டு ரேங்க் காட்டப்படும். ஒரு சரியான அறிவிப்புக்கு அனைத்து 13 சீட்டுகளும் இணைப்புகளில், குறைந்தபட்சம் இரண்டு தொடர்கள் மற்றும் ஒரு நேரான தொடர் வைல்டு மாற்றங்கள் இல்லாமல் இருக்க வேண்டும்."},"indian-rummy.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"indian-rummy.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"இந்த தேதியில் இந்த இடத்தில் எந்த நிகழ்வும் நடக்கவில்லை."},"indian-rummy.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"38047c4bbe9fe015ab19fee410a909b81813ed877b433d208fbca2b304ce562a","translation":"இல்லை. இந்த