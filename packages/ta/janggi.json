{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"janggi.copy.fields.localRules":{"context":"janggi UI copy.fields.localRules","source_hash":"ded4b2fea4a2151003abbee4c08715a3080251b1cced5019b52dd9a9598a5299","translation":"கொரியா ஜாங்கி கூட்டமைப்பின் புள்ளி- மதிப்பீட்டு விதிமுறைகளை பயன்படுத்தும் ஒரு உள்ளூர் இருவர் விளையாட்டு. நகர்வு வடிவவியல் தரமான ஜாங்கியை பின்பற்றுகிறது: துப்பாக்கிகளுக்கு ஒரு துப்பாக்கி இல்லாத திரை தேவை, அமைதியான நகர்வுகளுக்கும்; குதிரை மற்றும் யானையின் பாதைகளை தடுக்க முடியும்; அரண்மனை நேர்கோட்டு பாதைகளை குறிக்கிறது. சோதனை அறிவிப்பு அல்லது கணினி எதிர்ப்பாளர் சேர்க்கப்படவில்லை."},"janggi.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"janggi.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"இந்த தேதியில் இந்த இடத்தில் எந்த நிகழ்வும் நடக்கவில்லை."},"janggi.copy.name":{"context":"janggi UI copy.name","source_hash":"4abfe2dd5a02f1a0c0e3baa4ad16e01a26c17f4bc80ac64d8da9777b5cb93dc0","translation":"ஜாங்கி (கொரிய சதுரங்கம்)"},"janggi.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"38047c4bbe9fe015ab19fee410a909b81813ed877b433d208fbca2b304ce562a","translation":"இல்லை. இந்த உலாவியில் செயலாக்கம் நடக்கிறது. உங்கள் உள்ளீடு இந்த கருவியால் ஏற்றப்படவோ அல்லது சேமிக்கப்படவோ இல்லை."}},"locale":"ta","missing":["janggi.copy.intro","janggi.copy.howQuestion","janggi.copy.privacyQuestion","janggi.copy.actions.run","janggi.copy.actions.example","janggi.copy.actions.reset","janggi.copy.actions.copy","janggi.copy.actions.download","janggi.copy.actions.start","janggi.copy.actions.pause","janggi.copy.actions.resume","janggi.copy.actions.restart","janggi.copy.actions.pass","janggi.copy.messages.complete","janggi.copy.messages.error","janggi.copy.messages.copie