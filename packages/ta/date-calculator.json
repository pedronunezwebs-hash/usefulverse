{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"date-calculator.copy.description":{"context":"date-calculator UI copy.description","source_hash":"b9545b9eb0577f4e5b0dc2fa9201b0f0e0fdd95a3327cefb8c12fb2e2ea9ff46","translation":"தேதிகளுக்கு இடையிலான நாட்களை கணக்கிடவும் அல்லது ஆண்டுகள், மாதங்கள், வாரங்கள் மற்றும் நாட்களை சேர்க்கவும். நாட்காட்டி கால அளவு, வார நாட்கள் மற்றும் மாத முடிவு விதிமுறைகளை பார்க்கவும். இலவசமாக, உங்கள் உலாவியில் கணக்கீடுகளுடன்."},"date-calculator.copy.faq.1.question":{"context":"date-calculator UI copy.faq.1.question","source_hash":"5575581be04ce9e4caf865dcb74b689a3fd2fe3a7d8ae3669419322ae908c2ad","translation":"நான் துவக்க மற்றும் முடிவு தேதிகளை எண்ண வேண்டுமா?"},"date-calculator.copy.labels.how":{"context":"date-calculator UI copy.labels.how","source_hash":"f21a4da11fe59b6e02feee265f01bd0102515147b4bb11597ca1865b049141c3","translation":"ஒரே ஒரு எளிய பணி"},"date-calculator.copy.navigation.onPage":{"context":"date-calculator UI copy.navigation.onPage","source_hash":"06a7b55d6c3eb44df5cb54524e6103ecbc08f496c8689513efc7aac2b548b170","translation":"அதை பெரும்பாலான செய்ய"},"date-calculator.copy.privacy.paragraphs.2":{"context":"date-calculator UI copy.privacy.paragraphs.2","source_hash":"69bc3a9f0734b944a69b852a935df233299f12a6c680220407802077c9d7d41c","translation":"கணக்கீடுகள் வலைப்பின்னல் கோரிக்கைகளை செய்யாது மற்றும் தானாகவே சேமிக்கப்படுவதில்லை. பக்கமும் அதன் மின்னெழுத்துகளும் தளத்திலிருந்து ஏற்றப்படும். பகிர்வு இணைப்பை நகலெடுப்பது உங்கள் உள்ளிடப்பட்ட தேதிகளை அந்த இணைப்பில் இடும். யாராவது அதை திறக்கும் போது, அந்த தேதிகள் பக்க முகவரியின் ஒரு பகுதியாக மாறும். தனிப்பட்ட தேதிகளை பகிர வேண்டாம்."},"date-calculator.copy.ui.inclusive":{"context":"date-calculator UI copy.ui.inclusive","source_hash":"744b95368d1d43a95bf3223762734ea3810910735211c105cac83d8b7da44ccc","translation":"இரண்டு தேதிகளையும் எண்ணு"},"date-calculator.copy.ui.swap":{"context":"date-calculator UI copy.ui.swap","source_hash":"5a53f2ea2408fe917b2a53a4b77db805de12d