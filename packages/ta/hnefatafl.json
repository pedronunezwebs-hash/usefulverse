{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"hnefatafl.copy.additionalFaqs.1.answer":{"context":"hnefatafl UI copy.additionalFaqs.1.answer","source_hash":"3fbaadfab3513e78843b38849e18c9e5e82cd656b8bec198dcc120dd80892a3b","translation":"இந்தப் பக்கம் ஒரு வீட்டு-விதி 11×11 மாறுபாட்டை பயன்படுத்துகிறது. Tafl விளையாட்டுகளுக்கு பிராந்திய விதிகளில் வேறுபாடுகள் உள்ளன; இந்த பதிப்பு AI, இணைய விளையாட்டு, மறுமுறை கையாளுதல் அல்லது சுழற்சி விதி இல்லை."},"hnefatafl.copy.fields.K":{"context":"hnefatafl UI copy.fields.K","source_hash":"13166b63aaa73022433839e2a56117c9d04bc638877b53f945c06c4f665e159d","translation":"ராஜா"},"hnefatafl.copy.howAnswer":{"context":"hnefatafl UI copy.howAnswer","source_hash":"6399b8dea57d345162b61f1fe13e503af4246d910062c9da4fe38e75e23f5adf","translation":"தாக்குவோர் முதலில் நகர்வார்கள். உங்கள் துண்டுகளில் ஒன்றை தேர்ந்தெடுக்கவும், பின்னர் வெற்று சதுரத்தை ஒரு வெற்று வரிசை அல்லது நெடுக்கையுடன் இணைக்கவும். பாதுகாப்பாளர்கள் ராஜா ஒரு முனைக்கு சென்றால் வெற்றி பெறுவார்கள்; தாக்குவோர் ராஜாவை நான்கு பக்கங்களிலும் சுற்றி வளைத்து வெற்றி பெறுவார்கள். சாதாரண துண்டுகள் நண்பர் துண்டு அல்லது எதிரி முனை அல்லது அரியாசனத்தின் மீது சண்டை போடுவதன் மூலம் கைப்பற்றப்படுகின்றன."},"hnefatafl.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"hnefatafl.copy.messages.fileError":{"context":"Shared UI copy.messages.fileError","source_hash":"da2bff338747a6e8148ba09e05ba32d0100aac1572969f54081341e9c075d3c3","translation":"பிம்பத்தை வாசிக்க முடியவில்லை."},"hnefatafl.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"இந்த தேதியில் இந்த இடத்தில் எந்த நிகழ்வும் நடக்கவில்லை."},"hnefatafl.copy.messages.selectDestination":{"context":"Shared UI copy.messages.selectDestination","source_hash":"8986dfdb4bb1c1