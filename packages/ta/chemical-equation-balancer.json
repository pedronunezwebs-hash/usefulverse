{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"chemical-equation-balancer.copy.additionalFaqs.1.question":{"context":"chemical-equation-balancer UI copy.additionalFaqs.1.question","source_hash":"7f5858038f976e5167b699999bf0cae8dde82f30b5e6fe3ae02c6a373a8f1af8","translation":"இது அயனி சமன்பாடுகளை சமன்படுத்த முடியுமா?"},"chemical-equation-balancer.copy.fields.accuracyNote":{"context":"chemical-equation-balancer UI copy.fields.accuracyNote","source_hash":"758fe8d4dba50f9dc62caa9e850d666c7783e1e126aff129f3c23273e6a553ea","translation":"கல்வி அணு- எண்ணிக்கை சமன்பாடு மட்டுமே, எதிர்வினை எதிர்வினை அல்லது ஒரு ஆய்வக நெறிமுறை இல்லை. அயனி ஏற்றம்/ மின்னணுக்கள் சமன்படுத்தப்படுவதில்லை, தயாரிப்புகளை எதிர்வினை எதிர்வினை, விளைவுகள் அல்லது ஆபத்துகளை மதிப்பீடு செய்கிறது, அல்லது பாதுகாப்பான கையாளுதல் வழிமுறைகளை வழங்குகிறது. பல முறையான சமன்பாடுகளுடன் சமன்பாடுகளுக்கு, வரையறுக்கப்பட்ட தீர்ப்பான் ஒரு சிறிய முறையான முடிவுகளைத் தருகிறது, உலகளாவிய குறைந்தபட்சத்தை உறுதி செய்யாது; சில வழக்கங்களில் நிராகரிக்கப்படுகிறது. வேதியியல் சரிபார்க்கவும் தகுதியான ஆய்வக பாதுகாப்பு முறைகளை பின்பற்றவும்."},"chemical-equation-balancer.copy.messages.balancedEquation":{"context":"Shared UI copy.messages.balancedEquation","source_hash":"e2ba0a543ea9f5d93aeb09582b765fba8e0cd79fdefa17dc5425d907983142f4","translation":"சமச்சீரான சமன்பாடு"}},"locale":"ta","missing":["chemical-equation-balancer.copy.name","chemical-equation-balancer.copy.title","chemical-equation-balancer.copy.description","chemical-equation-balancer.copy.intro","chemical-equation-balancer.copy.howQuestion","chemical-equation-balancer.copy.howAnswer","chemical-equation-balancer.copy.privacyQuestion","chemical-equation-balancer.copy.privacyAnswer","chemical-equation-balancer.copy.fields.equation","chemical-equation-balancer.copy.fields.formulaHint","chemical-equation-balancer.copy.actions.calculate","chemical-equation-balancer.copy.actions.generate","chemical-equation-balancer.copy.actions.reset","chemical-equation-balancer.