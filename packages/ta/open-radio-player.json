்கும் மற்றும் UsefulVerse அல்லது அடைவு சேவைக்கு அனுப்பப்படுவதில்லை. இயக்குவதற்கு முன்னர், பட்டியலிடப்பட்ட ஒலி புரவலனை சரிபார்க்கவும். நீங்கள் இயக்குவதை அழுத்தினால், உங்கள் உலாவி நேரடியாக அந்த புரவலனுடன் இணைகிறது, அது உங்கள் IP முகவரியை பார்க்க முடியும். நம்பமுடியாத மூலத்திலிருந்து பாடல் பட்டியல்களை இயக்க வேண்டாம். UsefulVerse பதிமாற்று, பதிவு அல்லது ஒலியை சேமிக்காது. தானாகவே தேடுதல் அல்லது புதுப்பித்தல் இல்லை."}},"locale":"ta","missing":["open-radio-player.copy.intro","open-radio-player.copy.howQuestion","open-radio-player.copy.privacyQuestion","open-radio-player.copy.actions.run","open-radio-player.copy.actions.example","open-radio-player.copy.actions.reset","open-radio-player.copy.actions.copy","open-radio-player.copy.actions.download","open-radio-player.copy.actions.start","open-radio-player.copy.actions.pause","open-radio-player.copy.actions.resume","open-radio-player.copy.actions.restart","open-radio-player.copy.messages.complete","open-radio-player.copy.messages.copied","open-radio-player.copy.messages.copyUnavailable","open-radio-player.copy.messages.imageTooLarge","open-radio-player.copy.messages.canvasUnavailable","open-radio-player.copy.messages.readerFinished","open-radio-player.copy.messages.choosePlaylist","open-radio-player.copy.messages.playlistTooLarge","open-radio-player.copy.messages.invalidPlaylist","open-radio-player.copy.messages.noValidStations","open-radio-player.copy.messages.tooManyStations","open-radio-player.copy.messages.emptyFilter","open-radio-player.copy.messages.searchComplete","open-radio-player.copy.messages.noStations","open-radio-player.copy.messages.directoryUnavailable","open-radio-player.copy.messages.streamUnavailable","open-radio-player.copy.messages.playing","open-radio-player.copy.name","open-radio-player.copy.title","open-radio-player.copy.description","open-radio-player.copy.howAnswer","open-radio-player.copy.fields.playlistFile","open-radio-player.copy.fields.playlistInstructions","open-radio-player.copy.fields.country",