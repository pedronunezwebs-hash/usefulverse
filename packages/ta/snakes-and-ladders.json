தமான பலகை ஓவியங்கள், குதிக்கும் இடங்கள் மற்றும் முடிக்கும் விதிமுறைகளுடன் பாம்புகள் மற்றும் ஏணிகள் விளையாடப்படுகின்றன. இந்த பக்கம் உண்மையான பலகை ஓவியங்களை பயன்படுத்துகிறது மற்றும் அதன் வடிவமைக்கக்கூடிய ஓவர்ஷூட் விதிமுறைகளை பட்டியலிடுகிறது; இதை ஒரு உள்ளமைந்த அல்லது அதிகாரப்பூர்வமான பதிப்பாக கருத வேண்டாம். இந்த விளையாட்டு ஒரு எளிய கணினி எதிரியை பயன்படுத்துகிறது, ஒரு வலைப்பின்னல் போட்டி அல்ல. கணக்கு தேவையில்லை மற்றும் நகர்வுகள் ஏற்றப்படுவதில்லை."},"snakes-and-ladders.copy.name":{"context":"snakes-and-ladders UI copy.name","source_hash":"9af8f00b16c8ad3ad2ce92d008a9b5377537701d51c53fe7e1e23441951ac3d8","translation":"பாம்புகளும் ஏணிகளும்"}},"locale":"ta","missing":["snakes-and-ladders.copy.title","snakes-and-ladders.copy.description","snakes-and-ladders.copy.intro","snakes-and-ladders.copy.exampleHeading","snakes-and-ladders.copy.example","snakes-and-ladders.copy.howItWorks","snakes-and-ladders.copy.details","snakes-and-ladders.copy.faq.0.q","snakes-and-ladders.copy.faq.1.q","snakes-and-ladders.copy.faq.1.a","snakes-and-ladders.copy.faq.2.q","snakes-and-ladders.copy.faq.2.a","snakes-and-ladders.copy.faq.3.q","snakes-and-ladders.copy.faq.3.a","snakes-and-ladders.copy.faq.4.q","snakes-and-ladders.copy.faq.4.a","snakes-and-ladders.copy.limitsHeading","snakes-and-ladders.copy.privacy","snakes-and-ladders.copy.useTool","snakes-and-ladders.copy.related","snakes-and-ladders.copy.freeBadge","snakes-and-ladders.copy.language","snakes-and-ladders.copy.home","snakes-and-ladders.copy.fields.players","snakes-and-ladders.copy.fields.mode","snakes-and-ladders.copy.fields.cpu","snakes-and-ladders.copy.fields.shared","snakes-and-ladders.copy.fields.finishRule","snakes-and-ladders.copy.fields.exact","snakes-and-ladders.copy.fields.bounce","snakes-and-ladders.copy.fields.newGame","snakes-and-ladders.copy.fields.resume","snakes-and-ladders.copy.fields.roll","snakes-and-ladders.copy.fields.rolling","snakes-and-ladders.copy.fields.ready","snakes-and-ladders.copy.fields.yourTurn","snakes-and-