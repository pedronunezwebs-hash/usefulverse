{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-student-finance-calculator.copy.faq.2.a":{"context":"norway-student-finance-calculator UI copy.faq.2.a","source_hash":"364cb21fd6dc69157177c010f6382293ab153f9c72da11513001cf4f0801a83b","translation":"இல்லை. மாற்று மதிப்பீட்டிற்காக தகுதியான அடிப்படைக் கடன் மட்டுமே பயன்படுத்தப்படுகிறது. கூடுதல் கடன்களை விருப்பமான திருப்பிச் செலுத்தும் சூழ்நிலைக்கு தனியாக சேர்க்கலாம், ஆனால் அவை மாற்றக்கூடியதாக கருதப்படுவதில்லை."},"norway-student-finance-calculator.copy.fields.assetLimit":{"context":"norway-student-finance-calculator UI copy.fields.assetLimit","source_hash":"9a891e40cc83d89d920f98f9efeb6f7608e85bf9305957ae091c4716b7436045","translation":"பயன்படுத்தப்பட்ட 2026 சுத்தச் சொத்து வரம்பு"},"norway-student-finance-calculator.copy.fields.degree":{"context":"norway-student-finance-calculator UI copy.fields.degree","source_hash":"81c8747fdc7cf5164b90754b7880a5720107b295896d455fcc2e2f935af30e73","translation":"நான் 25% படிப்பு மாற்றத்திற்கு தகுதியான படிப்பை முடித்தேன்"},"norway-student-finance-calculator.copy.fields.repaymentNote":{"context":"norway-student-finance-calculator UI copy.fields.repaymentNote","source_hash":"938ef58a386973833d18af5164a363abd2c345af2d0fe00de5cb14840998e9af","translation":"திருப்பிச் செலுத்தல் என்பது நீங்கள் உள்ளிட்ட விகிதத்தை மற்றும் காலத்தை பயன்படுத்தி ஒரு பொதுவான நிலையான- விகித உதாரணமாகும். இது ஒரு Lånekassen திருப்பிச் செலுத்தல் திட்டம் அல்ல."},"norway-student-finance-calculator.copy.fields.supportedCredits":{"context":"norway-student-finance-calculator UI copy.fields.supportedCredits","source_hash":"318d87cc6aefef5d2e05232bf8a6385f5387229d6cefce496e3c8a26bb2bd2f5","translation":"கடன்கள் அல்லது சமமான படிப்பு அலகுகள் ஆதரிக்கப்படுகின்றன"}},"locale":"ta","missing":["norway-student-finance-calculator.copy.name","norway-student-finance-calculator.copy.title","norway-student-finance-calculator.copy.description","norway-student-finance-calculator.copy.intro","norway-student-fin