{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"poker-odds-calculator.copy.howTo.1":{"context":"poker-odds-calculator UI copy.howTo.1","source_hash":"a0e53ec8c1cbd9b72d59abc8820bd1615b61f133da20544a0ac9c7e5284d8e6f","translation":"பூஜ்யத்திலிருந்து ஐந்து காணப்படும் பொது சீட்டுகளை உள்ளிடவும், 1–8 எதிரிகளைத் தேர்ந்தெடுக்கவும், பாவனை எண்ணிக்கை மற்றும் விதை அமைக்கவும்."},"poker-odds-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"fb05393912aa67c396bb186c0cd22c5fdaddb757559cec909fa71d4dfc1ec54f","translation":"உங்கள் இரண்டு மறை சீட்டுகளையும், பொது சீட்டுகளையும் மற்றும் எதிர்ப்பாளர்களின் எண்ணிக்கையை உள்ளிடவும். ஒரு முழுமையான ஆறு பலகை ஒரு எதிர்ப்பாளர்க்கு எதிராக சரியான எண்ணிக்கையைப் பயன்படுத்துகிறது; மற்ற சூழ்நிலைகள் இந்த உலாவியில் மறுபடியும் பயன்படுத்தக்கூடிய பாவனைகளைப் பயன்படுத்துகின்றன."},"poker-odds-calculator.copy.messages.duplicateCards":{"context":"Shared UI copy.messages.duplicateCards","source_hash":"b6aa0d35dc6ab45a2e81be2f6862458aed7717729e051edc28b964a137064eb0","translation":"ஒரு அட்டை ஒருமுறைக்கு மேல் தோன்ற முடியாது."},"poker-odds-calculator.copy.messages.notEnoughCards":{"context":"Shared UI copy.messages.notEnoughCards","source_hash":"ca179036dd94fb5d8b3a4a3ac894dd21080fe7a1e6217c288e3d546f8780ca49","translation":"அந்த சூழ்நிலைக்கு போதுமான சீட்டுகள் இல்லை."},"poker-odds-calculator.copy.messages.trialsRange":{"context":"Shared UI copy.messages.trialsRange","source_hash":"60c845da865310ce2f90983075c440a6af29b1af0d60a0108865b94627f19434","translation":"1,000 மற்றும் 25,000 பாவனைகளுக்கிடையே தேர்ந்தெடுக்கவும்."}},"locale":"ta","missing":["poker-odds-calculator.copy.name","poker-odds-calculator.copy.title","poker-odds-calculator.copy.description","poker-odds-calculator.copy.howQuestion","poker-odds-calculator.copy.howAnswer","poker-odds-calculator.copy.privacyQuestion","poker-odds-calculator.copy.privacyAnswer","poker-odds-calculator.copy.howTo.0","poker-odds-calculator.copy.howTo.2","poker-odds-calculator.copy.ex