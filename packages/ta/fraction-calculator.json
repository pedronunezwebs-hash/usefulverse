{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fraction-calculator.copy.examples.3.heading":{"context":"fraction-calculator UI copy.examples.3.heading","source_hash":"599f37646506a1d0c95a566c845042c2a843b0c814ea17740e4f40626e6f4cb2","translation":"இரண்டுக்கும் மேற்பட்ட பின்னங்கள்"},"fraction-calculator.copy.faqHeading":{"context":"fraction-calculator UI copy.faqHeading","source_hash":"60614104ed521729598445ddcf8330ba2f7c254806b3b9d9c156d0982b2c05b4","translation":"இந்த கணிப்பைப் பற்றிய கேள்விகள்"},"fraction-calculator.copy.form.fields.b":{"context":"fraction-calculator UI copy.form.fields.b","source_hash":"c4a53a97a697da8ba37c2c76c6303344d9e387d469ec763f7ae38afaac37a176","translation":"இரண்டாவது மதிப்பு"},"fraction-calculator.copy.privacy.paragraphs.1":{"context":"fraction-calculator UI copy.privacy.paragraphs.1","source_hash":"385bbbc22c5ebef5f1b966691700700df07e063a184ff05e36f2c7ab920055b0","translation":"உங்கள் தலைப்பு விருப்பத்தை மட்டுமே இந்த பக்கம் சேமிக்கும். நகலெடுக்கப்பட்ட இணைப்பில் தேர்ந்தெடுக்கப்பட்ட உள்ளீடுகள் மற்றும் விருப்பத்தேர்வுகள் உள்ளன, எனவே அதை கவனமாக பகிர்ந்து கொள்ளவும்."},"fraction-calculator.copy.privacy.paragraphs.2":{"context":"fraction-calculator UI copy.privacy.paragraphs.2","source_hash":"8b3fd9a899a4f3c379c1bc5f5801391bfa6053d76d429ccef1de4f2589ffbb6f","translation":"பெரிய கணக்கீடுகள் சாதன நேரம் மற்றும் நினைவகத்தைப் பொறுத்தது. ரத்து செய்யும் போது நடப்பு பணி நிறுத்தப்படும். பிழை பழைய பதில்களை நீக்கி அவற்றின் பதிவிறக்கங்களை செயல் நீக்குகிறது."},"fraction-calculator.copy.ui.errors.NUMBER":{"context":"fraction-calculator UI copy.ui.errors.NUMBER","source_hash":"5791b10619568453aa365b88ae69c40df27f9ff3b3f317469873bc97d5e215e3","translation":"ஒரு முழு எண், தசம புள்ளி, பின்னம், அல்லது கலவையான எண் 2 1/3 போன்றவற்றை பயன்படுத்தவும். ஆயிரங்களை பிரிப்பவர்களை பயன்படுத்த வேண்டாம்."},"fraction-calculator.copy.ui.errors.ONE_UNKNOWN":{"context":"fraction-calculator UI copy.ui.errors.ONE_UNKNOWN","source_hash":"08e586d34210470a2e5f7f1e2a5845dd76cc0823de19cfc166aeff64f234ed98","translation":"கேள்வி குறியினால் A, B, C அல்லது Dல் ஒன்றை சரியாக மாற்றவும்."},"fraction-calculator.copy.ui.shareNotice":{"context":"fraction-calculator UI copy.ui.shareNotice","source_hash":"6383dd0ea5880f8934eac8229978cd58c6b6ef2ec0f48b9e81993aaa743962ba","translation":"இந்த இணைப்பு உங்கள் நுழைவை உள்ளடக்கியது. மற்றவர்களும் இதைப் பார்க்க வேண்டுமென்றால் மட்டுமே இதை பகிர்ந்து கொள்ளவும்."},"fraction-calculator.copy.ui.themeLight":{"context":"fraction-calculator UI copy.ui.themeLight","source_hash":"2f740f4cf6888e99dfe73f3d6208323cb350b33a37016e1ae3367a90b3e93c84","translation":"இலேசான தலைப்புக்கு மாற்று"},"fraction-calculator.copy.uses.paragraphs.2":{"context":"fraction-calculator UI copy.uses.paragraphs.2","source_hash":"372969b904ab08477549c6acddc9d6ad630258b6fcf7bae9ac44f752a1e70c9f","translation":"ஒரு நீண்ட பட்டியல் அல்லது மிகப்பெரிய பகிர்வாளர் அதிக நினைவகத்தையும் நேரத்தையும் எடுத்துக் கொள்ளும். பணியாளர் கணக்கீட்டை இடைமுகத்திலிருந்து விலக்கி வைக்கிறது, மற்றும் ரத்து செய்வது அதை நிறுத்துகிறது. தினசரி அளவு அல்லது உள்ளீட்டு வரிகளின் நிலையான எண்ணிக்கை இல்லை."}},"locale":"ta","missing":["fraction-calculator.copy.title","fraction-calculator.copy.description","fraction-calculator.copy.heading","fraction-calculator.copy.intro","fraction-calculator.copy.category","fraction-calculator.copy.eyebrow","fraction-calculator.copy.ui.themeDark","fraction-calculator.copy.ui.copy","fraction-calculator.copy.ui.share","fraction-calculator.copy.ui.copied","fraction-calculator.copy.ui.copyFallback","fraction-calculator.copy.ui.reset","fraction-calculator.copy.ui.featuresLabel","fraction-calculator.copy.ui.trust.0","fraction-calculator.copy.ui.trust.1","fraction-calculator.copy.ui.trust.2","fraction-calculator.copy.ui.calculate","fraction-calculator.copy.ui.cancel","fraction-calculator.copy.ui.result","fraction-calculator.copy.ui.empty","fraction-calculator.copy.ui.working","fraction-calculator.copy.ui.cancelled","fraction-calculator.copy.ui.