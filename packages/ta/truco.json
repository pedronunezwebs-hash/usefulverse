{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"truco.copy.fields.accuracyNote":{"context":"truco UI copy.fields.accuracyNote","source_hash":"423926e70cb209bfe4d730d7aef2104053c00a539f03ecda83038f90e1365a90","translation":"இது ஒரு இரு அணிகள் கற்றுக்கொள்ளும் பதிப்பாகும், எளிய வீட்டு விதிமுறைகளுடன், ஒரு போட்டி நிர்ணயிப்பாளராகவோ அல்லது ஒவ்வொரு பிராந்திய மாறுபாட்டின் சரியான பாவனையாகவோ இல்லை. அர்ஜென்டினா விவரக்குறிப்பு ஒரு எளிய envido மட்டுமே, flor அல்லது chained envidos இல்லை. Paulista விவரக்குறிப்பு ஒரு எளிய நான்கு- விளையாட்டாளர் சுற்று மற்றும் mão de onze போன்ற போட்டி விதிவிலக்குகளை செயல்படுத்தாது. உள்ளூர் விதிமுறைகள் வேறுபடுகின்றன; விளையாடுவதற்கு முன்பு விவரக்குறிப்புக்கு ஒப்புக்கொள்ளவும். அனைத்து சீட்டுகள், மதிப்பெண்கள் மற்றும் செயல்கள் இந்த உலாவியில் இருக்கும்."},"truco.copy.fields.defaultPlayer1":{"context":"truco UI copy.fields.defaultPlayer1","source_hash":"27a99f01e114bf92a249aa3e2a3eb78731e143ca79f5f9ff38f1746f14f241f9","translation":"விளையாடுபவர் 1"},"truco.copy.fields.defaultPlayer4":{"context":"truco UI copy.fields.defaultPlayer4","source_hash":"811e7a3900f62f1f8432dfc031d4d876fc6a79dd32ea5970e3c934c2f8b699cf","translation":"விளையாடுபவர் 4"},"truco.copy.fields.playerThree":{"context":"truco UI copy.fields.playerThree","source_hash":"dab147c2b008e050773d7b571486a7dd4125ace56110a05a420443b0941c70cb","translation":"விளையாடுபவரின் பெயர் 3 (அணி 1)"},"truco.copy.fields.trick":{"context":"truco UI copy.fields.trick","source_hash":"209e3aa0b53cd8cda20bd44dcd56987fe6e832d3ee4cd08b752bdd171c8ffca2","translation":"ட்ரிக்"},"truco.copy.messages.all-tied":{"context":"Shared UI copy.messages.all-tied","source_hash":"3206305f39bdd6c723797bdf1486cdeab9ad2cce491bcecc1ff4d38622b169e3","translation":"அனைத்து மூன்று ட்ரிக்குகளும் சமமாகும்; எந்த அணியும் இந்த கையால் புள்ளிகள் பெறுவதில்லை."},"truco.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","t