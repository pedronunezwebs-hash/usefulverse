{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"personal-color-analysis.copy.additionalFaqs.1.question":{"context":"personal-color-analysis UI copy.additionalFaqs.1.question","source_hash":"db798dd753c227c45a3872b95c032e1f05bfaabaac067c9698be4925d27ae534","translation":"இந்த முடிவு எவ்வளவு சரியானது?"},"personal-color-analysis.copy.fields.accuracyNote":{"context":"personal-color-analysis UI copy.fields.accuracyNote","source_hash":"1d285c91b4072d3dc04174d2ae77b79244949565aa35922ae5c6ec046f35dcc8","translation":"இது ஒரு காட்சி உதவி, தனிப்பட்ட வண்ண அறிகுறி அல்லது தொழில்முறை வடிவமைப்பு முடிவு அல்ல. பிம்பம் உங்கள் உலாவியில் மட்டுமே செயலாக்கப்படுகிறது மற்றும் எப்போதும் பதிவேற்றப்படுவதில்லை. திரை சரிபார்ப்பு, ஒளி, மேக்கப் மற்றும் கேமரா அமைப்புகள் வண்ணங்களை மாற்றுகின்றன. நெருக்கமான- மாதிரி முடிவுகள் எளிய RGB தொலைவை பயன்படுத்துகின்றன, ஒரு உணர்வு மாதிரி அல்ல."},"personal-color-analysis.copy.fields.noPhoto":{"context":"personal-color-analysis UI copy.fields.noPhoto","source_hash":"9d3414246c545f503ca9d180606c3b8caf5a6d4e6215033d6af7a6a0babcb3e9","translation":"ஒரு புகைப்படத்தை தேர்ந்தெடுத்து அதை உள்ளமைவாக முன்பார்வையிடு."},"personal-color-analysis.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"பிம்பத்தை முதலில் தேர்ந்தெடு."},"personal-color-analysis.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"இந்த தேதியில் இந்த இடத்தில் எந்த நிகழ்வும் நடக்கவில்லை."},"personal-color-analysis.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"38047c4bbe9fe015ab19fee410a909b81813ed877b433d208fbca2b304ce562a","translation":"இல்லை. இந்த உலாவியில் செயலாக்கம் நடக்கிறது. உங்கள் உள்ளீடு இந்த கருவியால் ஏற்றப்படவோ அல்லது சேமிக்கப்படவோ இல்லை."},"personal-color-analysis.copy.title":{"context":"personal-color-analysis