a60e70ea08c93132d80893fdbab50184","translation":"Een voorjaarswisseling kan een uur van de lokale klok verwijderen. Sommige lokale tijden komen nooit voor. Een herfstwisseling kan een uur herhalen, waardoor een label dubbelzinnig wordt. Deze rekenmachine verwerpt ontbrekende tijden en vraagt welke gebeurtenis u bedoelt voor herhaalde tijden. Het verplaatst uw invoer nooit in stilte."},"time-duration-calculator.copy.privacy.paragraphs.1":{"context":"time-duration-calculator UI copy.privacy.paragraphs.1","source_hash":"787281ddc1bb2b812a3be8c259895b5cbb6ba1b5c4ada5fb2807a38f19e302f1","translation":"Tijdzoneregels komen van de browsergegevens die door de tijdbibliotheek worden gebruikt. Werk uw browser bij voor nieuwere regels. Toekomstige wijzigingen van de overheid en historische gegevens kunnen verschillen tussen gegevensversies. Deze tool modelleert geen schrikkelseconden of de overgang van elk land van de juliaanse kalender."},"time-duration-calculator.copy.related.1.text":{"context":"time-duration-calculator UI copy.related.1.text","source_hash":"7ff01e7f88e05a3f5c4100fbfd46cbbb12659b96f14492781e8647be3828bee0","translation":"Bekijk hetzelfde moment op verschillende locaties."},"time-duration-calculator.copy.ui.advanced":{"context":"time-duration-calculator UI copy.ui.advanced","source_hash":"3975b87809e4ceeb33d4d80de4d005c5354d2cf75489cc7d2a6a6ace98107326","translation":"Herhaalde uren & tijdzones"},"time-duration-calculator.copy.ui.nextDay":{"context":"time-duration-calculator UI copy.ui.nextDay","source_hash":"2100b59882b37bd2d82eb39500397f5f8146e029efae851ebf54f8b12372d221","translation":"Einde is de volgende dag"},"time-duration-calculator.copy.ui.reversed":{"context":"time-duration-calculator UI copy.ui.reversed","source_hash":"22be478c9830eeceaa042e25d4652513bc6faf1421c8377f23dddf55b5b7e788","translation":"Het einde is eerder. Dit resultaat geeft de positieve afstand weer."},"time-duration-calculator.copy.ui.trust.0":{"context":"time-duration-calculator UI