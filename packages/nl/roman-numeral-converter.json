"roman-numeral-converter UI copy.method.paragraphs.4","source_hash":"6ac415ddf4a16459de63fa7eaba140115f7c4c1c5c7e7e9f8feb974f815d21ef","translation":"Dezelfde grote waarde kan andere historische of moderne spellingen hebben. Sommige systemen gebruiken een overstreping of speciale archaïsche symbolen. Deze tool interpreteert deze spellingen of apostrofnotatie niet. Gebruik het getoonde gegroepeerde formulier wanneer u een waarde hier terug kopieert."},"roman-numeral-converter.copy.privacy.paragraphs.2":{"context":"roman-numeral-converter UI copy.privacy.paragraphs.2","source_hash":"0059006d8a1dfaadf61d213846a626636601eedc7f243cb43f1f1709f412355a","translation":"Nul, negatieve waarden en breuken worden niet weergegeven in de hier gebruikte notatie. Unicode Romeinse compatibiliteitstekens worden omgezet naar hun Latijnse equivalenten. Voor archaïsche tekens en overline-invoer is een andere conventie nodig. Historische letters moeten worden gecontroleerd op hun eigen context, niet worden gelabeld als universeel verkeerd."},"roman-numeral-converter.copy.related.0.title":{"context":"roman-numeral-converter UI copy.related.0.title","source_hash":"e1293ff5859e1d09ddd4acb8dd3722a43c1f9421fbaa28817da34c5da7d5d9f3","translation":"Nummer naar Woorden"},"roman-numeral-converter.copy.related.1.text":{"context":"roman-numeral-converter UI copy.related.1.text","source_hash":"8eaf235e23adcf2f06d9b8df567e5c81096fef06cb80f0c5d7ce0f54c6b56063","translation":"Converteer getallen en tekst met de geselecteerde binaire bewerking."},"roman-numeral-converter.copy.ui.breakdown":{"context":"roman-numeral-converter UI copy.ui.breakdown","source_hash":"0ed43e218487bf44e2e29a259e5e727db055edcedd2b8dfd31c1a1036eb1a9c7","translation":"Hoe de onderdelen samenkomen"},"roman-numeral-converter.copy.ui.errors.STANDARD_RANGE":{"context":"roman-numeral-converter UI copy.ui.errors.STANDARD_RANGE","source_hash":"59c92b2c4b3fc5ad812a37a0a00c422bf7cc9e9e38e37e7a5f4b422d83c0e092","translation":"Gebruik gegroep