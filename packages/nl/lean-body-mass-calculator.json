{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"lean-body-mass-calculator.copy.additionalFaqs.1.answer":{"context":"lean-body-mass-calculator UI copy.additionalFaqs.1.answer","source_hash":"fe25881ef26cbd5da19c86fc8f76157af7e9711e1b40a2221e6ce84d2574b61c","translation":"Het schat de vetvrije lichaamsmassa op basis van lengte en gewicht met behulp van een gepubliceerde vergelijking voor mannen of vrouwen.Het kan afwijken van een individuele meting, dus behandel het als een ruwe schatting."},"lean-body-mass-calculator.copy.additionalFaqs.1.question":{"context":"lean-body-mass-calculator UI copy.additionalFaqs.1.question","source_hash":"f4c45e3e2224092a559e0052688c9d469c306676e48c3c2ee3be67e27d45a8b7","translation":"Wat schat de Boer-vergelijking?"},"lean-body-mass-calculator.copy.additionalFaqs.2.answer":{"context":"lean-body-mass-calculator UI copy.additionalFaqs.2.answer","source_hash":"6a32a3066fe4496977060b6d0ebd5a971f06907353a0a5a6bad9ad95581e252f","translation":"Het resultaat is een schatting en is geen diagnose of behandelingsaanbeveling. Het is bedoeld voor volwassenen, niet voor kinderen of zwangere vrouwen.Vraag een gekwalificeerde zorgverlener om persoonlijke gezondheidsbeslissingen."},"lean-body-mass-calculator.copy.messages.calculated":{"context":"Shared UI copy.messages.calculated","source_hash":"5387a20c957ddf672af20e02fd2854fc3ab5e53af2d4ff79197ee55034ee0c5e","translation":"Schatting berekend."}},"locale":"nl","missing":["lean-body-mass-calculator.copy.name","lean-body-mass-calculator.copy.title","lean-body-mass-calculator.copy.description","lean-body-mass-calculator.copy.intro","lean-body-mass-calculator.copy.howQuestion","lean-body-mass-calculator.copy.howAnswer","lean-body-mass-calculator.copy.privacyQuestion","lean-body-mass-calculator.copy.privacyAnswer","lean-body-mass-calculator.copy.fields.method","lean-body-mass-calculator.copy.fields.directMethod","lean-body-mass-calculator.copy.fields.boerMethod","lean-body-mass-ca