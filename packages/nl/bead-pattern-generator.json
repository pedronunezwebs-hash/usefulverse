{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"bead-pattern-generator.copy.description":{"context":"bead-pattern-generator UI copy.description","source_hash":"14e499fbf2299b4af0e2027ba3e9b4fe95a941ebcefa5f0ed85e4962c5f637e5","translation":"Verander uw eigen afbeelding in een geteld kraal- of kruissteekpatroon, beperk kleuren, kies rastergrootte, bekijk de symboollegende en exporteer lokaal."},"bead-pattern-generator.copy.details":{"context":"bead-pattern-generator UI copy.details","source_hash":"0c7775645dca9b2e076c7b5c4c04211e73fe753d1be816befbd7c3b13062ab21","translation":"De afbeelding wordt in vierkante cellen ingedeeld en gereduceerd tot het geselecteerde aantal kleuren. Optionele dithering kan extra tinten suggereren met behulp van nabijgelegen cellen. Elke gevulde cel krijgt een symbool en de legenda telt de cellen in elke kleur. Het resultaat is een visueel concept: het wijst kleuren niet toe aan een bepaald merk, kraalgrootte, garenkaart of kit."},"bead-pattern-generator.copy.exampleHeading":{"context":"bead-pattern-generator UI copy.exampleHeading","source_hash":"69f36336a4e548557948e78eb99136c7ffe44f059bfb558518c20be227ce1e83","translation":"Hoe te beginnen"},"bead-pattern-generator.copy.fields.beads":{"context":"bead-pattern-generator UI copy.fields.beads","source_hash":"84b6ae882645e14692892041b7210356a6d84fad6c9f677800d9b4e5eaab26a9","translation":"Het patroon van de kraal"},"bead-pattern-generator.copy.fields.generated":{"context":"bead-pattern-generator UI copy.fields.generated","source_hash":"7d2c22d0d57ece1dea808137a1ed1fcd9735ffd16d378dc72bfb7cea0e5ac2dd","translation":"Controleer de kleuren van het patroon en het materiaal voordat je begint."},"bead-pattern-generator.copy.fields.height":{"context":"bead-pattern-generator UI copy.fields.height","source_hash":"101f2ff3de22441fcab3e15ca0b09ac3428642cf628558f16fa404fc3137baea","translation":"rijen"}},"locale":"nl","missing":["bead-pattern-generator.copy.name","bead-pattern