{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"half-life-calculator.copy.actions.calculate":{"context":"Shared UI copy.actions.calculate","source_hash":"2121cc15afb6ba5350deb90e1a292faa7d932537a19ddddadff4aeb796a8d595","translation":"Berekenen"},"half-life-calculator.copy.fields.accuracyNote":{"context":"half-life-calculator UI copy.fields.accuracyNote","source_hash":"e1f4748997a82fea593ded12511e146b8166004dfb9191159629cc7d4b150fab","translation":"Gebruik positieve hoeveelheden en halfwaardetijden; de verstreken tijd kan nul zijn. De resterende hoeveelheid kan de oorspronkelijke hoeveelheid in een vervalmodel niet overschrijden. Voer de verstreken tijd en halfwaardetijd in dezelfde eenheid in. De waarden zijn beperkt tot het eindige numerieke bereik dat door de rekenmachine wordt weergegeven. Dit is een educatief rekenhulpmiddel, geen stralings-, gezondheids-, dosering- of veiligheidscalculator."},"half-life-calculator.copy.fields.minutes":{"context":"half-life-calculator UI copy.fields.minutes","source_hash":"4f846a84e7fc9ef6e68468c270c9153c20204641bd7b839ad4b8e5233e1c86d0","translation":"Notulen"},"half-life-calculator.copy.fields.mode":{"context":"half-life-calculator UI copy.fields.mode","source_hash":"1a54d3cb785f61225fac14deaddef7dc9bd9c3a9aeca645bc1f9965696188fda","translation":"Waarde om op te lossen"},"half-life-calculator.copy.fields.solveHalfLife":{"context":"half-life-calculator UI copy.fields.solveHalfLife","source_hash":"6a28c4fe555ef03f9cd05da9dbd70be467ab1a171ab4b8d13b782a6c8ed16928","translation":"halfwaardetijd"},"half-life-calculator.copy.howAnswer":{"context":"half-life-calculator UI copy.howAnswer","source_hash":"8613317289246f6264e45987f0be8e56b0a638ff9f86b08fdfaa763dd3fe62c0","translation":"Het model is resterende hoeveelheid = initiële hoeveelheid × (1/2)^(verstreken tijd ÷ halfwaardetijd). Kies welke waarde u wilt oplossen, voer de andere drie in en gebruik dezelfde tijdseenheid voor verstreken tijd en halfwaardetijd. Na één halfwaardetijd blijft 50% over; na twee, 25%. Dit is een wiskundig model, geen medisch, veiligheids- of hanteringsadvies."},"half-life-calculator.copy.howQuestion":{"context":"Shared UI copy.howQuestion","source_hash":"c646fd7b84f6b232946af1fe993ec6e66dcae7c7c7415f2d29a89ad997d95322","translation":"Hoe bereken je de halfwaardetijd en het radioactief verval?"},"half-life-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"0c98631791704a3ee4f783a2e95f8d215d6e3c41a0e07e204b0997649dc93b78","translation":"Los één waarde in de halfwaardetijdvergelijking op uit de andere drie, bekijk de resterende hoeveelheid, het percentage en de verstreken halfwaardetijden zonder gegevens te uploaden."},"half-life-calculator.copy.messages.bagsToBuy":{"context":"Shared UI copy.messages.bagsToBuy","source_hash":"a89760dac2e54e45dd5902cb4c842481cde3f3a18cf1e636c62843a2383e997f","translation":"Hele zakken kopen"},"half-life-calculator.copy.messages.checkInputs":{"context":"Shared UI copy.messages.checkInputs","source_hash":"dc7a9f50d5fedbb28101ce90ecdbf2d38378c8ff40d38144214a1fabaacedc6d","translation":"Controleer de waarden en vervalveronderstellingen."},"half-life-calculator.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"Kopiëren is niet beschikbaar in deze browser."},"half-life-calculator.copy.messages.remainingPercent":{"context":"Shared UI copy.messages.remainingPercent","source_hash":"638b227e714be33331df9f9eb438f1c3c4b4ee0329e9250a9f6c2eb8b6a148ba","translation":"Percentage resterend"},"half-life-calculator.copy.privacyQuestion":{"context":"Shared UI copy.privacyQuestion","source_hash":"7c516f2d04f697daac52c93a46d46856b0303ccdd6c1eae980e1b52890e58cd2","translation":"Worden mijn waarden geüpload?"}},"locale":"nl","missing":["half-life-calculator.copy.name","half-life-calculator.copy.title","half-life-calculator.copy.descrip