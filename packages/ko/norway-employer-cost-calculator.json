{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-employer-cost-calculator.copy.details":{"context":"norway-employer-cost-calculator UI copy.details","source_hash":"8b288037e5ace5a06c2ac3508b1fb5530ef3639d3532d57a8cec85bb4567058f","translation":"이 계산기는 일반 활동 또는 농업/어업에 대한 공개된 2026 지역 요금을 사용합니다. 입력된 휴가 급여, 과세 대상 보상금 및 연금 기부금을 기부 기준에 추가합니다. Ia 지역의 일반 활동에 대해서는 기업당 850,000 NOK 차등 보조금이 올해 이미 사용된 것으로 입력된 금액에 적용됩니다. 결과는 연간 계획 추정치이며, 고용주의 등록 위치와 활동이 적용 규칙을 결정합니다."},"norway-employer-cost-calculator.copy.example":{"context":"norway-employer-cost-calculator UI copy.example","source_hash":"f30c769371f3acb43827634a4b139057c36d7da182d30717c996a403dd1b0030","translation":"총 연간 급여를 입력하고 고용주의 등록된 기여 지역과 활동 유형을 선택한 다음 휴가 지급, 연금 및 기타 보상을 추가합니다. 예를 들어, I 지역의 기여 기준 1,000,000 NOK는 141,000 NOK의 고용주 기여를 14.1%에서 제공합니다."},"norway-employer-cost-calculator.copy.fields.error":{"context":"norway-employer-cost-calculator UI copy.fields.error","source_hash":"e0caf23988fca7242277ea69c70c0363cb510202eff21c3dcded2eec12708db7","translation":"각 금액이 유효한 음수가 아닌 숫자이고 각 백분율이 범위 내에 있는지 확인합니다."},"norway-employer-cost-calculator.copy.fields.totalResult":{"context":"norway-employer-cost-calculator UI copy.fields.totalResult","source_hash":"83cc4ca547abddd59ddda04c7568f1ab5ebcbce14e8dea8a43af8f39a46415bb","translation":"고용주의 연간 비용 예상"},"norway-employer-cost-calculator.copy.fields.zoneI":{"context":"norway-employer-cost-calculator UI copy.fields.zoneI","source_hash":"96a34e364aec748f3584a35aa81dab8353c815a79613d3d79953ff275337dfa4","translation":"영역 I — 14.1%"},"norway-employer-cost-calculator.copy.fields.zoneIVa":{"context":"norway-employer-cost-calculator UI copy.fields.zoneIVa","source_hash":"371bc2246cf8d2bb68e6eedfba7196e215d3434a81b06d0124935709c4ea0dd5","translation":"지역 IVa — 7.9% 일반 / 5.1% 농업 및 어업"},"norway-employer-cost-calculator.copy.privacy":{"context":"norway-employer-cost-calculator UI copy.privacy","source_hash":"93d1688cd5db8cf74640bfc82cfb3a48a2987ec9ec0f0e56ee605