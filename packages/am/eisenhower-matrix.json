{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"eisenhower-matrix.copy.fields.accuracyNote":{"context":"eisenhower-matrix UI copy.fields.accuracyNote","source_hash":"93a1c514af8a17be51bce196a38a0b7577a2df44d2ddd5106c4177d463c9fe44","translation":"የእርስዎን የግል ርዕሰ ጉዳይ በመጠቀም ስራዎችን ይከፋፍሉ፤ ሜትሪክስ ለእርስዎ ትኩረት አይሰጥም ፡፡ መረጃው በዚህ መክፈቻ ውስጥ በሜሞሪ ውስጥ ይቀራል እና መከታተያውን ካላስወጡ ወይም ካላስቀመጡት በስተቀር ሲዘጉ ወይም ሲጫኑ ይደመሰሳል ፡፡ ማስገባት የዚህ መሳሪያን JSON መከታተያ ብቻ ይቀበላል ፣ እስከ 1 MB እና 300 ስራዎች ድረስ።"},"eisenhower-matrix.copy.fields.dropNote":{"context":"eisenhower-matrix UI copy.fields.dropNote","source_hash":"407b905fc717e51fe833312ef9948ea39e685c2d3cadeb06856dc2127ccf6d2a","translation":"አስቸጋሪም ሆነ አስፈላጊ አይደለም: ያስወግዱት ወይም ከፕሮግራምዎ ውጭ ይተውት."},"eisenhower-matrix.copy.intro":{"context":"Shared UI copy.intro","source_hash":"bc8863adf34c330ed3c7cac7ed88ab6a5a6a351ee635dd8e1096e3736f3c9602","translation":"የስራ ዝርዝርን ወደ አራት ግልጽ ምርጫዎች ይለውጡ: ማድረግ, ቀን መቁጠሪያ, ላኪ ወይም ማውረድ. ምን አስፈላጊ እና አስቸኳይ እንደሆነ ወሰኑ; ቀኖች ማስታወሻዎች ናቸው, አይደለም አውቶማቲክ ፍርዶች."},"eisenhower-matrix.copy.messages.importFailed":{"context":"Shared UI copy.messages.importFailed","source_hash":"3345dd67f1a33ec68ccd43bb945635e2e73480388f530d4da81d48cea751608d","translation":"የተመረጠው ፋይል መክፈት አልተቻለም"},"eisenhower-matrix.copy.messages.importLarge":{"context":"Shared UI copy.messages.importLarge","source_hash":"64ab32e27bd1bb19e4b24914e09bf1a9f8707c8cf4277f65fcda0cffaf9d45d9","translation":"መዝገብ ቤቱ በጣም ትልቅ ነው. የወሰኑት 1 MB እና 300 ስራዎች ናቸው።"}},"locale":"am","missing":["eisenhower-matrix.copy.name","eisenhower-matrix.copy.title","eisenhower-matrix.copy.description","eisenhower-matrix.copy.howQuestion","eisenhower-matrix.copy.howAnswer","eisenhower-matrix.copy.privacyQuestion","eisenhower-matrix.copy.privacyAnswer","eisenhower-matrix.copy.fields.title","eisenhower-matrix.copy.fields.notes","eisenhower-matrix.copy.fields.dueDate","eisenhower-matrix.copy.fields.quadrant","eisenhower-matrix.copy.fields.addTask","eisenhower-matrix.copy.fields.importantR