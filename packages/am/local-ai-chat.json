{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"local-ai-chat.copy.actions.send":{"context":"Shared UI copy.actions.send","source_hash":"93a26b1eaff99b3a84dd80366660991d15703a96514497afd997c12c43000ed7","translation":"መልእክት ላክ"},"local-ai-chat.copy.fields.accuracyNote":{"context":"local-ai-chat UI copy.fields.accuracyNote","source_hash":"d662dd0b0a63eec7345a1cb41748775c98270ab1e1a159052b2dd389a86858ec","translation":"ትንሽ ሙከራ ሞዴል: መልሶች ስህተት ሊሆን ይችላል, ያልተሟላ ወይም በተለያዩ ቋንቋዎች መካከል ያልተመጣጠነ. አይደለም እውነተኛ መነሻ ወይም ሙያዊ ምክር. ጥያቄዎችዎ በውስጥ ተስተካክለዋል; ሞዴል እና ዌብጂፒዩ ሩንታይም ከ Hugging ፊት እና ከ WebLLM ፕሮጀክት, ከ UsefulVerse አይደለም."},"local-ai-chat.copy.howAnswer":{"context":"local-ai-chat UI copy.howAnswer","source_hash":"b74056f7c1fc21311817b479bfa538109ae098960a07e513c05ba0a01412462f","translation":"መተግበሪያውን ለመጫን ሲመርጡ ብቻ ሞዴሉን ይጫኑ። የመጀመሪያው መተግበሪያው 351 MB ነው እናም የዌብጂፒዩ-ተስማሚን መቃኛ ይፈልጋል።"},"local-ai-chat.copy.messages.canvasUnavailable":{"context":"Shared UI copy.messages.canvasUnavailable","source_hash":"87f1714ac2b50a74f2590e77ef89541657c6dcc3726bc088d40302e09fc91137","translation":"ይህ መቃኛ ቅድመ ዕይታን ማዘጋጀት አልቻለም"},"local-ai-chat.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"ቅጂው በዚህ መቃኛ ውስጥ አልተገኘም"},"local-ai-chat.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"በዚህ ቀን በዚህ ቦታ ምንም ክስተት የለም"},"local-ai-chat.copy.messages.unsupported":{"context":"Shared UI copy.messages.unsupported","source_hash":"190cd29f2514d83f784d4373a5199c48c491a42de39119b3dcbf8847ce9c9691","translation":"ይህ መቃኛ የዌብጂፒዩን ደህንነቱ በተጠበቀ ገጽ ላይ አያቀርብም. የሚስማማውን የስራ стол መቃኛ ይሞክሩ"}},"locale":"am","missing":["local-ai-chat.copy.intro","local-ai-chat.copy.howQuestion","local-ai-chat.copy.privacyQuestion","local-ai-chat.copy.privacyAnswer","local-ai-chat.copy.actions