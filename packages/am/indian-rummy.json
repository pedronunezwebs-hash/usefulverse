{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"indian-rummy.copy.fields.accuracyNote":{"context":"indian-rummy UI copy.fields.accuracyNote","source_hash":"b6904e635e5bb7db32b70de6929e4689695c3dcd94de7a47f74574988f1b4f69","translation":"አንድ ግልጽ የተገለጸ የሁለት ጫፎች, የሁለት ተጫዋቾች Paplu-style የደንቦች ስብስብ ሁለት የተጻፉ ጆከሮች, አንድ አካባቢያዊ ተቃዋሚ, እና 13-ካርድ መግለጫ ማረጋገጫን ይጠቀማል. ካርድ ከማስወገድ ስብስብ የተወሰደ በፍጥነት ሊወገድ አይችልም. ምንም ውጤት, ተቀማጮች, ገንዘብ, በመስመር ላይ መጫወት ወይም ቤት-ሕግ ምርጫ. ሮቦት ቀላል ነው እና ስትራቴጂካዊ ሊጫወት አይችልም."},"indian-rummy.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"ቅጂው በዚህ መቃኛ ውስጥ አልተገኘም"},"indian-rummy.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"በዚህ ቀን በዚህ ቦታ ምንም ክስተት የለም"}},"locale":"am","missing":["indian-rummy.copy.intro","indian-rummy.copy.howQuestion","indian-rummy.copy.privacyQuestion","indian-rummy.copy.privacyAnswer","indian-rummy.copy.actions.run","indian-rummy.copy.actions.example","indian-rummy.copy.actions.reset","indian-rummy.copy.actions.copy","indian-rummy.copy.actions.download","indian-rummy.copy.actions.start","indian-rummy.copy.actions.pause","indian-rummy.copy.actions.resume","indian-rummy.copy.actions.restart","indian-rummy.copy.actions.drawStock","indian-rummy.copy.actions.drawDiscard","indian-rummy.copy.messages.complete","indian-rummy.copy.messages.error","indian-rummy.copy.messages.copied","indian-rummy.copy.messages.chooseFile","indian-rummy.copy.messages.fileError","indian-rummy.copy.messages.imageTooLarge","indian-rummy.copy.messages.canvasUnavailable","indian-rummy.copy.messages.readerFinished","indian-rummy.copy.name","indian-rummy.copy.title","indian-rummy.copy.description","indian-rummy.copy.howAnswer","indian-rummy.copy.fields.practiceOnly","indian-rummy.copy.fields.playerName","indian-