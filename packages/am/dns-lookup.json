{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"dns-lookup.copy.additionalFaqs.1.answer":{"context":"dns-lookup UI copy.additionalFaqs.1.answer","source_hash":"4c177408f4656975927506d23324dd2b6389bc65e8a23adb52ae0ec1dcfd353f","translation":"የዶሜይን ስም እና የመዝገብ ዓይነት ወደ Cloudflare የሕዝብ DNS ይተላለፋል. ይህ የዶሜይንን የባለቤትነት ስም ሰርቨር አይጠይቅም ወይም ማስፋፋትን አያረጋግጥም፣ የመዝገብ ቤት ማስተካከያዎችን ወይም ደህንነትን."},"dns-lookup.copy.description":{"context":"dns-lookup UI copy.description","source_hash":"6340068c36b4c4239118b92fcc56a358b5ef1b7da9ad3239366d339f76fb453b","translation":"አንድ የዲ ኤን ኤስ መዝገብ ዓይነት ለዶሜይን Cloudflare የሕዝብ ዲ ኤን ኤስ በ HTTPS ላይ በመጠቀም ፈልግ. ተመልሰው ዋጋዎች, TTL እና የ resolver DNSSEC ሁኔታ ይመልከቱ."},"dns-lookup.copy.fields.recordType":{"context":"dns-lookup UI copy.fields.recordType","source_hash":"93d4f90284dbec636cd75eeaf159f769abd4e9b390a11754ae46291d4d4c4760","translation":"የDNS መዝገብ ቤት ዓይነት"},"dns-lookup.copy.messages.canvasUnavailable":{"context":"Shared UI copy.messages.canvasUnavailable","source_hash":"87f1714ac2b50a74f2590e77ef89541657c6dcc3726bc088d40302e09fc91137","translation":"ይህ መቃኛ ቅድመ ዕይታን ማዘጋጀት አልቻለም"},"dns-lookup.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"ቅጂው በዚህ መቃኛ ውስጥ አልተገኘም"},"dns-lookup.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"በዚህ ቀን በዚህ ቦታ ምንም ክስተት የለም"}},"locale":"am","missing":["dns-lookup.copy.intro","dns-lookup.copy.howQuestion","dns-lookup.copy.privacyQuestion","dns-lookup.copy.privacyAnswer","dns-lookup.copy.actions.run","dns-lookup.copy.actions.example","dns-lookup.copy.actions.reset","dns-lookup.copy.actions.copy","dns-lookup.copy.actions.download","dns-lookup.copy.actions.start","dns-lookup.copy.actions.pause","dns-lookup.copy.actions.resume","dns-lookup.copy.actions.restart","dns-loo