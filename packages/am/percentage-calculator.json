{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"percentage-calculator.copy.examples.1.text":{"context":"percentage-calculator UI copy.examples.1.text","source_hash":"ac07325702a2fe93cc3d030d68480c1913ec192973f5efde29298c2be92bb65b","translation":"ጭማሪው 20 ነው። ከመጀመሪያው 80 ጋር ሲነጻጸር፣ ይህ 25% ለውጥ ነው።"},"percentage-calculator.copy.faq.5.question":{"context":"percentage-calculator UI copy.faq.5.question","source_hash":"e14ad178da1312232029c37d89f261a28bbfc709df0e550049c41401c75da626","translation":"% ስህተት ምንድነው?"},"percentage-calculator.copy.faq.6.answer":{"context":"percentage-calculator UI copy.faq.6.answer","source_hash":"58f941eedb0094ac6b3deea6ecf3b5f967ff0aa3d43a3e61e65090709c5da7ba","translation":"አይደለም። ከ 100 በላይ ያለው በመቶኛ ትክክለኛ ነው። ከ 100 በላይ ያለው መቀነስ አሉታዊ ውጤት ሊያስከትል ይችላል፣ ስለዚህ ሁኔታውን በጥንቃቄ ተረድቱ።"},"percentage-calculator.copy.faq.8.question":{"context":"percentage-calculator UI copy.faq.8.question","source_hash":"40aa3e397dcf26fa50e463e8199d7f4e1ba2660cb6640f36588664edf6f7700f","translation":"መልሱ ለምን አንዳንድ ጊዜ ክፍሎችን ይ containsል?"},"percentage-calculator.copy.method.paragraphs.1":{"context":"percentage-calculator UI copy.method.paragraphs.1","source_hash":"82bedcebc7ca9439235a632b6f5ea15c8a715fe46fe6a36e3aceeb07ceaf9918","translation":"በመቶኛ ለውጥ አዲስ ዋጋን ከቅድመ-መነሻ ጋር ያነጻጽራል። ፎርሙላው (አዲስ - ቅድመ) / |ቅድመ-መነሻ| × 100 ነው። ሙሉው ተቀባዩ ለከፊል መነሻ ዋጋዎች ግልጽ የሆነ ስምምነት ይሰጣል። ከ -10 ወደ -5 መንቀሳቀስ በዚህ መሣሪያ ውስጥ +50% ይሰጣል።"},"percentage-calculator.copy.navigation.home":{"context":"percentage-calculator UI copy.navigation.home","source_hash":"3a78695388b38b5cceefaf6796b0137877514593543b91af2752d5a17e3d736c","translation":"ቤት"},"percentage-calculator.copy.related.1.title":{"context":"percentage-calculator UI copy.related.1.title","source_hash":"03e2151932cce67166c7188df754eb6f21264f6bb20de2d7b25aaa032b6e6e6a","translation":"ሬቲዮ ፐሮፖርሽን ካልኩሌተር"},"percentage-calculator.copy.ui.digitNotice":{"context":"percentage-calculator UI copy.ui.digitNotice","source_hash":"b9f5000e5540eb7b