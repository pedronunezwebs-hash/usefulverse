{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"uk-stamp-duty.copy.fields.accuracyNote":{"context":"uk-stamp-duty UI copy.fields.accuracyNote","source_hash":"ff2629b59a112298d0565f9e68608a1d874331c8151d3ecce82f3a5e53e79bdd","translation":"ለግልጽ የቤት መግዛት ቀላል የተደረገ ትንበያ, በ 19 ኦክቶበር 2026 ላይ የተረጋገጠውን የቀረበውን መጠን በመጠቀም. ይህ ኪራይ, የተቀላቀለበት ንብረት, ኩባንያ / ትረስት ደንቦች, የተገናኙ መግዛቶች እና ልዩ መቀነስን ያስወግዳል. ችሎታ በሁሉም ሸማቾች እና በትራንስፖርት ዝርዝሮች ላይ የተመሠረተ ነው. ዋጋዎች ሊለወጡ ይችላሉ; ከመስራትዎ በፊት የተገናኘው የክፍያ ባለሥልጣን ጋር ትንበያውን ያረጋግጡ. የመግባቶችዎ በዚህ መቃኛ ውስጥ ይቀራሉ እናም ወደ UsefulVerse አልተላኩም."},"uk-stamp-duty.copy.fields.yes":{"context":"uk-stamp-duty UI copy.fields.yes","source_hash":"85a39ab345d672ff8ca9b9c6876f3adcacf45ee7c1e2dbd2408fd338bd55e07e","translation":"አዎ"},"uk-stamp-duty.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"ቅጂው በዚህ መቃኛ ውስጥ አልተገኘም"},"uk-stamp-duty.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"በዚህ ቀን በዚህ ቦታ ምንም ክስተት የለም"}},"locale":"am","missing":["uk-stamp-duty.copy.intro","uk-stamp-duty.copy.howQuestion","uk-stamp-duty.copy.privacyQuestion","uk-stamp-duty.copy.privacyAnswer","uk-stamp-duty.copy.actions.run","uk-stamp-duty.copy.actions.example","uk-stamp-duty.copy.actions.reset","uk-stamp-duty.copy.actions.copy","uk-stamp-duty.copy.actions.download","uk-stamp-duty.copy.actions.start","uk-stamp-duty.copy.actions.pause","uk-stamp-duty.copy.actions.resume","uk-stamp-duty.copy.actions.restart","uk-stamp-duty.copy.messages.complete","uk-stamp-duty.copy.messages.error","uk-stamp-duty.copy.messages.copied","uk-stamp-duty.copy.messages.chooseFile","uk-stamp-duty.copy.messages.fileError","uk-stamp-duty.copy.messages.imageTooLarge","uk-stamp-duty.copy.messages.canvasUnavailable","uk-stamp-duty.copy.messages.readerFinished","uk-sta