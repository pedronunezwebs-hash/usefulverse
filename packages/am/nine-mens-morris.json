{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"nine-mens-morris.copy.details":{"context":"nine-mens-morris UI copy.details","source_hash":"94bcf79f949c5c356bee432117345f05fed6ef0d578c713237ea702c39b10360","translation":"ተጫዋች ሁሉ ዘጠኝ ቁራጮችን በዙር ይጥላል. ከማስቀመጥ በኋላ, አንድ ቁራጭ በታሰረ መስመር ላይ ወደ ቀጣዩ ባዶ ነጥብ ይንቀሳቀሱ. ሶስት ቁራጮች ካሉዎት, ይህ ስሪት ወደ ማንኛውም ባዶ ነጥብ ለመውጣት ያስችልዎታል። አንድ ማሽን መፍጠር የጠላትን ቁራጭ ያስወግዳል. ጠላትን ወደ ሁለት ቁራጮች በመቀነስ ወይም ያለምንም ህጋዊ መንቀሳቀስ በመውሰድ ያሸንፋሉ. የቀረበው ቦታ ወይም 200-የቀረበው ገደብ ውጤቱ እኩል ነው."},"nine-mens-morris.copy.example":{"context":"nine-mens-morris UI copy.example","source_hash":"1defc8e395637533a7c181cb3e0c372b4f93b33b5a5cd3c21f50a7e3c188463b","translation":"ሦስት ቁሳቁሶችዎን በአንድ መስመር ላይ ያድርጉ ፣ ከዚያም ተመሳሳይ ቁሳቁሶችን ማውጣት ይችላሉ ፣ በአንድ መስመር ውስጥ የተጠበቀው ቁሳቁስ ካልሆነ በስተቀር ሌላው ያልተጠበቀው ቁሳቁስ ይኖራል ፡፡"},"nine-mens-morris.copy.fields.computer":{"context":"nine-mens-morris UI copy.fields.computer","source_hash":"76ed42d22129dc354362704eb4b54208041b68736f976932aada43bc0035f7c0","translation":"ኮምፒውተር"},"nine-mens-morris.copy.fields.invalidCapture":{"context":"nine-mens-morris UI copy.fields.invalidCapture","source_hash":"378d7a55b9b7049eecae8d493671ede035029dc26f9d44902dbbf6bc4703bea1","translation":"ያልተጠበቀው ቁራጭ ሲያለ ይህ ቁራጭ ሊወገድ አይችልም"},"nine-mens-morris.copy.fields.sourceTitle":{"context":"nine-mens-morris UI copy.fields.sourceTitle","source_hash":"425ad95e9e8790c664b3570babf398d10ba754962901a89ad8cddc5efbdff4e4","translation":"ዘጠኝ ወንዶች ሞሪስ ደንቦች"},"nine-mens-morris.copy.home":{"context":"nine-mens-morris UI copy.home","source_hash":"81c151f98a190da765d67a020d175d400bfd9e46ed8da05bdaeeb0a9b8eef566","translation":"ሁሉንም መሳሪያዎች"},"nine-mens-morris.copy.howItWorks":{"context":"nine-mens-morris UI copy.howItWorks","source_hash":"13a6b22428cd17c402c4a0361b645ee0894bada3ee921a3faa3eb3f2dd110e0c","translation":"እንዴት እንደሚጫወት"},"nine-mens-morris.copy.name":{"context":"nine-mens-morris UI copy.name","source_hash":"6e8a74179a315a93b9b739a61629b8d1ac58d5e0406e96b5ec65b6567c93b2d6","tra