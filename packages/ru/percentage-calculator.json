{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"percentage-calculator.copy.examples.1.text":{"context":"percentage-calculator UI copy.examples.1.text","source_hash":"ac07325702a2fe93cc3d030d68480c1913ec192973f5efde29298c2be92bb65b","translation":"Увеличение составляет 20. Относительно первоначального 80, то есть это изменение 25%."},"percentage-calculator.copy.faq.0.answer":{"context":"percentage-calculator UI copy.faq.0.answer","source_hash":"8a055e5310f75e4ec73ad05c40cc7be8c940801d4837c3dc2c7089c0ba9ff44d","translation":"Выберите Процент от значения. Введите процент сначала, а затем базовую сумму. Например, 15% из 200 будет 30."},"percentage-calculator.copy.faq.1.answer":{"context":"percentage-calculator UI copy.faq.1.answer","source_hash":"894f5cc577100b93671064be656ef4a79bc054b9c193c44ace54df1ecb5d586f","translation":"Введите известную часть и ее процент. Нулевой процент не может определить уникальное целое."},"percentage-calculator.copy.faq.1.question":{"context":"percentage-calculator UI copy.faq.1.question","source_hash":"982a77516af2676a5cb692e3f779c4bce33777ee18109c6e1584db04f4c8dd69","translation":"Как я нахожу первоначальное целое?"},"percentage-calculator.copy.faq.3.question":{"context":"percentage-calculator UI copy.faq.3.question","source_hash":"148f00fe12d06e4c6e28be7c37e7bc46183687c900d7c47b4e8ceba381c3fd82","translation":"Чем отличаются изменения и различия?"},"percentage-calculator.copy.faq.5.question":{"context":"percentage-calculator UI copy.faq.5.question","source_hash":"e14ad178da1312232029c37d89f261a28bbfc709df0e550049c41401c75da626","translation":"Что такое процентная погрешность?"},"percentage-calculator.copy.faq.8.question":{"context":"percentage-calculator UI copy.faq.8.question","source_hash":"40aa3e397dcf26fa50e463e8199d7f4e1ba2660cb6640f36588664edf6f7700f","translation":"Почему в ответе иногда содержится дробь?"},"percentage-calculator.copy.form.modeLabels.change.b":{"context":"percentage-calculator UI copy.form.modeLabels.change.b","source_hash":"7ca9b97db8e5fed63d6e75e1c970c3e29c514436d5b9390d94f8a907bca92b12","translation":"Новая стоимость"},"percentage-calculator.copy.form.modeLabels.decrease.b":{"context":"percentage-calculator UI copy.form.modeLabels.decrease.b","source_hash":"bb30a38c014844609fe2151caa34b4f9a2afbd99cab277340bf3707fc616c80b","translation":"Сокращение в процентах"},"percentage-calculator.copy.form.modeLabels.share.a":{"context":"percentage-calculator UI copy.form.modeLabels.share.a","source_hash":"8570a2e1669ff057c9f9f64098c35346c82a82b5492982c6a347a36b1eb39f65","translation":"Часть"},"percentage-calculator.copy.form.modes.change":{"context":"percentage-calculator UI copy.form.modes.change","source_hash":"8c832cf75bfbe9f9347f3abb55077511bfb36850f9a05f7c3eba2abb760260d3","translation":"Изменение в процентах"},"percentage-calculator.copy.form.modes.of":{"context":"percentage-calculator UI copy.form.modes.of","source_hash":"3ca8ef3d6c84d92a4342122639e6a4d612486bbc507b2a9faea63e4b77553790","translation":"Процент от стоимости"},"percentage-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"ea016446549509b96e619593431fabe7571e8c8eb107f4d267db6637a898b484","translation":"Выберите вопрос о процентах, на который вам нужно ответить. Введите два значения и посмотрите формулу, а также результат."},"percentage-calculator.copy.method.paragraphs.1":{"context":"percentage-calculator UI copy.method.paragraphs.1","source_hash":"82bedcebc7ca9439235a632b6f5ea15c8a715fe46fe6a36e3aceeb07ceaf9918","translation":"Процентное изменение сравнивает новое значение с первоначальной ссылкой. Формула: (новое - первоначальное) / |первоначальное| × 100. Абсолютный знаменатель дает явное соглашение для отрицательных начальных значений. Поэтому перемещение из -10 в -5 дает +50% в этом инструменте."},"percentage-calculator.copy.navigation.onPage":{"context":"percentage-calculator UI copy.navigation.onPage","source_hash":"06a7b55d6c3eb44df5cb54524e6103ecbc08f496c8689