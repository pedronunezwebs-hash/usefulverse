{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"age-calculator.copy.examplesHeading":{"context":"age-calculator UI copy.examplesHeading","source_hash":"fda4132009d6425530e0ae5b050f43114602805ccc1514d99874cd85e7788625","translation":"Четыре полезных способа начать работу"},"age-calculator.copy.faq.3.answer":{"context":"age-calculator UI copy.faq.3.answer","source_hash":"3ca6c19d6382ce2d91bf17a30dd7a7997c8645c652f14c83f984b0d99fa6d340","translation":"Число завершенных лет увеличивается, а отсчет дней рождения, отображаемых для справочной даты, начинается с нуля."},"age-calculator.copy.faq.9.answer":{"context":"age-calculator UI copy.faq.9.answer","source_hash":"84ded048e4ba76e0bad4a4e83173199d7447de3513a327f1e2984bebb75db57f","translation":"Нет. Он показывает календарную арифметику с выбранным соглашением о високосных днях. Официальные правила отбора требуют соответствующего авторитетного правила."},"age-calculator.copy.heading":{"context":"age-calculator UI copy.heading","source_hash":"771cca3cb610954b3cc1c401d28e38a7292d134d247db569a38bd8b29707ab80","translation":"Возраст Калькулятор"},"age-calculator.copy.how.steps.0.text":{"context":"age-calculator UI copy.how.steps.0.text","source_hash":"6157ca6f51010ab2f6713af18b45a746abc523f4da16534e0ad18dfe1fc79f6d","translation":"Выберите режим, соответствующий вашей задаче. Вводные метки следуют за этим выбором."},"age-calculator.copy.labels.examples":{"context":"age-calculator UI copy.labels.examples","source_hash":"38a8c28c47b65bc9325ba45486b759c726d614e9fc2509eae8fbd0fdf234681b","translation":"Небольшое преимущество на старте"},"age-calculator.copy.labels.how":{"context":"age-calculator UI copy.labels.how","source_hash":"f21a4da11fe59b6e02feee265f01bd0102515147b4bb11597ca1865b049141c3","translation":"Одна простая задача"},"age-calculator.copy.privacy.paragraphs.1":{"context":"age-calculator UI copy.privacy.paragraphs.1","source_hash":"385bbbc22c5ebef5f1b966691700700df07e063a184ff05e36f2c7ab920055b0","translation":"Страница сохраняет только ваши предпочтения темы. Скопированная ссылка содержит выбранные входы и опции, так что делитесь ею сознательно."},"age-calculator.copy.related.0.text":{"context":"age-calculator UI copy.related.0.text","source_hash":"4cea3b65879e4c7af68da7984de27d0e4034d238086fe9895955e4f421132071","translation":"Продолжить с калькулятором даты."},"age-calculator.copy.ui.answerLabel":{"context":"age-calculator UI copy.ui.answerLabel","source_hash":"55bbb131a0ecda2443a9be4d5ec2a489d2dde01fcda72274f01aefe3752a8ff0","translation":"Возраст календаря: годы / месяцы / дни"},"age-calculator.copy.ui.cancelled":{"context":"age-calculator UI copy.ui.cancelled","source_hash":"cbc7e63195c8c729eb51e1604d71b9a5e25fa25e519cbe3319c9563fe20ffb48","translation":"Остановлено. Изменить вводные данные или произвести перерасчет."},"age-calculator.copy.ui.digitNotice":{"context":"age-calculator UI copy.ui.digitNotice","source_hash":"b9f5000e5540eb7bae5e906ab3a1b7f5eaec6a9b05f92fcceb0e98079b138bea","translation":"Поцифровое считывание; для этого значения не используются именованные английские шкалы."},"age-calculator.copy.ui.empty":{"context":"age-calculator UI copy.ui.empty","source_hash":"72f9b98ac8ee163204fef0a6f69a9f77fe2fc236cbb20f021cbf1b65b74b8326","translation":"Ваш результат появится здесь."},"age-calculator.copy.ui.errors.ALL_ZERO":{"context":"age-calculator UI copy.ui.errors.ALL_ZERO","source_hash":"ef1e47cc0edf70d59e683713b2b9de86f4c0a09ed7ef394e731cfaf29a6f8237","translation":"Отношение с нулевыми значениями не имеет единственной простой формы. Введите хотя бы один ненулевой член."},"age-calculator.copy.ui.errors.WORKER_FAILED":{"context":"age-calculator UI copy.ui.errors.WORKER_FAILED","source_hash":"2d55ed95e686a05aaf6b2347b346baba1e1086347306d0f0830e97e7c2b68933","translation":"Не удалось запустить фоновые расчеты. Перезагрузите в текущем браузере."},"age-calculator.copy.ui.labels.mixed":{"context":"age-calculator UI copy.ui.labels.mixed","source