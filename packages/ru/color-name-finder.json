{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"color-name-finder.copy.actions.circle":{"context":"Shared UI copy.actions.circle","source_hash":"b93d3bcecff5d7493a58a41ea44f7196a46295f6512ebc06940510676a666384","translation":"Круг"},"color-name-finder.copy.actions.copyHex":{"context":"Shared UI copy.actions.copyHex","source_hash":"d97c659bc1c67d2b696bac753435d90eedb870adeecb0d80bff77bcce8cc6e01","translation":"Копировать шестнадцатеричное значение"},"color-name-finder.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"2530c04512b78dcc9559de75b55ced6386ea960bc8ba9872f52bdd9f92ecae09","translation":"Попробовать пример"},"color-name-finder.copy.actions.findName":{"context":"Shared UI copy.actions.findName","source_hash":"205f085a9f31d1eda1de5fc957e159fd8b28f61e65186b8f85224ccf5caaea77","translation":"Найти имя цвета"},"color-name-finder.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"Треугольник"},"color-name-finder.copy.additionalFaqs.0.answer":{"context":"color-name-finder UI copy.additionalFaqs.0.answer","source_hash":"9417ffeaf291ae72345f09925132d479415b7081e373cf49d74d6fd656de4bca","translation":"Нет. CSS определяет фиксированную именованную палитру цветов. Для других значений этот инструмент показывает ближайшие цвета палитры как приближения."},"color-name-finder.copy.additionalFaqs.1.answer":{"context":"color-name-finder UI copy.additionalFaqs.1.answer","source_hash":"351cfc0377173cbe901ca696237281d988695479c8609d6e11ed5e68e65a579c","translation":"Некоторые стандартные имена являются псевдонимами, такими как aqua и cyan. Инструмент группирует имена, которые имеют одно и то же точное значение RGB."},"color-name-finder.copy.description":{"context":"color-name-finder UI copy.description","source_hash":"39abfeb1541554cdce491f16585bb24ec2f0fe65202221ffec735e1c8ded51ff","translation":"Найдите ближайшее CSS имя цвета для любого шестнадцатеричного кода. Сравните перцептуальные совпадения и скопируйте имя или значение. Бесплатно, неограниченное использование в вашем браузере."},"color-name-finder.copy.howAnswer":{"context":"color-name-finder UI copy.howAnswer","source_hash":"e22f6ced46e1b599774fda39b6c6caec49ec912c4eb05fdcf50b1ce86ea05550","translation":"Введите шестнадцатеричные значения 3- или 6-, с или без #, или используйте выбор цвета. Точные названия цветов в CSS помечены отдельно. Другие результаты являются ближайшими стандартными названиями по расстоянию восприятия OKLab; они являются приближениями, а не универсальными названиями."},"color-name-finder.copy.messages.checkColor":{"context":"Shared UI copy.messages.checkColor","source_hash":"4cf948b13d5364cefe45e443c644093d2eb69a70d394216041b9cee3dae2d415","translation":"Введите правильный шестнадцатеричный цвет цифры 3- или 6-."},"color-name-finder.copy.messages.checkInputs":{"context":"Shared UI copy.messages.checkInputs","source_hash":"6ff8847244631961a615cde9eed82d7f815735e6002cecc11729e195e9e56b3d","translation":"Введите число выше нуля для каждого требуемого измерения. Проверьте также необязательные значения."},"color-name-finder.copy.privacyQuestion":{"context":"Shared UI copy.privacyQuestion","source_hash":"dba5d961b249a1e0c4d38ee27660a8366920ddef961564f5c722e187cbbba863","translation":"Мой цвет загружен?"}},"locale":"ru","missing":["color-name-finder.copy.name","color-name-finder.copy.title","color-name-finder.copy.intro","color-name-finder.copy.howQuestion","color-name-finder.copy.privacyAnswer","color-name-finder.copy.fields.hexColor","color-name-finder.copy.fields.colorPreview","color-name-finder.copy.fields.nearestNames","color-name-finder.copy.fields.exactMatchNote","color-name-finder.copy.fields.paletteNote","color-name-finder.copy.actions.calculate","color-name-finder.copy.actions.generate","color-name-finder.copy.actions.reset","color-name-finder.copy.actions.newGame","color-name-finder.cop