{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"music-identifier.copy.accuracyNote":{"context":"music-identifier UI copy.accuracyNote","source_hash":"edbb6715fc878fd18f4e1862e771b5670810488647d88ee1bf3553420b9ec079","translation":"Результат - это эвристическое соответствие между клипом и выбранными вами справочными файлами. Это не доверие, вероятность или проверенная идентичность песни."},"music-identifier.copy.actions.run":{"context":"Shared UI copy.actions.run","source_hash":"2b2bb216207a48cd9a04329585563cc02d3939b932eb9029bb8bf3da6e5db866","translation":"Сравнить клипы"},"music-identifier.copy.additionalFaqs.1.question":{"context":"music-identifier UI copy.additionalFaqs.1.question","source_hash":"db798dd753c227c45a3872b95c032e1f05bfaabaac067c9698be4925d27ae534","translation":"Насколько точен этот результат?"},"music-identifier.copy.fields.accuracyNote":{"context":"music-identifier UI copy.fields.accuracyNote","source_hash":"c91b93b916e047af5f9ba09dee9ba8679813a06e8b8b450e2577413ba28b787a","translation":"Это эвристическое локальное сравнение, а не глобальный каталог песен, проверенная идентификация или вероятность. Это работает лучше всего с одной и той же записью или аналогичной композицией; редактирование, живые версии, шум, молчание и транспозиция могут изменить результат. Аудиофайлы декодируются в памяти после отправки и не загружаются или сохраняются."},"music-identifier.copy.howAnswer":{"context":"music-identifier UI copy.howAnswer","source_hash":"1548880b72d2c86bfe3eb040421148031eebb6c85e60f0a0e13a295ecca3e166","translation":"Выберите второй клип запроса 2–20 и справочные файлы 1–5, которыми вы владеете или можете пользоваться. Браузер сравнивает образцы энергии шага и показывает ближайшее локальное имя файла, если сходство высоко."},"music-identifier.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"Сначала выберите изображение."},"music-identifier.copy.messages.fileError":{"context":"Shared UI copy.messages.fileError","source_hash":"da2bff338747a6e8148ba09e05ba32d0100aac1572969f54081341e9c075d3c3","translation":"Изображение не считывается."},"music-identifier.copy.messages.noEvent":{"context":"Shared UI copy.messages.noEvent","source_hash":"fada4bbd7921e74e716f9bc535ac0b187b4458e6292f18a99a5d0717427d13af","translation":"Никаких событий в этот день в этом месте нет."},"music-identifier.copy.messages.noMatch":{"context":"Shared UI copy.messages.noMatch","source_hash":"ceedd5a9c384d60635154c0bfe78453b67991ad12e390b57d7ef270916723149","translation":"Не найдено достаточно похожее ссылка. Попробуйте другой клип или ссылку."},"music-identifier.copy.name":{"context":"music-identifier UI copy.name","source_hash":"cbab25c4b7c8728ae1ceaa908cd2e7d2f901195aa73225e40b7c9fd77c430391","translation":"Местный музыкальный клип Matcher"},"music-identifier.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"06bd611ef108e898cdd28605795bb78a980ff72044c84b7cb3cf0d56a93f841f","translation":"Звук декодируется локально только после отправки. Он не загружается и не сохраняется этим инструментом."}},"locale":"ru","missing":["music-identifier.copy.intro","music-identifier.copy.howQuestion","music-identifier.copy.privacyQuestion","music-identifier.copy.actions.example","music-identifier.copy.actions.reset","music-identifier.copy.actions.copy","music-identifier.copy.actions.download","music-identifier.copy.actions.start","music-identifier.copy.actions.pause","music-identifier.copy.actions.resume","music-identifier.copy.actions.restart","music-identifier.copy.messages.complete","music-identifier.copy.messages.error","music-identifier.copy.messages.copied","music-identifier.copy.messages.copyUnavailable","music-identifier.copy.messages.imageTooLarge","music-identifier.copy.messages.canvasUnavailable","music-identifier.copy.messages.readerFinished","music-identifier.copy.messages.