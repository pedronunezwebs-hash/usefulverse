{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"personal-color-analysis.copy.actions.copy":{"context":"Shared UI copy.actions.copy","source_hash":"c467973d015e9cb72b4e3a39d8b304099974fe9b6cb67f3f6f66a328069179a6","translation":"Копировать результат"},"personal-color-analysis.copy.fields.accuracyNote":{"context":"personal-color-analysis UI copy.fields.accuracyNote","source_hash":"1d285c91b4072d3dc04174d2ae77b79244949565aa35922ae5c6ec046f35dcc8","translation":"Это визуальная помощь, а не персональная диагностика цвета или результат профессионального стиля. Изображение обрабатывается только в вашем браузере и никогда не загружается. Калибровка экрана, освещение, макияж и настройки камеры меняют цвета. Результаты ближайшего образца используют простое RGB-расстояние, а не восприятие модели."},"personal-color-analysis.copy.fields.palette":{"context":"personal-color-analysis UI copy.fields.palette","source_hash":"81a9be1a8044ef411a75e79cce5977cb4f41ccf658612dd312cdb3b9f984951c","translation":"Цветовая палитра"},"personal-color-analysis.copy.howAnswer":{"context":"personal-color-analysis UI copy.howAnswer","source_hash":"bae4b71682fb6dde890769cfb759e8efc410fafee4fbeee111f87e4af4c0f9b5","translation":"Выберите фотографию JPEG, PNG или WebP размером до 10 MB. Сравните ее внешний вид с четырьмя палитрами, отрегулируйте предварительный просмотр или щелкните изображение, чтобы выбрать пиксель. Сохраненные палитры и экспорт JSON содержат только цветовые значения."},"personal-color-analysis.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"Сначала выберите изображение."},"personal-color-analysis.copy.messages.downloaded":{"context":"Shared UI copy.messages.downloaded","source_hash":"fcba5d417a80b6417a4abf231a30b94dc5c10e57cb8b1253e68a35f1d55bedb8","translation":"Цветовые значения загружены как JSON."},"personal-color-analysis.copy.messa