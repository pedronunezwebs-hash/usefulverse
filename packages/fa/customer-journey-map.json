{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"customer-journey-map.copy.actions.copy":{"context":"Shared UI copy.actions.copy","source_hash":"c467973d015e9cb72b4e3a39d8b304099974fe9b6cb67f3f6f66a328069179a6","translation":"رونوشت نتیجه"},"customer-journey-map.copy.actions.start":{"context":"Shared UI copy.actions.start","source_hash":"e4bb9f1ece9af9264a3b9e3913bbdb2cf497457167b14ced5f85688bfde74644","translation":"شروع"},"customer-journey-map.copy.fields.accuracyNote":{"context":"customer-journey-map UI copy.fields.accuracyNote","source_hash":"8a5b56e297300a6c29a61a9227fe1b50426f5a4e40a1c59c8fd9a678ce23309e","translation":"این یک فضای کاری ساختاری است ، نه پژوهش مشتری. با افراد مصاحبه نمی‌کند ، رفتار مشتری را استنباط نمی‌کند یا شواهدی تولید نمی‌کند. مراحل پیشنهادی ، پیامهای ویرایش‌پذیر هستند ، نه ادعاهایی درباره مخاطبان شما. فرضیات را به عنوان فرضیات و مناطق پژوهش نشده را به عنوان ناشناخته علامت بزنید. تمام محتوا در این صفحه باقی می‌ماند ، مگر اینکه JSON را بارگیری کنید."},"customer-journey-map.copy.fields.evidenceStatus":{"context":"customer-journey-map UI copy.fields.evidenceStatus","source_hash":"d7e710b9658fce9a5ed2e32f9e6a0730eca94e1eb7fcb899371017ef8f19cd4e","translation":"وضعیت شواهد"},"customer-journey-map.copy.fields.resultTitle":{"context":"customer-journey-map UI copy.fields.resultTitle","source_hash":"ed91015caced4bf874ae07258d4cf7689211d495c24772666b949c651fd3134c","translation":"نقشه سفر"},"customer-journey-map.copy.fields.stage":{"context":"customer-journey-map UI copy.fields.stage","source_hash":"de838855e4a6e04ea2f284b246a07a1126e7fcd151be9449e112006ad7db5c50","translation":"مرحله"},"customer-journey-map.copy.fields.starterStages.0":{"context":"customer-journey-map UI copy.fields.starterStages.0","source_hash":"d4a33d5b78bccebe3f16843dc30e6c0f73b4eb6efb4e7114ddfebde7fa2c9954","translation":"کشف"},"customer-journey-map.copy.fields.touchpoint":{"context":"customer-journey-map UI copy.fields.touchpoint","source_hash":"e9e9c