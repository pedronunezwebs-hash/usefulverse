{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"us-roth-conversion.copy.actions.start":{"context":"Shared UI copy.actions.start","source_hash":"e4bb9f1ece9af9264a3b9e3913bbdb2cf497457167b14ced5f85688bfde74644","translation":"شروع"},"us-roth-conversion.copy.additionalFaqs.1.answer":{"context":"us-roth-conversion UI copy.additionalFaqs.1.answer","source_hash":"5a34ee6a52ad76537798e0c9bbc8c3facd440522b9e1934e79ff5ff09736b85f","translation":"تمام نرخ‌ها تخمین‌هایی هستند که شما وارد می‌کنید. این محاسبه‌گر اساس مالیاتی، برخورد تناسبی، دسته‌های مالیاتی، مالیات ایالتی، جریمه بازنشستگی زودهنگام، اثرات یا شایستگی Medicare را تعیین نمی‌کند. مالیات پرداخت شده خارج از IRA هزینه فرصتی دارد که در توازن حساب نمایش داده نشده است. قوانین مالیاتی جاری را با IRS یا یک متخصص مالیاتی واجد شرایط تأیید کنید."},"us-roth-conversion.copy.fields.currentRate":{"context":"us-roth-conversion UI copy.fields.currentRate","source_hash":"e9540f3fe177e7cec4f797ed5ddf5211fe7d1d79b04e14e0e70cf6029c55000d","translation":"نرخ مالیات جاری فرضی)٪("},"us-roth-conversion.copy.howAnswer":{"context":"us-roth-conversion UI copy.howAnswer","source_hash":"fdbc42773f93e509ea5320ab5cea9d8ec723b4915aa05869743c628177c2c1bf","translation":"وارد کردن مقدار تبدیل ، نرخ مالیات جاری و آینده فرض شده ، بازگشت سالانه و سالهای باقی مانده تا برداشت. مقایسه توازن Roth پیش‌بینی شده هنگامی که مالیات خارج از IRA پرداخت می‌شود یا از تبدیل نگه داشته می‌شود با توازن سنتی پس از مالیات تخمین زده شده."},"us-roth-conversion.copy.messages.canvasUnavailable":{"context":"Shared UI copy.messages.canvasUnavailable","source_hash":"87f1714ac2b50a74f2590e77ef89541657c6dcc3726bc088d40302e09fc91137","translation":"این مرورگر نتوانست پیش‌نمایش را آماده کند."},"us-roth-conversion.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"ابتدا یک تصویر را انتخاب کنید."},"us-roth-conversion.copy.messages.noEvent":{"