{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fuel-cost-calculator.copy.faq.4.question":{"context":"fuel-cost-calculator UI copy.faq.4.question","source_hash":"a1d33422cc16c263ac16f1f824d60e31e3479b74eeb8816af2386150291b67f7","translation":"چرا سهام گرد شده هميشه دقيقا جمع نميشه؟"},"fuel-cost-calculator.copy.faq.6.question":{"context":"fuel-cost-calculator UI copy.faq.6.question","source_hash":"16509f9ac96d7dbbe8391c51c7a1b04b1e6cff75698e4db9ade0f30ee2f1a6bc","translation":"این قیمت فعلی سوخت رو نشون میده؟"},"fuel-cost-calculator.copy.faq.9.answer":{"context":"fuel-cost-calculator UI copy.faq.9.answer","source_hash":"3b77456371d776f1744ad5a2264005871fe45c880034d613fa37ec70142a4ec4","translation":"لزوماً نه. مصرف واقعی با شرایط تغییر می کند. نتیجه تخمین زده شده از مقادیری است که شما ارائه می دهید."},"fuel-cost-calculator.copy.how.heading":{"context":"fuel-cost-calculator UI copy.how.heading","source_hash":"6643e0aafaf46092d12acfd0539b8d40605366adf900ffce3fdbe473c0314f8b","translation":"انتخاب کن، وارد شو، چک کن"},"fuel-cost-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"b237cee27f84a7011acd8ab8173e58dca2ef4322298ed9caa18bc7bf99e0be48","translation":"فاصله، مصرف سوخت و قیمت پمپ را وارد کنید. هزینه سفر را تخمین بزنید، از جمله سفر برگشت یا سهم مسافر."},"fuel-cost-calculator.copy.method.paragraphs.2":{"context":"fuel-cost-calculator UI copy.method.paragraphs.2","source_hash":"853cdb4c9b7a6a32c4c963064871ab098b5703e3161918074b02b1ea72a231dc","translation":"گالونهای آمریکایی و گالونهای امپراتوری مقادیر متفاوتی هستند. حالت صحیح MPG را برگزینید و از قیمت پمپ برای نوع یکسان گالون استفاده کنید. ماشین حساب به طور خاموش یک تعریف گالون را با دیگری مخلوط نمی‌کند یا قیمتی را که واحد آن ناشناخته است ، تبدیل نمی‌کند."},"fuel-cost-calculator.copy.method.paragraphs.3":{"context":"fuel-cost-calculator UI copy.method.paragraphs.3","source_hash":"2650f6ef3afb1a464fa9cfd375dcafeb6249b5e74bef004f63d2232bf7b1ea7d","translation":"سفر برگشت 