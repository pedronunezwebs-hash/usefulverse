{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"amerikaner-card-game.copy.faq.0.q":{"context":"amerikaner-card-game UI copy.faq.0.q","source_hash":"8788e11e58a20d4339822c60f9156e759298d13734ef9e31f7d290b570360536","translation":"چند نفر مي تونن بازي کنن؟"},"amerikaner-card-game.copy.faq.1.a":{"context":"amerikaner-card-game UI copy.faq.1.a","source_hash":"9b3aa9c3c5c1c535572ca2a536662648df1f7e4eb5012312243cdb1088ac0b39","translation":"از کارت‌های 52 بدون جوکر استفاده کنید. یک دو را برای سه بازیکن کنار بگذارید، هیچ‌کدام را برای چهار بازیکن، دو را برای پنج بازیکن، و تمام چهار دو را برای شش بازیکن کنار بگذارید تا هر دست تعداد یکسانی از کارت‌ها داشته باشد."},"amerikaner-card-game.copy.fields.allPassed":{"context":"amerikaner-card-game UI copy.fields.allPassed","source_hash":"a8f9bb7e6e3ea22f975b293ec67010001be8b55805757850b6373b083bd79113","translation":"همه پاس کردن دست دوباره باز شد و دلال به سمت چپ رفت"},"amerikaner-card-game.copy.fields.deleted":{"context":"amerikaner-card-game UI copy.fields.deleted","source_hash":"1f9bc6adddbd1af200d7e3b66d3aaf6fea0a7c77681fa3ece722b90b62c6479a","translation":"بازی ذخیره‌شده حذف شد."},"amerikaner-card-game.copy.fields.noSave":{"context":"amerikaner-card-game UI copy.fields.noSave","source_hash":"2737af063d040db83bfb9452dae26f2b6a487a984b54671ddcf89a358755bc60","translation":"هیچ بازی ذخیره‌شده‌ای در این دستگاه وجود ندارد."},"amerikaner-card-game.copy.fields.player":{"context":"amerikaner-card-game UI copy.fields.player","source_hash":"64aee8c6cbd026d9ea9221661f7632351d9a741198cd01ca017450b56f78a206","translation":"بازیکن"},"amerikaner-card-game.copy.fields.summary":{"context":"amerikaner-card-game UI copy.fields.summary","source_hash":"664d651c70685d8a9ceee9910c6ea5b9af9a2a68c57654572c69d1f1c94bfe1d","translation":"یک دست کارت‌های استاندارد 52، بدون جوکر. با کنار گذاشتن دوهای کافی برای بازیکنان 3–6 به صورت مساوی تقسیم کنید. یک پیشنهاد عادی از نصف دست گرد شده شروع می‌شود و باید از پیشنهاد قبلی بالاتر باشد. آمریکایی را صدا بزنید تا همه طلسم‌ها را به تنهایی بگیرد. در یک پیشنهاد عادی، رهبری را برای قرار دادن ترفند و درخواست یک کارت شریک انجام دهید. هنگامی که می‌توانید رنگ را دنبال کنید. هر تیم پیشنهاد را می‌برد یا از دست می‌دهد؛ بازیکنان دیگر شمارش طلسم خود را بدست می‌آورند. بالاترین امتیاز زمانی که امتیاز به 52 برسد برنده می‌شود."},"amerikaner-card-game.copy.fields.table":{"context":"amerikaner-card-game UI copy.fields.table","source_hash":"43ddeb606a8eeb2c5a7c777efd291b76377cf1ec1371d4cb03fc944e744197fc","translation":"ترفند جاری"},"amerikaner-card-game.copy.limitsHeading":{"context":"amerikaner-card-game UI copy.limitsHeading","source_hash":"926339d39ba2e00f153580c146d2bd10a422f42555e686773349380ba6e3672c","translation":"قواعد و محدودیت‌ها"}},"locale":"fa","missing":["amerikaner-card-game.copy.name","amerikaner-card-game.copy.title","amerikaner-card-game.copy.description","amerikaner-card-game.copy.intro","amerikaner-card-game.copy.exampleHeading","amerikaner-card-game.copy.example","amerikaner-card-game.copy.howItWorks","amerikaner-card-game.copy.details","amerikaner-card-game.copy.faqHeading","amerikaner-card-game.copy.faq.0.a","amerikaner-card-game.copy.faq.1.q","amerikaner-card-game.copy.faq.2.q","amerikaner-card-game.copy.faq.2.a","amerikaner-card-game.copy.faq.3.q","amerikaner-card-game.copy.faq.3.a","amerikaner-card-game.copy.faq.4.q","amerikaner-card-game.copy.faq.4.a","amerikaner-card-game.copy.faq.5.q","amerikaner-card-game.copy.faq.5.a","amerikaner-card-game.copy.limits","amerikaner-card-game.copy.privacy","amerikaner-card-game.copy.useTool","amerikaner-card-game.copy.related","amerikaner-card-game.copy.freeBadge","amerikaner-card-game.copy.language","amerikaner-card-game.copy.home","amerikaner-card-game.copy.fields.players","amerikaner-card-game.copy.fields.newGame","amerikaner-card-game.copy.fields.resume","amerikaner-card-game.copy.fields.deleteSave","amerikaner-card-game.copy.fields.exportResults","amerikaner-card-game.copy.fields.spades","amerikaner-