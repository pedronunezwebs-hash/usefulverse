{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"uk-universal-credit.copy.additionalFaqs.1.answer":{"context":"uk-universal-credit UI copy.additionalFaqs.1.answer","source_hash":"4a5506124846288e6347287158891c1e308abc590a854560b4a430683b0dab07","translation":"این تنها کاهش درآمد را نشان می‌دهد و صلاحیت را بررسی نمی‌کند یا یک جایزه اعتبار جهانی کامل را محاسبه نمی‌کند. حداکثر جایزه را قبل از اینکه درآمد از قبل شناخته شده باشد، فرض می‌کند. کاهش 55% بالاتر از کمک‌هزینه کار انتخاب شده اعمال می‌شود: £427 با حمایت مسکن، £710 بدون حمایت مسکن، یا £0 اگر هیچ کمک‌هزینه کار اعمال نشود. موارد ویژه و سایر تخفیفات مستثنی هستند. قوانین برای 2026–27 است و باید قبل از 6 آوریل 2027 بررسی شود."},"uk-universal-credit.copy.fields.maximumAward":{"context":"uk-universal-credit UI copy.fields.maximumAward","source_hash":"ce1b1e45deb61c7434c53700d9f665a83345df5659ab0994a37f9a059c3ad705","translation":"حداکثر پاداش UC ماهانه قبل از درآمد (GBP)"},"uk-universal-credit.copy.fields.resultTitle":{"context":"uk-universal-credit UI copy.fields.resultTitle","source_hash":"6e7d50e84f4731ef74187cf8cfa2672184eed8866b0b0074a772f4a64e0f4ba2","translation":"نتیجه"},"uk-universal-credit.copy.howAnswer":{"context":"uk-universal-credit UI copy.howAnswer","source_hash":"0e44e8eafd8cc8a7031bef858c5dde7f31083eb9d8dcfb0bf1754a429c6361b1","translation":"حداکثر مبلغ ماهانه اعتبار جهانی را قبل از درآمد، درآمد خالص ماهانه گزارش شده و هرگونه کمک هزینه کار قابل اعمال وارد کنید."},"uk-universal-credit.copy.messages.canvasUnavailable":{"context":"Shared UI copy.messages.canvasUnavailable","source_hash":"87f1714ac2b50a74f2590e77ef89541657c6dcc3726bc088d40302e09fc91137","translation":"این مرورگر نتوانست پیش‌نمایش را آماده کند."},"uk-universal-credit.copy.messages.chooseFile":{"context":"Shared UI copy.messages.chooseFile","source_hash":"ae62e1d50b38fae9077b5204790e9e4a282f0da94fc923bd78b5dd2c7295a6bc","translation":"ابتدا یک تصویر را انتخاب کنید."},"uk-universal-credit.copy.messages.noEvent":{"con