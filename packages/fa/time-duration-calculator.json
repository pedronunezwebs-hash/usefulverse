{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"time-duration-calculator.copy.category":{"context":"time-duration-calculator UI copy.category","source_hash":"2459ea42894c5c5b6f95fdbde7276e335f60615d3fb2e4aa2550f731cbace2bb","translation":"تاریخ و زمانComment"},"time-duration-calculator.copy.examples.2.text":{"context":"time-duration-calculator UI copy.examples.2.text","source_hash":"3be9367ab59bbaf25b7c5e5cc1e2d49086665edeeb656841752a696205fdde4e","translation":"در نیویورک در ماه مارس 10, 2024, نیمه شب تا 04:00 3 ساعت‌ها گذشته است. ساعت یک ساعت می‌پرد."},"time-duration-calculator.copy.faq.4.question":{"context":"time-duration-calculator UI copy.faq.4.question","source_hash":"4c5124e6f8b4e752b638795149664f4799736c3e34cc6dc4f2e8decf115e09b2","translation":"زمان تابستانی مدت زمان را تغییر می‌دهد؟"},"time-duration-calculator.copy.faq.5.question":{"context":"time-duration-calculator UI copy.faq.5.question","source_hash":"1dfb585a22dda3b59fee639209d057dfa767a27176db1d5cfff9dd0fd0b0f28a","translation":"چرا يه زماني که وجود نداره رو محاسبه گر رد ميکنه؟"},"time-duration-calculator.copy.faq.8.question":{"context":"time-duration-calculator UI copy.faq.8.question","source_hash":"a468b2c227af29c92d1a64d455e5ed9b841baa585f5b812805106f45dbeb936e","translation":"ساعت هاي اعشاري چطور کار مي کنن؟"},"time-duration-calculator.copy.how.heading":{"context":"time-duration-calculator UI copy.how.heading","source_hash":"8c53d88b153589eb1bdcb0e5e8cba15e4e9a39b1852537d7345fd19a7d433a1e","translation":"دو بار، يه جواب که ميتوني چک کني"},"time-duration-calculator.copy.method.paragraphs.2":{"context":"time-duration-calculator UI copy.method.paragraphs.2","source_hash":"0cb1ecf008172991fb74da08089f6548a60e70ea08c93132d80893fdbab50184","translation":"یک تغییر ساعت بهار می‌تواند یک ساعت را از ساعت محلی حذف کند. برخی از زمان‌های محلی هرگز رخ نمی‌دهند. یک تغییر پاییز می‌تواند یک ساعت را تکرار کند ، که برچسب را مبهم می‌کند. این محاسبه‌گر ، زمان‌های گم‌شده را رد می‌کند و می‌پرسد که برای زمان‌های تکراری ، منظورتان کدام رخداد است. هرگز ورودی شما را به صورت خاموش حرکت نمی‌دهد."},"time-duration-calculator.copy.navigation.mainLabel":{"context":"time-duration-calculator UI copy.navigation.mainLabel","source_hash":"eb355944b92d10582856f8aea34b3e319ba465b8aa4c294973cf53f665399a2c","translation":"ناوش اصلی"},"time-duration-calculator.copy.navigation.method":{"context":"time-duration-calculator UI copy.navigation.method","source_hash":"b16509e3daf1095de76d04de628ca3f2354472a71660196b42b7de6d4b4392d5","translation":"قواعد شمارش"},"time-duration-calculator.copy.privacy.paragraphs.1":{"context":"time-duration-calculator UI copy.privacy.paragraphs.1","source_hash":"787281ddc1bb2b812a3be8c259895b5cbb6ba1b5c4ada5fb2807a38f19e302f1","translation":"قواعد منطقه زمانی از داده‌های مرورگر که توسط کتابخانه زمان استفاده می‌شود ، به دست می‌آید. مرورگر خود را برای قوانین جدیدتر به‌روزرسانی کنید. تغییرات آینده دولت و سوابق تاریخی ممکن است بین نسخه‌های داده تفاوت داشته باشند. این ابزار ثانیه‌های کبیسه یا تغییر هر کشور از تقویم جولیان را مدل نمی‌کند."},"time-duration-calculator.copy.related.0.title":{"context":"time-duration-calculator UI copy.related.0.title","source_hash":"89fe5bf1078d8a03fe09395a9ef3907bd5546137e1a6e99b0c742dbcbb06823f","translation":"محاسبه‌گر تاریخ"},"time-duration-calculator.copy.related.1.text":{"context":"time-duration-calculator UI copy.related.1.text","source_hash":"7ff01e7f88e05a3f5c4100fbfd46cbbb12659b96f14492781e8647be3828bee0","translation":"یک لحظه را در مکان‌های مختلف ببینید."},"time-duration-calculator.copy.ui.advanced":{"context":"time-duration-calculator UI copy.ui.advanced","source_hash":"3975b87809e4ceeb33d4d80de4d005c5354d2cf75489cc7d2a6a6ace98107326","translation":"ساعتهای تکراری و مناطق زمانی"},"time-duration-calculator.copy.ui.earlier":{"context":"time-duration-calculator UI copy.ui.earlier","source_hash":"5c8bf7e191bdaa50eafeac0aeb778a84ef54a5434dbe2e564d5f267ec88ada67","translation":"اولین رخداد"},"time-duration-calculator