{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"online-whiteboard.copy.actions.copy":{"context":"Shared UI copy.actions.copy","source_hash":"c467973d015e9cb72b4e3a39d8b304099974fe9b6cb67f3f6f66a328069179a6","translation":"رونوشت نتیجه"},"online-whiteboard.copy.actions.start":{"context":"Shared UI copy.actions.start","source_hash":"e4bb9f1ece9af9264a3b9e3913bbdb2cf497457167b14ced5f85688bfde74644","translation":"شروع"},"online-whiteboard.copy.additionalFaqs.1.answer":{"context":"online-whiteboard UI copy.additionalFaqs.1.answer","source_hash":"531d48239ff8ee3112b38e1c23f8403f0c7f995e217eb2848944547481194ebb","translation":"این تخته سفید فقط در این دستگاه اجرا می‌شود. خط‌ها و یادداشت‌ها در حافظه صفحه باقی می‌مانند و هنگامی که دوباره بارگذاری یا بازنشانی می‌کنید پاک می‌شوند. همگام‌سازی، همکاری از راه دور یا بارگذاری محتوای شما را انجام نمی‌دهد. فهرست یادداشت‌های دسترسی‌پذیر به شما اجازه می‌دهد بدون استفاده از بوم، یادداشت‌ها را انتخاب کنید."},"online-whiteboard.copy.fields.exportPng":{"context":"online-whiteboard UI copy.fields.exportPng","source_hash":"3f09c05b1382289e9141dda5f4b18079361cb22af1c442f334ac1e449d53ba12","translation":"بارگیری تابلو به عنوان PNG"},"online-whiteboard.copy.howAnswer":{"context":"online-whiteboard UI copy.howAnswer","source_hash":"5bdbae264ee3c8a799b45c48cac5d4842083526af9947c673b808612e614d15a","translation":"صفحه را شروع کنید، قلم یا گزینش را انتخاب کنید، سپس نوت‌های کوتاه را ترسیم یا اضافه کنید. نوت‌ها را برای مرتب کردن آن‌ها بکشید؛ برای انتخاب چند نوت، کلید Shift را نگه دارید، سپس آن‌ها را گروه‌بندی کنید. از کلیدهای پیکان صفحه‌کلید برای جابه‌جایی نوت‌های انتخاب شده و Delete برای حذف آن‌ها استفاده کنید. هنگامی که آماده شدید، یک PNG را صادر کنید."},"online-whiteboard.copy.messages.canvasUnavailable":{"context":"Shared UI copy.messages.canvasUnavailable","source_hash":"87f1714ac2b50a74f2590e77ef89541657c6dcc3726bc088d40302e09fc91137","translation":"این مرورگر نتوانست پیش‌نمایش را آماده کند."},"online-whiteboard.cop