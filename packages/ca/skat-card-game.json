{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"skat-card-game.copy.details":{"context":"skat-card-game UI copy.details","source_hash":"7850c2586a2737a7960b5257390f795f390b02bd0fc491fcc9a26eb426d3fdea","translation":"Un repartiment utilitza cartes 32: set, vuit, nou, sota, reina, rei, deu i as de cada pal. Cada jugador rep deu cartes i dues per formar l'Skat. Ofereix per torns; el jugador que faci l'oferta més alta tria diamants, cors, piques, trèvols, gran o nul. Amb un joc de recollida, agafa l'Skat i retorna dues cartes; amb la mà, deixa-la sense veure. Els jugadors han de seguir el pal o el triomf principal quan sigui possible. Els jocs de pal i de gran necessiten ulls 61; en nul, el declarant no ha de fer cap truc."},"skat-card-game.copy.faq.0.q":{"context":"skat-card-game UI copy.faq.0.q","source_hash":"69df622edd2710f6cd5a92ae3f44add3f8e13f364a5304bc54b38a5f35fa3514","translation":"Quantes persones juguen a Skat?"},"skat-card-game.copy.faq.1.q":{"context":"skat-card-game UI copy.faq.1.q","source_hash":"f26101756ed1e94acbd3a1876e32426a575ad15c0e8128c5fcd7aaf06afbf251","translation":"Què és l'Skat?"},"skat-card-game.copy.faq.5.a":{"context":"skat-card-game UI copy.faq.5.a","source_hash":"5024081baac864f783a9f8c2d3957126060d7be5ad9db3346e465b8a306b3579","translation":"El declarant necessita almenys 61 dels ulls de carta 120, incloent-hi l'Skat. Els defensors combinen els seus ulls."},"skat-card-game.copy.faq.7.q":{"context":"skat-card-game UI copy.faq.7.q","source_hash":"82b38ac20be7aca069020424c4451ccc63fcc1b2d77876b849d18c97e5b6711b","translation":"La CPU és de nivell expert?"},"skat-card-game.copy.faq.8.a":{"context":"skat-card-game UI copy.faq.8.a","source_hash":"b7942fdd67d9d953d0564d31fafc758477010175d745e38e60f9d47a378ebc20","translation":"No s' han pujat dades de la partida. El repartiment actual es desarà automàticament en aquest navegador d' aquest dispositiu per a que el pugueu reprendre més tard."},"skat-card-game.copy.fields.invalid":{"context":"skat-card-game UI copy.fields.invalid","source_hash":"9253246254ee7cd354e1aee272dec9d6c8609cfb26dbd484e7f8f040104eaeb9","translation":"Aquesta acció no és legal. Comproveu les regles i la vostra selecció."},"skat-card-game.copy.fields.newGame":{"context":"skat-card-game UI copy.fields.newGame","source_hash":"a87d9117ffbed49ace8f52968f5d69c3ddbb2a23631291955ef0d338d36f893e","translation":"Repartiment nou"},"skat-card-game.copy.fields.nullWon":{"context":"skat-card-game UI copy.fields.nullWon","source_hash":"e01d0c1ad8201bab5b63226a7385048b1e086ab2cc2644d7e5fa644ebb41da2f","translation":"Feta nul· la: el declarant no ha fet cap truc."},"skat-card-game.copy.fields.roundResult":{"context":"skat-card-game UI copy.fields.roundResult","source_hash":"1c93f5d6014a504e666dda13c9e209673e4b59ed19adfe0bb1777c71ea1216f1","translation":"Resultat del repartiment"},"skat-card-game.copy.fields.ruleSource":{"context":"skat-card-game UI copy.fields.ruleSource","source_hash":"5f50c454e6864854d3685a041dbc13a9a5a36b14c4daa80892ef4d0b2efd9b0a","translation":"International Skat Order (alemany)"},"skat-card-game.copy.fields.you":{"context":"skat-card-game UI copy.fields.you","source_hash":"08b041935798fbf6fd6ff51099ffedb140a475889986d14f5559ff8e7fc571dd","translation":"Vostè."},"skat-card-game.copy.language":{"context":"skat-card-game UI copy.language","source_hash":"a4fe65264ef7dbb38d104b1e81eb3350f3142f3d16f32bdec39b1d9b42c1b8d1","translation":"Idioma"},"skat-card-game.copy.limits":{"context":"skat-card-game UI copy.limits","source_hash":"2eafca25eb46a598de4d0d9cf8c1671c366c2b53b759e136be77eb7b0cdd3832","translation":"Aquest és un joc casual de pràctica per a tres jugadors amb dues CPU locals, no multijugador en línia, torneig, joc d'apostes o solucionador de joc perfecte. La subhasta és una escala de pràctica ascendent simplificada, no el diàleg complet del torneig. Funciona amb pals, grans i nuls amb els bàsics de la presa/mano, la legalitat del pal següent i la puntuació del repartiment. Obert/obert, Schneider/Schwarz anunciat, no s'implementen les penalitzacions de torneig ni les regles de la casa."},"skat-card-game.copy.title":{"context":"skat-card-game UI copy.title","source_hash":"5ebccba181e523ebf3c2180baac0304e1355593f32b65107a44388e5c595f095","translation":"Skat Online - Joc de cartes gratuït per a tres jugadors contra la CPU"},"skat-card-game.copy.useTool":{"context":"skat-card-game UI copy.useTool","source_hash":"843d0ad1bb31ad9fe5c7879a8d0d79d44ecd062e8ae6b470187e62ae93180f1f","translation":"Jugar a Skat"}},"locale":"ca","missing":["skat-card-game.copy.name","skat-card-game.copy.description","skat-card-game.copy.intro","skat-card-game.copy.exampleHeading","skat-card-game.copy.example","skat-card-game.copy.howItWorks","skat-card-game.copy.faqHeading","skat-card-game.copy.faq.0.a","skat-card-game.copy.faq.1.a","skat-card-game.copy.faq.2.q","skat-card-game.copy.faq.2.a","skat-card-game.copy.faq.3.q","skat-card-game.copy.faq.3.a","skat-card-game.copy.faq.4.q","skat-card-game.copy.faq.4.a","skat-card-game.copy.faq.5.q","skat-card-game.copy.faq.6.q","skat-card-game.copy.faq.6.a","skat-card-game.copy.faq.7.a","skat-card-game.copy.faq.8.q","skat-card-game.copy.limitsHeading","skat-card-game.copy.privacy","skat-card-game.copy.related","skat-card-game.copy.freeBadge","skat-card-game.copy.home","skat-card-game.copy.fields.resume","skat-card-game.copy.fields.deleteSave","skat-card-game.copy.fields.nextDeal","skat-card-game.copy.fields.ready","skat-card-game.copy.fields.readyStatus","skat-card-game.copy.fields.cpu","skat-card-game.copy.fields.forehand","skat-card-game.copy.fields.hand","skat-card-game.copy.fields.skat","skat-card-game.copy.fields.trick","skat-card-game.copy.fields.contract","skat-card-game.copy.fields.score","skat-card-game.copy.fields.eyes","skat-card-game.copy.fields.tricks","skat-card-game.copy.fields.turn","skat-card-game.copy.fields.bidNext","skat-card-game.copy.fields.pass","skat-card-game.copy.fields.cu