{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"rlc-circuit-calculator.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"Carrega un exemple"},"rlc-circuit-calculator.copy.additionalFaqs.1.answer":{"context":"rlc-circuit-calculator UI copy.additionalFaqs.1.answer","source_hash":"a0027fb9c91e4376b4b288a1bf0485cb799a4f5fc2a2d349880e24e09cd01b09","translation":"En ressonància, un RLC en sèrie ideal té una impedància mínima igual a R; un RLC paral·lel ideal té una impedància màxima igual a R. El comportament del corrent i la tensió, per tant, difereixen encara que l'ideal f₀ sigui el mateix."},"rlc-circuit-calculator.copy.additionalFaqs.1.question":{"context":"rlc-circuit-calculator UI copy.additionalFaqs.1.question","source_hash":"0c30b5c12cc69227e387725280eec22e553a4cba225d519295171affcdf8177d","translation":"Com difereixen els circuits RLC en sèrie i paral·lels?"},"rlc-circuit-calculator.copy.additionalFaqs.2.answer":{"context":"rlc-circuit-calculator UI copy.additionalFaqs.2.answer","source_hash":"d929113d31b49cd67fa0b70f4d3ec5403c3e4e89c98b4fcab359fb6074436c8a","translation":"Pel model en sèrie, Q = ω₀L/ R i l' amplada de banda és R/ (2πL). Pel model paral· lel, Q = R/ (ω₀L) i l' amplada de banda és 1/ (2πRC). Aquestes són relacions de ressonància única ideals."},"rlc-circuit-calculator.copy.fields.frequency":{"context":"rlc-circuit-calculator UI copy.fields.frequency","source_hash":"cd142c7604abf70b73af5a86d0d07108cb611cda3e0b64c943f8bb579e063498","translation":"Freqüència a avaluar"},"rlc-circuit-calculator.copy.fields.inductance":{"context":"rlc-circuit-calculator UI copy.fields.inductance","source_hash":"9ac621b9553b6e1400a6225848954f69ad24cd3579b8dfcc0e0f5c60e7c23c67","translation":"Inductància"},"rlc-circuit-calculator.copy.fields.resistance":{"context":"rlc-circuit-calculator UI copy.fields.resistance","source_hash":"5e7eb