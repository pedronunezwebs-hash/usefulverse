{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"canasta-card-game.copy.exampleHeading":{"context":"canasta-card-game UI copy.exampleHeading","source_hash":"c5872244109aaa97b376f35e70452f8bc4f5cdf67606bbabaeefffb1bb356c46","translation":"Un exemple ràpid"},"canasta-card-game.copy.faq.3.a":{"context":"canasta-card-game UI copy.faq.3.a","source_hash":"939607a824ddba0d96bb4bc2ec894b3501e5360a83e65e783199b7edbb48c36d","translation":"El mínim és 50 punts per sota dels punts acumulatius 1,500, 90 des de 1,500, 120 des de 3,000 i 150 des de 5,000. Els punts de fusió existents no es compten per a una nova obertura."},"canasta-card-game.copy.fields.clearSelection":{"context":"canasta-card-game UI copy.fields.clearSelection","source_hash":"cea4d2e010b8fd52bc28a66eca24ff0d616b2c7d982545757780c196c5cc04c7","translation":"Neteja la selecció"},"canasta-card-game.copy.fields.cpuTurn":{"context":"canasta-card-game UI copy.fields.cpuTurn","source_hash":"0b9577706de06f156b8dce3d112fadeeb12b7dfb332e8ad16438ff445105b2e5","translation":"L'ordinador està prenent el seu torn..."},"canasta-card-game.copy.fields.draw":{"context":"canasta-card-game UI copy.fields.draw","source_hash":"b0028796832327688a6dd76230d68b873b295c9b164017cc09ef23aa91d9b4ef","translation":"El partit està empatat."},"canasta-card-game.copy.fields.gameWon":{"context":"canasta-card-game UI copy.fields.gameWon","source_hash":"dd4b3a76440a647f9b3a6822f11bf0574ea3691bbd347aeffd4b8e87a44ab744","translation":"Heu arribat a l'objectiu i heu guanyat la partida!"},"canasta-card-game.copy.fields.readyStatus":{"context":"canasta-card-game UI copy.fields.readyStatus","source_hash":"2565595d9881f5426ba4f7ff009409b555053a4a02ad062f8a6c9dfce67f77fe","translation":"Escolliu Nova ronda per a començar."},"canasta-card-game.copy.fields.resumed":{"context":"canasta-card-game UI copy.fields.resumed","source_hash":"f200ed9ce82b4f47df7bc145dd132a3fbf7f06ff1af2fc3b04938e148fde49a5","translation":"S' ha reprès la ronda