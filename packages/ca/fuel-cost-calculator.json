{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fuel-cost-calculator.copy.description":{"context":"fuel-cost-calculator UI copy.description","source_hash":"28b0424515306b4664c435b6ef3c0375e35e4413eda885f057ab6db09788893e","translation":"Estima el combustible i el cost del viatge usant L/100 km, US MPG o imperial MPG. Afegeix un viatge de tornada i divideix el cost per passatgers. Gratuït al navegador."},"fuel-cost-calculator.copy.examples.3.text":{"context":"fuel-cost-calculator UI copy.examples.3.text","source_hash":"80a2dd27b28c7e970f497d43560333a8bdcc46a493767020d56ca8129f949833","translation":"200 milles a 40 imperial MPG usa 5 galons imperials. A 7.00 per galó, el cost és 35.00 GBP."},"fuel-cost-calculator.copy.faq.2.answer":{"context":"fuel-cost-calculator UI copy.faq.2.answer","source_hash":"a0655341c9476911f6218850265daa555d347d3b4c73aa46838318e9e7516354","translation":"Introduïu la distància d' una sola direcció en usar Viatge de tornada. Aquesta opció la duplica. Introduïu el viatge complet només quan es seleccioni Viatge d' una sola direcció."},"fuel-cost-calculator.copy.faq.4.question":{"context":"fuel-cost-calculator UI copy.faq.4.question","source_hash":"a1d33422cc16c263ac16f1f824d60e31e3479b74eeb8816af2386150291b67f7","translation":"Per què les parts arrodonides no sempre sumen exactament?"},"fuel-cost-calculator.copy.faq.6.question":{"context":"fuel-cost-calculator UI copy.faq.6.question","source_hash":"16509f9ac96d7dbbe8391c51c7a1b04b1e6cff75698e4db9ade0f30ee2f1a6bc","translation":"Això mostra els preus actuals del combustible?"},"fuel-cost-calculator.copy.faq.8.answer":{"context":"fuel-cost-calculator UI copy.faq.8.answer","source_hash":"6346bf2653a9151af5771bf07b9a66444fba2d2b92d4594d9f316b29a0a7ceb3","translation":"No. Només estima el combustible. Afegiu altres costos acordats per separat per a un pressupost de viatge complet."},"fuel-cost-calculator.copy.faq.8.question":{"context":"fuel-cost-calculator UI copy.faq.8.question","source_hash":"c11af5f5ccab97b1a1f7bd0104a3613ebd3bd55270014ef72b82e04ae5c11c18","translation":"L'estimació inclou els peatges o el desgast del vehicle?"},"fuel-cost-calculator.copy.faq.9.answer":{"context":"fuel-cost-calculator UI copy.faq.9.answer","source_hash":"3b77456371d776f1744ad5a2264005871fe45c880034d613fa37ec70142a4ec4","translation":"No necessàriament. El consum real canvia amb les condicions. El resultat és una estimació dels valors que proporcioneu."},"fuel-cost-calculator.copy.form.fields.c":{"context":"fuel-cost-calculator UI copy.form.fields.c","source_hash":"dddf9349afeae6c62b56691f005b6c3ec892f9f55988486bb4c745a5862bd9d4","translation":"Preu per litre"},"fuel-cost-calculator.copy.form.fields.currency":{"context":"fuel-cost-calculator UI copy.form.fields.currency","source_hash":"de3ac40ff858392eeb316d45b55dae2e75e634b3b9e2f8c72850b0531ec8d722","translation":"Etiqueta de moneda"},"fuel-cost-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"b237cee27f84a7011acd8ab8173e58dca2ef4322298ed9caa18bc7bf99e0be48","translation":"Introduïu la distància, l' ús de combustible i el preu de la bomba. Estimeu el cost del viatge, incloent un viatge d' tornada o una quota de passatgers."},"fuel-cost-calculator.copy.privacy.heading":{"context":"fuel-cost-calculator UI copy.privacy.heading","source_hash":"bef0dc8aaebf768fa2be1fb224ac1a08ac3fa810c85991f3040785b5239b6229","translation":"Càlculs privats, límits clars"},"fuel-cost-calculator.copy.ui.copied":{"context":"fuel-cost-calculator UI copy.ui.copied","source_hash":"a53e263c52533edb4352c9cba5d92004a24af3ea14a03481a95739f840650396","translation":"Copiat al porta- retalls."},"fuel-cost-calculator.copy.ui.errors.NOT_ENOUGH":{"context":"fuel-cost-calculator UI copy.ui.errors.NOT_ENOUGH","source_hash":"dea150bdfc2549c8be20d8114bc3689c883a873f0049febf17cb14037be47dc6","translation":"L' interval conté menys valors diferents del que heu sol· licitat. Amplieu- lo o permeteu repeticions."},"fuel-co