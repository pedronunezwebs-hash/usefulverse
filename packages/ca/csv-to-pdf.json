{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"csv-to-pdf.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"Carrega un exemple"},"csv-to-pdf.copy.actions.result":{"context":"Shared UI copy.actions.result","source_hash":"65678eb33ccf9e4d7210c4f53fb526e4e1fb57638c9f3c1c587141cf5a479161","translation":"Taula imprimible"},"csv-to-pdf.copy.additionalFaqs.0.answer":{"context":"csv-to-pdf UI copy.additionalFaqs.0.answer","source_hash":"a491169782cf61b111a4db6480160b4e2cd83d6f9d36c3e9679f3a53e7e756af","translation":"Sí. Obteniu una vista prèvia, escolliu Imprimeix o Desa com a PDF, i seleccioneu Desa com a PDF en el diàleg d' impressió del navegador si està disponible."},"csv-to-pdf.copy.additionalFaqs.1.answer":{"context":"csv-to-pdf UI copy.additionalFaqs.1.answer","source_hash":"6be36ae7299ba7cf55dbcd64436706f9ce7c8f9b5c86894ccf502d687e49f5e7","translation":"No. CSV emmagatzema valors de text pla. Aquesta eina imprimeix els valors mostrats i no calcula fórmules ni preserva estils de full de càlcul, gràfics o pestanyes de llibre de treball."},"csv-to-pdf.copy.additionalFaqs.2.answer":{"context":"csv-to-pdf UI copy.additionalFaqs.2.answer","source_hash":"79e6214bf0ca8f496dcd2d73e15d53d1a1976baf15fabc59efa1402e6bcf6951","translation":"Els fitxers es queden al vostre dispositiu i estan limitats a 5 MiB, 2,000 files de dades, 40 columnes i 50,000 cel· les per tal que el navegador pugui construir una taula imprimible."},"csv-to-pdf.copy.fields.accuracyNote":{"context":"csv-to-pdf UI copy.fields.accuracyNote","source_hash":"bfa8af6720f321b7d30a8991a0b6ecc83009d91290b707f0fbe0d28e829130f8","translation":"Això només imprimeix les dades de la taula simple. No manté l' estil del full de càlcul, les fórmules, els gràfics o els fulls del llibre de treball."},"csv-to-pdf.copy.fields.limitNote":{"context":"csv-to-pdf UI copy.fields.limitNote","source_hash":"bb5e135d81215339668b47afe3de3e72b3d2e81d16c52ed02216bc52bdc01e6f","translation":"Límits locals: 5 MiB, 2,000 files de dades, 40 columnes i 50,000 cel· les. Una taula gran pot trigar més a imprimir- se en un telèfon."},"csv-to-pdf.copy.fields.orientation":{"context":"csv-to-pdf UI copy.fields.orientation","source_hash":"6a6e01c73a80d8040e494efb0b15b5d6e1d920deb21968ebcc9e5fb8383d1dc4","translation":"Orientació de la pàgina"},"csv-to-pdf.copy.howAnswer":{"context":"csv-to-pdf UI copy.howAnswer","source_hash":"917866acfdab2a05d54bbe930a484fa5efcc1bfdd733a9607967ec67ac21dd10","translation":"Escolliu un fitxer CSV, confirmeu el seu separador i codificació de text, visualitzeu la taula, establiu les opcions de pàgina i seleccioneu Imprimeix o Desa com a PDF. La conversió romandrà al navegador."},"csv-to-pdf.copy.intro":{"context":"Shared UI copy.intro","source_hash":"b02cbb309a67e88519329d9ade4dcada0b0b5b3199551f9a93563f70246365df","translation":"Converteix una taula CSV en una pàgina imprimible neta. Vegeu les files, escolliu el paper i la disposició, llavors useu el diàleg d' impressió del navegador per desar com a PDF."},"csv-to-pdf.copy.messages.bagsToBuy":{"context":"Shared UI copy.messages.bagsToBuy","source_hash":"a89760dac2e54e45dd5902cb4c842481cde3f3a18cf1e636c62843a2383e997f","translation":"Compra bosses senceres"},"csv-to-pdf.copy.messages.checkInputs":{"context":"Shared UI copy.messages.checkInputs","source_hash":"6ff8847244631961a615cde9eed82d7f815735e6002cecc11729e195e9e56b3d","translation":"Introduïu un número superior a zero per a cada mesura requerida. Comproveu també els valors opcionals."},"csv-to-pdf.copy.messages.estimatedWeight":{"context":"Shared UI copy.messages.estimatedWeight","source_hash":"25e39d42c673f4802d073a6f3d5f448206846fdd0a959d92f8a176123e2edf71","translation":"Pes estimat"},"csv-to-pdf.copy.messages.noRows":{"context":"Shared UI copy.messages.noRows","source_hash":"3d98bfd22fa4df2a15acc71280ab81f3c93bc59811a4a6c85c7ce90986e20