{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"schnapsen-card-game.copy.example":{"context":"schnapsen-card-game UI copy.example","source_hash":"c1aa01d5d0f73408dbbf3a17652642230ec189094b267519d6a61b7d29237593","translation":"Cada jugador rep cinc cartes. Guanyeu peces per recollir punts de carta, anuncieu un matrimoni Rei-Reina per 20 o 40, i sigueu el primer a reclamar correctament 66."},"schnapsen-card-game.copy.faq.0.a":{"context":"schnapsen-card-game UI copy.faq.0.a","source_hash":"2eaad7118c5494a9370079931990abb897abe96eb4c2951132867cdee693b199","translation":"Aquesta pàgina usa el Schnapsen austríac: cartes 20, mans de cinc cartes i l'intercanvi de la sota de triomf. No és el joc alemany de cartes 24 Sechsundsechzig."},"schnapsen-card-game.copy.faq.2.a":{"context":"schnapsen-card-game UI copy.faq.2.a","source_hash":"37c133a841c84f82e0d8d9413eab8fb82f93ec8c50eb4c334fe173237c219953","translation":"Quan conduïu amb cinc cartes a la mà, podeu tancar la pila. Això acaba el robar i us compromet a arribar a 66; la puntuació de l'adversari al tancament afecta el resultat."},"schnapsen-card-game.copy.fields.chooseCard":{"context":"schnapsen-card-game UI copy.fields.chooseCard","source_hash":"257a5901d1c5d73d23cb758973938e67a8ed446a870a8015373f704fe5c5bf09","translation":"Seleccioneu una carta i després jugueu- la."},"schnapsen-card-game.copy.fields.claim66":{"context":"schnapsen-card-game UI copy.fields.claim66","source_hash":"e4a8beb9342a2fe6dd0f9dd0b9bdb0b30ea70c79d6b3302b3bb7e4853a44b60e","translation":"Afirmació 66"},"schnapsen-card-game.copy.fields.claimAvailable":{"context":"schnapsen-card-game UI copy.fields.claimAvailable","source_hash":"61f472ab052a3cc884fdbeb2ab56c2a9a95466ae8aec390b0441fc51caa88fd4","translation":"Teniu com a mínim 66 punts comptabilitzats. Reclamar després d' aquest truc o casament."},"schnapsen-card-game.copy.fields.invalid":{"context":"schnapsen-card-game UI copy.fields.invalid","source_hash":"8c3a1bc87d36943c