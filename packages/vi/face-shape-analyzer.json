{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"face-shape-analyzer.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"Tải ví dụ"},"face-shape-analyzer.copy.actions.start":{"context":"Shared UI copy.actions.start","source_hash":"e4bb9f1ece9af9264a3b9e3913bbdb2cf497457167b14ced5f85688bfde74644","translation":"Bắt đầu"},"face-shape-analyzer.copy.additionalFaqs.1.answer":{"context":"face-shape-analyzer UI copy.additionalFaqs.1.answer","source_hash":"c83fd72627cf1f77b0c535ba64b39d351a9d835e35d8c7dff12b8b7c4896e949","translation":"Các nhãn hình khuôn mặt là các phân loại kiểu dáng không chính thức, không phải là thông tin y tế hay nhận dạng. Kỹ thuật đo lường và biến đổi tự nhiên có thể thay đổi kết quả; tỷ lệ hỗn hợp có thể không phù hợp với một phân loại duy nhất. Công cụ chỉ sử dụng các con số bạn nhập và không truy cập máy ảnh hay lưu các đo lường."},"face-shape-analyzer.copy.description":{"context":"face-shape-analyzer UI copy.description","source_hash":"cf949989a25c29203b7bd4376e82017adc2d56931f8588de596c26a2f987287d","translation":"Khám phá một dạng khuôn mặt truyền thống từ bốn đo đạc bạn nhập. Không có gì được chụp ảnh hay tải lên."},"face-shape-analyzer.copy.fields.shape_round_or_square":{"context":"face-shape-analyzer UI copy.fields.shape_round_or_square","source_hash":"e9a967a1d8daae672e1d9529dbddde70859f0610e341d48f5cda2a7f86720337","translation":"Tỷ lệ tròn hay vuông"},"face-shape-analyzer.copy.howAnswer":{"context":"face-shape-analyzer UI copy.howAnswer","source_hash":"0c393082580f72429970612ed2381105c7ad084dd69ae83358b27fc9d345d81d","translation":"Đo chiều rộng trán, chiều rộng xương gò má, chiều rộng hàm và chiều dài khuôn mặt sử dụng cùng một đơn vị. Trang này so sánh tỷ lệ và hiển thị sự phát minh đơn giản đằng sau một phân loại xấp xỉ."},"face-shape-analyzer.copy.messages.complete":{"context":"Shared UI copy.message