{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"switzerland-health-deductible-comparator.copy.example":{"context":"switzerland-health-deductible-comparator UI copy.example","source_hash":"4cc5ed6c7118c9fc23cfada16af3f997cd70089b8fe06f21d5227a5227782b4e","translation":"Nếu một người lớn nhập bảo hiểm hàng tháng CHF 400 với mức khấu trừ CHF 300 và CHF 350 với mức khấu trừ CHF 2,500, chênh lệch bảo hiểm hàng năm là CHF 600. So sánh việc tiết kiệm đó với sự chênh lệch mô hình trong việc chia sẻ chi phí ở mỗi mức chi phí hợp lệ thấp, dự kiến và cao của bạn."},"switzerland-health-deductible-comparator.copy.faq.2.answer":{"context":"switzerland-health-deductible-comparator UI copy.faq.2.answer","source_hash":"d30ed4c6406d57f3621a53484697aab2c63efb3bc7f241cbe002e51ba155ffe0","translation":"Không, mô hình này bao gồm chi phí trừ đi thông thường và phí giữ lại 10% tiêu chuẩn trên chi phí hợp lệ. Nó không bao gồm các khoản đóng góp ngày bệnh viện, giữ lại thuốc đặc biệt 40%, dịch vụ miễn phí, chăm sóc không được bảo hiểm và bảo hiểm bổ sung."},"switzerland-health-deductible-comparator.copy.faq.2.question":{"context":"switzerland-health-deductible-comparator UI copy.faq.2.question","source_hash":"b8ba082e8f3b64612114110b8a6dc71c52bc0baa3cb54e745c6b180260fbea0d","translation":"Đây có phải là toàn bộ hóa đơn y tế của tôi không?"},"switzerland-health-deductible-comparator.copy.fields.breakEvenSpend":{"context":"switzerland-health-deductible-comparator UI copy.fields.breakEvenSpend","source_hash":"1c1247eb126aad977279c3272a29c6befd2aaf709fa8ab54d759379f572e22ea","translation":"Chi phí y tế khi tiết kiệm bảo hiểm đã hết"},"switzerland-health-deductible-comparator.copy.fields.highCostShare":{"context":"switzerland-health-deductible-comparator UI copy.fields.highCostShare","source_hash":"69c6be6070ff19290216f574b5f889ae3f4d707e4103ec9e775d15d6996c91ff","translation":"Chi phí chia sẻ với chi phí cao"},"switzerland-health-deductible-comparator.copy.fields.lowC