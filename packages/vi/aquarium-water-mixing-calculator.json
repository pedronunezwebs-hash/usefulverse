{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"aquarium-water-mixing-calculator.copy.description":{"context":"aquarium-water-mixing-calculator UI copy.description","source_hash":"61dd91488b833acdedd8ce221383d57763de1b7915bdbefefd4108721cf6320b","translation":"Trộn hai nguồn nước bằng cách đo GH và KH. Thay đổi đơn vị độ cứng Đức, Pháp, ppm và meq/L, kiểm tra nếu cả hai mục tiêu tương thích, và tính toán lít địa phương."},"aquarium-water-mixing-calculator.copy.details":{"context":"aquarium-water-mixing-calculator UI copy.details","source_hash":"e529ff5cbce7bbde87ab815f67e792fd239e078941ada7be3cbd52aa843fb31f","translation":"Mỗi giá trị độ cứng được chuyển đổi thành độ Đức để tính toán. GH và KH được coi là nồng độ đo được trộn lẫn tuyến tính; công cụ kiểm tra cả hai độc lập và chỉ cho một công thức nước khi hai kết quả đồng ý trong 0.05 °dH."},"aquarium-water-mixing-calculator.copy.faq.4.a":{"context":"aquarium-water-mixing-calculator UI copy.faq.4.a","source_hash":"a824dc3105b10cbaeb5ec506e03d2124af3d7abc1f365a5fa6627269841c8a7f","translation":"Không. pH không pha trộn theo đường thẳng, và nước phù hợp cho bể cá phụ thuộc vào loài và các tính chất hóa học khác. Công cụ này chỉ ước tính tỉ lệ pha trộn GH/ KH từ các đo đạc được cung cấp."},"aquarium-water-mixing-calculator.copy.fields.german":{"context":"aquarium-water-mixing-calculator UI copy.fields.german","source_hash":"579a57b4fad01db2b594922027e825610fc5d33ce801fc0b98d69e873152420b","translation":"Cấp Đức (°dH)"},"aquarium-water-mixing-calculator.copy.fields.ghRatio":{"context":"aquarium-water-mixing-calculator UI copy.fields.ghRatio","source_hash":"e468fe22f0c9b266fdf63f2bdb5bf9d4b3fb9e793b4802d1e35c95b1ca0443a4","translation":"Nguồn A share required by GH"},"aquarium-water-mixing-calculator.copy.fields.incompatible":{"context":"aquarium-water-mixing-calculator UI copy.fields.incompatible","source_hash":"ecfc5078a6a2690d6e85f059bbb11dd24c961368d0bab16de456fec247bb4ddc","translation":