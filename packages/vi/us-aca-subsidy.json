{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"us-aca-subsidy.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"4dbb46fc867a7b17cea649674662720d4e85b95589c1f4feea6bd44f23d870d0","translation":"Tải ví dụ"},"us-aca-subsidy.copy.actions.start":{"context":"Shared UI copy.actions.start","source_hash":"e4bb9f1ece9af9264a3b9e3913bbdb2cf497457167b14ced5f85688bfde74644","translation":"Bắt đầu"},"us-aca-subsidy.copy.fields.accuracyNote":{"context":"us-aca-subsidy UI copy.fields.accuracyNote","source_hash":"aa93625ce4b55ecbb584f9f9511ebaa603922df529412a2799f59111620b90a6","translation":"Kịch bản năm địa phương này sử dụng bảng tỷ lệ phần trăm 2026 và hướng dẫn nghèo 2025 được sử dụng để đăng ký vào thị trường 2026. Đây không phải là quyết định đầy đủ về khả năng, báo giá thị trường, tính toán mẫu 8962 hoặc nộp thuế. Người sử dụng lao động và chính phủ, tình trạng nộp hồ sơ, bảo hiểm một phần năm và các quy tắc khác có thể thay đổi kết quả. Phí bảo hiểm là đầu vào của bạn; không có dữ liệu nào được tải lên hoặc lưu."},"us-aca-subsidy.copy.fields.irsSource":{"context":"us-aca-subsidy UI copy.fields.irsSource","source_hash":"dfde4797a7cd3b1c9121220c2cec9da4ce1632e4f2d4bea6a77c1eab1279da05","translation":"IRS 2026 tỷ lệ áp dụng và hướng dẫn"},"us-aca-subsidy.copy.fields.monthlyCredit":{"context":"us-aca-subsidy UI copy.fields.monthlyCredit","source_hash":"ed7f25602bd67175064e726fff849780486bf789d1d983c47cecce3d092cffdc","translation":"Kịch bản tín dụng trung bình hàng tháng"},"us-aca-subsidy.copy.howAnswer":{"context":"us-aca-subsidy UI copy.howAnswer","source_hash":"9ef5955b62b821093a1ce8b9f502c520d5ce1c00c8cf1c9f42e9f3be34bba6a1","translation":"Nhập ước tính MAGI hộ gia đình, kích thước gia đình, khu vực FPL, phí bảo hiểm kế hoạch bạc thấp thứ hai hàng năm, và phí bảo hiểm đăng ký hàng năm của bạn."},"us-aca-subsidy.copy.messages.fileError":{"context":"Shared UI copy.messages.fileError","source_hash":"da2bff338747a6e8148