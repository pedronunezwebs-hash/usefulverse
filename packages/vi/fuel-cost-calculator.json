{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fuel-cost-calculator.copy.description":{"context":"fuel-cost-calculator UI copy.description","source_hash":"28b0424515306b4664c435b6ef3c0375e35e4413eda885f057ab6db09788893e","translation":"Ước tính nhiên liệu và chi phí chuyến đi bằng cách sử dụng L/100 km, US MPG hoặc imperial MPG. Thêm một chuyến đi trở về và chia chi phí theo hành khách. Miễn phí trong trình duyệt."},"fuel-cost-calculator.copy.examples.3.text":{"context":"fuel-cost-calculator UI copy.examples.3.text","source_hash":"80a2dd27b28c7e970f497d43560333a8bdcc46a493767020d56ca8129f949833","translation":"200 dặm ở 40 imperial MPG dùng 5 imperial gallon. Ở 7.00 mỗi gallon, chi phí là 35.00 GBP."},"fuel-cost-calculator.copy.faq.4.question":{"context":"fuel-cost-calculator UI copy.faq.4.question","source_hash":"a1d33422cc16c263ac16f1f824d60e31e3479b74eeb8816af2386150291b67f7","translation":"Tại sao các cổ phiếu tròn không luôn luôn tổng chính xác?"},"fuel-cost-calculator.copy.faq.9.answer":{"context":"fuel-cost-calculator UI copy.faq.9.answer","source_hash":"3b77456371d776f1744ad5a2264005871fe45c880034d613fa37ec70142a4ec4","translation":"Không nhất thiết. Sử dụng thực sự thay đổi theo điều kiện. Kết quả là ước tính từ giá trị bạn cung cấp."},"fuel-cost-calculator.copy.form.fields.c":{"context":"fuel-cost-calculator UI copy.form.fields.c","source_hash":"dddf9349afeae6c62b56691f005b6c3ec892f9f55988486bb4c745a5862bd9d4","translation":"Giá mỗi lít"},"fuel-cost-calculator.copy.form.fields.currency":{"context":"fuel-cost-calculator UI copy.form.fields.currency","source_hash":"de3ac40ff858392eeb316d45b55dae2e75e634b3b9e2f8c72850b0531ec8d722","translation":"Nhãn tiền tệ"},"fuel-cost-calculator.copy.form.hint":{"context":"fuel-cost-calculator UI copy.form.hint","source_hash":"9c82738424488dd1290e1905689fbabab4c6b6b42c687ab0799aa3a752cb4b24","translation":"Đặt đơn vị giá bơm tương ứng với đơn vị nhiên liệu đã chọn. Tiền tệ là một nhãn, không phải là một biến đổi tỷ giá hối đoái thực."},"fuel-cost-calculator.copy.form.modeLabels.us.b":{"context":"fuel-cost-calculator UI copy.form.modeLabels.us.b","source_hash":"30f8212f899cdc8a62b1664ad78f7dd473359d9a5b82fb742a69d550712fd1b0","translation":"Hiệu suất (US MPG)"},"fuel-cost-calculator.copy.method.paragraphs.3":{"context":"fuel-cost-calculator UI copy.method.paragraphs.3","source_hash":"2650f6ef3afb1a464fa9cfd375dcafeb6249b5e74bef004f63d2232bf7b1ea7d","translation":"Chuyến đi trở về sẽ gấp đôi khoảng cách đi một chiều trước khi tính lượng nhiên liệu. Nhập khoảng cách đi một chiều ngay cả khi chọn tùy chọn đó. Nếu chuyến đi trở về có chiều dài hoặc lượng nhiên liệu khác nhau, tính toán mỗi đoạn riêng lẻ và kết hợp số lượng."},"fuel-cost-calculator.copy.navigation.home":{"context":"fuel-cost-calculator UI copy.navigation.home","source_hash":"3a78695388b38b5cceefaf6796b0137877514593543b91af2752d5a17e3d736c","translation":"Nhà"},"fuel-cost-calculator.copy.sourcesText":{"context":"fuel-cost-calculator UI copy.sourcesText","source_hash":"2ca12e5930143193abc7ef654dc9490feafa270d5cc0a75f6aab40a8f0e000c1","translation":"Đọc các quy tắc nguồn và so sánh các ví dụ làm việc. Không có dịch vụ tính toán bên ngoài nào nhận đầu vào của bạn."},"fuel-cost-calculator.copy.ui.cancelled":{"context":"fuel-cost-calculator UI copy.ui.cancelled","source_hash":"cbc7e63195c8c729eb51e1604d71b9a5e25fa25e519cbe3319c9563fe20ffb48","translation":"Dừng. Thay đổi đầu vào hoặc tính lại."},"fuel-cost-calculator.copy.ui.copied":{"context":"fuel-cost-calculator UI copy.ui.copied","source_hash":"a53e263c52533edb4352c9cba5d92004a24af3ea14a03481a95739f840650396","translation":"Sao chép vào bảng tạm."},"fuel-cost-calculator.copy.ui.decimalNote":{"context":"fuel-cost-calculator UI copy.ui.decimalNote","source_hash":"130afa47f1fb786eeebfdef705eb46297f9d4ab3d1e6d6a161954a9537c72251","translation":"Các giá trị thập phân được tròn đến 12. Phần số vẫn chính xác."},"fuel-cost-calculator.copy.ui.featuresLabel"