{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"percentage-calculator.copy.examples.2.text":{"context":"percentage-calculator UI copy.examples.2.text","source_hash":"0663c652695ab0c09f08d5d21f476a6d3464cd761fa52e470e9601f178c3d0af","translation":"80 và 120 có tỷ lệ phần trăm khác nhau của 40%, sử dụng trung bình của 100 như là tham chiếu."},"percentage-calculator.copy.faq.0.answer":{"context":"percentage-calculator UI copy.faq.0.answer","source_hash":"8a055e5310f75e4ec73ad05c40cc7be8c940801d4837c3dc2c7089c0ba9ff44d","translation":"Chọn Tỷ lệ phần trăm của một giá trị. Đầu tiên nhập tỉ lệ phần trăm và sau đó nhập số tiền cơ sở. Ví dụ, 15% của 200 là 30."},"percentage-calculator.copy.faq.1.question":{"context":"percentage-calculator UI copy.faq.1.question","source_hash":"982a77516af2676a5cb692e3f779c4bce33777ee18109c6e1584db04f4c8dd69","translation":"Làm sao tôi tìm được toàn bộ bản gốc?"},"percentage-calculator.copy.faq.6.answer":{"context":"percentage-calculator UI copy.faq.6.answer","source_hash":"58f941eedb0094ac6b3deea6ecf3b5f967ff0aa3d43a3e61e65090709c5da7ba","translation":"Không. Tỷ lệ phần trăm trên 100 là hợp lệ. Giảm trên 100 có thể tạo ra kết quả âm, vì vậy hãy giải thích ngữ cảnh cẩn thận."},"percentage-calculator.copy.faq.9.question":{"context":"percentage-calculator UI copy.faq.9.question","source_hash":"cef1f540e644606dd68e8153da86b19e6f2ab20db4e92ddc3f8388edd17397c9","translation":"Tôi có thể hủy bỏ giảm giá bằng cách thêm cùng một phần trăm không?"},"percentage-calculator.copy.form.modeLabels.change.b":{"context":"percentage-calculator UI copy.form.modeLabels.change.b","source_hash":"7ca9b97db8e5fed63d6e75e1c970c3e29c514436d5b9390d94f8a907bca92b12","translation":"Giá trị mới"},"percentage-calculator.copy.form.modeLabels.of.b":{"context":"percentage-calculator UI copy.form.modeLabels.of.b","source_hash":"6eada24ff447a65f044fa10b4225144ea5f50ed781717b672329c649747414a8","translation":"Giá trị cơ sở"},"percentage-calculator.copy.form.modes.of":{"context":"percentage-calculator UI copy.form.modes.of","source_hash":"3ca8ef3d6c84d92a4342122639e6a4d612486bbc507b2a9faea63e4b77553790","translation":"Tỷ lệ phần trăm giá trị"},"percentage-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"ea016446549509b96e619593431fabe7571e8c8eb107f4d267db6637a898b484","translation":"Chọn câu hỏi phần trăm bạn cần trả lời. Nhập hai giá trị và xem công thức cũng như kết quả."},"percentage-calculator.copy.method.paragraphs.1":{"context":"percentage-calculator UI copy.method.paragraphs.1","source_hash":"82bedcebc7ca9439235a632b6f5ea15c8a715fe46fe6a36e3aceeb07ceaf9918","translation":"Tỷ lệ thay đổi so sánh một giá trị mới với tham chiếu gốc. Công thức là (new - original) / |original| × 100. Điểm chia tuyệt đối cho một quy ước rõ ràng cho các giá trị khởi đầu âm. Di chuyển từ -10 đến -5 do đó cho +50% trong công cụ này."},"percentage-calculator.copy.navigation.method":{"context":"percentage-calculator UI copy.navigation.method","source_hash":"206fd2b03204fe9e9df9ce2d22f9a340e96e7c9c830092dfb1d88b6b4c40a704","translation":"Phương pháp & ý nghĩa"},"percentage-calculator.copy.privacy.paragraphs.2":{"context":"percentage-calculator UI copy.privacy.paragraphs.2","source_hash":"8b3fd9a899a4f3c379c1bc5f5801391bfa6053d76d429ccef1de4f2589ffbb6f","translation":"Tính toán lớn phụ thuộc vào thời gian và bộ nhớ của thiết bị. Hủy sẽ dừng công việc đang chạy. Lỗi sẽ xóa các câu trả lời cũ và vô hiệu hóa việc tải về chúng."},"percentage-calculator.copy.ui.digitNotice":{"context":"percentage-calculator UI copy.ui.digitNotice","source_hash":"b9f5000e5540eb7bae5e906ab3a1b7f5eaec6a9b05f92fcceb0e98079b138bea","translation":"Đọc từng chữ số; thang đo tiếng Anh không được sử dụng cho giá trị này."},"percentage-calculator.copy.ui.empty":{"context":"percentage-calculator UI copy.ui.empty","source_hash":"72f9b98ac8ee163204fef0a6f69a9f77fe2fc236cbb20f021cbf1b65b74b8326","translation":"Kết quả của bạn sẽ xuất hiện ở đây."},"