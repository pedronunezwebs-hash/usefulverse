{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"flow-rate-calculator.copy.actions.calculate":{"context":"Shared UI copy.actions.calculate","source_hash":"2121cc15afb6ba5350deb90e1a292faa7d932537a19ddddadff4aeb796a8d595","translation":"Изчисли"},"flow-rate-calculator.copy.actions.circle":{"context":"Shared UI copy.actions.circle","source_hash":"b93d3bcecff5d7493a58a41ea44f7196a46295f6512ebc06940510676a666384","translation":"Кръг"},"flow-rate-calculator.copy.additionalFaqs.1.answer":{"context":"flow-rate-calculator UI copy.additionalFaqs.1.answer","source_hash":"7c573fd71701c5e24bd47ca8e0166f74d1abdd30205c3784fa09ec87d1ac23bf","translation":"Умножете площта на напречното сечение на тръбата по средната скорост на флуида.За кръгла тръба, площта е π пъти вътрешния диаметър на квадрат, разделен на четири; използвайте вътрешния диаметър, а не външния диаметър."},"flow-rate-calculator.copy.additionalFaqs.2.answer":{"context":"flow-rate-calculator UI copy.additionalFaqs.2.answer","source_hash":"a664962ae4c403ca652e8c38c43efdfcde0ecc63186e8d676e83c3155c5ab18e","translation":"Разделете обема на резервоара на дебитната скорост, като използвате съвместими единици за обем и време.Оценката предполага, че дебитът остава постоянен и резервоарът не прелива или губи течност."},"flow-rate-calculator.copy.additionalFaqs.2.question":{"context":"flow-rate-calculator UI copy.additionalFaqs.2.question","source_hash":"cffa48f25cc229417de12392b582fcee47267fe87caad80c176309eae47df2e4","translation":"Как да преценя колко време отнема пълненето на резервоара?"},"flow-rate-calculator.copy.howAnswer":{"context":"flow-rate-calculator UI copy.howAnswer","source_hash":"1f3f4899f63ab5cc3e1f65d9265252070b9fa68d439aaa24dc4a03795f9b489f","translation":"За постоянен поток през дадена секция, обемният дебит е равен на площта на напречното сечение умножена по средната скорост За да се изчисли времето за пълнене, обемът на контейнера се дели на дебит. Реалните системи могат да варират с налягане, триене, фитинги, свойства на флуида и променящи се нива."},"flow-rate-calculator.copy.howQuestion":{"context":"Shared UI copy.howQuestion","source_hash":"e2638b6bc67a72d651d4c174b47410000757e25660b285e32cef37355793e026","translation":"Как да изчисля скоростта на потока?"},"flow-rate-calculator.copy.messages.angle":{"context":"Shared UI copy.messages.angle","source_hash":"1968034b13f84d0c3e441fcc8b5f3ec7b75fcabdbcecb68177445498557d3e33","translation":"Ъгъл"},"flow-rate-calculator.copy.messages.maxMoment":{"context":"Shared UI copy.messages.maxMoment","source_hash":"9e1788c937440f0fc3cfd437c5bd11ba46dc9dd6a5982dc74139ff9df9e11eca","translation":"Максимален момент на огъване"},"flow-rate-calculator.copy.messages.momentArm":{"context":"Shared UI copy.messages.momentArm","source_hash":"315ea9d949b1edba5cb9404becae65d858585b11822371cf0325299232aa0fe5","translation":"Перпендикулярен момент ръка"},"flow-rate-calculator.copy.messages.neutral":{"context":"Shared UI copy.messages.neutral","source_hash":"1c6ac69f1e5db9c36e9f549d72ef77d23ceab19c557a7eb3a27c7f06f4484b44","translation":"Неутрален"},"flow-rate-calculator.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"18fe1d87e59c2545603f0184ce78978b46e108ca1e18f24e1a77c8862be23027","translation":"Изчисленията се изпълняват в този браузър. Стойностите, които въвеждате, не се качват или записват от този инструмент."}},"locale":"bg","missing":["flow-rate-calculator.copy.name","flow-rate-calculator.copy.title","flow-rate-calculator.copy.description","flow-rate-calculator.copy.intro","flow-rate-calculator.copy.privacyQuestion","flow-rate-calculator.copy.fields.mode","flow-rate-calculator.copy.fields.solveFlow","flow-rate-calculator.copy.fields.solveArea","flow-rate-calculator.copy.fields.solveVelocity","flow-rate-calculator.copy.fields.estimateFillTime","flow-rate-calculator.copy.fields.area","flow-rate-calculator.copy.fields.areaUnit","flow-rate-calculator.copy.fields.squareMeters","flow-ra