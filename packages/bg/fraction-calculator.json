{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fraction-calculator.copy.faqHeading":{"context":"fraction-calculator UI copy.faqHeading","source_hash":"60614104ed521729598445ddcf8330ba2f7c254806b3b9d9c156d0982b2c05b4","translation":"Въпроси относно това изчисление"},"fraction-calculator.copy.footer":{"context":"fraction-calculator UI copy.footer","source_hash":"cc6a568643e72d46318873863eaa7d8453c43c2bd226e53e97619f2e95091528","translation":"Полезни инструменти. Ясни резултати. Създадени за вашия браузър."},"fraction-calculator.copy.method.paragraphs.0":{"context":"fraction-calculator UI copy.method.paragraphs.0","source_hash":"9614b44469c2e261bc3d4423d6138004e20ce7b690a3da0a434535255a2f467d","translation":"Дробът има числител над ненулев знаменател. Знаменателя нарича еднакво големите части. Числителят брои тези части. Намаляването на двете числа от най-големия им общ делител запазва стойността непроменена. Положителният знаменател улеснява сравняването на знаците."},"fraction-calculator.copy.method.paragraphs.5":{"context":"fraction-calculator UI copy.method.paragraphs.5","source_hash":"641a721581662619f1d93c3d34e282ce693cb987ef849272aa6b71432ff000d4","translation":"Добавяне на списък, когато една рецепта или упражнение има много термини. Празните редове се пропускат. Всеки ред се добавя по ред, а работата запазва всяка междинна сума. Този режим добавя стойности; той не анализира общ израз с предимство на оператора."},"fraction-calculator.copy.navigation.allTools":{"context":"fraction-calculator UI copy.navigation.allTools","source_hash":"81c151f98a190da765d67a020d175d400bfd9e46ed8da05bdaeeb0a9b8eef566","translation":"Всички инструменти »"},"fraction-calculator.copy.navigation.faq":{"context":"fraction-calculator UI copy.navigation.faq","source_hash":"170c554f6d94a09b2ec7ad12f0b43cd2245655c2a8716b2bfce24cf80e5b7901","translation":"Въпроси & отговори"},"fraction-calculator.copy.privacy.heading":{"context":"fraction-calculator UI copy.privacy.heading","source_hash":"bef0dc8aaebf768fa2be1fb224ac1a08ac3fa810c85991f3040785b5239b6229","translation":"Частни изчисления, ясни граници"},"fraction-calculator.copy.privacy.paragraphs.0":{"context":"fraction-calculator UI copy.privacy.paragraphs.0","source_hash":"2a8a7346782ddf710d2aeed2933d35a281ab8c2cb38470663cc705491c8c8dce","translation":"Вашите входове и резултати остават в този браузър.Изчислението се изпълнява в локална работна програма, без изчисление или качени данни."},"fraction-calculator.copy.privacy.paragraphs.2":{"context":"fraction-calculator UI copy.privacy.paragraphs.2","source_hash":"8b3fd9a899a4f3c379c1bc5f5801391bfa6053d76d429ccef1de4f2589ffbb6f","translation":"Големите изчисления зависят от времето на устройството и паметта.Отказ спира активната задача.Грешка изтрива старите отговори и забранява изтеглянето им."},"fraction-calculator.copy.sourcesHeading":{"context":"fraction-calculator UI copy.sourcesHeading","source_hash":"ad180e24b51e8dadbc735c0373e09d62e666a13fead123dfc44db64aebfbb4a6","translation":"Препратки за изчисление"},"fraction-calculator.copy.sourcesText":{"context":"fraction-calculator UI copy.sourcesText","source_hash":"2ca12e5930143193abc7ef654dc9490feafa270d5cc0a75f6aab40a8f0e000c1","translation":"Прочетете правилата на източника и сравнете работещите примери.Няма външна услуга за изчисление, която да получава вашите данни."},"fraction-calculator.copy.ui.answers.prime":{"context":"fraction-calculator UI copy.ui.answers.prime","source_hash":"dd8444850764b8740de73e71453b36697dc0c8bfa173ec1f3cece323ffff98e0","translation":"Прайм"},"fraction-calculator.copy.ui.calculate":{"context":"fraction-calculator UI copy.ui.calculate","source_hash":"2121cc15afb6ba5350deb90e1a292faa7d932537a19ddddadff4aeb796a8d595","translation":"Изчисли"},"fraction-calculator.copy.ui.cancel":{"context":"fraction-calculator UI copy.ui.cancel","source_hash":"19766ed6ccb2f4a32778eed80d1928d2c87a18d7c275ccb163ec6709d3eb2e27","translation":"& Отказ"},"fraction-cal