{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-parental-benefit-planner.copy.example":{"context":"norway-parental-benefit-planner UI copy.example","source_hash":"e17880128eda76f798d6ecbd64e5e32d3cfe82c4b4d6f2a85623710fc3e299ee","translation":"Pour un enfant né le 1 novembre 2026, la période de NAV standard pendant laquelle les deux parents sont admissibles est de 49 semaines à 100% ou 61 semaines et de 1 jours à 80%. Le choix 80% échelonne généralement les paiements sur une période plus longue. Selon la NAV, le paiement total est approximativement égal."},"norway-parental-benefit-planner.copy.faq.2.a":{"context":"norway-parental-benefit-planner UI copy.faq.2.a","source_hash":"c25a79727aec58cf1438ec83e14d635ce033d61aef390667918cfde57bb57c19","translation":"Certains arrangements peuvent se chevaucher, mais le planificateur standard limite le retrait combiné à 100%.Les naissances multiples spéciales et autres exceptions doivent être vérifiées avec NAV."},"norway-parental-benefit-planner.copy.fields.comparisonHeading":{"context":"norway-parental-benefit-planner UI copy.fields.comparisonHeading","source_hash":"41a0bc0ab79c316f1dc76c821113198332159579ac2d9fc98d9108f1c7bf6de2","translation":"Comparez les deux choix de couverture"},"norway-parental-benefit-planner.copy.fields.comparisonShared":{"context":"norway-parental-benefit-planner UI copy.fields.comparisonShared","source_hash":"3567fe20f899c859d05b6a51b64a55315a54254c76d35a7182cc1e5d734c5251","translation":"Période partagée"},"norway-parental-benefit-planner.copy.fields.endDate":{"context":"norway-parental-benefit-planner UI copy.fields.endDate","source_hash":"67c5a381ba8bd5c8ba1cfa175776fdf8cc77739c48f696957342e480056ffcbd","translation":"Dernière date"},"norway-parental-benefit-planner.copy.fields.errorNotEligibleCase":{"context":"norway-parental-benefit-planner UI copy.fields.errorNotEligibleCase","source_hash":"1a7ed35484f3ddbad00fa45139c9912b656fa614bc77b178a1d31c814ed704f9","tr