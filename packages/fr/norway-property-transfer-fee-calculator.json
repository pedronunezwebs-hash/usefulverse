{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-property-transfer-fee-calculator.copy.description":{"context":"norway-property-transfer-fee-calculator UI copy.description","source_hash":"15a7886ebacbc442f5044efd082d79b95b55e3640b4e1ff396fec8afbc652514","translation":"Calculez l'impôt norvégien sur les transferts de propriété et les frais d'enregistrement en utilisant les taux 2026.Montrer la part acquise et toute exemption légale que vous avez vérifiée."},"norway-property-transfer-fee-calculator.copy.details":{"context":"norway-property-transfer-fee-calculator UI copy.details","source_hash":"4fe1493c27fa081466540c83453a65da27522e540f1860f2c56afb5f3c41ca60","translation":"Pour un transfert imposable de biens immobiliers enregistrés, la taxe de transfert de propriété 2026 est 2.5% de la valeur marchande de la part de propriété transférée, avec un minimum de NOK 250. Une unité coopérative d'habitation est exonérée de cette taxe. Les frais d'enregistrement sont distincts et facturés pour chaque document enregistré. L'estimation ne décide pas si une personne ou un transfert est admissible à une exonération légale."},"norway-property-transfer-fee-calculator.copy.exampleHeading":{"context":"norway-property-transfer-fee-calculator UI copy.exampleHeading","source_hash":"d029f87e3d80f8fd9b1be67c7426b4cc1ff47b4a9d0a8461c826a59d8c5eb6cd","translation":"Exemple"},"norway-property-transfer-fee-calculator.copy.fields.export":{"context":"norway-property-transfer-fee-calculator UI copy.fields.export","source_hash":"b28a0179ff0d5f8358d1f0bb1df83a4c07a3c29b803b65a65328746ffdb65be4","translation":"Estimation des exportations (CSV)"},"norway-property-transfer-fee-calculator.copy.fields.propertyValue":{"context":"norway-property-transfer-fee-calculator UI copy.fields.propertyValue","source_hash":"888cb239a8059e0e5a145ace6ddf3ae1fbd36be43b87683327d366686fc6b768","translation":"Valeur marchande totale de la propriété à l'immatriculation (NOK)"},"norway-pro