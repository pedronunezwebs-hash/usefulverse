{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"lines-of-action.copy.actions.resume":{"context":"Shared UI copy.actions.resume","source_hash":"d640c7421da066618a39daf4266da5f61f66a9b1afcd626481b831a17064965d","translation":"Reprendre"},"lines-of-action.copy.additionalFaqs.0.answer":{"context":"lines-of-action UI copy.additionalFaqs.0.answer","source_hash":"928250cafc7ac491f348b3e7b83b2ffda36fc04c0a72892956242dccaba2363d","translation":"Oui, il est gratuit dans votre navigateur et ne nécessite pas de compte. La mémoire de l'appareil et la prise en charge du navigateur s'appliquent toujours."},"lines-of-action.copy.fields.accuracyNote":{"context":"lines-of-action UI copy.fields.accuracyNote","source_hash":"09b37b643e7a02924e95e8009e90c8027ced5eda7adb57dae972f935a23258d0","translation":"Ceci suit la description de la règle 8×8 de l'International Computer Games Association: douze pièces par côté, comptage exact de la ligne complète, adjacence diagonale pour la connexion, passe lorsque vous ne pouvez pas bouger, et un match nul sur une troisième position répétée.Une variante publiée diffère sur les connexions simultanées; sélectionnez la règle que vous préférez.L'adversaire informatique utilise une petite heuristique locale et n'est pas un moteur de tournoi."},"lines-of-action.copy.fields.captured":{"context":"lines-of-action UI copy.fields.captured","source_hash":"8a03fa9ad749bcce484582760843efbb983ea7ec92c3444cbabafe1517b3dac5","translation":"Capturé"},"lines-of-action.copy.fields.legalDestination":{"context":"lines-of-action UI copy.fields.legalDestination","source_hash":"e6ec90033fe66b3622914560e28e73cedae8dc82e0b6c84c44f97cfa72813810","translation":"Destination légale"},"lines-of-action.copy.fields.simultaneousMoverWins":{"context":"lines-of-action UI copy.fields.simultaneousMoverWins","source_hash":"7ecca5726343fd0b86b78c8c03d1efc71b422fdca48f93f0d0be58d25f0019fa","translation":"Le joueur qui a déplacé gagne"},"lines-of-action.copy.fields