{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"flow-rate-calculator.copy.actions.twoPlayers":{"context":"Shared UI copy.actions.twoPlayers","source_hash":"c6bb2c909f5d2b0d2aad3900bc88417f4bcb145d19243ba28a094cb8dced2807","translation":"Deux joueurs sur cet appareil"},"flow-rate-calculator.copy.additionalFaqs.0.question":{"context":"flow-rate-calculator UI copy.additionalFaqs.0.question","source_hash":"68c990505da9a8f5b2e044b9b6e10f453b8e2033e57dd21ccfc986823197c019","translation":"Quel est le débit d'une section 2 m² se déplaçant à 3 m/s?"},"flow-rate-calculator.copy.additionalFaqs.2.answer":{"context":"flow-rate-calculator UI copy.additionalFaqs.2.answer","source_hash":"a664962ae4c403ca652e8c38c43efdfcde0ecc63186e8d676e83c3155c5ab18e","translation":"Divisez le volume du réservoir par le débit, en utilisant des unités de volume et de temps compatibles, en supposant que le débit demeure constant et que le réservoir ne déborde pas ou ne perd pas de liquide."},"flow-rate-calculator.copy.additionalFaqs.2.question":{"context":"flow-rate-calculator UI copy.additionalFaqs.2.question","source_hash":"cffa48f25cc229417de12392b582fcee47267fe87caad80c176309eae47df2e4","translation":"Comment puis-je estimer le temps de remplissage d'un réservoir?"},"flow-rate-calculator.copy.fields.squareMeters":{"context":"flow-rate-calculator UI copy.fields.squareMeters","source_hash":"6fa3a09dc4d3a0b3fd32d1b310eb3be11312fa1209f526d98ca469ddc1b6ac0a","translation":"Mètres carrés (m²)"},"flow-rate-calculator.copy.fields.usGallons":{"context":"flow-rate-calculator UI copy.fields.usGallons","source_hash":"c295a8b8a622ed30ee8b09be98a9ec9f9610b5c578d2f0cf1ef541defe7407a1","translation":"Gallons américains (US gal)"},"flow-rate-calculator.copy.howAnswer":{"context":"flow-rate-calculator UI copy.howAnswer","source_hash":"1f3f4899f63ab5cc3e1f65d9265252070b9fa68d439aaa24dc4a03795f9b489f","translation":"Pour un écoulement constant dans une section, le débit volumétrique Q est égal à la section transversale A multipliée par la vitesse moyenne v: Q = A × v. Pour estimer le temps de remplissage, divisez le volume du conteneur par le débit. Les systèmes réels peuvent varier en fonction de la pression, du frottement, des raccords, des propriétés du fluide et des niveaux changeants."},"flow-rate-calculator.copy.howQuestion":{"context":"Shared UI copy.howQuestion","source_hash":"e2638b6bc67a72d651d4c174b47410000757e25660b285e32cef37355793e026","translation":"Comment calculer le débit?"},"flow-rate-calculator.copy.messages.arm":{"context":"Shared UI copy.messages.arm","source_hash":"8af7b1bc920f46fdb15717e378a0185190bdb5d76015aede7ce9f1c9b1f31c27","translation":"Bras de levier"},"flow-rate-calculator.copy.messages.copyUnavailable":{"context":"Shared UI copy.messages.copyUnavailable","source_hash":"2eb044e6057cc7d4d73d582e1a78b365a7c1a1ba784a90b401e8a18766a332d5","translation":"La copie n'est pas disponible dans ce navigateur."},"flow-rate-calculator.copy.messages.diagram":{"context":"Shared UI copy.messages.diagram","source_hash":"0d4b590136e7d6f4030cbc73f9f02dab39a5336a572f4f64a4877f0a00e42e72","translation":"Levier, pivot et direction de la force"},"flow-rate-calculator.copy.messages.flowRate":{"context":"Shared UI copy.messages.flowRate","source_hash":"44de4e4694d8721a2b21ba5b37075bd0f7c9a43c676f30c0ca4e4da03a8d772d","translation":"Débit volumétrique"},"flow-rate-calculator.copy.messages.molesResult":{"context":"Shared UI copy.messages.molesResult","source_hash":"102bc9dccddaf5ac89ce2f3df26db04332d8a84eeb1755dce1f94e27fba52629","translation":"Quantité de soluté"},"flow-rate-calculator.copy.messages.neutral":{"context":"Shared UI copy.messages.neutral","source_hash":"1c6ac69f1e5db9c36e9f549d72ef77d23ceab19c557a7eb3a27c7f06f4484b44","translation":"Neutre"},"flow-rate-calculator.copy.privacyAnswer":{"context":"Shared UI copy.privacyAnswer","source_hash":"18fe1d87e59c2545603f0184ce78978b46e108ca1e18f24e1a77c8862be23027","translation":"Non, les c