{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"norway-employer-cost-calculator.copy.details":{"context":"norway-employer-cost-calculator UI copy.details","source_hash":"8b288037e5ace5a06c2ac3508b1fb5530ef3639d3532d57a8cec85bb4567058f","translation":"计算器使用公布的2026区域税率计算普通活动或农业/渔业的缴款基数,并加上已输入的假期工资、应纳税补偿金和任何养老金缴款。 对于Ia区的普通活动,将850,000挪威克朗的每个企业的差别津贴适用于已输入的本年度已使用的金额。 结果是年度规划估计数;雇主的注册地点和活动决定适用的规则。"},"norway-employer-cost-calculator.copy.example":{"context":"norway-employer-cost-calculator UI copy.example","source_hash":"f30c769371f3acb43827634a4b139057c36d7da182d30717c996a403dd1b0030","translation":"输入年度工资总额,选择用人单位登记的缴费区和活动类型,然后加上假期工资、养老金和其他补偿。 例如,I区的缴费基数为1,000,000挪威克朗,则用人单位缴费基数为141,000挪威克朗,则用人单位缴费基数为14.1%。"},"norway-employer-cost-calculator.copy.faq.3.a":{"context":"norway-employer-cost-calculator UI copy.faq.3.a","source_hash":"cc7d5e9ffcc6fb913633a6319fc4e13af00a4531ac7d7bc89f73cdaef48157c5","translation":"假期薪金率和基数、应计养恤金薪金和其他费用是可编辑的假设，保险、薪金管理、特别福利、豁免和个人雇员限额尚未完全模拟。"},"norway-employer-cost-calculator.copy.fields.totalResult":{"context":"norway-employer-cost-calculator UI copy.fields.totalResult","source_hash":"83cc4ca547abddd59ddda04c7568f1ab5ebcbce14e8dea8a43af8f39a46415bb","translation":"雇主年度费用估计数"},"norway-employer-cost-calculator.copy.fields.zoneIVa":{"context":"norway-employer-cost-calculator UI copy.fields.zoneIVa","source_hash":"371bc2246cf8d2bb68e6eedfba7196e215d3434a81b06d0124935709c4ea0dd5","translation":"第四区a — 7.9% 普通/5.1% 农业和渔业"},"norway-employer-cost-calculator.copy.fields.zoneIa":{"context":"norway-employer-cost-calculator UI copy.fields.zoneIa","source_hash":"ad01c947bfcd70b7f90ff1412a2adb63e54c298957cce429e8bfed0f8968f90d","translation":"第Ia区 — 14.1% 普通/10.6% 农业和渔业"},"norway-employer-cost-calculator.copy.related":{"context":"norway-employer-cost-calculator UI copy.related","source_hash":"3da6e153ee8cea08506a33e168e7b5e25fbdf546dcd75c3aeb3fa4345774f329","translation":"相关工具"}},"locale":"zh-CN","missing":["norway-employer-cost-calc