{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"pulley-calculator.copy.actions.circle":{"context":"Shared UI copy.actions.circle","source_hash":"b93d3bcecff5d7493a58a41ea44f7196a46295f6512ebc06940510676a666384","translation":"వృత్తం"},"pulley-calculator.copy.actions.result":{"context":"Shared UI copy.actions.result","source_hash":"3d1add36b6ca4fbf2e6e625dea61450af61728982f7d5c0739622ab4355ab0b4","translation":"అంచనావేసిన ఫలితాలు"},"pulley-calculator.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"త్రిభుజం"},"pulley-calculator.copy.fields.accuracyNote":{"context":"pulley-calculator UI copy.fields.accuracyNote","source_hash":"06aa6f128ac76f10a509b08b22f3b5c3b3a9f5e80dbbcc21f58dcc8d60c77e95","translation":"ఒక ఆలోచనీయమైన, తెరిచిన రెండు- పులే బెల్టు కొరకు దాదాపు పిట్ పొడవు. అన్ని పరిమాణముల కొరకు ఒకే యూనిట్‌ను వుపయోగించుము. నిజమైన బెల్టు పొడవు మరియు వేగం బెల్టు ప్రొఫైల్, పిట్, టెన్షన్, స్లిప్, వినియోగం మరియు తటస్థతలతో భిన్నంగా ఉండవచ్చు. ఇది కొనుగోలు చేయదగిన బెల్టును యెంపికచేయదు లేదా శక్తిని, కాపలా లేదా భద్రతను అంచనా వేయదు. వుపయోగించే ముందు తయారీదారు డేటాను పరిశీలించుము. స్థానికంగా నడుస్తుంది; అప్లోడ్ చేయబడదు."},"pulley-calculator.copy.fields.millimeters":{"context":"pulley-calculator UI copy.fields.millimeters","source_hash":"fed19d3a21f4ae230d9a5993faa5c8cfe566afb346ad7f12367f79a6aa968fca","translation":"మిలిమీటర్లు (mm)"},"pulley-calculator.copy.fields.sketchDescription":{"context":"pulley-calculator UI copy.fields.sketchDescription","source_hash":"fc325ccd8e1a94c1d460fb7be8376f35361c88b9ae50d2082ee2d9c6f7220fb9","translation":"ఎడమ వైపున డ్రైవర్ మరియు కుడి వైపున డ్రైవ్ చేయబడిన పులేతో, ఒక తెరిచిన బెల్ట్ ద్వారా అనుసంధానించబడిన రెండు పులేల యొక్క రేఖాంశం."},"pulley-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"3d8d256e856780786107b2f635eee2d2957af2b37025b9885ebbc0b36584fb74","translation":"రెండు పూలీల మధ్య ఒక సాదారణ తెరిచిన బెల్టు కొరకు పిట్ పొడవు మరియు వేగ సంబంధాన్ని అంచనా వేయుము. అదే యూనిట్‌లో పరిమాణాలను ప్రవేశపెట్టుము."},"pulley-calculator.copy.messages.bagsToBuy":{"context":"Shared UI copy.messages.bagsToBuy","source_hash":"a89760dac2e54e45dd5902cb4c842481cde3f3a18cf1e636c62843a2383e997f","translation":"కొనుగోలు చేయడానికి మొత్తం బ్యాగులు"},"pulley-calculator.copy.messages.beltSpeed":{"context":"Shared UI copy.messages.beltSpeed","source_hash":"5236d9c335e41d361c836c30e4f8d81d8255d240e47b7a3f8372ea25809e56a2","translation":"డ్రైవర్ బెల్ట్ వేగము"},"pulley-calculator.copy.messages.calculated":{"context":"Shared UI copy.messages.calculated","source_hash":"f81a501cb538aa0836549555a9b34a40fa9478cec88c73f1f3869915ebed1bbb","translation":"బెల్ట్-డ్రైవ్ అంచనా గణన."},"pulley-calculator.copy.messages.depth":{"context":"Shared UI copy.messages.depth","source_hash":"f1dbc33978a95b952b19bfc0da8f928e8e3958930810988de2f6e4bd8b27ce01","translation":"లోతు"},"pulley-calculator.copy.messages.estimatedWeight":{"context":"Shared UI copy.messages.estimatedWeight","source_hash":"25e39d42c673f4802d073a6f3d5f448206846fdd0a959d92f8a176123e2edf71","translation":"అంచనా బరువు"},"pulley-calculator.copy.messages.verticalVelocity":{"context":"Shared UI copy.messages.verticalVelocity","source_hash":"9b4b21065e73c780bfb795d5c738dc00c3d138a1b8a96abb929dfd8449b00ffa","translation":"వెర్టికల్ లాంచ్ వేగం"}},"locale":"te","missing":["pulley-calculator.copy.name","pulley-calculator.copy.title","pulley-calculator.copy.description","pulley-calculator.copy.howQuestion","pulley-calculator.copy.howAnswer","pulley-calculator.copy.privacyQuestion","pulley-calculator.copy.privacyAnswer","pulley-calculator.copy.fields.driverDiameter","pulley-calculator.copy.fields.drivenDiameter","pulley-calculator.copy.fields.centerDistance","pulley-calculator.copy.fields.diameterUnit","pulley-calculator.copy.fields.inches","pulley-calculator.copy.fields.inputRpm","pulley-calculator.copy.fields.sketchTitle","pulley-calculator.cop