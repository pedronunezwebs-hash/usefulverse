{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"date-calculator.copy.description":{"context":"date-calculator UI copy.description","source_hash":"b9545b9eb0577f4e5b0dc2fa9201b0f0e0fdd95a3327cefb8c12fb2e2ea9ff46","translation":"తేదీల మధ్య రోజులు గణించండి లేదా సంవత్సరాలు, నెలలు, వారాలు మరియు రోజులు జతచేయండి. క్యాలెండర్ పొడవులు, వారపు రోజులు మరియు నెల- చివరి నిబంధనలను చూడండి. ఉచితంగా, మీ బ్రౌజర్ లో గణనలతో."},"date-calculator.copy.examples.2.heading":{"context":"date-calculator UI copy.examples.2.heading","source_hash":"1662029e28fed513e56ae163ee5f9c1f8609a5555b0182b31a63a42086e439c1","translation":"జనవరి తరువాత ఒక నెల 31"},"date-calculator.copy.examplesAction":{"context":"date-calculator UI copy.examplesAction","source_hash":"68623191a26dab07c7acedb36efb8ae1cacd13e3fabd0fe23f1f7d026bfe8424","translation":"ఈ ఉదాహరణను వుపయోగించు"},"date-calculator.copy.faq.1.question":{"context":"date-calculator UI copy.faq.1.question","source_hash":"5575581be04ce9e4caf865dcb74b689a3fd2fe3a7d8ae3669419322ae908c2ad","translation":"నేను ప్రారంభం మరియు ముగింపు తేదీలను లెక్కించాలా?"},"date-calculator.copy.faq.4.question":{"context":"date-calculator UI copy.faq.4.question","source_hash":"20e2906acf94872777c6f078ae781854e6c4a0c33727dc5f5c7180393ef6f6ba","translation":"జనవరి 31 పైన ఒక నెల ఫిబ్రవరి 28 గా ఎందుకు మారుతుంది?"},"date-calculator.copy.faq.5.answer":{"context":"date-calculator UI copy.faq.5.answer","source_hash":"c295a7457ac3f473e2189f8320e41b3622b9d2f407d44a7e1da5a4f757c5e5a3","translation":"అవును. నాలుగు వలన విభజించదగిన సంవత్సరములు లీప్ సంవత్సరములు, శతాబ్దము సంవత్సరములు 400 వలన విభజించదగినవి కాని మినహాయింపు. సంవత్సరము 2000 లో ఫిబ్రవరి 29 ఉంది; 1900 లేదు."},"date-calculator.copy.faq.7.question":{"context":"date-calculator UI copy.faq.7.question","source_hash":"1db31f79eca7e861e53e33bf5d69ab07641998a90bc740e652efa8904ab34f7c","translation":"ముగింపు తేదీ ప్రారంభ తేదీ కంటే ముందు ఉంటే ఏమి జరుగుతుంది?"},"date-calculator.copy.faq.9.question":{"context":"date-calculator UI copy.faq.9.question","source_hash":"3da5ad3925c1d5d801d5c8b33511473428bf0388dc437022566a061094940482","translation":"నేను నా గణనను దాచగలనా లేదా పంచుకోగలనా?"},"date-calculator.copy.labels.privacy":{"context":"date-calculator UI copy.labels.privacy","source_hash":"aab7685123cf4b021c62a41c905fdc381aaa3ae8e944299e4cdf58955258f445","translation":"తెలుసుకొనుటకు మంచిది"},"date-calculator.copy.method.paragraphs.4":{"context":"date-calculator UI copy.method.paragraphs.4","source_hash":"c0e9da1bd3710dc9fba1b6cd203cb5e7dce6ffe21c9a57c1bcec59f1dbb24949","translation":"గణనలు కెలెండర్ తేదీలను వుపయోగిస్తాయి, రోజు యొక్క సమయము కాదు. ఒక డేలైట్- సేవింగ్ మార్పు ఒక కెలెండర్ రోజును ఇక్కడ భాగముగా మార్చదు. సమయము మధ్య గంటలకు, సమయము పొడవు గణనను వుపయోగించుము. పని రోజుల కొరకు, వ్యాపార దినాల గణనను వుపయోగించుము మరియు వర్తించే సెలవు దినములను యెంపికచేయుము."},"date-calculator.copy.navigation.allTools":{"context":"date-calculator UI copy.navigation.allTools","source_hash":"81c151f98a190da765d67a020d175d400bfd9e46ed8da05bdaeeb0a9b8eef566","translation":"అన్ని పనిముట్లు"},"date-calculator.copy.navigation.method":{"context":"date-calculator UI copy.navigation.method","source_hash":"b16509e3daf1095de76d04de628ca3f2354472a71660196b42b7de6d4b4392d5","translation":"లెక్కింపు నిబంధనలు"},"date-calculator.copy.relatedHeading":{"context":"date-calculator UI copy.relatedHeading","source_hash":"3c58c9b49496d3b29abd442f69ac5d04503717cbf21db0c65d6fb72d7bef75f4","translation":"మీ ప్రణాళికలు కదిలే ఉంచండి"},"date-calculator.copy.sourcesText":{"context":"date-calculator UI copy.sourcesText","source_hash":"a5d3fbf62bfe69a16e922e70d5e1c2d3cf4247de4fcc3edd19dad6cdacaab82f","translation":"పనిచేసిన ఉదాహరణలు పరీక్షలలో పునఃగణన చేయబడతాయి. గ్రెగొరియన్ రోజు గణనలు Python యొక్క తేదీ గణనలతో క్రాస్- చెక్ చేయబడతాయి. నెల- చివరి ప్రవర్తనను ప్రచురితమైన తాత్కాలిక ఉదాహరణలతో చెక్ చేయబడుతుంది."},"date-calculator.copy.title":{"context":"date-calculator UI copy.title","source_hash":"db18aaed564e06ed2a7fb82c53d71496b0bdead1dbcdebed2d8d9be9e32109d1","translation":"తేదీ గణన - తేదీల మధ్య రోజులు & తేదీలను జతచేయుము | UsefulVerse"},"date-calculator.copy.ui.errors.LINK_INVALID":{"context":"date-calculator UI copy.ui.errors.LINK_INVALID","source_hash":"f74e7dc8e4a84e4b31bb61e1a666a283f9d9ab8f49a54ee6c29877449de55896","translation":"ఈ లింకు చెల్లని తేదీలను లేదా ఐచ్చికములను కలిగివుంది. మళ్ళీ ప్రారంభించుటకు క్రింది తేదీలను యెంపికచేయుము."},"date-calculator.copy.ui.reversed":{"context":"date-calculator UI copy.ui.reversed","source_hash":"55a5f24eece5795cccc41db96491e794c2e232b9542b196f935b9159e24db9f7","translation":"మీ ముగింపు తేదీ ముందే ఉంది. మొత్తం తేదీల మధ్య దూరాన్ని చూపిస్తుంది."},"date-calculator.copy.ui.start":{"context":"date-calculator UI copy.ui.start","source_hash":"8169693101a4536c24e384595cce97fa4740c7529114bead65525f5532699597","translation":"ప్రారంభ తేదీ"},"date-calculator.copy.ui.years":{"context":"date-calculator UI copy.ui.years","source_hash":"b68ca0811f132f73edc68e9d3bebb288ef036c1fef8aabe6d2c63a2b6bfa859c","translation":"సంవత్సరాలు"}},"locale":"te","missing":["date-calculator.copy.heading","date-calculator.copy.intro","date-calculator.copy.category","date-calculator.copy.eyebrow","date-calculator.copy.ui.between","date-calculator.copy.ui.shift","date-calculator.copy.ui.calculation","date-calculator.copy.ui.end","date-calculator.copy.ui.base","date-calculator.copy.ui.inclusive","date-calculator.copy.ui.inclusiveHint","date-calculator.copy.ui.swap","date-calculator.copy.ui.calculate","date-calculator.copy.ui.today","date-calculator.copy.ui.operation","date-calculator.copy.ui.add","date-calculator.copy.ui.subtract","date-calculator.copy.ui.months","date-calculator.copy.ui.weeks","date-calculator.copy.ui.days","date-calculator.copy.ui.overflow","date-calculator.copy.ui.constrain","date-calculator.copy.ui.reject","date-calculator.copy.ui.advanced","date-calculator.copy.ui.copy","date-calculator.copy.ui.share","date-calculator.copy.ui.reset","date-calculator.copy.ui.copied","date-calculator.co