{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"social-security-calculator.copy.actions.example":{"context":"Shared UI copy.actions.example","source_hash":"d24a24b50640963326a4d7dcca6b665b8b0c98b84ae5ed99c397438eb1001a2f","translation":"2026 SSA ఉదాహరణను ఎక్కించు"},"social-security-calculator.copy.fields.claimingAge":{"context":"social-security-calculator UI copy.fields.claimingAge","source_hash":"b6cac06d6e9289c3890dbadad766fe235419abc94a9050cdf55a896fff47011f","translation":"ప్రయోజనాలు ప్రారంభమయ్యే వయస్సు"},"social-security-calculator.copy.fields.estimateOnly":{"context":"social-security-calculator UI copy.fields.estimateOnly","source_hash":"10b7141dcd1652e32b02bf1b2d445fdbb5860cd67362820d6dcc6d3a79f3c284","translation":"ఇది ఒక సులభమైన అంచనా, ఒక అవార్డు లేదా చెల్లింపు యొక్క వాగ్దానం కాదు. ఇది అధికారిక 2025 / 2026 PIA ఫార్ములాను ఉపయోగిస్తుంది మరియు 67 యొక్క పూర్తి పదవీ విరమణ వయస్సును ఊహిస్తుంది. ఇది వేతనాల నుండి AIME ను గణించదు, తరువాత COLA లను జోడించదు, పని క్రెడిట్స్ లేదా ఆదాయాలను సరిచూడదు, లేదా మోడల్ పన్నులు, మెడికల్ ప్రీమియంలు, కుటుంబ ప్రయోజనాలు, వికలాంగత లేదా మిగిలినవారి ప్రయోజనాలు. మీ అధికారిక సామాజిక భద్రత ప్రకటనను తనిఖీ చేయండి మరియు వ్యక్తిగత అంచనా కోసం SSA యొక్క అంచనాను ఉపయోగించండి. ఈ సాధనం సాధారణ సమాచారాన్ని ఇస్తుంది, ఆర్థిక సలహా కాదు."},"social-security-calculator.copy.fields.resultClaimAge":{"context":"social-security-calculator UI copy.fields.resultClaimAge","source_hash":"228eb3c52630e187f718f2232bc645b3b1c1b4572f444cb51ba626a6973a8de0","translation":"క్లెయిమింగ్ వయస్సు ఎంపికచేయబడింది"},"social-security-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"ba22b570174c2ab9fae09ea5bfe222ed4021e58e65c38627273fdb366ee32e44","translation":"మీ సగటు సూచిక నెలవారీ ఆదాయం (AIME) ఉపయోగించి ఒక రిటైర్డ్-వర్కర్ ప్రయోజనం అంచనా వేయండి, మీరు 62ను మార్చిన సంవత్సరం, మరియు 62 నుండి 70 వరకు ఒక డిమాండ్ వయస్సు. ఈ సహజ అంచనా మీ సామాజిక భద్రత రికార్డును యాక్సెస్ చేయదు."},"social-security-calculator.copy.messages.checkInputs":{"context":"Shared UI copy.messages.checkInputs","source_hash":"b783d1c825983958909863790e82e6c29fbe67a202fdbc519536276f9df670b8","translation":"0 నుండి 200,000 వరకు ఒక పూర్తి డాలర్ AIMEను ప్రవేశపెట్టుము మరియు సహాయపడే సంవత్సరము మరియు వయస్సును ఎంచుకొనుము."}},"locale":"te","missing":["social-security-calculator.copy.name","social-security-calculator.copy.title","social-security-calculator.copy.description","social-security-calculator.copy.howQuestion","social-security-calculator.copy.howAnswer","social-security-calculator.copy.privacyQuestion","social-security-calculator.copy.privacyAnswer","social-security-calculator.copy.howTo.0","social-security-calculator.copy.howTo.1","social-security-calculator.copy.howTo.2","social-security-calculator.copy.example.label","social-security-calculator.copy.actions.calculate","social-security-calculator.copy.actions.reset","social-security-calculator.copy.actions.result","social-security-calculator.copy.fields.aime","social-security-calculator.copy.fields.eligibilityYear","social-security-calculator.copy.fields.age62","social-security-calculator.copy.fields.age63","social-security-calculator.copy.fields.age64","social-security-calculator.copy.fields.age65","social-security-calculator.copy.fields.age66","social-security-calculator.copy.fields.age67","social-security-calculator.copy.fields.age68","social-security-calculator.copy.fields.age69","social-security-calculator.copy.fields.age70","social-security-calculator.copy.fields.officialInputs","social-security-calculator.copy.fields.sourceLinkText","social-security-calculator.copy.fields.sourceFormula","social-security-calculator.copy.fields.sourceExamples","social-security-calculator.copy.fields.resultYear","social-security-calculator.copy.fields.resultAime","social-security-calculator.copy.fields.resultPia","social-security-calculator.copy.fields.resultMonthly","social-security-calculator.copy.fields.resultFactor","social-security-calculator.copy.fields.firstBend","social-security-calcula