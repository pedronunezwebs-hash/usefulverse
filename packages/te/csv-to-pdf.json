{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"csv-to-pdf.copy.actions.calculate":{"context":"Shared UI copy.actions.calculate","source_hash":"2121cc15afb6ba5350deb90e1a292faa7d932537a19ddddadff4aeb796a8d595","translation":"గణించు"},"csv-to-pdf.copy.actions.circle":{"context":"Shared UI copy.actions.circle","source_hash":"b93d3bcecff5d7493a58a41ea44f7196a46295f6512ebc06940510676a666384","translation":"వృత్తం"},"csv-to-pdf.copy.actions.result":{"context":"Shared UI copy.actions.result","source_hash":"65678eb33ccf9e4d7210c4f53fb526e4e1fb57638c9f3c1c587141cf5a479161","translation":"ప్రచురించదగిన పట్టిక"},"csv-to-pdf.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"త్రిభుజం"},"csv-to-pdf.copy.additionalFaqs.0.answer":{"context":"csv-to-pdf UI copy.additionalFaqs.0.answer","source_hash":"a491169782cf61b111a4db6480160b4e2cd83d6f9d36c3e9679f3a53e7e756af","translation":"అవును. దీనిని ముందస్తు వీక్షణం చేయుము, ప్రచురించు లేదా PDF గా దాచు అని యెంచుకొనుము, మరియు మీ బ్రౌజర్ యొక్క ప్రచురణ డైలాగునందు అందుబాటులో ఉంటే PDF గా దాచు అని యెంచుకొనుము."},"csv-to-pdf.copy.additionalFaqs.2.answer":{"context":"csv-to-pdf UI copy.additionalFaqs.2.answer","source_hash":"79e6214bf0ca8f496dcd2d73e15d53d1a1976baf15fabc59efa1402e6bcf6951","translation":"ఫైళ్ళు మీ పరికరమునందు ఉంటాయి మరియు 5 MiB, 2,000 డాటా అడ్డువరుసలు, 40 నిలువు వరుసలు మరియు 50,000 సెల్స్‌కు పరిమితం చేయబడి ఉన్నాయి కాబట్టి బ్రౌజర్ ఒక ప్రచురించదగిన పట్టికను నిర్మించగలదు."},"csv-to-pdf.copy.additionalFaqs.2.question":{"context":"csv-to-pdf UI copy.additionalFaqs.2.question","source_hash":"0d3bb20615ab2539374651c0d00eca38aee4446e3de236502722ebc2c982f190","translation":"దస్త్రం మరియు పట్టిక పరిమితులు ఏమిటి?"},"csv-to-pdf.copy.fields.limitNote":{"context":"csv-to-pdf UI copy.fields.limitNote","source_hash":"bb5e135d81215339668b47afe3de3e72b3d2e81d16c52ed02216bc52bdc01e6f","translation":"స్థానిక పరిమితులు: 5 MiB, 2,000 డాటా అడ్డువరుసలు, 40 నిలువు వరుసలు మరియు 50,000 సెల్స్. పెద్ద పట్టికను ఫోన్‌పై ప్రచురించుటకు ఎక్కువ సమయం పట్టవచ్చు."},"csv-to-pdf.copy.howAnswer":{"context":"csv-to-pdf UI copy.howAnswer","source_hash":"917866acfdab2a05d54bbe930a484fa5efcc1bfdd733a9607967ec67ac21dd10","translation":"CSV ఫైలును యెంపికచేయుము, దాని విభజకమును మరియు వచన ఎన్కోడింగ్‌ను ధృవీకరించుము, పట్టిక యొక్క ముందస్తు వీక్షణం, పేజీ ఐచ్ఛికములను అమర్చుము మరియు ప్రచురించుము లేదా PDF గా దాచుమును యెంపికచేయుము. పరివర్తన మీ బ్రౌజర్‌లో ఉండును."},"csv-to-pdf.copy.howQuestion":{"context":"Shared UI copy.howQuestion","source_hash":"0fa64a4e4c5257a24bb084c5555f2fcb634e71095465bef2b68d4b023e4af4b0","translation":"నేను ఒక CSV ఫైలును PDF కు ఎలా మార్చగలను?"},"csv-to-pdf.copy.messages.bagsToBuy":{"context":"Shared UI copy.messages.bagsToBuy","source_hash":"a89760dac2e54e45dd5902cb4c842481cde3f3a18cf1e636c62843a2383e997f","translation":"కొనుగోలు చేయడానికి మొత్తం బ్యాగులు"},"csv-to-pdf.copy.messages.checkInputs":{"context":"Shared UI copy.messages.checkInputs","source_hash":"6ff8847244631961a615cde9eed82d7f815735e6002cecc11729e195e9e56b3d","translation":"ప్రతి అవసరమైన కొలత కొరకు శూన్యం కంటే పెద్ద సంఖ్యను ప్రవేశపెట్టుము. ఐచ్ఛిక విలువలను కూడా పరిశీలించుము"},"csv-to-pdf.copy.messages.downloaded":{"context":"Shared UI copy.messages.downloaded","source_hash":"763a367d06161bfbb93ebb2d254e2c812bf182be371e0ddde96611edeb5969c9","translation":"వచన దస్త్రం డౌన్ లోడ్ అయింది."},"csv-to-pdf.copy.messages.estimatedWeight":{"context":"Shared UI copy.messages.estimatedWeight","source_hash":"25e39d42c673f4802d073a6f3d5f448206846fdd0a959d92f8a176123e2edf71","translation":"అంచనా బరువు"},"csv-to-pdf.copy.messages.fileTooLarge":{"context":"Shared UI copy.messages.fileTooLarge","source_hash":"c60674b16aae9d4aa7658da21d403b5d70bb433b77bc422a2e7bd8cb081f5bd2","translation":"ఈ దస్త్రం 5 MiB స్థానిక పరిమితిని మించిపోయింది."},"csv-to-pdf.copy.messages.noRows":{"context":"Shared UI copy.messages.noRows","source_hash":"3d98bfd22f