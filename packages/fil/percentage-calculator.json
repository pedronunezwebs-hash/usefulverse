{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"percentage-calculator.copy.examples.1.text":{"context":"percentage-calculator UI copy.examples.1.text","source_hash":"ac07325702a2fe93cc3d030d68480c1913ec192973f5efde29298c2be92bb65b","translation":"Ang pagtaas ay 20. Kaugnay sa orihinal na 80, iyon ay isang 25% pagbabago."},"percentage-calculator.copy.faq.2.question":{"context":"percentage-calculator UI copy.faq.2.question","source_hash":"95c81a1f95a9d8525b9c616b53828461f0ed7811c8204b65fb243ac6078f621d","translation":"> Bakit ay pagbabago mula sa zero undefined?"},"percentage-calculator.copy.faq.3.question":{"context":"percentage-calculator UI copy.faq.3.question","source_hash":"148f00fe12d06e4c6e28be7c37e7bc46183687c900d7c47b4e8ceba381c3fd82","translation":"> Paano ang pagbabago at pagkakaiba ay naiiba?"},"percentage-calculator.copy.faq.6.answer":{"context":"percentage-calculator UI copy.faq.6.answer","source_hash":"58f941eedb0094ac6b3deea6ecf3b5f967ff0aa3d43a3e61e65090709c5da7ba","translation":"Hindi. Ang isang porsyento sa itaas 100 ay may bisa. Ang isang pagbawas sa itaas 100 ay maaaring gumawa ng isang negatibong resulta, kaya maunawaan ang konteksto maingat."},"percentage-calculator.copy.form.modeLabels.change.a":{"context":"percentage-calculator UI copy.form.modeLabels.change.a","source_hash":"43f8b8ea75c2f06bdb996ac07aa47ade875816b6500e55c7376facafd56c1bf9","translation":"> orihinal na halaga"},"percentage-calculator.copy.form.modeLabels.change.b":{"context":"percentage-calculator UI copy.form.modeLabels.change.b","source_hash":"7ca9b97db8e5fed63d6e75e1c970c3e29c514436d5b9390d94f8a907bca92b12","translation":"Bagong halaga"},"percentage-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"ea016446549509b96e619593431fabe7571e8c8eb107f4d267db6637a898b484","translation":"> Pumili ng porsyento tanong na kailangan mong sagutin. Ipasok ang dalawang mga halaga at makita ang formula pati na rin ang resulta."},"percentage-calculator.copy.labels.faq":{"context":"percentage-calculator UI copy.labels.faq","source_hash":"ee8b8980afb8513fc4543715506adbffda92e620c01a6cecec18ca8527def9b1","translation":"Ang kapaki-pakinabang na mga detalye"},"percentage-calculator.copy.method.paragraphs.1":{"context":"percentage-calculator UI copy.method.paragraphs.1","source_hash":"82bedcebc7ca9439235a632b6f5ea15c8a715fe46fe6a36e3aceeb07ceaf9918","translation":"Ang porsyento pagbabago ay inihambing sa isang bagong halaga na may isang orihinal na sanggunian. Ang formula ay (bagong - orihinal) / | orihinal | × 100. Ang absolute denominator ay nagbibigay ng isang malinaw na kasunduan para sa mga negatibong mga halaga ng pagsisimula. Ang isang paglipat mula sa -10 sa -5 samakatuwid ay nagbibigay +50% sa tool na ito."},"percentage-calculator.copy.navigation.onPage":{"context":"percentage-calculator UI copy.navigation.onPage","source_hash":"06a7b55d6c3eb44df5cb54524e6103ecbc08f496c8689513efc7aac2b548b170","translation":"> Gumawa ng karamihan ng mga ito"},"percentage-calculator.copy.related.0.title":{"context":"percentage-calculator UI copy.related.0.title","source_hash":"0c0a63cf23ba22d1000dee1df9de5677eb0704ca038b5e88839def42f3d9e80b","translation":"Kalkulador ng Diskwento"},"percentage-calculator.copy.related.1.title":{"context":"percentage-calculator UI copy.related.1.title","source_hash":"03e2151932cce67166c7188df754eb6f21264f6bb20de2d7b25aaa032b6e6e6a","translation":"> Ratio proporsyon calculator"},"percentage-calculator.copy.relatedHeading":{"context":"percentage-calculator UI copy.relatedHeading","source_hash":"3af73a31ab098fe0db206c522f27cc8b9cd49ef9f0227a8b1e4b20d7611ea7ed","translation":"Ang isang kapaki-pakinabang na susunod na pagkalkula"},"percentage-calculator.copy.title":{"context":"percentage-calculator UI copy.title","source_hash":"fbe845b2aeb7dd8bd6d9c6c5c6664a1d8af9f25c2ac6b0c511e79a103c26f973","translation":"Porsyento Calculator — Pagbabago, Pagkakaiba at Higit Pa"},"percentage-calculator.copy.u