{"complete_extracted_copy":false,"coverage":"centralized-copy","entries":{"three-phase-power-calculator.copy.actions.triangle":{"context":"Shared UI copy.actions.triangle","source_hash":"a0252691b5dc54b1d67f9d35a120e8c49187f20f0735574a61713c6317df6f72","translation":"Triangel"},"three-phase-power-calculator.copy.additionalFaqs.2.answer":{"context":"three-phase-power-calculator UI copy.additionalFaqs.2.answer","source_hash":"c869fab54372ba075b2321817d380f944fc81baca326e5337c0e24e2e18a7928","translation":"Ja, den aktiva effekten är den skenbara effekten multiplicerad med effektfaktorn. En lägre effektfaktor innebär mindre aktiv effekt för samma nätspänning och ström; den reaktiva effektens storlek uppskattas från S × √(1 − PF²)."},"three-phase-power-calculator.copy.additionalFaqs.3.answer":{"context":"three-phase-power-calculator UI copy.additionalFaqs.3.answer","source_hash":"d433d1b8e320c88f5651e45ec61035ad1e50324192dfe74fc727719e116c5426","translation":"Nej, detta är en idealiserad uppskattning för enfas eller balanserad trefas. Den analyserar inte obalanserade faser, övertoner, ledningar, utrustningsklassificeringar, skydd, stöt- eller brandrisk eller lokala elregler."},"three-phase-power-calculator.copy.description":{"context":"three-phase-power-calculator UI copy.description","source_hash":"6df7dc2a5ef8ab0ab0276c2564c6edfd7ac7b75b209ab011cce8f1e28aa366fb","translation":"Beräkna en- eller trefas växelströms effekt, skenbar effekt och reaktiv effekt gratis, obegränsat och beräknas lokalt i din webbläsare."},"three-phase-power-calculator.copy.fields.delta":{"context":"three-phase-power-calculator UI copy.fields.delta","source_hash":"18833da39fb9b7f8c917fe0220daf9cf12e6524df8fb16e39f04dbe827e2d200","translation":"Delta:"},"three-phase-power-calculator.copy.fields.singlePhase":{"context":"three-phase-power-calculator UI copy.fields.singlePhase","source_hash":"070f25b1b9d8ed1148df97d3bd803b8d5ffe8b4bfcf68bb5f7ad89e0d2c43e56","translation":"Enkelfas"},"three-phase-powe