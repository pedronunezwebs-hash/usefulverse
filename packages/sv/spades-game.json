{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"spades-game.copy.fields.bagNote":{"context":"spades-game UI copy.fields.bagNote","source_hash":"819af09dc4c429639e5a51a7d90e6590794c2220e99e1505dfb3913373d1a840","translation":"Varje övertrick är en påse, vid tio påsar förlorar laget 100 poäng och behåller resten."},"spades-game.copy.fields.rulesText":{"context":"spades-game UI copy.fields.rulesText","source_hash":"b070b3bdbe8ea9a514fbc13b545bd851619f9a66b846fe5b4b157ec211a4c86c","translation":"Standard 52-kortleken delas ut jämnt. Varje spelare bjuder på 0–13 stick; ett lyckat nollbud ger 100 och ett misslyckat nollbud förlorar 100. Lagkontrakt lägger till sina icke-nollbud: gör summan för 10 poäng per bud, plus en påse för varje extra stick; missa det och förlora 10 poäng per bud. Var tionde ackumulerade påsar drar 100 poäng. Spelare måste följa färgen ledd när det är möjligt. Spader kan inte ledas tills bruten om en spelare bara har spader, och ett spader slår något icke-spader kort."},"spades-game.copy.fields.spades":{"context":"spades-game UI copy.fields.spades","source_hash":"5612e4b8ae1c7ad6b160b4a17967df6c154ba9f9ee8b675f520e9f1877a632f5","translation":"Spader"},"spades-game.copy.fields.target":{"context":"spades-game UI copy.fields.target","source_hash":"f2e59eac1f5144b79ca89ff9895db3aa5c28bfb84e798377d50f659ac320764d","translation":"Poäng att vinna"},"spades-game.copy.fields.yourTeam":{"context":"spades-game UI copy.fields.yourTeam","source_hash":"5e27c9b0bb965efbfe7d961969b948c8b217cd6cfdbba58e973086f08b76d489","translation":"Nord–syd"},"spades-game.copy.howQuestion":{"context":"Shared UI copy.howQuestion","source_hash":"727497ee6358b2ce52fefc95a957190e61383f3256c7b8b86f147759eca37343","translation":"Hur spelar man Spades här?"}},"locale":"sv","missing":["spades-game.copy.name","spades-game.copy.title","spades-game.copy.description","spades-game.copy.category","spades-game.copy.intro","spades-game.copy.summary","spades-game.copy.how