{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"barcode-generator.copy.examples.2.heading":{"context":"barcode-generator UI copy.examples.2.heading","source_hash":"d82ec9a2d3a07a649ab97e84081d11249235276f9a96b30d1228435c8754cc90","translation":"Zachowaj wiodące zero"},"barcode-generator.copy.faq.0.answer":{"context":"barcode-generator UI copy.faq.0.answer","source_hash":"25e621396ada8da894dc86e786095f967b4bb0bc813929140fab855d267a1f44","translation":"Nie ma konta, dziennego limitu ani etapu płatności. Generowanie i pobieranie odbywa się w przeglądarce."},"barcode-generator.copy.faq.3.question":{"context":"barcode-generator UI copy.faq.3.question","source_hash":"22dc2f7523aed753ac0155249bf4139c22213c90808250c01548082e0b67fb8c","translation":"Dlaczego moja cyfra kontrolna jest odrzucana?"},"barcode-generator.copy.faq.7.answer":{"context":"barcode-generator UI copy.faq.7.answer","source_hash":"e2b07a0b91eb1d6b77c7df6d73fccb8148eab2e9bb13473bcce07c83cb281992","translation":"Tak, w pamięci urządzenia. Każda prawidłowa linia otrzymuje SVG w pliku ZIP.Manifest CSV zawiera listę wszystkich przetworzonych linii i błędów."},"barcode-generator.copy.how.steps.1.heading":{"context":"barcode-generator UI copy.how.steps.1.heading","source_hash":"b18ff78fac591a971167ed827b80a9abe166ef8bdcf5b457324b581fb0d6b62e","translation":"Podaj swoją wartość"},"barcode-generator.copy.method.paragraphs.1":{"context":"barcode-generator UI copy.method.paragraphs.1","source_hash":"f6bedd8064f12cce694674288d9895d0435f00dce5e87ab0331dcdc3ef2e6c53","translation":"EAN-13, UPC-A i EAN-8 używają końcowej cyfry kontrolnej. Zaczynając od cyfry danych po prawej stronie, pomnóż kolejne cyfry przez trzy. Dodaj pozostałe cyfry. Wybierz najmniejszą cyfrę końcową, która sprawi, że suma będzie wielokrotnością dziesięciu. Suma już podzielna przez dziesięć wymaga zera."},"barcode-generator.copy.method.paragraphs.2":{"context":"barcode-generator UI copy.method.paragraphs.2","source_hash":"d017f9d34c79652b7a97c5332a06a63122c1a5559c66a3decae9a4d4617701ef","translation":"Wprowadź tylko cyfry danych, aby obliczyć cyfrę końcową. Wprowadź pełną liczbę, aby ją zweryfikować. Generator odrzuca nieprawidłowo dostarczoną cyfrę. Nigdy nie naprawia pełnego numeru produktu bez powiadomienia. Wiodące zera pozostają ciągami w całym obliczeniu."},"barcode-generator.copy.navigation.how":{"context":"barcode-generator UI copy.navigation.how","source_hash":"9c870aa6e5e93270170d5a81277ad3e623afe8d4efd186d3e28f3d2b646d52e6","translation":"Jak to działa"},"barcode-generator.copy.related.0.title":{"context":"barcode-generator UI copy.related.0.title","source_hash":"346aab89640f01cb0a79cebe466788970acb229facb7ed28fd6711f8fb0eb8ab","translation":"Generator kodów QR"},"barcode-generator.copy.ui.cancel":{"context":"barcode-generator UI copy.ui.cancel","source_hash":"19766ed6ccb2f4a32778eed80d1928d2c87a18d7c275ccb163ec6709d3eb2e27","translation":"Anuluj"},"barcode-generator.copy.ui.errorHeading":{"context":"barcode-generator UI copy.ui.errorHeading","source_hash":"d21c025d2447f9789235b81186eb49be3225f0289f48630d426c026628d5ae50","translation":"Sprawdź swój wpis"},"barcode-generator.copy.ui.errors.LINK":{"context":"barcode-generator UI copy.ui.errors.LINK","source_hash":"ea0d1391b2e842da1152b3dd03ac1de7ab045a9bf2159624937e709c64dd994e","translation":"Ten link zawiera nieprawidłowe wartości. Wprowadź ponownie swoje dane."},"barcode-generator.copy.ui.previewNote":{"context":"barcode-generator UI copy.ui.previewNote","source_hash":"b90ea1b3136296f5f805686cafe21b4cfcade78ccde93500a4e9ab9f30d2f040","translation":"Podgląd: pierwsze pięć prawidłowych obrazów. ZIP zawiera każdy prawidłowy obraz i manifest CSV."},"barcode-generator.copy.ui.processed":{"context":"barcode-generator UI copy.ui.processed","source_hash":"2eeb81c311db35e5fadcadcc59e3c9df9cd5e124731a81f25dafa11cb07ff55f","translation":"Przetworzono {done} linii {total}."},"barcode-generator.copy.ui.svg":{"context":"barcode-generat