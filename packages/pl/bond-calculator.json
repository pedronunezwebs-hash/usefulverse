8ee9f7edcd8603db08716f8567dfec6","translation":"Cena obligacji to wartość bieżąca jej zaplanowanych kuponów i kapitału. Wyższa stopa dyskontowania zmniejsza tę wartość bieżącą. Niższa stopa dyskontowania ją zwiększa."},"bond-calculator.copy.fields.frequency":{"context":"bond-calculator UI copy.fields.frequency","source_hash":"a95f236f0931c91b1d39dee40632b46ee93aa60554568b1b4d61e7de068de511","translation":"Płatności kuponowe rocznie"},"bond-calculator.copy.fields.totalCoupons":{"context":"bond-calculator UI copy.fields.totalCoupons","source_hash":"a6b4ce2efcb3852dced502678645a0857f41df88fdb3a0e358d2b330c24eaa80","translation":"Łącznie zaplanowanych kuponów"},"bond-calculator.copy.howAnswer":{"context":"bond-calculator UI copy.howAnswer","source_hash":"5e3e70719fae6d57e02c6d4dc33f93f8a1f2482ca23462aa55124d447e2390b9","translation":"Wprowadź wartość nominalną, roczną stopę kuponową, lata do terminu zapadalności i częstotliwość kuponów. Wybierz opcję cena-od-dochodu, aby zdyskontować zaplanowane płatności kuponu i kapitału. Możesz też wybrać opcję dochód-od-ceny, aby obliczyć liczbowo nominalną roczną rentowność odpowiadającą cenie rynkowej."},"bond-calculator.copy.messages.complexity":{"context":"Shared UI copy.messages.complexity","source_hash":"3011582defc5ba3ddca1e4fe7536aae70560cfa48d033f9be7b4a0f6f9593ec9","translation":"Dokument jest zbyt skomplikowany, aby można go było bezpiecznie sprawdzić."},"bond-calculator.copy.messages.divisionByZero":{"context":"Shared UI copy.messages.divisionByZero","source_hash":"419684bc0b10da081c8517f0385259070ed707434fcf9b969d3fbcd9d8df5261","translation":"Nie można podzielić przez zero."},"bond-calculator.copy.messages.invalid-indent":{"context":"Shared UI copy.messages.invalid-indent","source_hash":"0e9d4d4c60f06c02e638504f50fe76eb821533603f39451a26ae2990d596013b","translation":"Wybierz obsługiwany rozmiar wcięcia."},"bond-calculator.copy.messages.invalid-xml-name":{"context":"Shared UI copy.messages.invalid-xml-name","source_hash