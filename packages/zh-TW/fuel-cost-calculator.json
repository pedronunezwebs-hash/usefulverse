{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"fuel-cost-calculator.copy.examples.2.heading":{"context":"fuel-cost-calculator UI copy.examples.2.heading","source_hash":"ca369bb83abe6f4840c513dcef30b5930f6d2bb2e819b16a1113a2dfcefa6fda","translation":"保持美國加侖一致"},"fuel-cost-calculator.copy.faq.4.question":{"context":"fuel-cost-calculator UI copy.faq.4.question","source_hash":"a1d33422cc16c263ac16f1f824d60e31e3479b74eeb8816af2386150291b67f7","translation":"為什麼四捨五入的份額並不總是精確相加?"},"fuel-cost-calculator.copy.form.hint":{"context":"fuel-cost-calculator UI copy.form.hint","source_hash":"9c82738424488dd1290e1905689fbabab4c6b6b42c687ab0799aa3a752cb4b24","translation":"將加油站價格單位與選定的燃料單位匹配。 貨幣是一個標籤,而不是實時匯率轉換。"},"fuel-cost-calculator.copy.form.modeLabels.us.b":{"context":"fuel-cost-calculator UI copy.form.modeLabels.us.b","source_hash":"30f8212f899cdc8a62b1664ad78f7dd473359d9a5b82fb742a69d550712fd1b0","translation":"效率(美國 MPG)"},"fuel-cost-calculator.copy.form.modes.metric":{"context":"fuel-cost-calculator UI copy.form.modes.metric","source_hash":"8d3b2f9c5952cdbc224f9fda28ff48da4e10b4a008dee3b08b988bb4b26d46d5","translation":"公里和升"},"fuel-cost-calculator.copy.intro":{"context":"Shared UI copy.intro","source_hash":"b237cee27f84a7011acd8ab8173e58dca2ef4322298ed9caa18bc7bf99e0be48","translation":"輸入距離、油耗和加油站價格,估算行程成本,包括往返行程或乘客份額。"},"fuel-cost-calculator.copy.method.paragraphs.2":{"context":"fuel-cost-calculator UI copy.method.paragraphs.2","source_hash":"853cdb4c9b7a6a32c4c963064871ab098b5703e3161918074b02b1ea72a231dc","translation":"美式加侖和英制加侖是不同的量,請選擇正確的MPG模式,並使用相同加侖型別的泵價格。 計算器不會預設混合一個加侖定義與另一個加侖定義或轉換未知單位的價格。"},"fuel-cost-calculator.copy.method.paragraphs.3":{"context":"fuel-cost-calculator UI copy.method.paragraphs.3","source_hash":"2650f6ef3afb1a464fa9cfd375dcafeb6249b5e74bef004f63d2232bf7b1ea7d","translation":"回程在計算燃料之前將輸入的單程距離加倍。 即使選擇了該選項,也要輸入單程距離。 如果回程路線的長度或燃料消耗不同,請分別計算每段路程,然後合併數量。"},"fuel-cost-calculator.copy.method.paragraphs.4":{"context":"fuel-cost-calculator UI copy.method.paragraphs.4","source_hash":"95618f6bf7f252e8d45a33a0738cb1321840fba03ade48f81d0799f5e24954b5","translation":"乘客份額 乘客份額是指整個行程費用除以共享人數的正整數。 當司機支付份額時,將司機也包括在內。 顯示的金額和份額獨立四捨五入到兩個位置,因此四捨五入後的份額可能與總額略有不同。"},"fuel-cost-calculator.copy.privacy.heading":{"context":"fuel-cost-calculator UI copy.privacy.heading","source_hash":"bef0dc8aaebf768fa2be1fb224ac1a08ac3fa810c85991f3040785b5239b6229","translation":"私人計算,明確的界限"},"fuel-cost-calculator.copy.privacy.paragraphs.2":{"context":"fuel-cost-calculator UI copy.privacy.paragraphs.2","source_hash":"8b3fd9a899a4f3c379c1bc5f5801391bfa6053d76d429ccef1de4f2589ffbb6f","translation":"大型計算取決於裝置時間和記憶體。 取消 停止當前作業。 出錯 清除舊答案並禁用其下載。"},"fuel-cost-calculator.copy.ui.cancelled":{"context":"fuel-cost-calculator UI copy.ui.cancelled","source_hash":"cbc7e63195c8c729eb51e1604d71b9a5e25fa25e519cbe3319c9563fe20ffb48","translation":"停止。 更改輸入或重新計算。"},"fuel-cost-calculator.copy.ui.decimalNote":{"context":"fuel-cost-calculator UI copy.ui.decimalNote","source_hash":"130afa47f1fb786eeebfdef705eb46297f9d4ab3d1e6d6a161954a9537c72251","translation":"小數值四捨五入到 12 位。 分數保持精確。"},"fuel-cost-calculator.copy.ui.errors.NOT_ENOUGH":{"context":"fuel-cost-calculator UI copy.ui.errors.NOT_ENOUGH","source_hash":"dea150bdfc2549c8be20d8114bc3689c883a873f0049febf17cb14037be47dc6","translation":"範圍中包含的不同值少於您請求的數量。 擴大範圍或允許重複。"},"fuel-cost-calculator.copy.ui.errors.RANGE":{"context":"fuel-cost-calculator UI copy.ui.errors.RANGE","source_hash":"ee3286fdd9a7187749d395a15a0297ac4ff762a01d4af8c31f54f5349e2bc8b8","translation":"檢查邊界。 選定的整數或小數網格必須至少包含一個值。"},"fuel-cost-calculator.copy.ui.featuresLabel":{"context":"fuel-cost-calculator UI copy.ui.featuresLabel","source_hash":"0d0481c8755dc795cf36b04a8ba791e0b35ab2b72acc375519566f568065252b","translation":"工具特點"},"fuel-cost-calculator.copy.ui.labels.maximum":{"context":"fuel-cost-calculator UI copy.ui.labels.maximum","source_hash":"66c9ab177708cbc6b9770301ef0caa3f4fdcab0e3741a7f555b025a5d7dac2eb","translation":"最大值"},"fuel-cost-calculator.copy.ui.labels.median":{"context":"fuel-cost-calculator UI copy.ui.labels.median","source_hash":"daab7c435134742abeb8e1e42de999740f2362c3f58271edf32e627e97bf2130","translation":"中值"},"fuel-cost-calculator.copy.ui.labels.minimum":{"context":"fuel-cost-calculator UI copy.ui.labels.minimum","source_hash":"735beee2e390c7979f936104c3cb5a30c752d73d68844eefc028c403aee8229b","translation":"最低限度"}},"locale":"zh-TW","missing":["fuel-cost-calculator.copy.title","fuel-cost-calculator.copy.description","fuel-cost-calculator.copy.heading","fuel-cost-calculator.copy.category","fuel-cost-calculator.copy.eyebrow","fuel-cost-calculator.copy.ui.themeDark","fuel-cost-calculator.copy.ui.themeLight","fuel-cost-calculator.copy.ui.copy","fuel-cost-calculator.copy.ui.share","fuel-cost-calculator.copy.ui.copied","fuel-cost-calculator.copy.ui.copyFallback","fuel-cost-calculator.copy.ui.reset","fuel-cost-calculator.copy.ui.shareNotice","fuel-cost-calculator.copy.ui.trust.0","fuel-cost-calculator.copy.ui.trust.1","fuel-cost-calculator.copy.ui.trust.2","fuel-cost-calculator.copy.ui.calculate","fuel-cost-calculator.copy.ui.cancel","fuel-cost-calculator.copy.ui.result","fuel-cost-calculator.copy.ui.empty","fuel-cost-calculator.copy.ui.working","fuel-cost-calculator.copy.ui.steps","fuel-cost-calculator.copy.ui.download","fuel-cost-calculator.copy.ui.noScript","fuel-cost-calculator.copy.ui.labels.decimal","fuel-cost-calculator.copy.ui.labels.mixed","fuel-cost-calculator.copy.ui.labels.factor","fuel-cost-calculator.copy.ui.labels.cofactor","fuel-cost-calculator.copy.ui.labels.witness","fuel-cost-calculator.copy.ui.labels.rounds","fuel-cost-calculator.copy.ui.labels.digitReading","fuel-cost-calculator.copy.ui.labels.exact","fuel-cost-calculator.copy.ui.labels.saved","fuel-cost-calculator.copy.ui.labels.discountRate","fuel-cost-calculator.copy.ui.labels.count","fuel-cost-calculator.copy.ui.labels.range","fuel-cost-calculator.copy.ui.labels.sum","fuel-cost-calculator.copy.ui.l