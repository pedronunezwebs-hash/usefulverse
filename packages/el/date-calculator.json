{"complete_extracted_copy":false,"coverage":"improved-source","entries":{"date-calculator.copy.description":{"context":"date-calculator UI copy.description","source_hash":"b9545b9eb0577f4e5b0dc2fa9201b0f0e0fdd95a3327cefb8c12fb2e2ea9ff46","translation":"Μετρήστε τις ημέρες μεταξύ ημερομηνιών ή προσθέστε έτη, μήνες, εβδομάδες και ημέρες.Δείτε τις περιόδους ημερολογίου, τις ημέρες της εβδομάδας και τους κανόνες τέλους μήνα. Δωρεάν, με υπολογισμούς στο πρόγραμμα περιήγησής σας."},"date-calculator.copy.examples.1.heading":{"context":"date-calculator UI copy.examples.1.heading","source_hash":"d6d28bc1383520659baef7759384cdd9eb82ee0c7a2094e8bd9e088f7b1ef544","translation":"Διασχίζοντας μια δίσεκτη ημέρα"},"date-calculator.copy.examplesAction":{"context":"date-calculator UI copy.examplesAction","source_hash":"68623191a26dab07c7acedb36efb8ae1cacd13e3fabd0fe23f1f7d026bfe8424","translation":"Χρησιμοποιήστε αυτό το παράδειγμα"},"date-calculator.copy.faq.1.question":{"context":"date-calculator UI copy.faq.1.question","source_hash":"5575581be04ce9e4caf865dcb74b689a3fd2fe3a7d8ae3669419322ae908c2ad","translation":"Πρέπει να υπολογίσω τις ημερομηνίες έναρξης και λήξης;"},"date-calculator.copy.faq.7.question":{"context":"date-calculator UI copy.faq.7.question","source_hash":"1db31f79eca7e861e53e33bf5d69ab07641998a90bc740e652efa8904ab34f7c","translation":"Τι γίνεται αν η ημερομηνία λήξης είναι πριν από την ημερομηνία έναρξης;"},"date-calculator.copy.faq.8.question":{"context":"date-calculator UI copy.faq.8.question","source_hash":"a3e51e0f5580c63175929bf0fed22199fc8b23f32be6b3c76d6b09ca4a79ab71","translation":"Εξαιρούνται τα Σαββατοκύριακα και οι αργίες;"},"date-calculator.copy.faq.9.question":{"context":"date-calculator UI copy.faq.9.question","source_hash":"3da5ad3925c1d5d801d5c8b33511473428bf0388dc437022566a061094940482","translation":"Μπορώ να αποθηκεύσω ή να μοιραστώ τον υπολογισμό μου;"},"date-calculator.copy.how.steps.1.heading":{"context":"date-calculator UI copy.how.steps.1.heading","source_hash":"52eb773145390fd7110cc934a5eaded6c227457ba9a6cc850de53707ec48abc5","translation":"Εισάγετε τις ημερομηνίες"},"date-calculator.copy.how.steps.2.heading":{"context":"date-calculator UI copy.how.steps.2.heading","source_hash":"7f0b30d9dd6daca4c10b947e1e8aa435e89d85ec0295002c9ecc1ca9d2714795","translation":"Διαβάστε το αποτέλεσμα"},"date-calculator.copy.labels.privacy":{"context":"date-calculator UI copy.labels.privacy","source_hash":"aab7685123cf4b021c62a41c905fdc381aaa3ae8e944299e4cdf58955258f445","translation":"Καλό να γνωρίζετε"},"date-calculator.copy.method.paragraphs.4":{"context":"date-calculator UI copy.method.paragraphs.4","source_hash":"c0e9da1bd3710dc9fba1b6cd203cb5e7dce6ffe21c9a57c1bcec59f1dbb24949","translation":"Οι υπολογισμοί χρησιμοποιούν ημερομηνίες ημερολογίου, όχι ώρες της ημέρας. Η αλλαγή της θερινής ώρας δεν μετατρέπει μια ημερολογιακή ημέρα σε κλάσμα εδώ. Για τις ώρες μεταξύ των ωρών, χρησιμοποιήστε την Υπολογιστής διάρκειας χρόνου. Για τις εργάσιμες ημέρες, χρησιμοποιήστε την Υπολογιστής εργάσιμων ημερών και επιλέξτε τις αργίες που ισχύουν."},"date-calculator.copy.navigation.method":{"context":"date-calculator UI copy.navigation.method","source_hash":"b16509e3daf1095de76d04de628ca3f2354472a71660196b42b7de6d4b4392d5","translation":"Κανόνες καταμέτρησης"},"date-calculator.copy.navigation.onPage":{"context":"date-calculator UI copy.navigation.onPage","source_hash":"06a7b55d6c3eb44df5cb54524e6103ecbc08f496c8689513efc7aac2b548b170","translation":"Επωφεληθείτε στο έπακρο"},"date-calculator.copy.ui.clipped":{"context":"date-calculator UI copy.ui.clipped","source_hash":"17b28869c0069b7545d357b15d31054abb7410b9e5d5eaaf9a1a90697bf31837","translation":"Ο μήνας-στόχος είναι μικρότερος. Χρησιμοποιήσαμε την τελευταία έγκυρη ημέρα του, όπως επιλέχθηκε."},"date-calculator.copy.ui.notClipped":{"context":"date-calculator UI copy.ui.notClipped","source_hash":"6975fb44d06932ad9e0bfa4270fc3f397855bb272909c5a212ffc6dac9642632","translation":"Η ημέ